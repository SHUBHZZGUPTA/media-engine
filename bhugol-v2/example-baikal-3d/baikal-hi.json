{
 "slug": "baikal",
 "lines": [
  {
   "o": 0,
   "text": "ये एक झील, पाँचों Great Lakes पर भारी है।",
   "chunks": [
    "ये *एक झील,*",
    "पाँचों Great Lakes|पर *भारी* है।"
   ]
  },
  {
   "o": 0,
   "text": "बेल्जियम से बस थोड़ी-सी बड़ी होकर... ये पाँचों पर भारी कैसे?",
   "chunks": [
    "*बेल्जियम* से बस|थोड़ी-सी बड़ी होकर...",
    "ये पाँचों पर|भारी *कैसे?*"
   ]
  },
  {
   "o": 0,
   "text": "ये है Lake बाइकाल, साइबेरिया में। Great Lakes को ये बात बिल्कुल पसंद नहीं।",
   "chunks": [
    "ये है Lake *बाइकाल,*",
    "*साइबेरिया* में।",
    "Great Lakes को ये बात|बिल्कुल *पसंद नहीं।*"
   ]
  },
  {
   "o": 0,
   "text": "हम तो लगभग आठ गुना बड़े हैं!",
   "chunks": [
    "हम तो लगभग|*आठ गुना* बड़े हैं!"
   ],
   "speaker": "superior"
  },
  {
   "o": 0,
   "text": "मैप पर? हाँ। तो बाइकाल इतना पानी छुपाता कहाँ है?",
   "chunks": [
    "मैप पर? *हाँ।*",
    "तो बाइकाल इतना *पानी*",
    "छुपाता *कहाँ* है?"
   ]
  },
  {
   "o": 0,
   "text": "सीधा नीचे।",
   "chunks": [
    "सीधा *नीचे।*"
   ]
  },
  {
   "o": 0,
   "text": "बाइकाल की गहराई है 1,642 मीटर। Lake Superior से करीब चार गुना।",
   "chunks": [
    "बाइकाल की गहराई है|*1,642 मीटर।*",
    "Lake Superior से",
    "करीब *चार गुना।*"
   ]
  },
  {
   "o": 0,
   "text": "नापने को किसने कहा था?",
   "chunks": [
    "*नापने* को|किसने कहा था?"
   ],
   "speaker": "superior"
  },
  {
   "o": 0,
   "text": "यानी लगभग पाँच एफिल टावर जितनी गहरी।",
   "chunks": [
    "यानी लगभग",
    "*पाँच एफिल टावर*|जितनी गहरी।"
   ]
  },
  {
   "o": 0,
   "text": "पर इतनी गहरी क्यों? बाइकाल किसी घाटी में नहीं, धरती की एक दरार में भरा है।",
   "chunks": [
    "पर इतनी|*गहरी क्यों?*",
    "बाइकाल किसी|*घाटी* में नहीं,",
    "धरती की एक",
    "*दरार* में भरा है।"
   ]
  },
  {
   "o": 0,
   "text": "यहाँ ज़मीन धीरे-धीरे दो हिस्सों में खिंच रही है।",
   "chunks": [
    "यहाँ ज़मीन|धीरे-धीरे",
    "दो हिस्सों में|*खिंच रही है।*"
   ]
  },
  {
   "o": 0,
   "text": "ये दरार 25 से 30 million साल पहले खुली थी। यानी बाइकाल धरती की सबसे पुरानी झील है।",
   "chunks": [
    "ये दरार",
    "*25 से 30 million*|साल पहले खुली थी।",
    "यानी बाइकाल",
    "धरती की|सबसे *पुरानी झील* है।"
   ]
  },
  {
   "o": 0,
   "text": "और Great Lakes? वो तो करीब 14,000 साल पहले भरीं।",
   "chunks": [
    "और *Great Lakes?*",
    "वो तो करीब|*14,000* साल पहले भरीं।"
   ]
  },
  {
   "o": 0,
   "text": "टॉपिक बदलें क्या?",
   "chunks": [
    "*टॉपिक* बदलें क्या?"
   ],
   "speaker": "superior"
  },
  {
   "o": 0,
   "text": "और ये दरार अब भी खुल रही है। हर साल करीब 4 millimetre।",
   "chunks": [
    "और ये दरार",
    "अब भी *खुल रही है।*",
    "हर साल करीब|*4 millimetre।*"
   ]
  },
  {
   "o": 0,
   "text": "चौड़ाई झील को बड़ा दिखाती है... गहराई उसे बड़ा बनाती है।",
   "chunks": [
    "*चौड़ाई* झील को|बड़ा दिखाती है...",
    "*गहराई* उसे|बड़ा बनाती है।"
   ]
  },
  {
   "o": 0,
   "text": "और ट्विस्ट ये है: पानी का तल, असली तल है ही नहीं।",
   "chunks": [
    "और *ट्विस्ट* ये है:",
    "पानी का तल, असली|*तल* है ही नहीं।"
   ]
  },
  {
   "o": 0,
   "text": "झील के तल के नीचे 7 किलोमीटर तक कीचड़ जमा है। दरार लगभग उतनी गहरी है, जितना Everest ऊँचा है।",
   "chunks": [
    "झील के तल के नीचे",
    "*7 किलोमीटर* तक|कीचड़ जमा है।",
    "दरार लगभग|उतनी गहरी है,",
    "जितना *Everest*|ऊँचा है।"
   ]
  },
  {
   "o": 0,
   "text": "और ऊपर से? अब भी बेल्जियम से बस थोड़ी-सी बड़ी लगती है।",
   "chunks": [
    "और *ऊपर से?*",
    "अब भी *बेल्जियम* से|बस थोड़ी-सी बड़ी लगती है।"
   ]
  },
  {
   "o": 0,
   "text": "हर बार मुझे ही क्यों घसीटते हो?",
   "chunks": [
    "हर बार|मुझे ही क्यों",
    "*घसीटते* हो?"
   ],
   "speaker": "belgium"
  },
  {
   "o": 0,
   "text": "ये है भूगोल। ऐसे ही मज़ेदार जियोग्राफी फैक्ट्स के लिए फॉलो करें।",
   "chunks": [
    "ये है *भूगोल।*",
    "ऐसे ही मज़ेदार जियोग्राफी|फैक्ट्स के लिए फॉलो करें।"
   ]
  }
