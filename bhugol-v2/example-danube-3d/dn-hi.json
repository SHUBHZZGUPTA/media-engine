{
 "slug": "danube-hi",
 "lines": [
  {
   "o": 0.443,
   "text": "आप Danube को जानते हैं: चार capitals, दस देश। पर आपने नहीं देखा इसका एक हिस्सा असल में कहाँ जाता है।",
   "chunks": [
    "आप *Danube* को|जानते हैं:",
    "*चार capitals,*",
    "*दस देश।*",
    "पर आपने नहीं देखा",
    "इसका एक हिस्सा|*असल में कहाँ जाता है।*"
   ],
   "cs": [
    0.443,
    1.954,
    2.71,
    3.465,
    4.976
   ]
  },
  {
   "o": 7.243,
   "text": "ये Germany के Black Forest से निकलती है, Black Sea की ओर।",
   "chunks": [
    "ये Germany के",
    "*Black Forest* से|निकलती है,",
    "*Black Sea* की ओर।"
   ],
   "cs": [
    7.243,
    8.6,
    9.279
   ]
  },
  {
   "o": 10.976,
   "text": "रास्ते में: Vienna. फिर, बस 56 kilometres बाद... Bratislava.",
   "chunks": [
    "रास्ते में:",
    "*Vienna.*",
    "फिर, बस|*56 kilometres* बाद...",
    "*Bratislava.*"
   ],
   "cs": [
    10.976,
    12.496,
    13.003,
    15.536
   ]
  },
  {
   "o": 16.043,
   "text": "दो capitals, कई लोगों के office से भी पास।",
   "chunks": [
    "दो capitals,",
    "*कई लोगों के office*|से भी पास।"
   ],
   "cs": [
    16.043,
    17.012
   ]
  },
  {
   "o": 19.433,
   "text": "फिर ये Budapest को बीच से काटती है, फिर Belgrade.",
   "chunks": [
    "फिर ये *Budapest* को",
    "बीच से काटती है,",
    "फिर *Belgrade.*"
   ],
   "cs": [
    19.433,
    20.942,
    21.696
   ]
  },
  {
   "o": 23.205,
   "text": "चार capitals एक नदी पर। किसी और नदी पर इतनी नहीं।",
   "chunks": [
    "*चार capitals*",
    "एक नदी पर।",
    "किसी और नदी पर",
    "*इतनी नहीं।*"
   ],
   "cs": [
    23.205,
    23.982,
    25.149,
    26.704
   ]
  },
  {
   "o": 27.481,
   "text": "तो फिर, शुरुआत के पास, ये कभी-कभी... ग़ायब क्यों होती है?",
   "chunks": [
    "तो फिर,",
    "शुरुआत के पास,",
    "ये कभी-कभी...",
    "*ग़ायब क्यों होती है?*"
   ],
   "cs": [
    27.481,
    28.427,
    29.846,
    31.265
   ]
  },
  {
   "o": 31.738,
   "text": "Rewind. Germany में Immendingen के पास, नदी के नीचे limestone है, दरारों से भरा।",
   "chunks": [
    "*Rewind.*",
    "Germany में *Immendingen*|के पास,",
    "नदी के नीचे|*limestone* है,",
    "*दरारों* से भरा।"
   ],
   "cs": [
    31.738,
    32.192,
    34.008,
    35.824
   ]
  },
  {
   "o": 37.186,
   "text": "पानी रिसकर सीधे ज़मीन में चला जाता है। 1921 में, वो हिस्सा सूखा रहा 309 दिन।",
   "chunks": [
    "पानी *रिसकर*",
    "सीधे ज़मीन में|चला जाता है।",
    "*1921* में,",
    "वो हिस्सा सूखा रहा",
    "*309 दिन।*"
   ],
   "cs": [
    37.186,
