{
 "slug": "bengaluru-hi",
 "lines": [
  {
   "o": 0.437,
   "text": "बेंगलुरु की लगभग हर झील, इंसानों ने हाथ से बनाई थी।",
   "chunks": [
    "बेंगलुरु की लगभग|हर *झील,*",
    "इंसानों ने",
    "*हाथ से* बनाई थी।"
   ],
   "cs": [
    0.437,
    1.669,
    3.311
   ]
  },
  {
   "o": 4.953,
   "text": "1,100 साल में। फिर शहर ने ज़्यादातर खो दीं।",
   "chunks": [
    "*1,100 साल* में।",
    "फिर शहर ने|*ज़्यादातर खो दीं।*"
   ],
   "cs": [
    4.953,
    6.292
   ]
  },
  {
   "o": 9.415,
   "text": "तो झीलें बनाईं ही क्यों?",
   "chunks": [
    "तो *झीलें*|बनाईं ही क्यों?"
   ],
   "cs": [
    9.415
   ]
  },
  {
   "o": 10.934,
   "text": "मैप देखिए। बेंगलुरु एक पहाड़ी पर है, करीब 920 मीटर ऊपर।",
   "chunks": [
    "मैप देखिए।",
    "*बेंगलुरु* एक|*पहाड़ी* पर है,",
    "करीब *920 मीटर* ऊपर।"
   ],
   "cs": [
    10.934,
    12.598,
    14.677
   ]
  },
  {
   "o": 16.341,
   "text": "यहाँ कोई बड़ी नदी नहीं बहती। नदियाँ नीचे बहती हैं। और बेंगलुरु खुद पहाड़ी है।",
   "chunks": [
    "यहाँ कोई बड़ी *नदी*|नहीं बहती।",
    "नदियाँ *नीचे* बहती हैं।",
    "और बेंगलुरु|*खुद पहाड़ी है।*"
   ],
   "cs": [
    16.341,
    18.563,
    19.896
   ]
  },
  {
   "o": 21.673,
   "text": "तो बिना नदी के, झीलें भरें कैसे?",
   "chunks": [
    "तो बिना *नदी* के,",
    "*झीलें* भरें कैसे?"
   ],
   "cs": [
    21.673,
    23.692
   ]
  },
  {
   "o": 24.701,
   "text": "चलिए, 1,100 साल पीछे।",
   "chunks": [
    "चलिए,|*1,100 साल* पीछे।"
   ],
   "cs": [
    24.701
   ]
  },
  {
   "o": 26.919,
   "text": "लोगों ने घाटियों में मिट्टी की दीवारें बनाईं, बारिश रोकने के लिए।",
   "chunks": [
    "लोगों ने घाटियों में",
    "*मिट्टी की दीवारें*|बनाईं,",
    "*बारिश* रोकने|के लिए।"
   ],
   "cs": [
    26.919,
    28.371,
    29.461
   ]
  },
  {
   "o": 30.913,
   "text": "बारिश एक झील भरती है। फिर अगली में छलकती है। फिर अगली में।",
   "chunks": [
    "बारिश एक|*झील भरती है।*",
    "फिर अगली में|*छलकती है।*",
    "फिर *अगली में।*"
   ],
   "cs": [
    30.913,
    32.673,
    34.874
   ]
  },
  {
   "o": 36.194,
   "text": "वीईई! झील नंबर 7!",
   "chunks": [
    "*वीईई!*",
    "झील नंबर|*7!*"
   ],
   "speaker": "drop",
   "cs": [
    36.194,
    36.778
   ]
  },
  {
   "o": 38.529,
   "text": "नहरों ने इन्हें 6 चेन में जोड़ा, 3 घाटियों में नीचे उतरते हुए।",
   "chunks": [
    "*नहरों* ने इन्हें|*6 चेन* में जोड़ा,",
    "*3 घाटियों* में|नीचे उतरते हुए।"
   ],
   "cs": [
    38.529,
    41.065
   ]
  },
  {
   "o": 42.756,
   "text": "1537 में केम्पेगौड़ा ने शहर बसाया, और झीलें बनवाते रहे।",
   "chunks": [
    "*1537* में",
    "*केम्पेगौड़ा* ने|शहर बसाया,",
    "और झीलें|*बनवाते रहे।*"
   ],
   "cs": [
    42.756,
    43.743,
    45.718
   ]
  },
  {
   "o": 47.692,
   "text": "फिर शहर बढ़ा। और बढ़ा। और बढ़ा।",
   "chunks": [
    "फिर शहर|*बढ़ा।*",
    "और *बढ़ा।*",
    "और *बढ़ा।*"
   ],
   "cs": [
    47.692,
    49.367,
    50.205
   ]
  },
  {
   "o": 51.043,
   "text": "1973 से 2013 तक, करीब 79% जल-स्रोत गायब हो गए।",
   "chunks": [
    "*1973* से|*2013* तक,",
    "करीब *79%*|जल-स्रोत",
    "*गायब हो गए।*"
   ],
   "cs": [
    51.043,
    53.241,
    56.538
   ]
  },
  {
   "o": 57.087,
   "text": "आज पानी कावेरी से करीब 100 km पंप होता है, और 300 मीटर ऊपर चढ़ाया जाता है।",
   "chunks": [
    "आज पानी *कावेरी* से",
    "करीब *100 km*|पंप होता है,",
    "और *300 मीटर*|ऊपर चढ़ाया जाता है।"
   ],
   "cs": [
    57.087,
    59.31,
    61.977
   ]
  },
  {
   "o": 64.2,
   "text": "जिस शहर ने अपनी झीलें खुद बनाईं, वो आज नदी उधार लेता है।",
   "chunks": [
    "जिस शहर ने|अपनी *झीलें* खुद बनाईं,",
    "वो आज *नदी*|*उधार लेता है।*"
   ],
   "cs": [
    64.2,
    66.521
   ]
  },
  {
   "o": 67.847,
   "text": "और खोई झीलें? कई आपके सामने ही छिपी हैं।",
   "chunks": [
    "और *खोई झीलें?*",
    "कई आपके सामने|ही *छिपी हैं।*"
   ],
   "cs": [
    67.847,
    69.163
   ]
  },
  {
   "o": 71.138,
   "text": "कंठीरवा स्टेडियम? संपंगी झील।",
   "chunks": [
    "कंठीरवा स्टेडियम?",
    "*संपंगी झील।*"
   ],
   "cs": [
    71.138,
    72.559
   ]
  },
  {
   "o": 73.979,
   "text": "KR मार्केट? सिद्दिकट्टे झील।",
   "chunks": [
    "KR मार्केट?",
    "*सिद्दिकट्टे झील।*"
   ],
   "cs": [
    73.979,
    75.204
   ]
  },
  {
   "o": 76.43,
   "text": "मैजेस्टिक बस स्टैंड? धर्मांबुधि झील।",
   "chunks": [
    "मैजेस्टिक बस स्टैंड?",
    "*धर्मांबुधि झील।*"
   ],
   "cs": [
    76.43,
    78.454
   ]
  },
  {
   "o": 79.804,
   "text": "टेक्निकली, मैं झील में पार्क हूँ।",
   "chunks": [
    "*टेक्निकली,*",
    "मैं झील में|*पार्क हूँ।*"
   ],
   "speaker": "bus",
   "cs": [
    79.804,
    80.347
   ]
  },
  {
   "o": 83.059,
   "text": "बेंगलुरु के पास कभी बड़ी नदी नहीं थी। तो उसने झीलें बना लीं।",
   "chunks": [
    "बेंगलुरु के पास कभी|बड़ी *नदी* नहीं थी।",
    "तो उसने|*झीलें* बना लीं।"
