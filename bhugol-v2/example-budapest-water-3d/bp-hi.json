{
 "slug": "budapest-water-hi",
 "lines": [
  {
   "o": 0.481,
   "text": "Budapest के नीचे हर दिन 70 million litres गर्म पानी ऊपर आता है। और वो नीचे क्या कर रहा है, आप सोच भी नहीं सकते।",
   "chunks": [
    "*Budapest* के नीचे",
    "हर दिन *70 million litres*",
    "*गर्म पानी* ऊपर आता है।",
    "और वो नीचे|क्या कर रहा है,",
    "आप *सोच भी नहीं सकते।*"
   ],
   "cs": [
    0.481,
    1.567,
    3.738,
    4.462,
    5.91
   ]
  },
  {
   "o": 7.719,
   "text": "तो इतना गर्म पानी आता कहाँ से है?",
   "chunks": [
    "तो इतना गर्म पानी",
    "*आता कहाँ से है?*"
   ],
   "cs": [
    7.719,
    9.608
   ]
  },
  {
   "o": 10.148,
   "text": "यहाँ धरती की परत पतली है। नीचे करीब हर 20 metres पर एक degree गर्मी बढ़ती है।",
   "chunks": [
    "यहाँ धरती की परत|*पतली* है।",
    "नीचे करीब हर|*20 metres* पर",
    "*एक degree*|गर्मी बढ़ती है।"
   ],
   "cs": [
    10.148,
    12.157,
    14.569
   ]
  },
  {
   "o": 16.176,
   "text": "बारिश Buda Hills में गहराई तक जाती है, गर्म होती है, और एक fault line से वापस ऊपर आती है।",
   "chunks": [
    "*बारिश* Buda Hills में|गहराई तक जाती है,",
    "गर्म होती है,",
    "और एक *fault line* से|वापस ऊपर आती है।"
   ],
   "cs": [
    16.176,
    18.535,
    19.208
   ]
  },
  {
   "o": 21.567,
   "text": "नतीजा? 123 गर्म झरने और कुएँ। पर असली अजीब बात ये नहीं है।",
   "chunks": [
    "नतीजा?",
    "*123* गर्म झरने|और कुएँ।",
    "पर असली *अजीब बात*|ये नहीं है।"
   ],
   "cs": [
    21.567,
    21.993,
    24.124
   ]
  },
  {
   "o": 26.681,
   "text": "Romans ने यहाँ 14 baths बनाए। Ottomans ने और बनाए, जो करीब 500 साल बाद भी खुले हैं।",
   "chunks": [
    "*Romans* ने यहाँ|*14 baths* बनाए।",
    "*Ottomans* ने और बनाए,",
    "जो करीब *500 साल* बाद|भी खुले हैं।"
   ],
   "cs": [
    26.681,
    29.21,
    30.895
   ]
  },
  {
   "o": 33.424,
   "text": "कुछ लोग तो जैसे कभी बाहर ही नहीं निकले।",
   "chunks": [
    "कुछ लोग तो जैसे",
    "कभी *बाहर ही नहीं निकले।*"
   ],
   "cs": [
    33.424,
    35.019
   ]
  },
  {
   "o": 35.976,
   "text": "पर ये पानी सिर्फ़ लोगों को गर्म नहीं कर रहा था। ये पत्थर खा रहा था।",
   "chunks": [
    "पर ये पानी सिर्फ़|लोगों को गर्म नहीं कर रहा था।",
    "ये *पत्थर खा रहा था।*"
   ],
   "cs": [
    35.976,
    38.443
   ]
  },
  {
   "o": 39.852,
   "text": "ज़्यादातर गुफाएँ बारिश ऊपर से बनाती है। ये गुफाएँ गर्म पानी ने... नीचे से बनाईं।",
   "chunks": [
    "ज़्यादातर गुफाएँ बारिश|*ऊपर से* बनाती है।",
    "ये गुफाएँ|गर्म पानी ने...",
    "*नीचे से* बनाईं।"
   ],
   "cs": [
    39.852,
    42.681,
    44.803
   ]
  },
  {
   "o": 45.51,
   "text": "तो अब नीचे क्या है?",
   "chunks": [
    "तो अब नीचे|*क्या है?*"
   ],
   "cs": [
    45.51
   ]
  },
  {
   "o": 47.052,
   "text": "एक busy सड़क के पास, metal के दरवाज़े के पीछे: पानी से भरी गुफा, करीब 6 kilometres लंबी।",
   "chunks": [
    "एक busy सड़क के पास,|*metal के दरवाज़े* के पीछे:",
    "*पानी से भरी गुफा,*",
    "करीब *6 kilometres* लंबी।"
   ],
   "cs": [
    47.052,
    49.988,
    51.089
   ]
  },
  {
   "o": 52.557,
   "text": "Divers इसमें तैरते हैं, गर्म पानी में, घरों से भरी पहाड़ी के नीचे।",
   "chunks": [
    "*Divers* इसमें तैरते हैं,",
    "गर्म पानी में,",
    "*घरों से भरी पहाड़ी*|के नीचे।"
   ],
   "cs": [
    52.557,
    53.943,
    54.983
   ]
  },
  {
   "o": 57.062,
   "text": "नीचे कोई traffic नहीं। Budapest का सबसे अच्छा रास्ता।",
   "chunks": [
    "नीचे कोई *traffic* नहीं।",
    "Budapest का|*सबसे अच्छा रास्ता।*"
   ],
   "cs": [
    57.062,
    58.643
   ]
  },
  {
   "o": 60.224,
   "text": "वहाँ नीचे: shark के fossil दाँत। Hungary में, जहाँ समुद्र ही नहीं है... अब।",
   "chunks": [
    "वहाँ नीचे:|*shark के fossil दाँत।*",
    "*Hungary* में, जहाँ|समुद्र ही नहीं है...",
    "*अब।*"
   ],
   "cs": [
    60.224,
    62.407,
    65.026
   ]
  },
  {
   "o": 65.462,
   "text": "Budapest में सिर्फ़ गर्म झरने नहीं हैं। Budapest ख़ुद एक झरने पर बैठा है।",
   "chunks": [
    "Budapest में सिर्फ़|गर्म झरने नहीं हैं।",
    "Budapest ख़ुद|*एक झरने पर बैठा है।*"
   ],
   "cs": [
    65.462,
    67.794
   ]
  },
  {
   "o": 69.348,
   "text": "और twist? वो गुफा अब भी बढ़ रही है।",
   "chunks": [
    "और *twist?*",
    "वो गुफा|*अब भी बढ़ रही है।*"
   ],
   "cs": [
    69.348,
    70.476
   ]
  },
  {
   "o": 72.357,
   "text": "अभी भी, गर्म पानी नीचे पत्थर घोल रहा है। बहुत... बहुत... धीरे।",
   "chunks": [
    "अभी भी, गर्म पानी|नीचे पत्थर *घोल* रहा है।",
    "बहुत...",
    "बहुत...",
    "*धीरे।*"
   ],
   "cs": [
