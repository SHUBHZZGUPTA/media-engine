{
 "slug": "marke",
 "lines": [
  {
   "o": 0,
   "text": "इस चट्टान पर खड़े हो जाओ, और आप एक साथ दो देशों और दो time zone में हो।",
   "chunks": [
    "इस चट्टान पर|खड़े हो जाओ,",
    "और आप एक साथ|*दो देशों*",
    "और *दो TIME ZONE*|में हो।"
   ]
  },
  {
   "o": 0,
   "text": "एक कदम, और घड़ी एक घंटा बदल जाती है।",
   "chunks": [
    "*एक कदम,*",
    "और घड़ी *एक घंटा*|बदल जाती है।"
   ]
  },
  {
   "o": 0,
   "text": "आधी Sweden, आधी Finland. और बॉर्डर? ऐसे मुड़ा है जैसे बहुत ज़्यादा coffee पी ली हो।",
   "chunks": [
    "आधी *SWEDEN,*",
    "आधी *FINLAND.*",
    "और *बॉर्डर?*",
    "ऐसे *मुड़ा* है",
    "जैसे बहुत ज़्यादा|*COFFEE* पी ली हो।"
   ]
  },
  {
   "o": 0,
   "text": "ये है Märket: 350 मीटर की नंगी चट्टान। ना पेड़, ना लोग। बस seals.",
   "chunks": [
    "ये है *MÄRKET:*",
    "*350 मीटर* की|नंगी चट्टान।",
    "ना पेड़, ना लोग।",
    "बस *SEALS.*"
   ]
  },
  {
   "o": 0,
   "text": "तो ये गड़बड़ किसने की?",
   "chunks": [
    "तो ये गड़बड़|किसने *की?*"
   ]
  },
  {
   "o": 0,
   "text": "चलो 1809 में। Sweden ने Finland को Russian Empire के हाथों खो दिया।",
   "chunks": [
    "चलो *1809* में।",
    "SWEDEN ने FINLAND को",
    "*RUSSIAN EMPIRE* के|हाथों *खो दिया।*"
   ]
  },
  {
   "o": 0,
   "text": "नया बॉर्डर? एक सीधी लाइन, ठीक इस चट्टान के बीच से।",
   "chunks": [
    "नया *बॉर्डर?*",
    "एक *सीधी लाइन,*",
    "ठीक इस चट्टान के|*बीच से।*"
   ]
  },
  {
   "o": 0,
   "text": "फिर 1885 में, Finland ने सबसे ऊँची जगह पर lighthouse बनाया। पूरे 2 मीटर ऊँची!",
   "chunks": [
    "फिर *1885* में,",
    "FINLAND ने सबसे|*ऊँची जगह* पर",
    "*LIGHTHOUSE* बनाया।",
    "पूरे *2 मीटर* ऊँची!"
   ]
  },
  {
   "o": 0,
   "text": "छोटी सी दिक्कत। वो जगह Sweden में थी।",
   "chunks": [
    "छोटी सी *दिक्कत।*",
    "वो जगह|*SWEDEN* में थी।"
   ]
  },
  {
   "o": 0,
   "text": "Sweden खुश नहीं था।",
   "chunks": [
    "SWEDEN|*खुश नहीं था।*"
   ]
  },
  {
   "o": 0,
   "text": "और lighthouse? उसे बस view पसंद था।",
   "chunks": [
    "और *LIGHTHOUSE?*",
    "उसे बस *VIEW*|पसंद था।"
   ]
  },
  {
   "o": 0,
   "text": "और वो 100 साल तक गलत देश में खड़ा रहा।",
   "chunks": [
    "और वो *100 साल*",
    "तक *गलत देश* में",
    "खड़ा रहा।"
   ]
  },
  {
   "o": 0,
   "text": "और इसका हल और भी अजीब है।",
   "chunks": [
    "और इसका हल|और भी *अजीब* है।"
   ]
  },
  {
   "o": 0,
   "text": "1985 में, lighthouse हटाने की जगह... उन्होंने बॉर्डर ही हटा दिया।",
   "chunks": [
    "*1985* में,",
    "LIGHTHOUSE हटाने|की जगह...",
    "उन्होंने *बॉर्डर*|ही *हटा दिया।*"
   ]
  },
  {
   "o": 0,
   "text": "अब बॉर्डर tower के चारों ओर 480 मीटर का S बनाता है।",
   "chunks": [
    "अब बॉर्डर *TOWER* के",
    "चारों ओर",
    "*480 मीटर* का|S बनाता है।"
   ]
  },
  {
   "o": 0,
   "text": "Finland को lighthouse मिला, और Sweden को उतनी ही ज़मीन वापस।",
   "chunks": [
    "FINLAND को|*LIGHTHOUSE* मिला,",
    "और SWEDEN को|*उतनी ही ज़मीन* वापस।"
   ]
  },
  {
   "o": 0,
   "text": "लेकिन याद रखो, Sweden का time Finland से एक घंटा पीछे है।",
   "chunks": [
    "लेकिन याद रखो,",
    "SWEDEN का TIME|FINLAND से",
    "*एक घंटा पीछे* है।"
   ]
  },
  {
   "o": 0,
   "text": "तो इस लाइन के आर-पार कूदो, और time में आगे-पीछे होते रहो।",
   "chunks": [
    "तो इस लाइन के|*आर-पार* कूदो,",
    "और TIME में",
    "*आगे-पीछे*|होते रहो।"
   ]
  },
  {
   "o": 0,
   "text": "Sweden का इनाम? एक घंटा ज़्यादा नींद।",
   "chunks": [
    "SWEDEN का *इनाम?*",
    "एक घंटा|*ज़्यादा नींद।*"
   ]
  },
  {
   "o": 0,
   "text": "तो अगली बार कोई कहे कि आप एक साथ दो जगह नहीं हो सकते...",
   "chunks": [
    "तो अगली बार|कोई कहे कि",
    "आप एक साथ|*दो जगह*",
    "नहीं हो सकते..."
   ]
  }
 ],
