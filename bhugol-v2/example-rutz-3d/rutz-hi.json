{
 "slug": "rutz",
 "lang": "hi",
 "lines": [
  {
   "o": 0,
   "text": "New Year की आधी रात आपके लिए एक बार। रूस में eleven बार।",
   "chunks": [
    "NEW YEAR की आधी रात|आपके लिए *एक* बार।",
    "रूस में|*ELEVEN* बार।"
   ]
  },
  {
   "o": 0,
   "text": "Kamchatka में midnight... तब Kaliningrad में अभी 2 PM।",
   "chunks": [
    "*KAMCHATKA* में|MIDNIGHT...",
    "तब KALININGRAD में|अभी *2 PM।*"
   ]
  },
  {
   "o": 0,
   "text": "तो एक देश eleven घड़ियों पर कैसे चले?",
   "chunks": [
    "तो एक देश|ELEVEN घड़ियों",
    "पर *कैसे चले?*"
   ]
  },
  {
   "o": 0,
   "text": "2010 में रूस ने दो zones हटा दिए।",
   "chunks": [
    "*2010* में",
    "रूस ने दो ZONES|*हटा दिए।*"
   ]
  },
  {
   "o": 0,
   "text": "Kamchatka के लोग... विरोध में उतर आए।",
   "chunks": [
    "KAMCHATKA के लोग...",
    "*विरोध में उतर आए।*"
   ]
  },
  {
   "o": 0,
   "text": "2014 तक, दोनों वापस।",
   "chunks": [
    "*2014* तक,",
    "दोनों *वापस।*"
   ]
  },
  {
   "o": 0,
   "text": "और ट्रेनें? 2018 तक, सारी timetables Moscow time पर चलती थीं।",
   "chunks": [
    "और *ट्रेनें?*",
    "*2018* तक, सारी|TIMETABLES",
    "*MOSCOW TIME* पर|चलती थीं।"
   ]
  },
  {
   "o": 0,
   "text": "आपकी 7 PM की ट्रेन? यहाँ तो 2 AM हैं।",
   "chunks": [
    "आपकी *7 PM*|की ट्रेन?",
    "यहाँ तो *2 AM* हैं।"
   ],
   "speaker": "clock"
  },
  {
   "o": 0,
   "text": "World record, है ना?",
   "chunks": [
    "WORLD RECORD,|*है ना?*"
   ]
  },
  {
   "o": 0,
   "text": "नहीं। France के twelve zones हैं... दुनिया भर में फैले द्वीपों की वजह से।",
   "chunks": [
    "*नहीं।*",
    "*FRANCE* के *TWELVE*|ZONES हैं...",
    "दुनिया भर में फैले|द्वीपों की वजह से।"
   ]
  },
  {
   "o": 0,
   "text": "रूस चौड़ा है। मैं हर जगह हूँ।",
   "chunks": [
    "रूस *चौड़ा* है।",
    "मैं *हर जगह* हूँ।"
   ],
   "speaker": "france"
  },
  {
   "o": 0,
   "text": "ये है भूगोल। ऐसे ही मज़ेदार जियोग्राफी फैक्ट्स के लिए फॉलो करें।",
   "chunks": [
    "ये है *भूगोल।*",
    "ऐसे ही मज़ेदार जियोग्राफी|फैक्ट्स के लिए फॉलो करें।"
   ]
  }
 ],
