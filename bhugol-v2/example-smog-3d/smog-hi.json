 "tail": 2.3,
 "lines": [
  {
   "o": 0,
   "text": "इस हफ़्ते, दुनिया के 100 सबसे प्रदूषित शहरों में से 86 एक ही देश में थे।",
   "chunks": [
    "इस हफ़्ते, दुनिया के|*100* सबसे प्रदूषित",
    "शहरों में से *86*",
    "*एक ही देश* में थे।"
   ]
  },
  {
   "o": 0,
   "text": "दिल्ली के एक स्टेशन पर AQI 488 पहुँचा। स्केल 500 पर ख़त्म होता है।",
   "chunks": [
    "दिल्ली के एक स्टेशन पर|AQI *488* पहुँचा।",
    "स्केल *500* पर|ख़त्म होता है।"
   ]
  },
  {
   "o": 0,
   "text": "तो यहीं क्यों? Space से देखिए, पंजाब से बंगाल तक धुंध की एक धूसर नदी।",
   "chunks": [
    "तो *यहीं* क्यों?",
    "*Space* से देखिए,|पंजाब से बंगाल तक",
    "धुंध की एक|*धूसर नदी।*"
   ]
  },
  {
   "o": 0,
   "text": "हर 10 में से 4 भारतीय इसके नीचे रहते हैं।",
   "chunks": [
    "हर *10 में से 4* भारतीय|इसके नीचे रहते हैं।"
   ]
  },
  {
   "o": 0,
   "text": "क्योंकि उत्तर भारत एक बड़ा कटोरा है।",
   "chunks": [
    "क्योंकि उत्तर भारत|एक *बड़ा कटोरा* है।"
   ]
  },
  {
   "o": 0,
   "text": "उत्तर में, धरती की सबसे ऊँची दीवार।",
   "chunks": [
    "उत्तर में, धरती की|*सबसे ऊँची दीवार।*"
   ]
  },
  {
   "o": 0,
   "text": "मेरे आगे कुछ नहीं जाता। धुआँ भी नहीं।",
   "chunks": [
    "मेरे आगे कुछ|*नहीं जाता।*",
    "*धुआँ* भी नहीं।"
   ],
   "speaker": "him"
  },
  {
   "o": 0,
   "text": "दक्षिण में, अरावली और विंध्य की पहाड़ियाँ।",
   "chunks": [
    "दक्षिण में, *अरावली*|और *विंध्य* की पहाड़ियाँ।"
   ]
  },
  {
   "o": 0,
   "text": "पर ये कटोरा तो लाखों साल पुराना है। तो सिर्फ़ सर्दियों में ही क्यों?",
   "chunks": [
    "पर ये कटोरा तो|*लाखों साल* पुराना है।",
    "तो सिर्फ़|*सर्दियों* में ही क्यों?"
   ]
  },
  {
   "o": 0,
   "text": "गर्मियों में गर्म हवा करीब 1 किलोमीटर ऊपर उठती है और धुआँ ले जाती है।",
   "chunks": [
    "*गर्मियों* में|गर्म हवा",
    "करीब *1 किलोमीटर*|ऊपर उठती है",
    "और धुआँ|*ले जाती है।*"
   ]
  },
  {
   "o": 0,
   "text": "नवंबर में तिब्बत के पठार से ठंडी हवा नीचे आती है, और गर्म हवा ऊपर बैठ जाती है।",
   "chunks": [
    "*नवंबर* में|तिब्बत के पठार से",
    "*ठंडी हवा*|नीचे आती है,",
    "और गर्म हवा|*ऊपर बैठ* जाती है।"
   ]
  },
  {
   "o": 0,
   "text": "जैसे पतीले पर ढक्कन।",
   "chunks": [
    "जैसे पतीले पर|*ढक्कन।*"
   ]
  },
  {
   "o": 0,
   "text": "छत गिरकर कुछ सौ मीटर रह जाती है, और हवा थम जाती है।",
   "chunks": [
    "छत गिरकर",
    "*कुछ सौ मीटर*|रह जाती है,",
    "और हवा|*थम जाती है।*"
   ]
  },
  {
   "o": 0,
   "text": "और ये अभी सबसे अजीब बात नहीं है।",
   "chunks": [
    "और ये अभी|*सबसे अजीब बात* नहीं है।"
   ]
  },
  {
   "o": 0,
   "text": "रिसर्चर्स कहते हैं, अगर दिल्ली ख़ुद ज़ीरो प्रदूषण करे,",
   "chunks": [
    "रिसर्चर्स कहते हैं,|अगर दिल्ली",
    "ख़ुद *ज़ीरो*|प्रदूषण करे,"
   ]
  },
  {
   "o": 0,
   "text": "तब भी उसकी सर्दियों की हवा शायद ख़राब ही होगी।",
   "chunks": [
    "तब भी उसकी|सर्दियों की हवा",
    "शायद *ख़राब ही होगी।*"
   ]
  },
  {
   "o": 0,
   "text": "क्योंकि पूरे मैदान के खेतों, सड़कों और फ़ैक्ट्रियों का धुआँ एक ही आसमान में है।",
   "chunks": [
    "क्योंकि पूरे मैदान के|*खेतों, सड़कों*",
    "और *फ़ैक्ट्रियों* का|धुआँ",
    "*एक ही आसमान* में है।"
   ]
  },
  {
   "o": 0,
   "text": "हवा शहर की सीमाएँ नहीं मानती।",
   "chunks": [
    "हवा शहर की|*सीमाएँ* नहीं मानती।"
   ]
  },
  {
   "o": 0,
   "text": "मुझे मत देखो। मैं तो बस लंबा हूँ।",
   "chunks": [
    "मुझे मत|देखो।",
    "मैं तो बस|*लंबा* हूँ।"
   ],
   "speaker": "him"
  },
  {
   "o": 0,
   "text": "कमेंट में बताइए, अभी आपके शहर का AQI कितना है?",
   "chunks": [
    "कमेंट में बताइए, अभी|आपके शहर का *AQI* कितना है?"
   ]
  },
  {
   "o": 0,
   "text": "ये है भूगोल। ऐसे ही मज़ेदार जियोग्राफी फैक्ट्स के लिए फॉलो करें।",
   "chunks": [
    "ये है *भूगोल।*",
    "ऐसे ही मज़ेदार जियोग्राफी|फैक्ट्स के लिए फॉलो करें।"
   ]
  }
 ],
