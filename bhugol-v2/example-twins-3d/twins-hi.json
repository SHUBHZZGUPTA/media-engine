 "lines": [
  {
   "o": 0,
   "text": "मैं $100 की शर्त लगाता हूँ, आपको नहीं पता था कि कुछ कंट्रीज़ दिखने में बिल्कुल अलग हैं, पर साइज़ में लगभग एक जैसी हैं!",
   "chunks": [
    "मैं *$100* की|शर्त लगाता हूँ,",
    "आपको नहीं पता था कि|कुछ कंट्रीज़",
    "दिखने में *बिल्कुल अलग* हैं,",
    "पर साइज़ में|लगभग *एक जैसी* हैं!"
   ]
  },
  {
   "o": 0,
   "text": "शुरू करते हैं नंबर फाइव से: नेपाल और बांग्लादेश।",
   "chunks": [
    "शुरू करते हैं|*नंबर फाइव* से:",
    "*नेपाल* और *बांग्लादेश।*"
   ]
  },
  {
   "o": 0,
   "text": "दोनों बस 22 km दूर हैं, पर एक माउंट एवरेस्ट से आसमान छूता है, और दूसरा अपनी नदियों से समंदर!",
   "chunks": [
    "दोनों बस *22 km*|दूर हैं,",
    "पर एक *माउंट एवरेस्ट* से",
    "*आसमान* छूता है,",
    "और दूसरा अपनी|*नदियों* से",
    "*समंदर!*"
   ]
  },
  {
   "o": 0,
   "text": "नंबर फोर: गिनी और यूनाइटेड किंगडम।",
   "chunks": [
    "*नंबर फोर:*",
    "*गिनी* और|*यूनाइटेड किंगडम।*"
   ]
  },
  {
   "o": 0,
   "text": "यकीन नहीं होगा। कभी दुनिया का सबसे बड़ा एम्पायर, आज उसका एरिया बस गिनी जितना है।",
   "chunks": [
    "*यकीन नहीं होगा।*",
    "कभी दुनिया का|*सबसे बड़ा* एम्पायर,",
    "आज उसका एरिया",
    "बस *गिनी* जितना है।"
   ]
  },
  {
   "o": 0,
   "text": "कितना दुखद।",
   "chunks": [
    "*कितना दुखद।*"
   ],
   "speaker": "uk"
  },
  {
   "o": 0,
   "text": "नंबर थ्री: चिली और ज़ाम्बिया।",
   "chunks": [
    "*नंबर थ्री:*",
    "*चिली* और *ज़ाम्बिया।*"
   ]
  },
  {
   "o": 0,
   "text": "ज़ाम्बिया को च्युइंग गम की तरह खींचो, तो उतनी ही बड़ी एक और चिली बन जाएगी।",
   "chunks": [
    "*ज़ाम्बिया* को",
    "*च्युइंग गम* की तरह|खींचो,",
    "तो उतनी ही बड़ी|एक और *चिली*",
    "*बन जाएगी।*"
   ]
  },
  {
   "o": 0,
   "text": "नंबर टू: इटली और फिलीपींस।",
   "chunks": [
    "*नंबर टू:*",
    "*इटली* और|*फिलीपींस।*"
   ]
  },
  {
   "o": 0,
   "text": "एक जूते जैसा दिखता है, और दूसरा बैठे हुए आदमी जैसा।",
   "chunks": [
    "एक *जूते* जैसा|दिखता है,",
    "और दूसरा|*बैठे हुए आदमी* जैसा।"
   ]
  },
  {
   "o": 0,
   "text": "पर दोनों को जोड़ दो, तो पूरा इंसान बन जाता है।",
   "chunks": [
    "पर दोनों को|*जोड़ दो,*",
    "तो *पूरा इंसान*|बन जाता है।"
   ]
  },
  {
   "o": 0,
   "text": "और नंबर वन है... मलेशिया और वियतनाम!",
   "chunks": [
    "और *नंबर वन* है...",
    "*मलेशिया* और|*वियतनाम!*"
   ]
  },
  {
   "o": 0,
   "text": "दोनों साउथईस्ट एशिया में हैं, दोनों के लंबे कोस्टलाइन्स हैं, और साइज़ लगभग बराबर।",
   "chunks": [
    "दोनों *साउथईस्ट एशिया*|में हैं,",
    "दोनों के लंबे|*कोस्टलाइन्स* हैं,",
    "और साइज़|*लगभग बराबर।*"
   ]
  },
  {
   "o": 0,
   "text": "लगता है, ये एक-दूसरे के लिए ही बने हैं।",
   "chunks": [
    "लगता है, ये *एक-दूसरे*|*के लिए ही बने* हैं।"
   ]
  },
  {
   "o": 0,
