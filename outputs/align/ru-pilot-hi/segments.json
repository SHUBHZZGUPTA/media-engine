  "text": " \u0915\u0940\u0935\u0928 \u0930\u0941\u0938\u092c \u0906\u092e\u0940\u0930 \u0925\u093e \u0907\u0938\u093e\u0908 \u0925\u093e \u0914\u0930 \u0926\u0942\u0928\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0936\u0939\u0930 \u0938\u0940 \u091c\u094b\u0917\u093e \u0925\u093e"
 },
 {
  "start": 283.36,
  "end": 288.0,
  "text": " \u0909\u0928\u0915\u0940 \u0935\u0940\u091f\u0940 \u092f\u093e\u0930\u094b\u0938 \u0932\u093e\u0935\u094d\u0926 \u0935\u093e\u0908\u0938 \u0915\u0940 \u0938\u092e\u0947\u0902 \u092f\u0947 \u092f\u094b\u0930\u094b\u092a \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0930\u093e\u0926\u094d\u092f\u094b\u0902\u0917\u0947 \u0925\u093e"
 },
 {
  "start": 288.0,
  "end": 292.28,
  "text": " \u0914\u0930 \u092b\u093f\u0930, \u0939\u093e\u0902\u0926\u093e\u0928 \u0928\u0947 \u0935\u0917\u0940 \u092f\u093e, \u092f\u094b \u0939\u092e \u0928\u093f\u0936\u093e \u0915\u0930\u0924\u093e \u0925\u093e"
 },
 {
  "start": 292.28,
  "end": 309.34,
  "text": " \u0906\u092a\u0938 \u092e\u0947\u0902 \u0932\u0921\u0928\u0940 \u0932\u0917\u0940, \u092c\u093e\u0908-\u092c\u093e\u0908 \u0938\u093f\u0932\u093e, \u091a\u091a\u0940\u0930\u093e \u092c\u093e\u0908-\u091a\u091a\u0940\u0930\u0940 \u0938\u093f\u0932, \u0930\u093e\u091c\u094d\u091c \u0926\u0930\u091c\u0928 \u092c\u0930 \u091c\u0917\u0930\u0924\u0940 \u0930\u091c\u094d\u0935\u093e\u0930\u0942 \u092e\u0947\u0902 \u092c\u0926 \u0917\u092f\u093e, \u092b\u093f\u0930\u0938\u0940 \u0905\u092a\u094d\u0930\u093e\u0924\u093e\u0926\u094d\u0930\u0940, \u0914\u0930 \u091c\u092c \u092a\u094d\u0930\u093f\u0902\u0938 \u0906\u092a\u0938 \u092e\u0947\u0902 \u0932\u0921\u0928\u0940 \u0932\u0921\u0928\u0940 \u0926\u0942\u0930 \u092a\u0942\u0930\u094d\u091c \u092e\u0947\u0902, \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0940 \u0938\u092c\u0938\u0940 \u0939\u094b\u092a\u0928\u093e\u0915 \u0938\u093f\u0932\u093e\u0928\u0940 \u092a\u093e\u0937\u094d\u091a\u093f\u0928 \u0915\u0940 \u0935\u094b\u0930 \ufffd"
 },
 {
