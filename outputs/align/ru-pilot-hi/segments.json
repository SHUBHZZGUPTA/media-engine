  "end": 275.46,
  "text": " \u0932\u0902\u092c \u092d\u0917 \u0928\u093e\u0908\u0908\u0908\u0917 \u092f\u0947\u092b \u092e\u0947\u0917, \u092d\u094d\u0930\u094d\u092d\u0940 \u092e\u093f\u0930\u0928\u0940 \u0905\u0930\u094d\u0925\u094b\u0921\u093c\u0916\u094d\u0938 \u0915\u094d\u0937\u094d\u091a\u094d\u091a\u094d\u091a\u094d\u091a\u094d\u091b\u094d\u091a\u094d\u091a\u094d\u091a\u094d\u091a\u094d\u091a\u094d\u091a\u094d\u091a\u0943\u0964"
 },
 {
  "start": 275.46,
  "end": 278.16,
  "text": " \u0914\u0930 \u0935\u0917 \u0924\u0940 \u0932\u094b\u0917\u094b \u0915\u093e \u0928\u0939\u0940\u0902 \u092e\u0947\u0902 \u092d\u0916\u094d\u091f\u093f\u0938\u094d\u092e\u093e \u0915\u0930\u0935\u093e\u092f\u093e."
