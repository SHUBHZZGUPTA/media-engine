  "text": " \u091c\u093e\u0915\u0938\u094d\u0924\u0940 \u0925\u0940 \u0924\u0940 \u0930\u0917 \u0915\u0940 \u092c\u0940 \u0925\u093e\u0915\u094d\u091a\u0921\u0940\u0917 \u0939\u0940 \u0916\u092c \u092c\u093e\u0917\u093e \u092a\u0939\u0924\u093f\u0917\u0924\u094b\u0917\u0947 \u0925\u0940."
 }
