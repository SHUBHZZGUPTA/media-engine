[
 {
  "start": 0.0,
  "end": 3.74,
  "text": " \u0905\u092a \u0926\u0947\u0916 \u0930\u0939\u0947 \u0939\u0948\u0902 \u090f\u0915 \u091c\u0902\u0917 \u091c\u094b \u0915\u092d\u0940 \u0916\u0924\u094d\u092e \u0928\u0939\u0940\u0902 \u0939\u094b\u0908"
 },
 {
  "start": 3.74,
  "end": 8.86,
  "text": " \u0928\u094b\u0930\u094d\u0920 \u0914\u0930 \u0938\u093e\u0909\u091f \u0915\u094b\u0930\u093f\u092f\u093e \u0928\u093e\u0928\u0947\u0902\u091f\u0940 \u092a\u093e\u0909\u0938 \u092a\u0930 \u0915\u093f\u0938\u0940\u0928\u0947 \u0938\u094d\u0925\u094b\u092c \u0915\u094d\u092f\u094b \u0928\u0940 \u0926\u092c\u093e\u092f\u093e"
 },
 {
  "start": 8.86,
  "end": 13.32,
  "text": " \u0936\u0930\u094d\u0935\u093e\u0926 \u0939\u0941\u0908 \u090f\u0915 \u092c\u094b\u093c\u0930 \u0938\u0947 \u091c\u094b \u090f\u0915 \u0930\u093e\u0926 \u092e\u0947\u0902 \u092e\u0948\u0916\u091c\u0940\u0928 \u0915\u0947 \u092e\u092a \u092a\u0930 \u0916\u093f\u091a\u093e"
 },
 {
  "start": 13.32,
  "end": 14.8,
  "text": " \u0938\u093e\u0932 \u0928\u093e\u0928\u0947\u0902\u091f\u0940\u0902 \u092b\u094b\u091f\u0940 \u092b\u093e\u0909\u0917"
 },
 {
  "start": 14.8,
  "end": 42.76,
  "text": " \u091c\u092c\u093e\u0928 \u0935\u094b\u0932\u094d\u0935\u093e\u0930\u094d\u091f\u094d\u091f\u0941 \u0939\u093e\u0930 \u091a\u0941\u0915\u093e \u0939\u0948, \u0914\u0930 \u0938\u093e\u0925 \u092e\u0947\u0902 \u0915\u094b\u0930\u094d\u092f\u093e \u092d\u0940, \u0928\u094b\u0930\u094d\u0925 \u0938\u0947 \u0938\u094b\u0935\u093f\u092f\u0924 \u092b\u094b\u091c\u0947\u0902 \u0916\u0942\u0938\u093e\u0924\u0940 \u0939\u0948\u0902, \u0914\u0930 \u0928\u092e\u0930\u0947\u0915\u0940 \u0915\u0930\u0940\u092a 6-100 \u092e\u0940\u0932 \u0926\u0942\u0930, \u0926\u0947\u0930 \u0930\u093e\u0924 \u0926\u094b \u0928\u092e\u0930\u0947\u0915\u0940 \u0905\u092b\u093f\u0938\u0930 \u090f\u0915 \u0932\u093e\u0908\u0902 \u0926\u0942\u0928\u0924\u0947 \u0939\u0948\u0902, \u0938\u094b\u0932 \u0915\u0947 \u0924\u0940\u0916 \u0909\u092a\u0930, \u0928\u093e \u0928\u0926\u0940 \u0928\u093e \u092a\u0939\u093e\u0921, \u092c\u0938 \u090f\u0915 \u0928\u092e\u092c\u0930, 30-8 \u092a\u0930\u0932\u0947\u0932, \u092e\u0948\u0902?"
 },
 {
  "start": 42.76,
  "end": 44.32,
  "text": " \u0924\u094b\u0928\u094b \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u0915\u0940 \u0905\u092a\u0928\u0940 \u0938\u0930\u094d\u0915\u093e\u0930 \u0925\u0940"
 },
 {
  "start": 44.32,
  "end": 46.38,
  "text": " \u0914\u0930 \u0926\u094b\u0928\u094b \u0915\u0926\u093e\u0935\u093e \u092a\u0941\u0930\u0947 \u0915\u094b\u0930\u093f\u092f\u093e \u092a\u0930"
 },
 {
  "start": 46.38,
  "end": 48.32,
  "text": " 1950 \u092e\u0947\u0902 \u0928\u094b\u0930\u094d\u0925 \u0928\u0947 \u0939\u092e\u094d\u0932\u093e \u0915\u093f\u092f\u093e"
 },
 {
