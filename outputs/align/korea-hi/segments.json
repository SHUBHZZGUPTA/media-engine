  "end": 51.78,
  "text": " \u0936\u093e\u0928\u0924\u0940 \u0915\u0940 \u092c\u093e\u091a\u094d\u091a\u0940 \u0924\u094b \u0938\u093e\u0932 \u0915\u093f\u091a\u0940"
 },
 {
  "start": 51.78,
  "end": 53.6,
  "text": " \u0914\u0930 158 \u092e\u0940\u091f\u0947\u0902\u0917s"
 },
 {
  "start": 53.6,
  "end": 56.32,
  "text": " \u0914\u0930 \u0906\u092a\u0915\u094b \u0932\u0915\u0924\u093e \u0924\u093e \u0905\u092a\u0915\u0940 \u0905\u092b\u093f\u0938 \u092e\u0940\u091f\u0947\u0902\u0917s \u0932\u0902\u092d\u0940 \u0939\u0948"
 },
 {
  "start": 56.32,
  "end": 60.08,
  "text": " \u091c\u0941\u0932\u093e\u0908 1953 \u092e\u0947\u0902 \u0906\u0916\u093f\u0930\u0915\u093e\u0930 \u0938\u093e\u0907\u0928 \u0939\u0942\u0901\u0901\u0908 \u090f\u0915 \u0906\u0930\u092e\u093f\u0938\u094d\u091f\u093f\u0938"
 },
 {
  "start": 60.08,
  "end": 62.56,
  "text": " \u092f\u093e\u0928\u0940\u090a \u0938\u0940\u0938\u094d\u091b\u094d\u092b\u093e\u092f\u0930, \u090f\u0915 \u092a\u094b\u0938 \u092c\u0924\u0928"
 },
 {
  "start": 62.56,
  "end": 66.38,
  "text": " \u092a\u0940\u0938 \u0924\u094d\u0930\u0940\u091f\u0940 \u0928\u0939\u0940\u0902, \u0914\u0930 \u0938\u093e\u0909\u0924 \u0916\u094b\u0930\u094d\u092f\u093e \u0909\u0938\u0928\u0947 \u0924\u0941 \u0936\u093e\u0907\u0928 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e"
 },
 {
  "start": 66.38,
  "end": 68.74,
  "text": " \u0930\u0901\u0926\u092c \u0915\u0940 \u092c\u0940\u0928\u093e \u0938\u0947 \u0924\u0940 \u0935\u0940\u0926\u093f\u090f \u092a\u0939\u0940\u091c\u0947\u0924\u093e\u0906 \u0916\u0941\u0917\u093e\u0964"
 },
 {
  "start": 68.74,
  "end": 69.4,
  "text": " \u0915\u0930\u0940\u092c \u0916\u093e\u0926\u0947\u0902\u0917\u0917\u0947 \u092c\u0940\u0917\u093e\u091f\u094d\u0935\u093e\u091c\u094d\u0935\u093e\u091c \u0915\u0940 \u0916\u093e\u092c\u0942\u0936\u0947 \u0916\u0947\u0932\u0964"
