[
 {
  "start": 1.3999999999999995,
  "end": 16.78,
  "text": " \u0905\u092a \u0926\u094b \u092a\u0921\u094b\u0938\u0940 \u092c\u0942\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0928\u094d\u092e\u0947 \u0938\u0947 \u090f\u0915 \u0924\u094b \u0905\u092a\u094d\u0930\u0940\u0915\u093e \u092e\u0947\u0902 \u0939\u0948, \u0924\u0940\u0928 \u0938\u092c \u0915\u094b \u092a\u0924\u093e \u0939\u0948, \u092a\u0941\u0930\u094d\u0924\u0941\u0917\u093e\u0932, \u092b\u094d\u0930\u093e\u0928\u094d\u0938 \u0914\u0930 \u091a\u094b\u0924\u093e \u0938\u093e \u0905\u0902\u0921\u094b\u0930\u093e, \u091a\u094b\u0924\u093e \u0939\u0948 \u092c\u094d\u0930\u093f\u0924\u093f\u0937, \u091c\u093f\u092c\u094d\u0930\u093e\u0932\u094d\u091f\u0930, \u091c\u093f\u0938\u0915\u0940 \u0932\u093e\u0928\u094d\u092c\u094b\u0921\u0930 \u0938\u0930\u094d\u092b \u0935\u0928 \u092a\u0941\u0902\u091f\u094d\u091f\u094b \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0939\u0948, \u092a\u093e\u091a\u094d\u0935\u093e \u092e\u0941\u0930\u0915\u094d\u0915\u094b. \u0905\u092a\u094d\u0930\u0940\u0915\u093e \u0915\u0947"
 },
 {
  "start": 16.78,
  "end": 22.12,
  "text": " \u0924\u092c \u0926\u094b \u0938\u094d\u092a\u093e\u0928\u093f\u0936 \u0936\u0939\u0930 \u0939\u0948, \u0938\u0947 \u0909\u091f\u093e \u0914\u0930 \u092e\u0947\u0932\u093f\u092f\u093e, \u092f\u093e\u0928\u0940 \u0938\u094d\u092a\u0947\u0928 \u0905\u092a\u094d\u0930\u0940\u0915\u093e \u0915\u094b \u0924\u092c 3 \u091c\u0917\u0947 \u091a\u0942\u091f\u093e \u0939\u0948."
 },
 {
  "start": 22.3,
  "end": 27.18,
  "text": " \u0924\u0940\u0938\u0930\u0940 \u0939\u0948 \u090f\u0915 \u091a\u091f\u094d\u091f\u093e\u0928, \u091c\u093f\u0938\u0947 1934 \u092e\u0947\u0902 \u090f\u0915 \u0924\u0942\u092b\u093e\u0928 \u0928\u0947 \u0905\u092a\u094d\u0930\u0940\u0915\u093e \u0938\u0947 \u091a\u093f\u092c\u0915\u093e \u0926\u093f\u092f\u093e."
 },
 {
  "start": 27.42,
  "end": 30.8,
  "text": " \u0935\u094b \u092c\u094b\u093c\u0930, \u0938\u0930\u094d\u0935 85 \u092e\u0940\u091f\u0930, \u092b\u0941\u091f\u092c\u093e\u0932 \u092b\u0940\u0932 \u0938\u0947 \u092d\u0940 \u091a\u0935\u091f\u093e."
 },
 {
  "start": 30.8,
  "end": 35.92,
  "text": " \u0924\u094b \u0905\u0917\u0930 \u0938\u094d\u092a\u0947\u0928 \u0905\u092a\u094d\u0930\u0940\u0915\u093e \u0924\u0915 \u092a\u0939\u0932\u093e \u0939\u0948, \u0924\u094b \u090f\u0915 \u0938\u094d\u092a\u093e\u0928\u093f\u0937 \u091f\u093e\u0901\u0928 \u092b\u094d\u0930\u093e\u0928\u094d\u0938 \u0915\u0947 \u0906\u0902\u0926\u0930 \u0915\u0948\u0938\u0947 \u092a\u094d\u0939\u0938\u0915\u092f\u093e?"
 },
 {
  "start": 36.14,
  "end": 40.6,
  "text": " \u091a\u0932\u093f\u092f\u0947 1659 \u092e\u0947\u0902, \u0938\u094d\u092a\u0947\u0928 \u092b\u094d\u0930\u093e\u0928\u094d\u0938 \u0915\u094b \u0909\u0924\u094d\u0930\u0940 \u0938\u0930\u094d\u0926\u093e\u0928\u094d\u092f\u093e \u0915\u0947 \u0917\u093e\u0909 \u0926\u0947 \u0926\u0947\u0924\u093e \u0939\u0948."
 },
 {
