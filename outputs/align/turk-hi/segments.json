[
 {
  "start": 0.0,
  "end": 3.64,
  "text": " \u0939\u06cc\u06a9 \u092d\u0930\u094d\u0926 \u091c\u093f\u0938\u0915\u093e \u0928\u093e\u092e \u090f\u0915 \u0926\u0947\u0937\u094d\u092a\u0930 \u0939\u0948, \u091c\u093e\u0917\u093e \u0915\u0935\u094b \u0939\u0948 \u0907\u0928\u0940!"
 },
 {
  "start": 4.18,
  "end": 8.74,
  "text": " \u0906\u0938\u0932 \u092e\u0947\u0902 \u092f\u0947 \u092e\u0947\u0916\u0938\u0947\u0915\u094b \u0915\u093e \u0939\u0948, \u0905\u0938\u094d\u091f\u0947\u0915\u0938\u0947 \u0938\u0947 \u092a\u093e\u0932\u0924\u0947 \u0925\u0947 \u0924\u094b \u092b\u093e\u0901\u0938\u093e\u0930 \u0938\u093e\u0932 \u0938\u0947 \u092d\u0940 \u092a\u0939\u0932\u0947."
 },
 {
  "start": 9.26,
  "end": 12.32,
  "text": " \u092b\u094d\u0930\u093f\u0937\u094d\u0924\u0940\u0928 \u0939\u0941\u0921\u093c\u094d\u0937 \u092e\u0947\u0902 \u0935\u093e\u0936\u0928\u0947 \u0932\u0947\u0917\u093e \u092f\u093e\u0930\u091f\u094d\u092c."
 },
 {
  "start": 12.7,
  "end": 14.5,
  "text": " \u0932\u093f\u0915\u093f\u0928 \u092f\u093e\u0930\u091f\u094d\u092c \u0915\u0928\u094d\u092b\u0941\u091c \u0914\u0917\u092f\u093e."
 },
 {
  "start": 14.5,
  "end": 20.02,
  "text": " \u092f\u0947 \u0926\u093f\u0915\u0924\u093e \u0924\u093e \u0917\u093f\u0928\u0940 \u092b\u093e\u090a\u0932 \u091c\u0948\u0938\u093e, \u0907\u0915 \u0906\u092a\u094d\u0930\u093f\u0915\u0928 \u092c\u0930\u0921 \u091c\u094b \u0906\u092f\u093e \u0924\u093e \u0924\u094b\u0917\u0917\u0940 \u0936\u093f\u0932\u093e\u0915\u094b \u0938\u0947 \u0939\u094b\u0915\u0947."
 },
 {
  "start": 20.34,
  "end": 22.5,
  "text": " \u0924\u094b \u0907\u0902\u0917\u0932\u093f\u0937\u094d\u0935\u093e\u0932\u094b \u0928\u0947 \u0928\u093e\u092e \u0930\u0917 \u0926\u093f\u092f\u093e \u0924\u094b\u0917\u0940."
 },
 {
  "start": 22.96,
  "end": 24.56,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u0924\u094b\u0917\u0940 \u092e\u0947\u0902 \u0938\u0947 \u0915\u094d\u092f\u093e \u0915\u094d\u092f\u093e \u0925\u0947\u0902?"
 },
 {
  "start": 24.98,
  "end": 26.94,
  "text": " \u0930\u093f\u0928\u094d\u0926\u0940, \u092e\u0924\u0932\u092c \u0905\u0917\u094d\u091f\u093f\u092f\u093e \u0935\u093e\u0932\u093e."
 },
 {
  "start": 33.28,
  "end": 46.54,
  "text": " \u0928\u093e\u0902\u0917 \u0930\u093e\u0928\u094d\u091f \u0915\u0940 \u0928\u0940\u0941\u092f\u093e \u0915\u0940 \u092e\u0941\u0930\u0950\u093f, \u092a\u0942\u0930 \u0924\u0917\u093e\u0932 \u092a\u0947\u0930\u0942 \u092a\u0947\u0930\u0942 \u0926\u0940\u0936 \u0915\u0947 \u0928\u093e\u092e\u094d\u092a\u0930 \u0905\u0930\u092d\u0940\u0915 \u092e\u0947\u0902 \u092e\u0941\u0930\u0941\u0917\u093e, \u092e\u0932\u0917\u0947\u0936\u092f\u093e \u0908\u0938 \u0921\u0930\u094d\u091a \u092e\u0941\u0930\u0941\u0917\u093f, \u0939\u0930 \u0926\u0947\u0936 \u0928\u0947 \u0907\u0938\u0915\u093e \u0928\u093e\u092e \u0915\u093f\u0938\u0940 \u0905\u0930 \u0926\u0947\u0936 \u092a\u0930 \u0930\u0916\u094d\u0916\u093e,"
 },
 {
  "start": 47.16,
  "end": 52.2,
  "text": " 2022 \u092e\u0948\u0902, \u0924\u0930\u094d\u0915\u0940 \u0928\u0947 \u092f\u0942\u0928 \u0938\u0947 \u0915\u0939\u093e\u092a, \u0924\u0942\u0930\u094d\u0915\u0940 \u092f\u0947 \u092c\u0941\u0932\u094b, \u0924\u094b\u0921\u093e \u0907\u0938 \u092c\u0930\u094d\u091f \u0938\u0947 \u092a\u0940\u091a\u093e \u091a\u094b\u0921\u093e\u0928\u0947 \u0915\u094b."
 },
 {
  "start": 52.68,
  "end": 57.74,
  "text": " \u0914\u0930 \u092e\u0947\u0915\u094d\u0938\u093f\u0915\u094b. \u092c\u0939\u093e\u0908, \u092f\u0947 \u092e\u0947\u0930\u093e \u0939\u0948, \u0939\u092e\u0947\u0938\u0947 \u0917\u0935\u093e\u091a\u094b\u0932\u094b\u0924\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902."
 },
 {
  "start": 57.94,
  "end": 60.22,
  "text": " \u0924\u094b \u0907\u0938 \u0920\u0941\u0938\u094d\u0921\u093c\u0947 \u0906\u092a \u0916\u093e\u0930\u0947 \u0939\u094b\u0902\u0917\u0947 \u0924\u0942\u0915\u0940."
 }
]