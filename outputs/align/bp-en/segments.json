[
 {
  "start": 0.0,
  "end": 2.6,
  "text": " What if Brazil and Portugal became one country?"
 },
 {
  "start": 3.72,
  "end": 5.78,
  "text": " Brazil is 92 times bigger."
 },
 {
  "start": 6.28,
  "end": 8.32,
  "text": " Portugal would be the tiny corner."
 },
 {
  "start": 9.28,
  "end": 12.76,
  "text": " 225 million people, all speaking Portuguese."
 },
 {
  "start": 13.54,
  "end": 16.02,
  "text": " So who would rule this giant country?"
 },
 {
  "start": 16.56,
  "end": 18.68,
  "text": " Here's the twist, it already happened."
 },
 {
  "start": 19.28,
  "end": 22.26,
  "text": " In 1807, Napoleon invaded Portugal."
 },
 {
  "start": 22.62,
  "end": 25.68,
  "text": " So the whole royal family sailed to Brazil."
 },
 {
  "start": 25.68,
  "end": 34.12,
  "text": " Brazil. For 13 years, Portugal was ruled from Rio de Janeiro. By 1815, one kingdom, two"
 },
 {
  "start": 34.12,
  "end": 39.82,
  "text": " continents. But that's not even the weirdest part. The king went home and left his son"
 },
 {
  "start": 39.82,
  "end": 47.64,
  "text": " in charge. And in 1822, his own son declared Brazil independent. Then the king died. And"
 },
 {
  "start": 47.64,
  "end": 50.14,
  "text": " And that son became king of Portugal too."
 },
 {
  "start": 50.96,
  "end": 52.58,
  "text": " For about two months."
 },
 {
  "start": 53.44,
  "end": 54.0,
  "text": " And the capital?"
 },
 {
  "start": 54.66,
  "end": 56.64,
  "text": " Lisbon, Rio, or Brasilia?"
 },
 {
  "start": 57.26,
  "end": 57.58,
  "text": " Brazil?"
 },
 {
  "start": 58.08,
  "end": 59.1,
  "text": " Five World Cups."
 },
 {
  "start": 59.64,
  "end": 59.92,
  "text": " Portugal?"
 },
 {
  "start": 60.48,
  "end": 62.1,
  "text": " Well, we have custard tarts."
 },
 {
  "start": 62.84,
  "end": 64.44,
  "text": " So one country or two?"
 },
 {
  "start": 64.78,
  "end": 65.5,
  "text": " Because honestly?"
 }
]