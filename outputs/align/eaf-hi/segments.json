[
 {
  "start": 0.0,
  "end": 2.1,
  "text": " \u0905\u0917\u0930 \u0907\u0938\u094d\u091f \u0906\u092a\u094d\u0930\u093f\u0915\u093e \u090f\u0915 \u0926\u0947\u0936 \u092c\u0928 \u091c\u093e\u090f?"
 },
 {
  "start": 2.54,
  "end": 5.7,
  "text": " \u0924\u0942\u090f\u0938\u094d\u091f \u092f\u0947 \u0939\u0948, \u0907\u0938\u0915\u093e \u0915\u094b\u0928\u094d\u0938\u094d\u091f\u093f\u091f\u0942\u0936\u0928 \u0905\u092d\u0940 \u0932\u093f\u0916\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948?"
 },
 {
  "start": 6.06,
  "end": 9.0,
  "text": " \u0906\u0930\u094d\u091f \u0926\u0947\u0936 \u0915\u094b\u0902\u0917\u094b \u0938\u0947 \u0938\u0941\u092e\u093e\u0932\u093f\u092f\u093e \u0924\u0915"
 },
 {
  "start": 9.0,
  "end": 12.04,
  "text": " \u090f\u0915 \u0939\u0940 \u0917\u094b\u0932 \u0907\u0938\u094d\u091f \u0906\u092a\u094d\u0930\u093f\u0915\u0928 \u092b\u0947\u091f\u0930\u0947\u0936\u093f\u0928"
 },
 {
  "start": 12.04,
  "end": 14.1,
  "text": " \u0924\u094b \u090f\u0938\u094d\u091f \u0926\u0947\u0936 \u0915\u094b \u0915\u094d\u092f\u093e \u092e\u093f\u0932\u0947\u0917\u093e?"
 },
 {
  "start": 14.84,
  "end": 16.82,
  "text": " 330 \u092e\u093f\u0932\u094d\u092f\u0928 \u0938\u0947 \u091c\u092f\u093e\u0926\u093e \u0932\u094b\u0917"
 },
 {
  "start": 16.82,
  "end": 22.84,
  "text": " \u0932\u0917 \u092d\u0917 \u0909\u0924\u0928\u0947 \u091c\u093f\u0924\u0928\u0947 U.S.A. \u092e\u0947\u0902 \u0926\u0942\u0928\u093f\u092f\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0926\u0947\u0936 \u0907\u0902\u0926\u093f\u092f\u093e \u0938\u0947 \u092d\u0940 \u0935\u0921\u093c\u093e"
 },
 {
  "start": 22.84,
  "end": 28.24,
  "text": " \u0906\u092a\u094d\u0930\u093f\u0915\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u0909\u091a\u093e \u092a\u0939\u093e\u0921 \u0938\u092c\u0938\u0947 \u092c\u0921\u0940 \u0932\u0947\u0917 \u0914\u0930 \u0926\u094b \u0935\u094b\u0936\u0928\u094d\u0938 \u092a\u0930 \u0915\u094b\u0938\u094d\u091f"
 },
 {
  "start": 28.24,
  "end": 29.98,
  "text": " \u0905\u0930 \u092f\u0947 \u092a\u0939\u0932\u0947 \u092d\u0940 \u0924\u094d\u0930\u093e \u0939\u0941\u0901\u0913\u093e."
 },
 {
  "start": 30.38,
  "end": 34.32,
  "text": " 1963 \u092e\u0947\u0902 \u0924\u0940\u0928 \u0932\u0940\u091f\u0930\u0947z \u092e\u0947\u0902 \u0935\u093e\u0926\u093e \u0915\u0940\u0906 \u090f\u0915 \u092b\u0947\u091f\u0930\u0947\u0936\u0928 \u0915\u093e."
 },
 {
  "start": 35.0,
  "end": 38.2,
  "text": " \u0909\u0938\u0940 \u0938\u093e\u0932 \u0915\u0940 \u0905\u0902\u0926\u0930 \u0935\u094b \u0915\u0935\u0939\u0940 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e."
 },
 {
  "start": 38.82,
  "end": 42.32,
  "text": " \u0924\u093f\u0928\u0915\u093e \u092a\u0939\u0932\u093e \u090f\u0941\u0928\u094d\u092f\u0928 \u092b\u0940\u0921\u093c\u093e \u092e\u0947\u0902 \u0924\u0941\u0921 \u0917\u092f\u093e."
 },
 {
  "start": 42.7,
  "end": 46.82,
  "text": " 2000 \u092e\u0947\u0902 \u092f\u0947 \u0935\u093e\u092a\u0938 \u0906\u092f\u093e \u0914\u0930 \u0924\u0940\u0928 \u0926\u0947\u0936\u094b \u0938\u0947 \u092c\u0921\u0916\u0930 \u0906\u093e\u0926 \u0939\u094b \u0917\u092f\u093e."
 },
 {
  "start": 46.82,
  "end": 49.14,
  "text": " \u0932\u093f\u0915\u093f\u0928 \u092f\u0939 \u092d\u0940 \u0938\u092c\u0938\u0947 \u0939\u091c\u0940\u092c \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948"
 },
 {
  "start": 49.14,
  "end": 52.46,
  "text": " \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u0941\u091d\u0941\u0926 \u0939\u0948 \u090f\u0915 \u092f\u0940\u0938\u094d\u091f \u0906\u092a\u094d\u0930\u093f\u0915\u0928 \u092a\u093e\u0938\u094d\u092a\u094b\u091f"
 },
 {
  "start": 52.46,
  "end": 54.82,
  "text": " \u090f\u0915 \u0906\u0928\u094d\u0920\u092e \u0914\u0930 \u090f\u0915 \u092a\u093e\u0930\u0932\u0947\u092e\u093f\u0928\u094d\u091f"
 },
 {
  "start": 54.82,
  "end": 58.1,
  "text": " \u0914\u0930 \u0915\u093e\u092a\u093f\u091f\u0932 \u0936\u093e\u092f\u0926 \u0905\u0930\u0941\u0936\u093e \u0924\u093e\u0928\u094d\u091c\u0928\u093f\u092f\u093e \u092e\u0947\u0902"
 },
 {
  "start": 58.1,
  "end": 59.34,
  "text": " \u0928\u093f\u0930\u094b \u092d\u0940 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 59.34,
  "end": 61.64,
  "text": " \u0915\u093f\u0928 \u0936\u093e\u0938\u093e \u092d\u0940 \u0928\u0939\u0940\u0902 \u091c\u094b \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0936\u0939\u0930 \u0939\u0948"
 },
 {
  "start": 61.64,
  "end": 69.04,
  "text": " \u0914\u0930 \u0906\u0930\u0941\u0936\u093e \u092c\u0938 \u090f\u0915 \u092c\u093e\u0924 \u0915\u0939\u0924\u093e \u0939\u0948, \u0924\u094b \u090f\u0915 \u092f\u0940\u091c \u0924\u093e\u092b\u094d\u0930\u093f\u0915\u093e \u092f\u093e \u0906\u0930\u094d\u091f \u0926\u0947\u0936 \u0915\u094d\u092f\u094b\u0902\u0915\u0940 \u0938\u091a \u092c\u0924\u093e\u0913\u0964"
 }
