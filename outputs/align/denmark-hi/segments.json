  "text": " \u0939\u0930 \u0938\u093e\u0932 \u0905\u0925\u093e\u0930\u093e \u092e\u0940\u091f\u0930 \u0924\u0915 \u0932\u0917\u092d\u0917 \u090f\u0915 \u0915\u094d\u0930\u093f\u0915\u0947\u091f \u092a\u093f\u091c\u093f\u0924\u0928\u093e"
 },
 {
  "start": 11.94,
  "end": 16.12,
  "text": " \u0924\u094b \u090f\u0915 \u0939\u0930\u0947 \u092d\u0930\u0947 \u092c\u093e\u0930\u093f\u0937\u094d\u0935\u093e\u0932\u0947 \u0926\u0947\u0936 \u092e\u0947\u0902 \u0930\u0947\u0917\u093f\u0938\u094d\u0924\u093e\u0928 \u0906\u092f\u093e \u0915\u0948\u0938\u0947?"
 },
 {
  "start": 16.12,
  "end": 18.68,
  "text": " \u092c\u093f\u091a\u0947 \u091a\u0932\u0924\u0947 \u0939\u0948, \u092b\u0942\u092a\u094d\u091f\u093f\u0928 \u0939\u0941\u091f\u093c\u0930\u0926\u094d\u0938 \u092e\u0947\u0902."
 },
 {
  "start": 18.78,
  "end": 21.96,
  "text": " \u0926\u0947\u0928\u094d\u091c\u0928\u0947 \u0905\u092a\u0928\u0947 \u091c\u0902\u0917\u0932 \u0916\u093e\u0921 \u0921\u093e\u0932\u0947 \u0932\u0915\u094d\u0921\u0940 \u0914\u0930 \u0916\u0947\u0924\u094b\u0902 \u0915\u093f\u0932\u093f\u090f,"
