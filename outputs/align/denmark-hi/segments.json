 {
  "start": 22.24,
  "end": 26.04,
  "text": " \u092f\u0947\u091f\u0940\u0928 \u0939\u0941\u091f\u093c\u0930\u091f \u0924\u0915 \u0926\u0947\u0928\u094d\u092e\u093e\u0915 \u092e\u0947\u0902 \u0938\u0930\u093f\u092b \u0924\u0942\u090f \u092b\u094b\u0930\u092a\u0930\u0936\u0947\u0902 \u091c\u0902\u0917\u0932 \u092c\u091a\u093e."
 },
 {
  "start": 26.52,
  "end": 28.44,
  "text": " \u0924\u0942 \u0935\u094b \u092a\u0947\u0921 \u0915\u0930 \u0915\u094d\u092f\u093e \u0930\u0939\u0947 \u0925\u0947\u0964"
