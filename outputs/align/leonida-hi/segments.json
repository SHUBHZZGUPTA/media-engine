[
 {
  "start": 0.0,
  "end": 3.6,
  "text": " \u0905\u0917\u0930 GTA6 \u0915\u093e \u0932\u093f\u092f\u094b\u0928\u0940\u0921\u093e \u090f\u0915 \u0905\u0938\u0932\u0940 \u0938\u094d\u091f\u0947\u091f \u0939\u094b\u0924\u093e"
