 {
  "start": 13.24,
  "end": 17.66,
  "text": " \u0917\u094d\u0930\u093e\u0938 \u0930\u093f\u0935\u0930\u094d\u0938, \u090f\u0935\u0917\u0932\u0947\u091f\u094d\u0938, \u091c\u093f\u0938\u0947 \u0930\u093f\u0935\u0930 \u0905\u092a \u0917\u094d\u0930\u093e\u0938 \u0915\u0948\u0924\u0947\u0902"
 },
 {
  "start": 17.66,
  "end": 20.92,
