 {
  "start": 3.6,
  "end": 7.62,
  "text": " \u0924\u0942\u0938\u094d\u091f\u093f\u092f\u093e \u0939\u0948, \u0935\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0948, \u0928\u093e\u092e \u0939\u0948, \u092b\u0932\u094b\u0930\u093f\u0921\u093e"
 },
 {
  "start": 7.62,
  "end": 10.18,
  "text": " \u0935\u093e\u0908 \u0938\u093f\u091f\u0940, \u0935\u094b \u092e\u092f\u093e\u092e\u0940 \u0939\u0948"
 },
 {
