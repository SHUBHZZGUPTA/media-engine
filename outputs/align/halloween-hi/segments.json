[
 {
  "start": 0.0,
  "end": 2.68,
  "text": " \u0906\u091c \u0930\u093e\u0924 \u0906\u092a \u0939\u091c\u093c\u093e\u0930\u094b \u092a\u092e\u0915\u093f\u0928\u094d\u0938 \u0926\u0947\u0916\u0947\u0902\u0917\u0947"
 },
 {
  "start": 2.68,
  "end": 6.58,
  "text": " \u092a\u0930 \u092a\u0939\u0932\u0947 \u091c\u093e\u0915\u094b \u0932\u0928\u094d\u091f\u0928\u094d\u0938 \u0915\u092d\u0940 \u092a\u092e\u0915\u093f\u0928\u094d\u0938 \u0925\u0947 \u0939\u0940 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 6.58,
  "end": 7.4,
  "text": " \u0924\u094b \u092b\u093f\u0930 \u0915\u094d\u092f\u093e \u0925\u0947?"
 },
 {
  "start": 7.92,
  "end": 8.3,
  "text": " \u0936\u0932\u091c\u092e"
 },
 {
  "start": 8.3,
  "end": 11.66,
  "text": " \u0914\u0930 \u092f\u0947 \u0938\u092c \u0906\u090f\u0932\u0947\u0902\u0926 \u0915\u0940 \u090f\u0915 \u091a\u094b\u091f\u0940 \u0938\u0940 \u092a\u0939\u093e\u0921\u0940 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u0941\u090f"
 },
 {
  "start": 11.66,
  "end": 15.34,
  "text": " \u0924\u094b \u0906\u0908\u0932\u0947\u0902\u0917 \u0915\u093e \u0936\u0932\u091c\u092e \u0906\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0947 \u0939\u0930 \u0926\u0930\u094d\u0935\u093e\u091c\u0947 \u0924\u0915 \u0915\u0948\u0938\u0947 \u092a\u0941\u091a\u093e?"
 },
 {
  "start": 15.58,
  "end": 20.76,
  "text": " \u091a\u0932\u093f\u092f\u0947 \u092a\u0940\u091a\u0947 \u0915\u093e\u0942\u0928\u094d\u0924\u0940 \u092e\u0940\u0924 \u0906\u0908\u0932\u0947\u0902\u0926, \u0939\u093f\u0932 \u0905\u092a \u0935\u093e\u0921, \u091c\u093f\u0938\u0947 \u0915\u092d\u0940 \u0924\u0932\u093e\u0915\u094d\u0924\u093e \u0915\u0948\u0924\u0947 \u0925\u0947"
 },
 {
  "start": 20.76,
  "end": 24.34,
  "text": " \u092f\u0939\u093e \u0932\u094b\u0917 \u0936\u093e\u092f\u0926 \u0935\u0928 \u092b\u093e\u0901\u0938\u0928 \u092d\u0940\u0938\u0940 \u0938\u0947 \u090f\u0915\u0920\u093e \u0939\u094b\u0924\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 24.34,
  "end": 27.24,
  "text": " \u092a\u0942\u0930\u093e\u0928\u0947 \u0906\u0908\u0930\u093f\u0937\u094d\u0915\u094d\u0930\u0928\u094d\u0924 \u0907\u0938\u0947 \u0938\u093e\u0935\u0947\u0928 \u0938\u0947 \u091c\u094b\u0921\u0924\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 27.24,
  "end": 29.3,
  "text": " \u092b\u0938\u0932 \u0915\u093e \u0905\u0928\u094d\u0924, \u0938\u0930\u094d\u0926\u0940 \u0915\u0940 \u0936\u0941\u0930\u094d\u0935\u093e\u0924"
 },
 {
  "start": 29.3,
  "end": 30.98,
  "text": " \u0924\u0930\u094d\u091f\u0940 \u092b\u093c\u0938\u094d\u091f \u0905\u0915\u094d\u091f\u094b\u092c\u0930 \u0915\u0940 \u0930\u093e\u0924"
 },
 {
  "start": 30.98,
  "end": 33.66,
  "text": " \u0915\u0939\u093e\u0928\u0940 \u0915\u0939\u0924\u0940 \u0939\u0948, \u092f\u0939\u093e\u0902 \u092c\u0921\u0940 \u0906\u0917 \u091c\u0932\u093e\u090f \u091c\u093e\u0924\u0940 \u0925\u0940"
 },
 {
  "start": 33.66,
  "end": 36.84,
  "text": " \u0914\u0930 \u092e\u0936\u093e\u0932\u0947 \u0909\u0938\u0947 \u0926\u0942\u0930 \u0926\u0942\u0930 \u0915\u0940 \u092a\u0939\u093e\u0921\u093f\u092f\u094b \u0924\u0915 \u0932\u0947\u091c\u093e\u0924\u0940 \u0925\u0940"
 },
 {
  "start": 36.84,
  "end": 43.04,
  "text": " \u0909\u0938 \u0930\u093e\u0924 \u0906\u0924\u094d\u092e\u093e\u092f \u0917\u0942\u0902\u0924\u0940 \u0939\u0948, \u0905\u0938\u093e \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0924\u093e, \u0924\u094b \u0932\u094b\u0917 \u0936\u0932\u091c\u092e \u092e\u0947\u0902 \u0926\u0930\u093e\u0935\u0928\u0947 \u091a\u0939\u0930\u0947 \u0915\u093e\u091f\u0924\u0947 \u0925\u0947."
 },
 {
  "start": 43.28,
  "end": 44.6,
  "text": " \u092e\u0948\u0902 \u0915\u094d\u092f\u094b\u0902 \u0939\u0930 \u092c\u093e\u0930?"
 },
 {
  "start": 44.9,
  "end": 48.46,
  "text": " \u092b\u093f\u0930 18-100's \u092e\u0947\u0902 \u0906\u0908\u0930\u093f\u0936 \u0932\u094b\u0917 \u0906\u0924\u0932\u093e\u0928\u094d\u091f\u093f\u0915 \u092a\u093e\u0930 \u0915\u0930 \u0915\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u092a\u0939\u0941\u091a\u0947."
 },
 {
  "start": 48.76,
  "end": 52.56,
  "text": " \u0935\u094b \u092a\u0930\u092e\u092a\u0930\u093e \u0938\u093e\u0925 \u0932\u093e\u0908, \u092a\u0930 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u092e\u0947\u0902 \u0936\u0932\u091c\u092e \u0938\u0947 \u092c\u0939\u0924\u0930 \u091a\u0940\u0938 \u0925\u0940."
 },
 {
  "start": 52.56,
  "end": 55.8,
  "text": " \u092a\u092e\u094d\u0915\u093f\u0928, \u092c\u0921\u093c\u0947 \u0928\u0930\u092e \u0914\u0930 \u0915\u093e\u091f\u0928\u0947 \u092e\u0947\u0902 \u0915\u0939\u0940 \u0906\u0938\u093e\u0928"
 },
 {
  "start": 55.8,
  "end": 58.24,
  "text": " \u0906\u0916\u093f\u0930 \u0915\u093e\u0930, \u092e\u0947\u0930\u0947 \u0932\u093e\u092f\u0915 \u0915\u093e\u092e"
 },
 {
  "start": 58.24,
  "end": 62.6,
  "text": " \u0907\u0938 \u0938\u093e\u0932 \u0906\u092e\u0947\u0930\u0947 \u0915\u0940 \u0939\u0932\u0941\u0935\u0940\u0928 \u092a\u0930 \u0915\u0930\u0940\u092c 13.5 \u092c\u093f\u0932\u094d\u092f\u0928 \u0921\u0932\u0930\u094d\u0938 \u0916\u0930\u091a \u0915\u0930\u0947\u0902\u0917\u0947"
 },
 {
  "start": 62.6,
  "end": 64.64,
  "text": " \u0924\u094b \u0926\u0942\u0928\u094d\u092f\u093e \u0915\u0940 \u0938\u092c\u0938\u0947 \u0926\u0930\u093e\u0935\u0928\u0940 \u0930\u093e\u0924"
 },
 {
  "start": 64.64,
  "end": 67.28,
  "text": " \u090f\u0915 \u0936\u093e\u0928\u094d\u0924 \u0906\u0908\u0930\u0936 \u092a\u0939\u093e\u0921\u0940 \u0915\u0940 \u0906\u0916 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u0941\u0908"
 },
 {
  "start": 67.28,
  "end": 73.5,
  "text": " \u092e\u0948\u0902 \u092a\u0939\u0932\u0947 \u0924\u093e, \u092f\u093e\u0926 \u0930\u0916\u0928\u093e, \u092f\u0947 \u0939\u0948 \u092c\u0939\u0941\u0917\u094b\u0932, \u0906\u091c\u093c\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e\u0930 \u091a\u094b\u0917\u094d\u0930\u092b\u0940 \u092b\u093e\u0915\u094d\u0924 \u0915\u0947 \u0932\u093f\u090f \u092b\u093e\u0932\u094b \u0915\u0930\u0947."
 }
]