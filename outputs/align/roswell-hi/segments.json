[
 {
  "start": 0.0,
  "end": 6.86,
  "text": " \u0905\u0917\u0930 \u0906\u092a 1947 \u0915\u0947 UFO \u0915\u094d\u0930\u093e\u0937 \u0915\u0947 \u0932\u093f\u092f\u0947 \u0930\u094b\u0938\u094d\u0935\u0932 \u091c\u093e\u090f\u0902, \u0924\u094b \u0906\u092a \u0915\u0930\u0940\u092c 100 km \u0917\u0932\u0924 \u0939\u0948\u0902."
 },
 {
  "start": 6.86,
  "end": 10.72,
  "text": " \u0924\u094b \u0930\u094b\u0938\u094d\u0935\u0932 \u0915\u094b aliens \u092e\u093f\u0932\u0947 \u0915\u0948\u0938\u0947? \u091a\u0932 \u092f\u0947 1947 \u092e\u0947\u0902."
 },
 {
  "start": 11.0,
  "end": 15.98,
  "text": " \u0915\u094b\u0930\u094b\u0928\u093e \u0928\u093e\u092e \u0915\u0947 \u091a\u094b\u091f\u0947 \u0917\u093e\u0901 \u0915\u0947 \u092a\u093e\u0938 \u0915\u093f\u0938\u093e\u0928 \u092e\u0948\u0915 \u092c\u094d\u0930\u0940\u091c\u093f\u0932 \u0915\u094b \u0915\u0947\u091f \u092b\u0930 \u092e\u0947\u0902 \u0915\u092c\u093e\u0921 \u092e\u093f\u0932\u0924\u093e \u0939\u0948."
 },
 {
  "start": 16.34,
  "end": 18.62,
  "text": " \u092a\u0928\u094d\u0928\u0940, \u0930\u092c\u0930, \u091f\u0947\u092a, \u0932\u0915\u094d\u0921\u093f\u092f\u093e."
 },
 {
  "start": 18.62,
  "end": 23.5,
  "text": " \u0932\u0915\u094d\u0924\u093e \u0939\u0948 \u092a\u0926\u0902\u0917 \u092a\u093e\u091f \u0917\u0908, \u0935\u094b \u0916\u093c\u092c\u0930 \u0915\u0930\u0924\u093e \u0939\u0948 \u0930\u094b\u0938\u094d\u0935\u093f\u0932 \u0915\u0947 \u0936\u0947\u0930\u093f\u092b \u0915\u094b."
 },
 {
  "start": 23.8,
  "end": 25.5,
  "text": " \u0924\u094b \u0930\u094b\u0938\u094d\u0935\u093f\u0932 \u0928\u0947 \u0907\u0938\u0947 \u091a\u0941\u0930\u093e\u092f\u093e \u0915\u0948\u0938\u0947?"
 },
 {
  "start": 25.92,
  "end": 27.4,
  "text": " \u0930\u094b\u0938\u094d\u0935\u093f\u0932 \u092e\u0947\u0902 \u090f\u0915 \u090f\u0930 \u092c\u0947\u0938 \u0925\u093e."
 },
 {
  "start": 27.84,
  "end": 30.36,
  "text": " \u0926\u0942\u0928\u094d\u092f\u093e \u0915\u0940 \u090f\u0915\u094d\u0932\u094b\u091f\u0940 \u0906\u0924\u094b\u092e\u093f\u0915 \u092c\u094b\u092e\u0930 \u0909\u0928\u093f\u091f \u0915\u093e \u0917\u0930."
 },
 {
  "start": 34.22,
  "end": 37.56,
  "text": " \u0905\u0917\u094d\u092c\u093e\u0930 \u0932\u093f\u0915\u094d\u0924\u0947\u0924\u093e \u0939\u0948 \u0930\u093e\u0902\u091c \u0930\u094b\u0938\u094d\u0935\u0932 \u0930\u0940\u091c\u0928 \u092e\u0947\u0902"
 },
 {
  "start": 37.56,
  "end": 39.04,
  "text": " \u0930\u0940\u091c\u0928 \u091a\u0932\u0947\u0917\u093e"
 },
 {
  "start": 39.04,
  "end": 41.68,
  "text": " \u090f\u0915 \u0926\u093f\u0928 \u092e\u0947\u0902 \u0906\u0930\u094d\u092e\u0940 \u0915\u0939\u0924\u0940 \u0939\u0948 \u0935\u0947\u0926\u092c\u0932\u0941\u0928"
 },
 {
  "start": 41.68,
  "end": 43.48,
  "text": " \u0938\u094d\u092a\u094b\u0932\u0930 \u0935\u094b \u092d\u0940 \u0928\u0939\u0940\u0902 \u0925\u093e"
 },
 {
  "start": 43.48,
  "end": 47.44,
  "text": " 1994 \u092e\u0947\u0902 \u0906\u0930\u094d\u092b\u094b\u0938 \u0928\u0947 \u0915\u0939\u093e \u092f\u0947 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u0924 \u092e\u094b\u0917 \u0917\u0941\u0932 \u0925\u093e"
 },
 {
  "start": 47.44,
  "end": 49.52,
  "text": " \u0906\u0932\u093e \u092e\u094b\u0917 \u0905\u0921\u094b \u0915\u0940 \u0938\u0940\u0915\u094d\u0930\u093f\u091f \u092c\u0932\u0941\u0928\u094d\u0938"
 },
 {
  "start": 49.52,
  "end": 52.34,
  "text": " \u0938\u094b\u0935\u093f\u092f \u0924\u091f\u094b\u092e\u093f\u0915 \u091f\u0947\u0938\u094d\u0924 \u0938\u0941\u0928\u094d\u0928\u0947\u0935\u093e\u0932\u0947 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u0941\u0928\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925"
 },
 {
  "start": 52.34,
  "end": 54.06,
  "text": " \u091c\u093e\u0938\u0941\u0938\u0940 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e"
 },
 {
  "start": 54.06,
  "end": 55.46,
  "text": " \u0917\u0942\u092e\u0928\u0947 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 55.46,
  "end": 57.52,
  "text": " \u0924\u0940\u0938 \u0938\u093e\u0932 \u0924\u0915 \u0915\u093f\u0938\u0940 \u0915\u094b \u092a\u0930\u094d\u0935\u093e\u0928 \u0939\u0940 \u0924\u0940"
 },
 {
  "start": 57.52,
  "end": 61.96,
  "text": " \u092b\u093f\u0930 1978 \u092e\u0947\u0902 \u0930\u094b\u0938\u094d\u0935\u0932 \u0915\u0947 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u0947 \u0905\u092b\u093f\u0938\u0930 \u0928\u0947 \u0907\u0938\u0947 \u0915\u0935\u0930 \u0905\u092a \u0915\u0939\u093e"
 },
 {
  "start": 61.96,
  "end": 63.24,
  "text": " \u0914\u0930 \u0915\u0939\u093e\u0928\u0940 \u091a\u0932 \u092a\u0921\u0940"
 },
 {
  "start": 63.24,
  "end": 66.42,
  "text": " \u0906\u091c \u0939\u0930 \u0938\u093e\u0932 \u0915\u0930\u0940\u092c 90,000 \u0932\u094b\u0917 \u0930\u094b\u0938\u094d\u0935\u0932 \u0906\u0924\u0947 \u0939\u0948"
 },
 {
  "start": 66.42,
  "end": 68.74,
  "text": " \u091c\u094b \u092d\u0940 \u0917\u093f\u0930\u093e \u0930\u094b\u0938\u094d\u0935\u0932 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0917\u093f\u0930\u093e"
 },
 {
  "start": 68.74,
  "end": 70.06,
  "text": " \u0924\u0942\u0930\u093f\u0938\u094d\u091f \u091c\u0930\u0942\u0930 \u0909\u0924\u094d\u0930\u0947"
 },
 {
  "start": 70.06,
  "end": 71.86,
  "text": " \u0917\u093f\u0930\u093e \u0924\u094b \u092e\u0941\u091a\u094d\u092a\u0930 \u0924\u093e"
 },
 {
  "start": 71.86,
  "end": 73.58,
  "text": " \u092e\u0947\u0930\u093e \u092e\u0941\u091c\u094d\u092f\u092e \u0915\u0939\u093e \u0939\u0948"
 },
 {
  "start": 73.58,
  "end": 74.82,
  "text": " \u092f\u0939\u0947 \u092c\u0939\u0941\u0917\u094b\u0932"
 },
 {
  "start": 74.82,
  "end": 77.62,
  "text": " \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e\u0921 \u091c\u094b\u0917\u094d\u0930\u092b\u0940 \u092b\u093e\u0915\u094d\u091f\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u0932\u094b \u0915\u0930\u0947"
 }
]