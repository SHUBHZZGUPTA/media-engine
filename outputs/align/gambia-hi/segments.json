  "text": " \u0932\u093f\u0915\u093f\u0902 \u091a\u094b\u0921\u093e \u092c\u0938 480 km \u0924\u0915"
 },
 {
  "start": 15.0,
  "end": 17.9,
  "text": " \u0915\u0948\u0924\u0947 \u0939\u0948 \u092c\u094d\u0930\u093f\u0924\u093f\u0937 \u0924\u094b\u092a \u0915\u0947 \u0917\u094b\u0932\u094b \u0928\u0947 \u092f\u0947 \u092c\u094b\u0905\u0921\u0930 \u092c\u0928\u093e\u092f\u093e"
 },
 {
  "start": 17.9,
  "end": 21.66,
  "text": " \u0905\u0938\u0932 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u0930\u093f\u0935\u0930 \u0915\u0947 \u0926\u094b\u0928\u094b \u0924\u0930\u0935, \u092c\u0938 \u091f\u0947\u0928 \u0915\u093f\u0932\u093e\u092e\u093f\u091f\u0930"
 },
 {
  "start": 21.66,
  "end": 23.52,
  "text": " \u0924\u094b \u092f\u0947 \u0926\u0947\u0936 \u0915\u094d\u092f\u093e \u092a\u093e\u090f\u0917\u093e?"
 },
 {
  "start": 24.06,
  "end": 28.3,
  "text": " 20 \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917, \u090f\u0915 \u0915\u094b\u0938 \u0932\u093e\u0908\u0928, \u0914\u0930 \u092a\u0942\u0930\u0940 \u0917\u0902\u092c\u093f\u092f\u093e \u0930\u093f\u0935\u0930"
 },
 {
  "start": 28.900000000000002,
  "end": 32.3,
  "text": " \u0914\u0930 \u0928\u094b\u0930\u094d\u0926 \u0938\u0948\u0928\u093f\u0915\u093e\u0932 \u0914\u0930 \u0938\u093e\u0909\u0925 \u0915\u0947 \u092d\u0940\u091a \u0915\u094b\u0908 \u092c\u094b\u091f\u0930 \u092a\u094b\u0938 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 32.3,
  "end": 34.52,
  "text": " \u0932\u093f\u0915\u093f\u0928 \u092f\u0939 \u0905\u092d\u0940 \u0938\u092a\u094d\u0930\u0915\u094d\u092f\u093e \u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948"
 },
 {
  "start": 34.52,
  "end": 37.66,
  "text": " 1981 \u092e\u0947\u0902, \u0917\u0902\u092c\u0940\u093e \u0915\u0947 \u092a\u094d\u0930\u0938\u094d\u091f\u093f\u091f\u094d\u091f\u0902\u091f \u0932\u0902\u0921\u0928 \u0917\u093e\u090f."
 },
 {
  "start": 38.14,
  "end": 40.34,
  "text": " \u0930\u094b\u092f\u0932 \u0935\u0940\u091f\u0940\u0902\u0915\u0947 \u0932\u093f\u090f, \u091a\u093e\u0932\u094d\u0937 \u0905 \u091f\u093e\u092f\u0928\u093e \u0915\u0940?"
 },
 {
  "start": 40.74,
  "end": 42.76,
  "text": " \u0914\u0930 \u092a\u093f\u091a\u0947 \u0926\u0947\u0936 \u092e\u0947\u0930 \u0921\u0947\u0935\u0932\u094d\u0938 \u0928\u0947 \u0915\u0942\u090f \u0915\u0930 \u0926\u093f\u092f\u093e."
 },
 {
  "start": 43.34,
  "end": 46.76,
  "text": " \u0938\u0947\u0928\u093f\u0917\u093e\u0932 \u0932\u0947\u0902 \u092c\u0947\u091c\u0947, 2700 \u0938\u0948\u0928\u093f\u0915 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092c\u091a\u093e\u0932\u094d\u0932\u093f\u092f\u093e?"
 },
 {
  "start": 47.26,
  "end": 50.22,
  "text": " \u0915\u0941\u091b \u092e\u0939\u0940\u0928\u0947 \u092c\u093e\u0926, \u0938\u0948\u0928\u0947 \u0917\u0902\u092c\u0940\u093e, \u090f\u0915 \u0916\u094b\u0932\u094d\u0917\u0933\u093e\u0936\u0928."
 },
 {
  "start": 50.22,
  "end": 54.34,
  "text": " \u092f\u0947 \u091a\u0932\u093e \u092c\u0938 \u0938\u0947\u0935\u0947\u0902 \u0938\u093e\u0932 \u092b\u093f\u0930 \u0924\u0942\u091f \u0917\u092f\u093e \u092a\u094d\u0930\u0938\u094d\u091f\u093f\u0928\u094d \u0915\u094b\u0928 \u092c\u0928\u0947 \u092f\u0938 \u092a\u0930"
 },
 {
  "start": 54.34,
  "end": 58.04,
  "text": " \u0914\u0930 \u0915\u093e\u092a\u093f\u091f\u0932 \u092c\u0921\u093c\u093e\u0938\u093e \u0926\u0915\u093e\u0930 \u092f\u093e \u091a\u094b\u0921\u093c\u093e \u0938\u093e \u092c\u093e\u0908\u0902\u091c\u0941\u0932"
 },
 {
  "start": 58.04,
  "end": 60.32,
  "text": " \u0917\u093e\u092e\u092d\u093f\u092f\u093e \u0915\u093e \u091c\u092c\u093e\u092c \u0939\u092e \u091c\u094b\u091f\u0947 \u0939\u0948"
