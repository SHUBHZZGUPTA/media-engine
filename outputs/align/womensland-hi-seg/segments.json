 {
  "start": 15.55,
  "end": 18.41,
  "text": " \u092d\u093f\u091c\u0932\u0940 \u0938\u094b\u0932\u0930 \u0938\u0947 \u092a\u093e\u0928\u0940 \u0917\u094d\u0930\u093e\u0935\u093f\u091f\u0940 \u092b\u0947\u091f \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0947"
 },
 {
  "start": 18.41,
  "end": 20.97,
  "text": " \u0914\u0930 80 \u092a\u0930\u0938\u0947\u0902 \u0938\u0947 \u091c\u093c\u093e\u0926\u093e \u0916\u093e\u0928\u093e \u092f\u0939\u0940 \u0909\u0915\u0924\u093e \u0939\u0948"
 },
 {
  "start": 20.97,
  "end": 22.37,
  "text": " \u0906\u0932\u0942 \u0938\u0947 \u091c\u093c\u0940 \u092c\u0941\u091f\u093f\u092f\u094b \u0924\u0915"
 },
 {
  "start": 22.37,
  "end": 26.53,
  "text": " \u0916\u0930\u091a\u093e \u0935\u0939\u0940\u0928\u0947 \u0915\u093e \u092a\u094d\u092f\u0935 \u092b\u093c\u0941\u0928\u0926\u093c\u0947 \u0921\u093c\u093e\u0932\u0930 \u0938\u0947 \u0917\u0940 \u0915\u092e \u0930\u093e\u0928\u093f\u094b \u091c\u0948\u0938\u0940 \u0938\u093f\u0902\u0927\u093f\u0917\u0940"
 },
 {
  "start": 26.53,
  "end": 29.91,
  "text": " \u092a\u0930 \u0938\u092c\u094d\u0938\u0947 \u0905\u091c\u093c\u093f\u092c \u0928\u0940\u092e \u092f\u0939\u093e\u0902 \u0932\u0921\u0915\u094b \u0915\u094b \u092a\u093e\u0932\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0924\u093e"
 },
 {
  "start": 29.91,
  "end": 33.41,
  "text": " \u092c\u0947\u091f\u093e \u0939\u0941\u0901\u0906 \u0924\u094b \u092e\u093e \u092c\u093e\u0939\u0930 \u091c\u092c \u092d\u0915 \u0935\u094b \u092c\u0921\u093e\u0939\u094b\u0917\u0930 \u091a\u0932\u0928\u093e \u091c\u093e\u090f"
 },
 {
  "start": 33.41,
  "end": 36.09,
  "text": " \u092a\u0930\u094d \u0938\u094d\u091f\u0947\u0902\u091f \u092d\u0940 \u0928\u0939\u0940\u0902 \u0906\u0938\u0915\u0924\u0947 \u091c\u092c \u0924\u0915 \u0935\u094b \u0905\u0930\u0924 \u0928\u0939\u094b"
 },
 {
  "start": 36.870000000000005,
  "end": 41.83,
  "text": " 1970 \u0938\u0947 \u0928\u093e \u092a\u0942\u0932\u0940\u0938, \u0928\u093e \u0936\u0930\u093f\u092b, \u0928\u093e \u090f\u0915 \u092d\u0940 9-1-1 call, \u0924\u094b \u0915\u094d\u092f\u093e \u0906\u092a \u0930\u0939 \u0938\u0915\u0924\u0947 \u0939\u0948?"
 },
 {
  "start": 42.04,
  "end": 51.879999999999995,
  "text": " \u0924\u0947\u0915\u094d\u0928\u093f\u0915\u0932\u0940 \u0928\u0939\u0940\u0902, \u0935\u0928 \u092e\u093f\u0932\u094d\u092f\u0928 \u0921\u093c\u094b\u0932\u0930\u094d\u0938 \u0926\u0947\u0915\u0930 \u092d\u0940 \u0928\u0939\u0940\u0902, \u092c\u093f\u0915\u093e\u0913 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u0907\u0928\u094d\u0935\u093f\u091f\u0947\u0936\u0928 \u0938\u0947, \u0914\u0930 \u0939\u0930\u0947\u0915 \u0905\u0930\u0924 \u0915\u0940 \u0939\u093e \u091c\u0930\u0942\u0930\u0940, \u092f\u0947 \u0939\u0948 \u0935\u0942\u092e\u093f\u0928\u094d\u0938 \u0932\u0928\u094d\u0926 \u0914\u0930\u0947\u0917\u0928 \u092e\u0947\u0902, \u0930\u0941\u0915\u094b \u092e\u0948\u0902\u0928\u0947 \u091a\u0947\u0915 \u0915\u093f\u092f\u093e."
 },
 {
  "start": 52.05,
  "end": 54.449999999999996,
  "text": " \u0924\u094d\u0935\u093f\u0938\u094d\u091f \u0907\u0938 \u092e\u0947\u0902 \u0938\u0947 \u0932\u0915\u094d\u092c\u0915 \u0915\u0941\u091b \u0938\u091a \u0928\u0939\u0940\u0902"
 },
 {
  "start": 54.449999999999996,
  "end": 55.39,
  "text": " \u092f\u0947 \u0936\u0939\u0930 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 55.39,
  "end": 57.51,
  "text": " \u0938\u0926\u0928 \u0905\u0930\u093f\u0917\u0928 \u0915\u0947 8 \u0936\u094b\u091f\u0947 \u092b\u093e\u092e\u094d\u0938 \u0925\u0947"
 },
 {
  "start": 57.51,
  "end": 59.39,
  "text": " \u0938\u092c \u0938\u0947 \u092c\u0921\u093c\u093e \u0915\u0930\u0940\u092c 150 \u0905\u0917\u0921"
 },
 {
  "start": 59.39,
  "end": 61.41,
  "text": " \u0939\u0930 \u092b\u093e\u092e\u092a\u0930 4 \u0938\u0947 30 \u0905\u0917\u0921\u091f\u0947"
 },
 {
  "start": 61.41,
  "end": 62.61,
  "text": " \u0915\u094b\u0908 \u0935\u094b\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 62.61,
  "end": 65.33,
  "text": " \u090f\u0915 \u092b\u093e\u092e\u092a\u0930 22 \u092f\u094b\u0938 \u0924\u0915 \u0915\u094b\u0908 \u092d\u0940 \u0905\u0930\u0924 \u0930\u0939\u0947 \u0938\u0915\u0924\u0940 \u0925\u0940"
 },
 {
  "start": 65.33,
  "end": 69.22999999999999,
  "text": " \u0932\u0917\u0915\u094b\u0902 \u0915\u093e \u0928\u093f\u092f\u092e, \u0939\u0930 \u092b\u093e\u092e \u0915\u093e \u0905\u0932\u0917, \u090f\u0915 \u092a\u0930 \u0938\u093f\u0915 \u0938\u093e\u0932 \u0938\u0947 \u091a\u094b\u091f\u0947 \u0932\u0917\u0915\u0947."
 },
 {
  "start": 69.47,
  "end": 73.21,
  "text": " \u092a\u0930 \u0938\u091a \u092f\u0947 \u0939\u0948, 1976 \u092e\u0947\u0902, \u0932\u0917\u092c\u0916 \u092c\u093f\u0928\u093e \u092a\u0948\u0938\u094b\u0902 \u0915\u0947,"
 },
 {
  "start": 73.53,
  "end": 76.00999999999999,
  "text": " \u0914\u0930\u094d\u0925\u094b\u0928\u0947 147 \u090f\u0915\u0921 \u092a\u0939\u093e\u0930\u0940 \u091c\u092e\u0940\u0928 \u0915\u0939\u0930\u0940 \u0926\u0940,"
 },
 {
  "start": 76.31,
  "end": 77.87,
  "text": " \u0914\u0930 \u0909\u0938\u0947 \u0914\u0930\u094d\u0925\u094b\u0902 \u0915\u093e \u0917\u0930 \u092c\u0928\u093e \u0926\u093f\u092f\u093e."
 },
 {
  "start": 78.06,
  "end": 80.0,
  "text": " 50 yrs baad bhi wo unhi ki hai."
 },
 {
  "start": 80.22,
  "end": 82.9,
  "text": " Saj kohun, ye kisi bhi viral midh se zyada kamal hai."
 },
 {
