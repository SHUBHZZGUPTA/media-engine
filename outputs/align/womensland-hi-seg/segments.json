[
 {
  "start": 0.0,
  "end": 4.06,
  "text": " \u0915\u094d\u092f\u093e \u0905\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948? \u092f\u0947 \u090f\u0915 \u0932\u094b\u091f\u093e \u0936\u0939\u0930 \u0939\u0948 \u091c\u093e\u0939\u093e\u0902 \u0938\u0947\u0930\u094d\u092b \u0914\u0930\u0924\u0947 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902"
 },
 {
  "start": 4.06,
  "end": 5.8,
  "text": " \u0914\u0930 \u0915\u093f\u0938\u0940 \u092e\u0930\u0926 \u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0928\u0939\u0940\u0902?"
 },
 {
  "start": 5.8,
  "end": 7.1,
