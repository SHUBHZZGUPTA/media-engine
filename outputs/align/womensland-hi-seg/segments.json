  "end": 8.4,
  "text": " \u0914\u0930 \u0938\u092c \u0938\u0947 \u0939\u0930\u093e\u0928\u0940 \u0915\u0940 \u092c\u093e\u0924"
 },
 {
  "start": 8.57,
  "end": 10.870000000000001,
  "text": " 48 \u092f\u0947\u0930 \u0938\u0947 \u0915\u094d\u0930\u093e\u0908\u092e \u091c\u0940\u0930\u094b"
 },
 {
  "start": 10.870000000000001,
  "end": 14.530000000000001,
  "text": " \u092f\u0947 \u0935\u0928 \u0924\u093e\u0913\u091c\u0928 \u090f\u0915\u0921 \u0915\u0940 \u091c\u092e\u0940\u0928 40 \u0938\u0947 \u091c\u093c\u093e\u0926\u093e \u0914\u0930\u0924\u0947 \u091a\u0932\u093e\u0924\u0940 \u0939\u0948\u0902"
 },
 {
