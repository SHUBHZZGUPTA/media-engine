  "text": " \u0914\u0930 \u0909\u0938\u0947 \u0914\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u0917\u0930 \u092c\u0928\u093e \u0926\u093f\u092f\u093e"
 },
 {
  "start": 77.9,
