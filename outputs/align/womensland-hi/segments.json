  "text": " 50 \u092f\u093e\u091c \u092c\u093e\u0926 \u092d\u0940 \u0935\u094b \u0909\u0928\u0939\u0940 \u0915\u0940 \u0939\u0948"
 },
 {
  "start": 80.06,
  "end": 82.96,
  "text": " \u0938\u091a \u0915\u0939\u0942\u0901 \u092f\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u093e\u0908\u0930\u0932 \u092e\u093f\u0925 \u0938\u0940 \u091c\u093c\u093e\u0926\u093e \u0915\u092e\u093e\u0932 \u0939\u0948"
 },
 {
  "start": 82.96,
  "end": 84.08,
  "text": " \u092f\u0947 \u0939\u0948 \u092c\u0939\u0941\u0917\u094b\u0932"
 },
 {
