  "text": " \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e \u091c\u094b\u0917\u0930\u092b\u0940 \u092b\u0948\u0915\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u0932\u094b \u0915\u0930\u0947"
 }
