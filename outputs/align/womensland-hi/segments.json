[
 {
  "start": 0.0,
  "end": 4.08,
  "text": " \u0915\u094d\u092f\u093e \u0905\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948? \u092f\u0947 \u090f\u0915 \u0932\u094b\u091f\u093e \u0936\u0939\u0930 \u0939\u0948 \u091c\u093e\u0939\u093e\u0902 \u0938\u0930\u094d\u092b \u0905\u0930\u094d\u091f\u0947 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902"
 },
 {
  "start": 4.08,
  "end": 5.7,
  "text": " \u0914\u0930 \u0915\u093f\u0938\u0940 \u092e\u0930\u094d\u0926 \u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0928\u0939\u0940\u0902?"
 },
 {
  "start": 5.72,
  "end": 6.82,
  "text": " \u091c\u0940 \u0939\u093e\u0902 \u0938\u0939\u0940 \u0938\u0942\u0928\u093e!"
 },
 {
  "start": 7.16,
  "end": 10.74,
  "text": " \u0914\u0930 \u0938\u092c\u0938\u0947 \u0939\u0930\u093e\u0928\u0940 \u0915\u0940 \u092c\u093e\u0924, 48 \u092f\u0939\u0930 \u0938\u0947 \u0915\u094d\u0930\u093e\u0908\u092e 0"
 },
 {
  "start": 10.74,
  "end": 15.0,
  "text": " \u092f\u0947 1001 \u0905\u0917\u0930 \u0915\u0940 \u091c\u092e\u0940\u0928 40 \u0938\u0947 \u091c\u093e\u0921\u093e \u0905\u0930\u094d\u091f\u0947 \u091a\u0932\u093e\u0924\u0940 \u0939\u0948\u0902"
 },
 {
  "start": 15.0,
  "end": 44.84,
  "text": " \u0905\u092a \u0926\u093c\u093e \u0905\u092a \u0917\u0930\u091f, \u092c\u093f\u091c\u0932\u0940 \u0938\u094b\u0932\u0930 \u0938\u0947, \u092a\u093e\u0928\u0940 \u0917\u094d\u0930\u093e\u0935\u093f\u091f\u0940 \u092b\u0947\u091f \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0947, \u0914\u0930 \u0906\u092a \u0906\u092a \u092a\u0930\u0938\u0947\u0902 \u0938\u0947 \u091c\u0906\u0926\u093e \u0915\u0939\u0928\u093e \u092f\u0939\u0940 \u092f\u0941\u0916\u0924\u093e \u0939\u0948, \u0906\u0932\u0941 \u0938\u0947 \u091c\u0921\u0940 \u092d\u0942\u091f\u093f\u092f\u094b \u0924\u0915, \u0916\u0930\u094d\u091a\u093e \u092e\u0939\u0940\u0928\u0947 \u0915\u093e \u092b\u0935\u0939\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901\u0901"
 },
 {
  "start": 44.84,
  "end": 46.68,
  "text": " \u092c\u093f\u0915\u093e\u0913 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u0907\u0928\u094d\u0935\u093f\u091f\u0947\u0936\u0928 \u0938\u0947"
 },
 {
  "start": 46.68,
  "end": 48.32,
  "text": " \u0914\u0930 \u0939\u0930\u0947 \u090f\u0915 \u0905\u0930\u0924 \u0915\u0940 \u0939\u093e \u091c\u0930\u0942\u0930\u0940"
 },
 {
  "start": 48.32,
  "end": 50.52,
  "text": " \u092f\u0947 \u0939\u0948 \u0935\u0942\u092e\u093f\u0928\u094d\u0938 \u0932\u0928\u094d\u0926, \u0914\u0930\u0947\u0917\u0928 \u092e\u0947\u0902"
 },
 {
  "start": 50.52,
  "end": 51.9,
  "text": " \u0930\u0941\u0915\u094b, \u092e\u0948\u0902\u0928\u0947 \u091a\u0947\u0915 \u0915\u093f\u092f\u093e"
 },
 {
  "start": 51.9,
  "end": 54.4,
  "text": " \u091f\u094d\u0935\u093f\u0938\u094d\u091f \u0907\u0938 \u092e\u0947\u0902 \u0938\u0947 \u0932\u0915\u094d\u092c\u0916 \u0915\u0941\u091b \u0938\u091a \u0928\u0939\u0940\u0902"
 },
 {
  "start": 54.4,
  "end": 57.5,
  "text": " \u092f\u0947 \u0936\u0939\u0930 \u0928\u0939\u0940\u0902, \u0938\u0926\u0928 \u0905\u0930\u0947\u0917\u0928 \u0915\u0947 8 \u0936\u094b\u091f\u0947 \u092b\u093e\u092e\u094d\u0938 \u0925\u0947"
 },
 {
  "start": 57.5,
  "end": 59.38,
  "text": " \u0938\u092c \u0938\u0947 \u092c\u0921\u093c\u093e \u0915\u0930\u0940\u092c 150 \u0905\u0917\u0921"
 },
 {
  "start": 59.38,
  "end": 61.42,
  "text": " \u0939\u0930 \u092b\u093e\u092e\u092a\u0930 4 \u0938\u0947 30 \u0905\u0917\u0921\u093c\u0947"
 },
 {
  "start": 61.42,
  "end": 62.58,
  "text": " \u0915\u094b\u0908 \u0935\u094b\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 62.58,
  "end": 65.34,
  "text": " \u090f\u0915 \u092b\u093e\u092e\u092a\u0930 22 \u092f\u094b\u0938 \u0924\u0915 \u0915\u094b\u0908 \u092d\u0940 \u0905\u0930\u0924 \u0930\u0939\u0947 \u0938\u0915\u0924\u0940 \u0924\u0940"
