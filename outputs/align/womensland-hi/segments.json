  "text": " \u0932\u0921\u093c\u0915\u094b\u0902 \u0915\u093e \u0928\u093f\u092f\u092e"
 },
 {
  "start": 66.3,
  "end": 67.4,
  "text": " \u0939\u0930 \u092b\u093e\u092e\u092a\u0930 \u0905\u0932\u0917"
 },
 {
