[
 {
  "start": 0.0,
  "end": 5.14,
  "text": " \u0915\u093f \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u094b? \u092f\u0947 \u091a\u094b\u091f\u093e \u0938\u093e \u0906\u0908\u0932\u0947\u0902\u091f \u0906\u0926\u093e \u0938\u094d\u0935\u0940\u091f\u0928 \u0939\u0948 \u0914\u0930 \u0906\u0926\u093e \u092b\u093f\u0928\u0932\u0947\u0902\u091f"
 },
 {
  "start": 5.14,
  "end": 10.12,
  "text": " \u0914\u0930 \u092f\u0947 \u092c\u094b\u093c\u0930 \u0924\u094b \u0926\u0947\u0916\u094b, \u092c\u093f\u0932\u0915\u094b\u0932 \u0906\u0938 \u091c\u0948\u0938\u093e \u0939\u0948. \u0915\u094b\u0908 \u0906\u0938\u093e \u092c\u094b\u093c\u0930 \u0915\u094d\u092f\u094b\u0902 \u092c\u0928\u093e\u090f\u0917\u093e?"
 },
 {
  "start": 10.62,
  "end": 15.24,
  "text": " \u092f\u0947 \u0939\u0948 \u092e\u093e\u0915\u0947\u091f \u090f\u0915 \u0916\u093e\u0932\u0940 \u091a\u091f\u093e\u0928, \u0938\u094d\u0935\u0940\u091f\u0928 \u0914\u0930 \u092b\u093f\u0928\u0932\u0947\u0902\u091f \u0915\u0947 \u092c\u0940\u091a."
 },
 {
  "start": 18.92,
  "end": 20.82,
  "text": " \u0905\u0902\u0917\u0947 \u0938\u093e\u092d\u094d\u091f\u093c\u093e\u0928\u094d\u0924\u093e\u0928\u094d\u0924\u0947\u0902\u091a\u0947 \u0926\u093c\u094d\u0926\u0941\u0928\u0947\u0917 \u0914\u0917\u0941\u091c\u0948\u0902alion"
 },
 {
  "start": 20.82,
  "end": 34.18,
  "text": " \u0914\u0930 \u0935\u0939\u093e\u0921\u093c\u093e\u0928\u094d\u0924\u093e\u0928, \u092a\u0930 \u0935\u0939\u093e\u0921\u093c\u093e\u0928\u094d\u0924\u093e\u0928 \u0924\u094b \u0932\u0940\u0923\u093f\u092f\u093e \u092d\u0940 \u092c\u093e\u0930\u094d\u0917\u093e\u0964\u0964\u0964\u0964\u0964\u0964"
 },
 {
  "start": 34.18,
  "end": 37.36,
  "text": " \u092c\u0938 \u090f\u0915 problem \u0935\u094b \u091c\u0917\u093e \u0936\u0941\u090f\u0921\u0928 \u092e\u0947 \u0925\u0940"
 },
 {
  "start": 37.36,
  "end": 41.019999999999996,
  "text": " \u0939\u0901\u0926\u0947\u0926 \u0938\u093e\u0932 \u0924\u0915 \u0935\u094b \u0916\u093c\u093c\u093e \u0930\u0939\u093e \u0917\u0932\u0924 \u0926\u0947\u0936 \u092e\u0947\u0902"
 },
 {
  "start": 41.54,
  "end": 44.28,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0905\u092d\u0940 \u0938\u092c\u0938\u0947 \u0905\u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948"
 },
 {
  "start": 45.26,
  "end": 47.92,
  "text": " 1985 \u092e\u0947\u0902 \u0932\u093e\u0907\u091f \u0939\u093e\u0901\u0938 \u0915\u094b \u0905\u0925\u093e\u0921\u0928\u0947 \u0915\u0940 \u091c\u0917\u0948"
 },
 {
  "start": 47.92,
  "end": 49.88,
  "text": " \u0909\u0928\u094b \u0928\u0947 \u092c\u093e\u0921\u0930 \u092f\u0947 \u0905\u0926\u093e \u0926\u093f\u092f\u093e"
 },
 {
  "start": 49.88,
  "end": 52.32,
  "text": " \u0905\u092c \u092f\u0947 \u0924\u093e\u0935\u0930 \u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0924\u0930\u092b \u0917\u0942\u092e\u0924\u093e \u0939\u0948"
 },
 {
  "start": 63.39999999999999,
  "end": 67.08,
  "text": " \u0924\u094b \u091c\u0940\u0928\u093f\u092f\u0938 \u0905\u0926\u093f\u092f\u093e, \u092f\u093e \u092a\u0941\u0930\u093e \u092a\u093e\u0917\u0932 \u092a\u0928, \u092f\u0941\u0915\u093f \u0938\u091c \u0935\u0924\u093e \u0939\u0942\u0901"
 }
