[
 {
  "start": 0.0,
  "end": 2.66,
  "text": " \u0905\u0917\u0930 \u092a\u0947\u0930\u0941 \u0914\u0930 \u092d\u0942\u0932\u093f\u0935\u093f\u092f\u093e \u090f\u0915 \u0926\u0947\u0936 \u092c\u0928 \u091c\u093e\u090f\u0902"
 },
 {
  "start": 2.66,
  "end": 5.16,
  "text": " \u0905\u091c\u0940\u092c \u0932\u0917\u093e, \u092f\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0939\u094b \u091a\u0941\u0915\u093e \u0939\u0948"
 },
 {
  "start": 5.16,
  "end": 6.8,
  "text": " 1836 \u092e\u0947\u0902"
 },
 {
  "start": 7.46,
  "end": 10.14,
  "text": " \u0907\u0938\u0915\u093e \u0928\u093e\u092e\u0924\u093e \u092a\u0947\u0930\u0941 \u092d\u0942\u0932\u093f\u0935\u093f\u092f\u0928 \u0915\u0941\u0928\u094d\u092b\u093f\u091f\u094d\u0930\u0947\u0936\u093f\u0928"
 },
 {
  "start": 10.14,
  "end": 14.0,
  "text": " \u092a\u0930 \u092a\u0921\u094b\u0938\u0940 \u0917\u092c\u094d\u0930\u093e\u0917 \u0906\u090f, \u0914\u0930 \u0907\u0938\u0947 \u0938\u093f\u0935 \u0924\u0940\u0928 \u0938\u093e\u0932 \u092e\u0947\u0902 \u0924\u094b\u0921 \u0926\u093f\u092f\u093e"
 },
 {
  "start": 14.64,
  "end": 16.3,
  "text": " \u0924\u094b \u0906\u091c \u092f\u0947 \u0926\u0947\u0936 \u0915\u0948\u0938\u093e \u0939\u094b\u0917\u093e"
 },
 {
  "start": 16.3,
  "end": 21.34,
  "text": " \u0916\u0930\u0940\u092c 48 \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917, \u0914\u0930 \u091c\u092e\u0940\u0928 \u092e\u0947\u0915\u094d\u0938\u093f\u0915\u094b \u0938\u0947 \u092d\u0940 \u091c\u093e\u0926\u093e"
 },
 {
  "start": 21.34,
  "end": 24.28,
  "text": " \u0906\u0928\u094d\u091f\u0940, \u0906\u092e\u091c\u093e\u0928 \u0914\u0930 \u092e\u093e\u091a\u094d\u091b\u0941 \u092a\u0940\u091a\u0941"
 },
 {
  "start": 24.28,
  "end": 28.5,
  "text": " \u0914\u0930 \u092d\u094c\u0932\u093f\u0935\u093f\u092f\u093e \u0915\u094b \u0906\u0916\u0930 \u0915\u093e\u0930 \u0935\u093e\u092a\u0938 \u092e\u093f\u0932\u0947\u0917\u093e \u0938\u092e\u0902\u0926\u0930"
 },
 {
  "start": 28.5,
  "end": 31.3,
  "text": " \u0907\u0938\u0915\u093e \u092a\u0942\u0930\u093e \u0915\u094b\u0938\u094d\u091f \u091a\u0940\u0932\u0947 \u0915\u0947 \u092a\u093e\u0938 \u091a\u0932\u093e \u0917\u092f\u093e"
 },
 {
  "start": 31.3,
  "end": 32.88,
  "text": " \u0938\u094b \u0938\u093e\u0932 \u0938\u0947 \u092d\u0940 \u092a\u0939\u0932\u0947"
 },
 {
  "start": 32.88,
  "end": 35.3,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u092d\u0940 \u0938\u092c\u0938\u0947 \u0905\u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 35.3,
  "end": 38.9,
  "text": " \u092c\u093f\u0928\u093e \u0938\u092e\u0928\u094d\u0926\u0930\u094d\u0935\u093e\u0932\u0947 \u092c\u093f\u0932\u093f\u0935\u093f\u092f\u093e \u0915\u0947 \u092a\u093e\u0938 \u0906\u091c \u092d\u0940 \u0939\u0948, \u090f\u0915 \u0928\u0947\u0935\u0940."
 },
 {
  "start": 40.38,
  "end": 44.54,
  "text": " \u091c\u094b \u091a\u0932\u0924\u0940 \u0939\u0948 \u090f\u0915 \u0932\u0947\u0915 \u092a\u0930, \u0932\u0947\u0915 \u0924\u093f\u091f\u0940 \u0915\u093e \u0915\u093e \u092e\u0947\u0902."
 },
 {
  "start": 44.92,
  "end": 47.74,
  "text": " \u0914\u0930 \u092a\u0947\u0930\u0942 \u0928\u0947 \u092c\u093f\u0932\u093f\u0935\u093f\u092f\u093e \u0915\u094b \u090f\u0915 \u092c\u0940\u091a \u0926\u093e\u0930 \u0926\u093f\u092f\u093e \u0939\u0948."
 },
 {
  "start": 48.04,
  "end": 49.5,
  "text": " \u0928\u093e\u0902\u091f\u0940 \u0928\u093e\u0901\u0928 \u0938\u093e\u0932 \u0915\u0947 \u0932\u093f\u090f."
 },
 {
  "start": 49.98,
  "end": 51.24,
  "text": " \u092b\u093f\u0930 \u0915\u093e\u092a\u093f\u0924\u0932 \u0915\u093e \u091c\u0917\u094d\u0921\u093e."
 },
 {
  "start": 51.24,
  "end": 54.14,
  "text": " \u0932\u093e\u0908\u092e\u093e \u092c\u094b\u0932\u0947\u0935\u093f\u092f\u093e \u0915\u0947 \u092a\u093e\u0938 \u0924\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0926\u094b\u0902 \u0939\u0948"
 },
 {
  "start": 54.14,
  "end": 55.72,
  "text": " \u092c\u094b\u0932\u0947\u0935\u093f\u092f\u093e \u0915\u093e \u091c\u092c\u093e\u092c"
 },
 {
  "start": 55.72,
  "end": 57.0,
  "text": " \u0915\u093e\u092a\u093f\u0930\u094d\u091f\u0932 \u0924\u0941\u092e \u0930\u0916\u094b"
 },
 {
  "start": 57.0,
  "end": 58.36,
  "text": " \u092e\u0941\u091d\u0947 \u092c\u0938 \u092d\u0940\u091a \u0926\u0947\u0926\u094b"
 },
 {
  "start": 58.36,
  "end": 60.22,
  "text": " \u0924\u094b \u090f\u0915 \u0926\u0947\u0936 \u092f\u093e \u0926\u094b"
 },
 {
  "start": 60.22,
  "end": 61.6,
  "text": " \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0938\u091a \u092c\u0924\u093e\u0913\u0902"
 }
]