  "text": " \u0939\u0930 \u0930\u0902\u0917 \u090f\u0915 \u0938\u093e\u0932 \u0939\u0948, \u0938\u092a\u0947\u0926 \u0930\u094b\u0937\u0928\u0940 1992 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0940,"
 },
 {
  "start": 22.700000000000003,
  "end": 26.64,
  "text": " \u0928\u0940\u0932\u0940 \u0928\u0948\u0902\u091f\u0940 \u0924\u0942\u0917\u0940, \u0939\u0930\u0940 \u0928\u0948\u0902\u091f\u0940 \u092f\u0947\u091f\u0915\u0940, \u0932\u093e\u0932 \u0924\u0942\u091b\u0928 \u0924\u0942\u091b\u0928 \u0924\u0942\u091b\u0928 \u0924\u0942\u091b\u0928 \u0924\u0942\u091b\u0928."
 },
 {
  "start": 26.85,
  "end": 28.89,
  "text": " \u0924\u094b \u092e\u0948\u0902 \u0907\u0938 \u092e\u0947\u0902 \u0939\u0941 \u0939\u0940 \u0928\u0939\u0940\u0902?"
 },
 {
  "start": 28.89,
  "end": 30.69,
  "text": " \u0906\u0938\u094d\u0932\u0940 \u0926\u093f\u0935\u093e\u0932\u0940 \u0938\u094d\u092a\u0947\u0938 \u0938\u0947 \u0915\u0948\u0938\u0940 \u0926\u093f\u0915\u0924\u0940 \u0939\u0948?"
 },
 {
  "start": 30.91,
  "end": 32.550000000000004,
  "text": " \u0928\u093e\u0938\u093e\u0928\u0947 2012 \u092e\u0947\u0902 \u0926\u0947\u0916\u093e."
 },
 {
  "start": 32.81,
  "end": 36.17,
  "text": " \u0905\u0924\u093f\u0930\u0947\u0915 \u0924\u0930\u094b\u0937\u0928\u0940 \u0907\u0924\u0928\u0940 \u0939\u0932\u094d\u0915\u0940 \u0924\u0940 \u0915\u0940 \u0909\u092a\u0930 \u0938\u0947 \u0936\u093e\u0907\u0926 \u0926\u093f\u0915\u0924\u0940 \u0939\u0940 \u0928\u0939\u0940\u0902."
