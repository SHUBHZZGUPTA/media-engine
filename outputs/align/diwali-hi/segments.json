  "end": 4.2,
  "text": " \u092f\u0947 \u0939\u0948 \u0935\u094b \u0926\u093f\u0935\u093e\u0932\u0940 \u092b\u094b\u091f\u094b \u091c\u093f\u0938\u0928\u0947 \u092a\u0942\u0930\u0947 \u092d\u093e\u0930\u0924 \u0915\u094b \u092c\u0947\u0935\u0915\u0942\u092a \u092c\u0928\u093e\u092f\u093e"
 },
 {
  "start": 4.2,
  "end": 6.02,
  "text": " \u0939\u0930 \u0926\u093f\u0935\u093e\u0932\u0940 \u092f\u0947 \u0935\u093e\u0908\u0930\u0932 \u0939\u094b\u0924\u0940 \u0939\u0948"
 },
 {
  "start": 6.02,
  "end": 8.06,
  "text": " \u0926\u093f\u0935\u093e\u0932\u0940 \u0915\u0940 \u0930\u093e\u0925 \u0938\u092a\u0947\u0938 \u0938\u0947 \u092d\u093e\u0930\u0924"
 },
 {
  "start": 8.3,
  "end": 13.0,
  "text": " \u0905\u0938\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0947 \u0905\u0938\u0932\u0940 \u0938\u093e\u091f\u0932\u093e\u0907\u0924 \u0926\u0947\u091f\u093e \u0939\u0948, \u092a\u0930\u0928\u093e \u0926\u093f\u0935\u093e\u0932\u0940 \u0915\u093e \u0928\u093e \u090f\u0915 \u0930\u093e\u0926 \u0915\u093e."
 },
 {
  "start": 13.4,
  "end": 16.240000000000002,
  "text": " \u0928\u094b\u0935\u093e \u0915\u0947 \u090f\u0915 \u0935\u0947\u0917\u094d\u092f\u093e\u0928\u093f\u0915 \u0928\u0939\u0940\u0902 \u0938\u0947 2003 \u092e\u0947\u0902 \u092c\u0928\u093e\u092f\u093e \u0925\u093e."
 },
 {
  "start": 16.48,
  "end": 18.82,
  "text": " \u092f\u0947 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0940 \u092c\u093e\u0930\u0924 \u0915\u0947 \u0936\u0939\u0930 \u0915\u0948\u0938\u0947 \u092c\u0921\u093c\u0947?"
