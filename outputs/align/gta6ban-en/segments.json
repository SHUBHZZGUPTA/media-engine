[
 {
  "start": 0.0,
  "end": 3.42,
  "text": " GTA VI is banned in these five countries."
 },
 {
  "start": 4.2,
  "end": 5.42,
  "text": " Or is it?"
 },
 {
  "start": 5.88,
  "end": 8.14,
  "text": " Because only one really did it."
 },
 {
  "start": 8.48,
  "end": 10.5,
  "text": " Number five, Saudi Arabia and the UAE."
 },
 {
  "start": 11.14,
  "end": 13.86,
  "text": " They capped GTA V out for 12 years."
 },
 {
  "start": 14.74,
  "end": 17.36,
  "text": " Then in 2025, the ban ended."
 },
 {
  "start": 17.72,
  "end": 19.12,
  "text": " GTA VI on sale."
 },
 {
  "start": 19.9,
  "end": 21.18,
  "text": " Number four, Russia."
 },
 {
  "start": 21.64,
  "end": 24.48,
  "text": " No ban, Sony and Xbox just stopped selling there."
 },
 {
  "start": 25.06,
  "end": 26.14,
  "text": " Number three, China."
 },
 {
  "start": 26.72,
  "end": 29.02,
  "text": " Every foreign game needs a government license."
 },
 {
  "start": 29.02,
  "end": 31.76,
  "text": " GTA 6 doesn't have one."
 },
 {
  "start": 32.32,
  "end": 34.42,
  "text": " But the last two get weirder."
 },
 {
  "start": 34.9,
  "end": 36.06,
  "text": " Number two, the golf."
 },
 {
  "start": 36.92,
  "end": 39.16,
  "text": " Kuwait, Qatar, Bahrain, Oman."
 },
 {
  "start": 39.68,
  "end": 40.76,
  "text": " It's not even on PlayStation."
 },
 {
  "start": 41.5,
  "end": 42.5,
  "text": " No ban announced."
 },
 {
  "start": 42.78,
  "end": 43.82,
  "text": " It's just missing."
 },
 {
  "start": 44.54,
  "end": 46.06,
  "text": " Number one, Tajikistan."
 },
 {
  "start": 46.62,
  "end": 50.16,
  "text": " In 2024, the government banned every GTA game."
 },
 {
  "start": 50.88,
  "end": 53.42,
  "text": " Police even announced raids on gaming clubs."
 },
 {
  "start": 53.94,
  "end": 54.88,
  "text": " And Counter Strike?"
 },
 {
  "start": 55.5,
  "end": 55.94,
  "text": " Banned too."
 },
 {
  "start": 55.94,
  "end": 57.86,
  "text": " So, which one shocked you most?"
 },
 {
  "start": 58.18,
  "end": 59.26,
  "text": " Because honestly..."
 }
]