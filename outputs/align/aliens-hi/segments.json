[
 {
  "start": 0.0,
  "end": 5.02,
  "text": " \u0915\u094d\u092f\u093e \u092f\u0947 \u0906\u0932\u094d\u092f\u0947\u0902\u091c \u0928\u0947 \u092c\u0928\u093e\u092f\u093e \u091a\u093e\u0930 \u091c\u0917\u0947\u0902, \u091c\u093f\u0928 \u092a\u0930 \u0932\u094b\u0917 \u0906\u091c \u092d\u0940 \u092c\u0939\u0947\u0902\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902."
 },
 {
