 {
  "start": 17.47,
  "end": 22.490000000000002,
  "text": " \u0907\u0938\u0940 \u0932\u093f\u090f 2017 \u092e\u0947\u0902 \u0905\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0928\u0947 \u0915\u0941\u0926\u0915\u094b \u0928\u0915\u094d\u0937\u0947 \u092a\u0930 1.8 \u092e\u0940\u091f\u0930 \u0915\u093f\u0938\u0915\u093e \u0926\u093f\u092f\u093e"
 },
 {
  "start": 22.69,
  "end": 25.650000000000002,
  "text": " \u0915\u0939\u0940 \u0915\u093f\u0938\u0940 \u092e\u0948\u092a \u0906\u092a\u0928\u0947 \u0915\u0939\u093e, \u092b\u093f\u0930\u0938\u0947 \u0932\u093f\u0915\u093e\u0932\u094d\u0915\u0942\u0932\u0947\u091f\u093f\u0902"
 },
 {
  "start": 25.650000000000002,
  "end": 27.79,
  "text": " \u0924\u094b \u0907\u0924\u0928\u093e \u092c\u0921\u093c\u093e \u0926\u0947\u0936 \u092a\u093e\u0930 \u0915\u0948\u0938\u0947 \u0915\u0930\u0947\u0902?"
 },
 {
  "start": 28.21,
  "end": 28.87,
  "text": " \u0909\u0920 \u092e\u0902\u0935\u093e\u0913!"
 },
 {
  "start": 29.05,
  "end": 35.03,
  "text": " \u0915\u092e \u0938\u0947 \u0915\u092e 15,000 \u0909\u0926\u093e\u092f, \u091c\u093c\u093e\u0926\u093e\u0924\u0930 \u092c\u094d\u0930\u093f\u0924\u093f\u0937 \u0906\u0928\u094d\u0926\u093f\u092f\u093e \u0938\u0947, \u092b\u093f\u091f\u094d\u0930\u093e\u0915\u093e \u0917\u092f, \u0914\u0930 \u0909\u0926 \u0906\u091c\u093e \u091a\u094b\u0930 \u0926\u093f\u092f\u0947 \u0917\u092f."
 },
 {
  "start": 35.23,
  "end": 38.169999999999995,
  "text": " \u0906\u091c \u092f\u0939\u093e\u0902 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0938\u092c \u0938\u0947 \u092c\u0921\u093c\u093e \u091c\u0902\u0917\u0932\u0940 \u0909\u091f\u094b \u0915\u093e \u091c\u0941\u0928\u094d\u0926 \u0939\u0948"
 },
 {
  "start": 38.169999999999995,
  "end": 40.449999999999996,
  "text": " \u0914\u0930 \u092f\u0947 \u0938\u093e\u0926\u093f\u092f\u093e \u0930\u0947\u092d\u094d\u092f\u093e \u0924\u0915\u0941\u091f \u092c\u0939\u093f\u091f \u091a\u0941\u0915\u093e \u0939\u0948"
 },
 {
  "start": 40.449999999999996,
  "end": 43.169999999999995,
  "text": " \u0930\u0947\u092d\u093f\u0938\u094d\u091f\u093e\u0928 \u0938\u0947 \u0930\u0947\u0917\u093f\u0938\u094d\u091f\u093e\u0928 \u092c\u093f\u0938\u0928\u093f\u0938 \u0916\u0932\u093e\u0938 \u092e\u0947\u0902"
 },
 {
  "start": 43.3,
  "end": 50.3,
  "text": " \u0932\u093f\u0915\u093f\u0928 \u092d\u0947\u0921 \u092a\u093e\u0932\u0928\u0947\u0935\u093e\u0932\u094b \u0915\u093e \u0906\u0938\u094d\u091f\u0940 \u0926\u0941\u0937\u094d\u092e\u0928 \u0924\u093e \u0926\u093f\u0902\u0917\u094b, \u0924\u094b \u0909\u0928\u0939\u094b\u0928\u0947 \u092d\u093e\u0930 \u092c\u0928\u093e\u0908, 5,614 km \u0932\u0902\u092d\u0940."
 },
 {
  "start": 52.07,
  "end": 57.25,
  "text": " \u092c\u093e\u0930 \u0928\u0947 \u0915\u0941\u0927\u094d\u0924\u094b\u0902 \u0915\u094b \u0930\u094b\u0915\u093e, \u092a\u0930 \u0907\u092e\u094d\u092f\u0942 \u0935\u094b \u0924\u094b \u092c\u0938 \u0916\u0942\u0938\u093e\u090f, \u0928\u0935\u0947\u092e\u092c\u0930 1932"
 },
 {
  "start": 57.56,
  "end": 60.34,
  "text": " \u0915\u0930\u0940\u092c 20,000 \u0907\u092e\u094d\u092f\u0941 \u0917\u0947\u0939\u0941 \u0915\u0947 \u0916\u0947\u0924\u094b \u092a\u0930 \u0924\u0942\u091f \u092a\u0921\u0947,"
 },
 {
  "start": 60.64,
  "end": 64.86,
  "text": " \u0924\u094b \u0905\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e\u0928\u0947 \u092d\u0947\u091c\u0940, \u092b\u094b\u091c, \u0926\u094b \u092e\u0936\u0940\u0902\u0917\u0928, 10,000 \u0917\u094b\u0932\u093f\u092f\u093e."
 },
 {
  "start": 65.02,
  "end": 67.88,
  "text": " \u092a\u093e\u091a \u0939\u092c\u0924\u0947 \u092c\u093e\u0926 \u092b\u094b\u091c\u0940 \u0917\u0930 \u0932\u094b\u091f\u0917\u0917\u0947, \u090f\u092e\u094d\u092f\u0942 \u0935\u0939\u0940 \u0930\u0939\u0947."
 },
 {
  "start": 68.22,
  "end": 71.53999999999999,
  "text": " \u0914\u0938\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u092e\u0947\u0902 \u091c\u092e\u0940\u0928 \u0907\u0924\u0928\u0940 \u092c\u0921\u093c\u0940 \u0939\u0948, \u0915\u093f \u0928\u093f\u092f\u092e \u091c\u093e\u0928\u0935\u0930 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948."
 },
 {
  "start": 71.74,
  "end": 77.64,
  "text": " \u0914\u0930 \u0907\u092e\u094d\u092f\u0941, 1932 \u0938\u0947 \u0905\u092a \u0926\u0915 \u0905\u091c\u0947\u092f \u0939\u0948, \u0924\u094b \u0939\u093e\u0901, \u0906\u092a \u0938\u091a \u092e\u0947\u0902 \u090f\u0915 \u092a\u0915\u094d\u0937\u0940 \u0938\u0947 \u091c\u0902\u0917 \u0939\u093e\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902."
 },
 {
  "start": 77.64,
  "end": 80.83999999999999,
  "text": " \u092f\u0939 \u0939\u0948 \u092d\u0941\u0917\u094b\u0932, \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u093f\u0926\u093e\u0930 \u091c\u094b\u0917\u0930\u092b\u0940 \u092b\u0948\u0915\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u093e\u0932\u094b \u0915\u0930\u0947\u0902."
 }
