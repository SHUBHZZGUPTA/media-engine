[
 {
  "start": 0.0,
  "end": 3.0,
  "text": " \u0905\u0917\u0930 \u0905\u0930\u094d\u091c\u0928\u094d\u091f\u093f\u0928\u093e \u0914\u0930\u0941\u0917\u0935\u0947 \u090f\u0915 \u0926\u0947\u0936 \u092c\u0928 \u091c\u093e\u090f\u0902\u0964"
 },
 {
  "start": 3.0,
  "end": 6.08,
  "text": " \u0924\u0942\u0907\u0938\u094d\u091f \u092f\u0947 \u0939\u0948 \u0915\u0947 \u092f\u0942\u0930\u0941\u0917\u0935\u0947 \u0928\u0947 \u0916\u094b\u0926\u093f\u0938 \u0915\u0947 \u0932\u093f\u090f \u0935\u094b\u091f \u0915\u093f\u092f\u093e \u0924\u093e"
 },
 {
  "start": 6.9,
  "end": 10.78,
  "text": " 1825 \u092e\u0947\u0902 \u092f\u0942\u0930\u0941\u0917\u0935\u0947 \u0915\u0940 \u0915\u0941\u0901\u0930\u093f\u0938 \u0928\u0947 \u0915\u093e\u0939\u093e, \u0939\u092e \u0906\u0930\u094d\u091c\u0928\u094d\u091f\u093f\u0928\u093e \u092e\u0947\u0902 \u092e\u093f\u0932\u0947\u0902\u0917\u0947"
 },
 {
  "start": 11.32,
  "end": 12.96,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092c\u094d\u0930\u091c\u0940\u0932 \u092d\u0940 \u091c\u0947 \u091a\u093e\u0924\u093e \u0925\u093e"
 },
 {
  "start": 12.96,
  "end": 17.28,
  "text": " \u0924\u094b \u091c\u0902\u0916 \u091a\u0921\u093c\u0917\u0917, \u092b\u093f\u0930 \u092c\u094d\u0930\u093f\u091f\u0947\u0928 \u092d\u0940\u091a \u092e\u0947\u0902 \u0906\u092f\u093e \u0914\u0930 \u092c\u0941\u0932\u093e \u0907\u0938\u0947 \u092c\u092b\u0930 \u0926\u0947\u0936 \u092c\u0928\u093e\u0926\u094b."
 },
 {
  "start": 17.74,
  "end": 21.88,
  "text": " \u0924\u094b 1828 \u092e\u0947\u0902 \u092f\u0942\u0930\u0941\u0917\u0935\u0947\u0935\u0928\u093e, \u0924\u094b \u0926\u093f\u0917\u0917\u091c\u094b\u0902 \u0915\u094b \u0905\u0932\u0917 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f."
 },
 {
  "start": 22.34,
  "end": 23.54,
  "text": " \u0924\u094b \u092f\u0939 \u0926\u0947\u0936 \u0915\u094d\u092f\u093e \u092a\u093e\u090f\u0930\u093e?"
 },
 {
  "start": 24.36,
  "end": 28.38,
  "text": " 49,000,000,000 \u0932\u094b\u0917 \u0914\u0930 \u092a\u0942\u0930\u0940 \u0930\u093f\u092f\u094b \u0926\u0947\u0932\u093e \u092a\u094d\u0932\u093e\u0924\u093e"
 },
 {
  "start": 28.38,
  "end": 32.42,
  "text": " 2 \u0915\u093e\u092a\u093f\u0924\u0932\u094d\u0938, \u090f\u0915 \u0924\u0941\u0938\u0930\u0947 \u0915\u094b \u092c\u0942\u0930\u094d\u0924\u0940 \u0939\u0941\u0908 \u090f\u0915 \u0930\u093f\u0935\u0930 \u0915\u0947 \u092a\u093e\u0930"
 },
 {
  "start": 32.42,
  "end": 35.16,
  "text": " \u0932\u093f\u0915\u093f\u0928 \u091c\u0940 \u0905\u092d\u0940 \u0938\u092c \u0938\u0947 \u0906\u091c\u0940\u092c \u0906\u091c\u0940\u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948"
 },
 {
  "start": 35.16,
  "end": 38.36,
  "text": " 1930 \u092e\u0947\u0902 \u0926\u094b\u0928\u094b \u0915\u0947\u0932\u0947 \u092a\u0939\u0932\u093e \u0935\u094b\u0932\u094d\u0917\u092c, \u092b\u093e\u0907\u0928\u0932"
 },
 {
  "start": 38.36,
  "end": 41.24,
  "text": " \u091c\u0917\u094d\u0921\u093e \u0939\u0942\u0901\u0906 \u0915\u093f \u0915\u093f\u0938 \u0915\u0940 \u092c\u0939\u0941\u0932 \u091a\u0930\u0947\u0917\u0940"
 },
 {
  "start": 41.24,
  "end": 48.32,
  "text": " \u0924\u094b \u0926\u094b\u0928\u094b\u0902 \u0915\u0940 \u092c\u093e\u0932 \u0938\u0947 \u090f\u0915 \u090f\u0915 \u0939\u093e\u092a \u0916\u0947\u0932\u093e \u0917\u092f\u093e, \u092f\u094b\u0930\u0941\u0917\u0935\u0947\u0908 \u091c\u0940\u0924\u093e \u092b\u094b\u0921 \u0924\u0942 \u0914\u0930 \u0905\u0917\u0932\u0947 \u0926\u093f\u0928 \u0928\u0936\u094d\u091b\u0928\u0932 \u0939\u094b\u0932\u093f\u091f\u0947 \u0939\u094b\u0917\u0924\u0947 \u0939\u094b\u0917\u0917\u0947\u090f."
 },
 {
  "start": 48.7,
  "end": 52.42,
  "text": " \u0905\u0930 \u0916\u092c\u0924\u0932, \u092c\u0921\u093c\u093e\u0938\u093e \u092c\u0942\u0928\u094d\u092f\u094b \u0938\u0947\u0930\u0940\u0938 \u092f\u093e \u091a\u093f\u0932\u094d\u092e \u092e\u094b\u0902\u091f\u0940 \u0935\u093f\u0930\u0947\u0908\u094b."
 },
 {
  "start": 52.42,
  "end": 56.9,
  "text": " \u0909\u0930\u0941\u0917\u0935\u0947 \u0915\u093e \u091c\u092c\u093e\u092c, \u0939\u092e \u091a\u094b\u091f\u0947 \u0939\u0948, \u092a\u0930 \u0935\u0932 \u0915\u092c \u092a\u0939\u0932\u0947 \u0939\u092e \u0928\u0947 \u091c\u0940\u0924\u093e."
 },
 {
  "start": 57.5,
  "end": 59.8,
  "text": " \u0924\u094b \u090f\u0915 \u0926\u0947\u0936\u093f\u092f \u0926\u094b, \u0915\u094d\u092f\u094b\u0902\u0915\u0940 \u0938\u091a \u092a\u0924\u093e \u0939\u0942\u0901?"
 }
]