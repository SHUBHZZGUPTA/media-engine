[
 {
  "start": 0.0,
  "end": 5.3,
  "text": " \u0907\u0938 \u091a\u091f\u094d\u091f\u093e\u0928 \u092a\u0930 \u0916\u0921\u0947 \u0939\u094b \u091c\u093e\u0913, \u0914\u0930 \u0906\u092a \u090f\u0915 \u0938\u093e\u0925 \u0926\u094b \u0926\u0947\u0936\u094b\u0902 \u0914\u0930 \u0926\u094b \u0924\u093e\u090f\u092e \u091c\u094b\u0902\u091c \u092e\u0947\u0902 \u0939\u094b."
 },
 {
  "start": 5.8,
  "end": 8.8,
  "text": " \u090f\u0915 \u0915\u0926\u092e \u0914\u0930 \u0917\u0921\u0940 \u090f\u0915 \u0917\u0928\u094d\u0924\u093e \u092c\u0921\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948."
 },
 {
  "start": 9.15,
  "end": 15.030000000000001,
  "text": " \u0906\u0926\u0940 \u0938\u094d\u0935\u0940\u0921\u0928, \u0906\u0926\u0940 \u092b\u093f\u0928\u0932\u093f\u0928\u094d\u091f, \u0914\u0930 \u092d\u093e\u0921\u0930 \u0906\u091c\u094d\u0938\u0947 \u092e\u0941\u0921\u093c\u093e\u092f \u091c\u0948\u0938\u0947 \u092c\u0939\u0941\u0924 \u091c\u093e\u0926\u093e \u0915\u094b\u092b\u0940 \u092a\u0940\u0932\u0940 \u0939\u094b"
 },
 {
  "start": 15.32,
  "end": 19.740000000000002,
  "text": " \u092f\u0947 \u0939\u0948 \u092e\u0930\u0915\u0947\u091f \u0924\u094d\u0930\u0940 \u092b\u093f\u0937\u094d\u091f\u0940 \u092e\u0940\u091f\u0930 \u0915\u0940 \u0928\u0902\u0917\u0940 \u091a\u091f\u094d\u091f\u093e\u0928"
 },
 {
  "start": 19.740000000000002,
  "end": 21.8,
  "text": " \u0928\u093e \u092a\u0947\u0921 \u0928\u093e \u0932\u094b\u0917"
 },
 {
  "start": 21.8,
  "end": 22.26,
  "text": " \u092c\u0938"
 },
 {
  "start": 22.51,
  "end": 25.110000000000003,
  "text": " \u0938\u0940\u0932\u094d\u0938, \u0924\u094b \u092f\u0947 \u0917\u0926\u092c\u0917 \u0915\u093f\u0938\u094d\u0928\u0947 \u0915\u0940"
 },
 {
  "start": 25.110000000000003,
  "end": 30.35,
  "text": " \u091a\u0932\u094b, 1809 \u092e\u0947\u0902, \u0938\u094d\u0935\u0940\u091f\u0928 \u0932\u0947 \u092b\u093f\u0928\u0932\u0947\u0902 \u0915\u094b \u0930\u0936\u094d\u092f\u0928 \u0906\u092e\u092a\u093e\u0930 \u0915\u0947 \u0939\u093e\u0924\u094b\u0902, \u0915\u094b \u0926\u093f\u092f\u093e?"
 },
 {
  "start": 30.61,
  "end": 34.71,
  "text": " \u0928\u092f\u093e \u092c\u094b\u0921\u093c\u0930 \u090f\u0915 \u0938\u0940\u0926\u0940 \u0932\u093e\u0908\u0928 \u0924\u0940\u0915 \u0907\u0938 \u091a\u091f\u093e\u0928 \u0915\u0947 \u092c\u0940\u091b \u0938\u0947"
 },
 {
  "start": 34.71,
  "end": 39.61,
  "text": " \u092b\u093f\u0930 1885 \u092e\u0947\u0902 \u092b\u093f\u0902\u0932\u093f\u0902\u091f \u0928\u0947 \u0938\u092c\u0938\u0947 \u0939\u0941\u0901\u091a\u0940 \u091c\u0917\u093e\u092a\u0930 \u0932\u093e\u0908\u091f\u093e\u0909\u0938 \u092e\u0928\u093e\u092f\u093e"
 },
 {
  "start": 39.8,
  "end": 41.66,
  "text": " \u092a\u0942\u0930\u0947 2 \u092e\u0940\u091f\u0930 \u0909\u091a\u0940"
 },
 {
  "start": 41.66,
  "end": 43.12,
  "text": " \u091a\u094b \u091f\u0940\u0938\u0940 \u0926\u093f\u0916\u0915\u0924"
 },
 {
  "start": 43.12,
  "end": 44.76,
  "text": " \u0935\u094b \u091c\u0917\u093e \u0938\u094d\u0935\u0940\u0926\u0947\u0928 \u092e\u0947\u0924\u0940"
 },
 {
  "start": 44.76,
  "end": 46.78,
  "text": " \u0938\u094d\u0935\u0940\u0926\u0947\u0928 \u0939\u0941\u0937 \u0928\u0939\u0940\u0902 \u0926\u093e"
 },
 {
  "start": 47.05,
  "end": 49.769999999999996,
  "text": " \u0914\u0930 \u0932\u093e\u0908\u091f\u093e\u0909\u0938, \u092e\u0941\u0938\u0947 \u092c\u0938 \u0935\u093f\u0935 \u092a\u0938\u0928 \u0924\u093e."
 },
 {
  "start": 50.089999999999996,
  "end": 53.05,
  "text": " \u0914\u0930 \u0935\u094b \u0930\u0939\u0928\u094d\u0930\u0947\u091f \u0938\u093e\u0932 \u0924\u0915 \u0917\u0932\u093e \u0926\u0947\u0936 \u092e\u0947\u0902 \u0915\u0921\u093c\u093e\u0930\u093e."
 },
 {
  "start": 53.37,
  "end": 55.51,
  "text": " \u0914\u0930 \u0907\u0938\u0915\u093e \u0939\u0932 \u0914\u0930 \u092d\u0940 \u0906\u091c\u0940\u092c \u0939\u0948"
 },
 {
  "start": 55.51,
  "end": 58.89,
  "text": " 1985 \u092e\u0947\u0902 \u0932\u093e\u0907\u091f \u0939\u093e\u0901 \u0938\u0924\u093e\u0928\u0947 \u0915\u0940 \u091c\u0917\u093e"
 },
 {
  "start": 58.89,
  "end": 60.41,
  "text": " \u0909\u0928\u094b \u0928\u0947 \u092c\u094b\u0921\u093c\u0930\u0940 \u0906\u0926\u093e \u0926\u093f\u092f\u093e"
 },
 {
  "start": 60.74,
  "end": 65.14,
  "text": " \u0905\u092c \u092c\u094b\u0921\u0930 \u0924\u093e\u0935\u0930 \u0915\u0940 \u091a\u093e\u0930\u094b\u0902 \u0914\u0930 \u092b\u094b\u0930 \u090f\u091f\u094d\u091f\u0940 \u092e\u0940\u091f\u0930 \u0915\u093e \u0906\u0938 \u092c\u0928\u093e\u0924\u093e \u0939\u0948"
 },
 {
  "start": 65.14,
  "end": 66.86,
  "text": " \u092b\u093f\u0928\u0932\u0947\u0902\u091f \u0915\u094b \u0932\u093e\u0907\u091f\u093e\u0909\u0938 \u092e\u093f\u0932\u093e"
 },
 {
  "start": 66.86,
  "end": 69.08,
  "text": " \u0914\u0930 \u0938\u094d\u0935\u0940\u0921\u0928 \u0915\u094b \u0909\u0924\u0928\u0940 \u0939\u0940 \u091c\u092e\u0940\u0928 \u0935\u093e\u092a\u093f\u0938"
 },
 {
  "start": 69.08,
  "end": 73.26,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u093e\u0926 \u0930\u0939\u094b, \u0938\u094d\u0935\u0940\u0921\u0928 \u0915\u093e \u0924\u093e\u0908\u092e \u092b\u093f\u0928\u0932\u0947\u0902\u091f \u0938\u0947 \u090f\u0915 \u0917\u0928\u094d\u0924\u093e \u092a\u0940\u0937\u0947 \u0939\u0948"
 },
 {
  "start": 73.47,
  "end": 77.19,
  "text": " \u0924\u094b \u0907\u0938 \u0932\u093e\u0908\u0928 \u0915\u0947 \u0906\u0930 \u092a\u093e\u0930\u0915\u0942\u0926\u094b \u0914\u0930 \u0924\u093e\u0908 \u092e\u0947\u0902 \u0906\u0917\u0947 \u092a\u0940\u091a\u0947 \u0939\u094b\u0924\u0947 \u0930\u0939\u094b."
 },
 {
  "start": 77.61,
  "end": 80.71,
  "text": " \u0938\u094d\u0935\u0940\u0921\u0928 \u0915\u093e \u090f\u0928\u093e, \u090f\u0915 \u0917\u0902\u0924\u093e \u091c\u093e\u0926\u093e \u0928\u0940\u0902\u0926."
 },
 {
  "start": 81.17,
  "end": 84.85,
  "text": " \u0924\u094b \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u0915\u094b\u0908 \u0915\u0939\u0947, \u0915\u093f \u0906\u092a \u090f\u0915 \u0938\u093e\u0925 \u0926\u094b \u091c\u0917\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u0947."
 }
