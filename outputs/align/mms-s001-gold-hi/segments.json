[
 {
  "start": 0.0,
  "end": 4.06,
  "text": " \u0906\u092a\u0915\u093e \u0938\u0947\u092b \u0939\u0947\u0935\u0928 \u0905\u092a\u0928\u0947 \u0930\u0947\u0915\u094b\u0921\u093c \u0938\u0947 28% \u0917\u093f\u0930 \u091a\u0941\u0915\u093e \u0939\u0948"
 },
 {
  "start": 4.06,
  "end": 6.76,
  "text": " \u0935\u094b \u092d\u0940 \u091c\u0902\u0917 \u0915\u0940 \u092c\u0940\u091a, \u0917\u094b\u0932\u094d\u091f \u0915\u094d\u092f\u094b \u0917\u093f\u0930 \u0930\u0939\u093e \u0939\u0948"
 },
 {
  "start": 6.76,
  "end": 11.5,
  "text": " \u0907\u0938 \u0939\u092c\u0924\u0947 \u0938\u093e\u0909\u0926\u0940 \u0913\u092f\u0932 \u092a\u0930 \u0939\u092e\u0932\u094b\u0902 \u0938\u0947 \u092c\u094d\u0930\u0947\u0902\u091f \u0915\u094d\u0930\u0942\u0921 \u0930\u0939\u093e \u0939\u0902\u091f\u0930\u094d\u0926\u0947\u0902 12 \u0921\u094b\u0932\u0930 \u092a\u0939\u0941\u091c \u0917\u092f\u093e"
 },
 {
  "start": 11.5,
  "end": 12.88,
  "text": " \u0938\u094d\u091f\u094b\u0915\u094d\u0938 \u092b\u093f\u0938\u0932 \u0930\u0939\u0947 \u0939\u0948"
 },
 {
  "start": 12.88,
  "end": 16.06,
  "text": " \u0914\u0930\u093e\u092e \u0938\u0947 \u0905\u092c \u092e\u0947\u0930\u093e \u0924\u093e\u0908\u092e \u0939\u0948"
 },
 {
  "start": 18.58,
  "end": 22.6,
  "text": " \u0924\u094b \u092f\u0947 \u0926\u093e\u0932 \u0924\u0940\u0915 \u0924\u092d\u0940 \u0915\u094d\u092f\u094b \u0924\u094b\u0921\u093c\u0924\u0940 \u0939\u0948, \u091c\u092c \u091c\u0930\u0941\u0921\u093c\u0924 \u0939\u094b?"
 },
 {
  "start": 23.1,
  "end": 25.1,
  "text": " \u092a\u0939\u0932\u0940 \u092c\u093e\u0924, \u0917\u094b\u0932\u094d\u0921 \u0906\u092a \u0915\u094b \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e."
 },
 {
  "start": 25.44,
  "end": 27.82,
  "text": " \u092f\u0942\u090f \u0938\u0930\u0915\u093e\u0930 \u0915\u093e \u092c\u093e\u0923\u094d\u0921 \u0915\u0930\u0940 \u092a\u094d\u0935\u0940\u092c \u092a\u0930\u0938\u0902\u091f \u0926\u0947\u0924\u093e \u0939\u0948."
 },
 {
  "start": 28.28,
  "end": 31.42,
  "text": " \u0905\u0908\u0932 \u092e\u0924\u0932\u092c \u0907\u0928\u094d\u092b\u0932\u0947\u0936\u0928, \u0907\u0928\u094d\u092b\u0932\u0947\u0936\u0928 \u092e\u0924\u0932\u092c \u0930\u0947\u091f\u094d\u0938 \u0909\u091a\u0947"
 },
 {
  "start": 31.42,
  "end": 33.44,
  "text": " \u0914\u0930 \u0916\u093e\u0932\u0940 \u091a\u0940\u091c\u093c \u0930\u0916\u0928\u093e \u092e\u0947\u0902\u0917\u093e \u092a\u0930\u0924\u093e \u0939\u0948"
 },
 {
  "start": 33.44,
  "end": 36.34,
  "text": " \u091c\u093c, \u092a\u0939\u0932\u0940 \u092c\u093e\u0930, \u0915\u093e\u0917\u0938 \u091c\u0940\u0924\u093e"
 },
 {
  "start": 36.34,
  "end": 41.16,
  "text": " \u0926\u0942\u0938\u0930\u0940 \u092c\u093e\u0924, \u0938\u094d\u091f\u094b\u0915\u094d\u0938 \u0917\u093f\u0930\u0947\u0902 \u0924\u094b \u0932\u094b\u0917 \u0935\u094b \u092c\u0940\u091a\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u092c\u093f\u0915\u0947, \u0935\u094b \u0928\u0939\u0940\u0902 \u091c\u094b \u092a\u0938\u0902\u0926 \u0939\u094b"
 },
 {
  "start": 41.16,
  "end": 42.86,
  "text": " \u0917\u094b\u0932\u094d\u0921 \u092c\u0928\u0924\u093e \u0939\u0948 \u090f\u091f\u0940\u092e"
 },
 {
  "start": 43.42,
  "end": 46.42,
  "text": " \u092f\u0939\u0940 \u0939\u0948 \u092e\u093f\u0930\u093e\u091c, \u0917\u094b\u0932\u094d\u0921 \u0915\u094d\u0930\u093f\u0938\u093f\u0938 \u0915\u0940 \u0921\u093e\u0932 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 46.42,
  "end": 48.5,
  "text": " \u092f\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0924\u0930 \u0926\u093e\u0935 \u0939\u0948 \u0915\u0940 \u0930\u0947\u091f\u094d\u0938 \u0917\u093f\u0930\u093f\u0902\u0917\u0947"
 },
 {
  "start": 48.5,
  "end": 50.86,
  "text": " \u0924\u094b \u091c\u092c \u0915\u094d\u0930\u0940\u0938\u093f\u0938 \u0930\u0947\u091f\u094d\u0938 \u0909\u092a\u0930 \u0926\u06be\u0916\u0940\u0932\u0947"
 },
 {
  "start": 50.86,
  "end": 53.32,
  "text": " \u0906\u092a\u0915\u093e \u0938\u0940\u092b \u0939\u0940\u0935\u0928, \u0938\u0940\u092b \u0928\u0939\u0940\u0902"
 },
 {
  "start": 53.32,
  "end": 56.06,
  "text": " \u092e\u093e\u0917\u093f\u0930 \u0928\u0939\u0940\u0902 \u0930\u0939\u093e, \u0914\u0930\u093e\u092e \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0902"
 },
 {
  "start": 56.66,
  "end": 59.5,
  "text": " \u092f\u0947 \u0939\u0948 \u092e\u0928\u0940 \u092e\u093f\u0930\u093e\u091c, \u0906\u091c\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u094b \u0915\u093f \u0932\u093f\u090f \u092b\u094b\u0932\u094b \u0915\u0930\u0947\u0902"
 }
]