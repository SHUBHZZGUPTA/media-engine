 },
 {
  "start": 96.0,
  "end": 98.0,
  "text": " \u0914\u0930 \u0906\u0916\u093f\u0930 \u092e\u0947\u0902 \u0909\u0928\u094d\u0939\u0947\u0902 \u0909\u0928\u0915\u093e \u0930\u093e\u0936\u0923 \u092e\u093f\u0932 \u0917\u094d\u092f\u093e"
 },
 {
  "start": 98.78,
  "end": 100.62,
  "text": " Unions notes \u092c\u0928\u093e \u0932\u093f\u091c\u0947"
 },
 {
  "start": 100.62,
  "end": 103.9,
  "text": " Ancient Egyptians \u0906\u092a \u0938\u0947 \u092c\u0939\u0932\u0947 \u0935\u093e\u0939\u093e\u0901 \u091a\u0941\u0915\u0947 \u0925\u0947"
 },
 {
  "start": 103.9,
  "end": 105.78,
  "text": " Fact number 6"
 },
 {
  "start": 105.78,
  "end": 108.0,
  "text": " \u0915\u093e\u0908\u0930\u094b \u092e\u0940 \u0932\u094b\u0917 \u090f\u0915 \u0915\u092c\u094d\u0930\u093f\u0938\u094d\u0924\u093e\u0928 \u092e\u0947\u0902 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 108.92,
  "end": 110.7,
  "text": " \u0907\u0938\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 City of the Dead"
 },
 {
  "start": 110.7,
  "end": 112.74,
  "text": " \u090f\u0915 \u0935\u093f\u0936\u093e\u0932 \u0928\u093f\u0915\u094d\u0930\u094b\u092a\u0932\u093f\u0938"
 },
 {
  "start": 112.74,
  "end": 114.4,
  "text": " \u0915\u0908 \u0915\u093f\u0932\u094b\u092e\u0947\u091f\u0930 \u0932\u0902\u092c\u093e"
 },
 {
  "start": 114.4,
  "end": 117.26,
  "text": " \u0914\u0930 \u090f\u0915 \u0939\u091c\u093e\u0930 \u0938\u093e\u0932 \u0938\u0947 \u092d\u0940 \u091c\u093e\u0926\u093e \u092a\u0942\u0930\u093e\u0928\u093e"
 },
 {
  "start": 117.26,
  "end": 121.16,
  "text": " \u0914\u0930 \u0915\u092c\u094d\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091c \u0916\u0930 \u0939\u0948\u0902, \u092a\u0930\u093f\u0935\u093e\u0930 \u0939\u0948\u0902, \u0926\u0941\u0915\u093e\u0928\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 121.16,
  "end": 124.54,
  "text": " \u092f\u0939\u093e\u0902 \u0924\u0915 \u0915\u0940 \u090f\u0915 \u092a\u094b\u0938\u094d\u091f \u0906\u092b\u093f\u0938 \u092d\u0940 \u0938\u0939\u0940 \u0917\u093f\u0928\u0924\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e"
 },
 {
  "start": 124.54,
  "end": 131.86,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u0905\u0928\u094d\u0926\u093e\u091c\u093e \u0939\u0948 \u0915\u093f \u0915\u0930\u0940\u092c 180,000 \u0938\u0947 \u0932\u0947\u0915\u0930 5,00,000 \u0924\u0915 \u0932\u094b\u0917 \u0915\u092c\u094d\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091c \u0930\u0939\u0924\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 131.86,
  "end": 134.22,
  "text": " \u0924\u0942\u092e\u094d\u0938 \u092e\u0947\u0902 \u0930\u0939\u0928\u093e officially allowed \u092d\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948"
 },
 {
  "start": 134.22,
  "end": 135.58,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u0941\u091b \u0924\u0942\u092e\u094d\u0938"
 },
