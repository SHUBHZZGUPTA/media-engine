 {
  "start": 69.62,
  "end": 71.18,
  "text": " FACT NUMBER 7"
 },
 {
  "start": 71.18,
  "end": 79.12,
  "text": " \u0924\u094b \u0915\u0930\u0940\u092a 1157 \u092c\u0940\u0938\u0940 \u092e\u0947\u0902 \u092b\u0947\u0930\u094b \u0930\u093e\u092e\u094d\u0938\u093f\u0938 \u0924\u0947 \u0925\u0930\u094d\u091f \u0915\u0947 \u091c\u092e\u093e\u0928\u0947 \u092e\u0947\u0902 \u0909\u0928\u0939\u094b\u0902\u0928\u0947 \u0906\u0909\u091c\u093e\u0930 \u0928\u093f\u091a\u0947 \u0930\u0916\u0947 \u0914\u0930 \u0915\u093e\u092e \u091b\u094b\u0921\u093c\u0915\u0930 \u0928\u093f\u0915\u0932 \u0917\u090f\u0964"
 },
 {
  "start": 79.12,
  "end": 83.88,
  "text": " \u0909\u0928\u0915\u093e \u092a\u094d\u0930\u094b\u0924\u0948\u0938\u094d\u091f \u090f\u0915 \u0938\u094d\u0915\u094d\u0930\u093e\u0907\u092c \u0928\u0947 \u0932\u093f\u0915\u094d\u0915\u0930 \u0930\u0916\u093e \u0914\u0930 \u0909\u0928\u0915\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0939\u092e \u092d\u0942\u0915\u0947 \u0939\u0948\u0902\u0964"
