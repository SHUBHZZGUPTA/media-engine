[
 {
  "start": 0.0,
  "end": 5.2,
  "text": " \u0906\u091c \u0930\u093e\u0924 \u092c\u094d\u0930\u093f\u091f\u0928 \u090f\u0915 \u090f\u0938\u0947 \u0906\u0926\u094d\u092e\u0940 \u0915\u094b \u091c\u0932\u093e\u0924\u093e \u0939\u0948, \u091c\u094b 16-06 \u092e\u0947\u0902 \u092e\u0930\u091a\u0941\u0915\u093e \u0924\u093e."
 },
 {
  "start": 5.38,
  "end": 11.48,
  "text": " 16-05 \u092e\u0947\u0902 13 \u0938\u093e\u091c\u093f\u0937 \u0915\u0930\u0924\u093e \u0939\u094b\u0928\u0947, \u092a\u093e\u0932\u0947\u092e\u093f\u0902\u091f \u0915\u0947 \u0928\u0940\u091a\u0947 \u0917\u0928 \u092a\u093e\u0905\u0921\u0930 \u0915\u0947 36 \u092c\u093e\u0930\u0932\u094d\u0938 \u091a\u093f\u092a\u093e\u090f."
 },
 {
  "start": 11.68,
  "end": 15.4,
  "text": " \u0915\u093f\u0902\u0915\u094b \u0909\u0921\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u090f\u0915 \u0917\u0941\u092e\u094d\u0928\u093e\u092e \u091a\u093f\u091f\u094d\u0920\u0940 \u0928\u0947 \u0909\u0928\u0915\u093e \u0930\u093e\u091c \u0916\u094b\u0932 \u0926\u093f\u092f\u093e."
 },
 {
  "start": 15.78,
  "end": 18.96,
  "text": " \u091a\u093e\u0930 \u0928\u0935\u0947\u0902\u092c\u0930 \u0915\u0940 \u0930\u093e\u0924, \u0917\u093e\u0930\u094d\u091f\u094d\u0938 \u0928\u0947 \u0917\u093e\u0908 \u092b\u094b\u0916\u094d\u0938 \u0915\u094b \u0938\u0947\u0932\u0930 \u092e\u0947\u0902 \u092a\u0915\u094d\u0930\u093e."
 },
 {
  "start": 19.24,
  "end": 23.42,
  "text": " \u092e\u093e\u091a\u093f\u0938 \u0915\u0947 \u0938\u093e\u0925, \u092a\u093e\u0932\u0947\u092e\u093f\u0928\u094d\u0924 \u0928\u0947 \u092a\u093e\u091a \u0928\u0935\u0947\u0902\u092c\u0930 \u0915\u094b \u0936\u0941\u0915\u094d\u0930\u093e\u0928\u093e \u092e\u0928\u093e\u0928\u0947 \u0915\u093e \u0926\u093f\u0928 \u092c\u0928\u093e \u0926\u093f\u092f\u093e."
 },
 {
  "start": 23.42,
  "end": 29.02,
  "text": " \u0915\u093e\u0928\u0941\u0928\u0928, \u0905\u0917\u0932\u0947 250 \u0938\u093e\u0932 \u0924\u0915, \u092c\u094b\u0928 \u092b\u093e\u092f\u0930, \u092b\u093e\u092f\u0930 \u0935\u0930\u094d\u0915\u094d\u0938, \u0914\u0930 \u0938\u092c\u0938\u0947 \u0909\u092a\u0930 \u091c\u0932\u0924\u093e \u0939\u0948 \u0917\u093e\u0908."
 },
 {
  "start": 29.22,
  "end": 33.8,
  "text": " \u092a\u0930 \u092b\u094b\u0915\u094d\u0938 \u0916\u0941\u0926 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u091c\u0932\u093e, \u0935\u094b \u092a\u093e\u0938\u0940 \u0915\u0947 \u0924\u0915\u094d\u0924\u093f\u0938\u0947 \u0915\u0941\u0926\u093e, \u0914\u0930 \u0909\u0938\u0915\u0940 \u0917\u0930\u094d\u0926\u0928 \u0924\u0942\u091f\u0917\u0917\u093e\u090f."
 },
 {
  "start": 34.04,
  "end": 37.64,
  "text": " \u0924\u0942\u0930 \u0939\u0928\u094d\u0930\u093f\u091f \u0938\u093e\u0932 \u0915\u0940 \u0906\u0924\u093f\u0937\u094d\u092c\u093e\u091c\u0940, \u0938\u093f\u0930\u094d\u092b \u0907\u0938\u0932\u0947 \u0915\u0940 \u090f\u0915 \u0906\u0926\u094d\u092e\u0940 \u092a\u0915\u094d\u0930\u093e \u0917\u092f\u093e,"
 },
 {
  "start": 37.839999999999996,
  "end": 40.66,
  "text": " \u0932\u0942\u0907\u0938, 17,000 \u0932\u094b\u0917\u094b\u0902 \u0915\u093e \u090f\u0915 \u091a\u094b\u091f\u093e \u0938\u093e \u0915\u0938\u094d\u092c\u093e,"
 },
 {
  "start": 40.66,
  "end": 46.32,
  "text": " \u091c\u0939\u093e\u0902 80,000 \u0924\u0915 \u0932\u094b\u0917 \u092a\u0942\u091b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 17 \u091c\u0932\u0924\u0947 \u0939\u0941\u090f \u0916\u094d\u0930\u094b\u0938\u093f\u0938 \u0926\u0942\u0928\u093f\u092f\u093e \u0915\u0940 \u092c\u093e\u0901\u0928 \u092b\u093e\u092f\u0930 \u0915\u093e\u092a\u093f\u091f\u0932."
 },
 {
  "start": 46.480000000000004,
  "end": 51.66,
  "text": " \u0914\u0930 \u0906\u091c \u092d\u0940 \u092a\u093e\u0932\u092e\u0947\u0902\u091f \u0915\u0947 \u0939\u0930 \u0938\u094d\u0924\u0947\u091f \u0905\u092a\u0928\u093f\u0902\u0917 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092f\u094b \u092e\u0947\u0902 \u0905\u092a \u0926\u0917\u093e\u091f \u0938\u0947\u0932\u0930\u094d\u0938 \u0915\u0940 \u0924\u0932\u093e\u0936\u0940 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902."
 },
 {
  "start": 51.66,
  "end": 52.64,
  "text": " \u0907\u0938\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e\u0930 \u091c\u094b\u0917\u0930\u094d\u092b\u0940 \u092a\u093e\u0915\u094d\u0924\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u0941\u0932\u094b \u0915\u0930\u0947\u0902"
 },
 {
  "start": 53.66,
  "end": 56.019999999999996,
  "text": " \u0905\u091c \u0930\u093e\u0926 \u092a\u0939\u0924\u0928\u0947 \u0935\u093e\u0932\u093e \u091a\u093f\u0930\u094d\u092b \u092e\u0947\u0939\u0941"
 },
 {
  "start": 56.019999999999996,
  "end": 57.04,
  "text": " \u092f\u0947 \u0939\u0948 \u092d\u0942\u0917\u094b\u0932"
 },
 {
  "start": 57.04,
  "end": 59.480000000000004,
  "text": " \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e\u0930 \u091c\u094b\u0917\u0930\u094d\u092b\u0940 \u092a\u093e\u0915\u094d\u0924\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u0941\u0932\u094b \u0915\u0930\u0947\u0902"
 }
