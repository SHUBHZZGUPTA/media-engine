[
 {
  "start": 0.0,
  "end": 2.24,
  "text": " \u0905\u092a\u0928\u0947 \u092e\u0948\u092a \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u091a\u094b\u0921\u093c\u094b"
 },
 {
  "start": 2.24,
  "end": 4.76,
  "text": " \u092f\u0947 \u092a\u093e\u091c \u092c\u094b\u0921\u0930 \u0928\u0915\u0932\u0940 \u0932\u0915\u0924\u0947\u0902"
 },
 {
  "start": 4.76,
  "end": 6.08,
  "text": " \u092a\u0930 \u0938\u092c \u0905\u0938\u0932\u0940 \u0939\u0948"
 },
 {
  "start": 6.08,
  "end": 10.0,
  "text": " \u0914\u0930 \u0928\u092e\u092c\u0930 \u0935\u093e\u0928, \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0917\u0930\u094b\u0902 \u0915\u0947 \u092d\u0940\u091a \u0938\u0947 \u0917\u0941\u091c\u0930\u0924\u093e \u0939\u0948"
 },
 {
  "start": 10.0,
  "end": 12.54,
  "text": " \u0928\u092e\u092c\u0930 \u092b\u093e\u091c, \u092a\u094b\u0908\u0902\u091f \u0930\u093e\u092c\u091f\u094d\u0938"
 },
 {
  "start": 12.54,
  "end": 14.14,
  "text": " \u092f\u0947 \u092f\u0942\u090f\u0938\u0947 \u092e\u0947\u0902 \u0939\u0948"
 },
 {
  "start": 14.14,
  "end": 17.3,
  "text": " \u092c\u0930 \u092f\u0939\u093e \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u090f\u0915 \u0932\u094b\u091f\u0940 \u0938\u0921\u093c\u0915 \u0915\u0928\u0921\u093c\u093e \u0938\u0947 \u0939\u094b\u0915\u0930 \u0906\u0924\u0940 \u0939\u0948"
 },
 {
  "start": 17.3,
  "end": 21.68,
  "text": " \u0924\u094b \u092c\u0921\u093c\u0947 \u092c\u091a\u094d\u091b\u0947 \u092c\u094b\u0921\u093c\u0930 \u092a\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0926\u093f\u0928 \u092e\u0947\u0902 \u091a\u093e\u0930 \u092c\u093e\u0930 \u092c\u0938 \u0916\u0942\u0932 \u0915\u0947 \u0932\u093f\u090f"
 },
 {
  "start": 21.68,
  "end": 28.24,
  "text": " \u0928\u092e\u094d\u092c\u0930 \u092b\u094d\u0930, \u092c\u094d\u092f\u0942 \u0938\u093f\u0902\u0917\u0947\u0928, \u090f\u0915 \u091c\u094b\u092e\u0928 \u0917\u093e\u0901, \u091c\u094b \u091a\u093e\u0930\u094b \u0924\u0930\u092b \u0938\u0947 \u0938\u094d\u0935\u093f\u091c\u094d\u091c\u0932\u0928\u094d\u0938\u0947 \u0917\u093f\u0930\u093e \u0939\u0948"
 },
 {
  "start": 28.24,
  "end": 30.72,
  "text": " \u092f\u0939\u093e\u0902, \u091c\u093e\u0921\u093c\u093e\u0924\u0930 \u0938\u094d\u0935\u093f\u0938\u094d\u091f\u094d\u0930\u0919\u0902\u0915 \u091a\u0932\u0924\u093e \u0939\u0948."
 },
 {
  "start": 30.96,
  "end": 32.64,
  "text": " \u0907\u0928\u0915\u0940 \u092b\u0941\u0926\u094d\u092c\u093e\u0932\u094d\u0924\u0940\u092e, \u0938\u094d\u0935\u093f\u0938\u094d\u0932\u0940\u0917 \u092e\u0947\u0902."
 },
 {
  "start": 32.92,
  "end": 36.34,
  "text": " \u0906\u092e\u092c\u0930 \u0924\u0930\u0940, \u090f\u0915 \u0930\u0947\u0932\u094d\u0935\u0947 \u0932\u093e\u0908\u0928, \u091c\u094b \u090f\u0915 \u0926\u0947\u0937 \u092c\u0928 \u0917\u092f\u0964"
 },
 {
  "start": 36.34,
  "end": 39.94,
  "text": " \u0935\u0942\u0932\u094d\u0921\u0935\u093e\u0930 \u0935\u0942\u0928 \u0915\u0947 \u092c\u093e\u0921, \u092c\u0932\u091c\u093f\u092e \u0915\u094b \u092f\u0947 \u091c\u0930\u094d\u092e\u0928 \u0930\u0947\u0932\u094d\u0935\u0947 \u092e\u093f\u0932\u0940."
 },
 {
  "start": 40.18,
  "end": 41.92,
  "text": " \u092a\u0924\u094d\u0930\u093f\u092f\u093e, \u091c\u092e\u0940\u0928, \u0938\u092c."
 },
 {
  "start": 41.92,
  "end": 46.14,
  "text": " \u092c\u0932\u094d\u091c\u093f\u092e \u0915\u0940 \u0907\u0938 \u092a\u0924\u0932\u0940 \u092a\u091f\u094d\u091f\u0940 \u0928\u0947 \u091c\u0930\u094d\u092e\u0928\u0940 \u0915\u0947 \u092a\u093e\u091a \u0924\u0941\u0915\u094d\u0921\u093c\u0947 \u0906\u0932\u0917 \u0915\u0930 \u0926\u093f\u092f\u0947"
 },
 {
  "start": 46.14,
  "end": 49.44,
  "text": " \u0909\u0928 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915, \u0935\u0938 \u090f\u0915 \u0917\u0930 \u0914\u0930 \u0909\u0938\u0915\u093e \u0917\u093e\u0930\u094d\u0926\u0928"
 },
 {
  "start": 49.44,
  "end": 51.66,
  "text": " \u0939\u0932\u094b, \u091c\u0930\u094d\u092e\u0928\u0940?"
 },
 {
  "start": 52.08,
  "end": 55.76,
  "text": " \u0928\u092e\u092c \u0924\u0941, \u090f\u0915 \u0906\u0908\u0932\u0947\u0902\u0926 \u091c\u094b \u0939\u0930 \u091a\u094d\u092f\u093e \u092e\u0939\u0940\u0928\u0947 \u0926\u0947\u0936 \u092c\u0921\u0932\u0924\u093e \u0939\u0948"
 },
 {
  "start": 55.76,
  "end": 59.48,
  "text": " \u0906\u0926\u093e \u0938\u093e\u0932 \u0938\u092a\u0947\u0902 \u091a\u0932\u093e\u0924\u093e \u0939\u0948, \u092c\u093e\u0915\u0940 \u0906\u0926\u093e \u092b\u094d\u0930\u093e\u0928\u094d\u0938"
 },
 {
  "start": 61.78,
  "end": 65.52,
  "text": " \u092f\u0939 \u0906\u0926\u0932\u093e \u092c\u0926\u094d\u0932\u0940 \u090f\u0915 \u0938\u094b \u092d\u0940 \u0938\u093e\u0932 \u0938\u0947 \u091a\u0932 \u0930\u0939\u0940 \u0939\u0948"
 },
 {
  "start": 65.52,
  "end": 68.38,
  "text": " \u0914\u0930 \u0906\u0926\u0932\u0947\u0902\u0926 \u090f\u0915 \u092b\u0941\u091f\u094d\u092c\u093e\u0932 \u0917\u094d\u0930\u093e\u0909\u0928 \u0938\u0947 \u092d\u0940 \u091a\u094b\u091f\u093e"
 },
 {
  "start": 68.38,
  "end": 71.14,
  "text": " \u092a\u0930 \u0928\u092e\u092c\u093e \u0935\u093e\u0928 \u0907\u0938 \u0938\u0947 \u092d\u0940 \u091c\u091c\u0940\u092c"
 },
 {
  "start": 71.14,
  "end": 73.7,
  "text": " \u0928\u092e\u092c\u093e \u0935\u093e\u0928 \u092c\u093e\u0930 \u0932\u0947"
 },
 {
  "start": 74.48,
  "end": 77.42,
  "text": " \u092f\u0939\u093e\u0902 \u092d\u0947\u0932\u091c\u0940\u092e \u0915\u0940 \u092c\u093e\u0907\u0938 \u0924\u0941\u0915\u094d\u0930\u0947 \u0928\u0947\u0926\u0932\u0947\u0902\u0938 \u0915\u0947 \u0905\u0902\u0926\u0930 \u092c\u093f\u0916\u093c\u0947 \u0939\u094b\u0908"
 },
 {
  "start": 77.42,
  "end": 80.36,
  "text": " \u0914\u0930 \u0915\u0941\u091a \u0915\u0947 \u0905\u0902\u0926\u0930 \u092b\u093f\u0930\u0938\u0947 \u0928\u0940\u0926\u0932\u0947\u0902\u0938 \u0915\u0947 \u0924\u0941\u0916\u0928\u0947 \u0939\u0948"
 },
 {
  "start": 80.36,
  "end": 84.4,
  "text": " \u0935\u093e\u0921\u0930, \u0926\u0941\u0915\u093e\u0928\u094b, \u0915\u0948\u092b\u0947 \u092f\u0939\u093e\u0926 \u0915\u0940 \u0917\u0930\u094b\u0902 \u0915\u0947 \u092d\u0940\u091b \u0938\u0947 \u091c\u093e\u0924\u093e \u0939\u0948"
 },
 {
  "start": 84.4,
  "end": 86.02,
  "text": " \u0924\u094b \u0906\u092a \u0915\u093f\u0938 \u0926\u0947\u0936 \u092e\u0947\u0902 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 86.02,
  "end": 87.98,
  "text": " \u091c\u093f\u0926\u0930 \u0906\u092a\u0915\u093e \u092e\u0947\u0902 \u0926\u0930\u094d\u0935\u093e\u091c\u093e \u0939\u0948"
 },
 {
  "start": 87.98,
  "end": 89.94,
  "text": " \u091c\u092c \u090f\u0915 \u0938\u0930\u0935\u0947\u0928\u0947 \u0932\u093e\u0908\u0902 \u0915\u093f\u0938\u0915\u093e\u0908"
 },
 {
  "start": 89.94,
  "end": 92.4,
  "text": " \u090f\u0915 \u0905\u0930\u093e\u0924 \u0915\u093e \u0917\u0930 \u0926\u091b \u0939\u094b \u0917\u092f\u093e"
 },
 {
  "start": 92.4,
  "end": 93.88,
  "text": " \u0924\u094b \u0909\u0938\u0915\u093e \u092e\u0947\u0902 \u0926\u0930\u094d\u0935\u093e\u091c\u093e \u0939\u0924\u093e \u0926\u093f\u092f\u093e"
 },
 {
  "start": 93.88,
  "end": 95.0,
  "text": " \u092b\u093f\u0930 \u0938\u0947 \u092c\u093f\u0932 \u091c\u0940\u0928"
 },
 {
  "start": 95.0,
  "end": 97.04,
  "text": " \u0905\u092c \u092d\u0940 \u0905\u092a\u0928\u0947 \u092e\u0948\u092a \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0939\u0948\u0902"
 }
]