[
 {
  "start": 0.0,
  "end": 4.2,
  "text": " \u0906\u092a \u0905\u0928\u094d\u0924\u093e\u0930\u094d\u0915\u094d\u091f\u093f\u0915\u093e \u092e\u0947\u0902 \u092f\u0939\u093e\u0902 \u0916\u0921\u0947 \u0939\u094b\u0902 \u0914\u0930 \u0915\u0939\u0940 \u092c\u0930\u094d\u092b \u0928\u093e \u0926\u093f\u0916\u0947\u0902"
 },
 {
  "start": 4.2,
  "end": 7.28,
  "text": " \u0915\u0939\u0924\u0947 \u0939\u0948, \u092f\u0939\u093e\u0902 \u0924\u0941 \u092e\u093f\u0932\u094d\u092f\u0928 \u0938\u093e\u0932 \u0938\u0947 \u092c\u093e\u0930\u093f\u0937 \u0928\u0939\u0940\u0902 \u0939\u0941\u0908"
 },
 {
  "start": 7.28,
  "end": 11.84,
  "text": " \u0924\u094b \u0915\u0948\u0938\u0947 \u092f\u0939 \u0917\u093e\u0924\u0940 \u0926\u0941\u0928\u094d\u092f\u093e \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u0940 \u0905\u0907\u0938 \u0936\u0940\u091f \u0915\u0947 \u092a\u093e\u0938 \u0939\u0948"
 },
 {
  "start": 11.84,
  "end": 16.0,
  "text": " \u092a\u0939\u0932\u0940 \u0935\u091c\u093e \u092a\u0939\u093e\u0921 \u092f\u0939 \u0917\u0932\u0947\u0936\u093f\u092f\u0938 \u0915\u094b \u0905\u0902\u0926\u0930 \u0906\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 16.0,
  "end": 20.18,
  "text": " \u092b\u093f\u0930 \u092c\u093e\u0915\u0940 \u0915\u093e\u092e \u0939\u0935\u093e \u0915\u0930\u0924\u0940 \u0939\u0948, \u0905\u0907\u0938 \u0936\u0940\u091f \u0938\u0947 \u0924\u0928\u094d\u0926\u0940 \u0939\u0935\u093e\u0928 \u0928\u0940\u091a\u0947 \u0917\u093f\u0930\u0924\u0940 \u0939\u0948,"
 },
 {
  "start": 20.44,
  "end": 22.9,
  "text": " \u0917\u0930\u092e \u0939\u094b\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0917\u093e\u0924\u093f\u092f\u093e \u0938\u0941\u0916\u093e \u0926\u0947\u0924\u0940 \u0939\u0948,"
 },
 {
  "start": 23.28,
  "end": 25.86,
  "text": " \u0915\u0930\u0940\u092c 140 \u0915\u093f\u0932\u094b\u092e\u093f\u091f\u0930 \u092a\u0930 \u0906\u0930\u0915\u0947 \u091c\u094b\u0915\u094b\u0902 \u0938\u0947,"
 },
 {
  "start": 26.24,
  "end": 27.66,
  "text": " \u0938\u0928\u094b \u0915\u093e \u0915\u094b\u0908 \u091a\u093e\u0928\u094d\u0938 \u0928\u0939\u0940\u0902."
 },
 {
  "start": 27.92,
  "end": 30.74,
  "text": " \u0924\u094b\u0921\u0940 \u0938\u0928\u094b \u0917\u093f\u0930\u0924\u0940 \u0939\u0948, \u0938\u093e\u0932 \u092e\u0947\u0902 \u0915\u0930\u0940\u092c 10 \u0938\u0902\u091f\u093f\u092e\u0940\u091f\u0930."
 },
 {
  "start": 30.74,
  "end": 34.22,
  "text": " \u092a\u0930 \u0939\u0935\u093e \u0907\u0924\u0928\u0940 \u0938\u0941\u0915\u0940 \u0939\u0948 \u0915\u093f \u0938\u0928\u094b \u0938\u0940\u0926\u0947 \u092d\u093e\u092a \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948"
 },
 {
  "start": 34.22,
  "end": 36.3,
  "text": " \u0917\u0930\u094d\u092e\u094d\u092f\u094b \u092e\u0947\u0902 \u0915\u0941\u091b \u0917\u0902\u091f\u094b \u092e\u0947\u0902 \u0917\u093e\u090f\u092c"
 },
 {
  "start": 36.3,
  "end": 38.06,
  "text": " \u0924\u094b \u092f\u0939\u093e\u0902 \u0915\u0941\u091b \u0917\u0940\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e"
 },
 {
  "start": 38.06,
  "end": 39.32,
  "text": " \u0915\u0941\u091b \u0938\u0930\u094d\u091f\u093e \u092d\u0940 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 39.32,
  "end": 41.76,
  "text": " \u092c\u0926\u0915\u094d\u0915\u0930 \u0906\u0908 \u0938\u0940\u0932\u094d\u0938 \u092f\u0939\u093e\u0902 \u0938\u0941\u0915 \u0915\u0930 \u092a\u0921\u0940 \u0939\u0948"
 },
 {
  "start": 41.76,
  "end": 43.84,
  "text": " \u0915\u0941\u091b \u0936\u093e\u092f\u0926 2,000 \u0938\u093e\u0932 \u092a\u0941\u0930\u093e\u0928\u0940"
 },
 {
  "start": 43.84,
  "end": 48.0,
  "text": " \u0924\u0928\u094d\u0926, \u0938\u0941\u0916\u093e, \u092d\u0947\u091c\u093e\u0928\u094d\u0938\u093e, \u0915\u0941\u091b \u092f\u093e\u0926 \u0906\u092f\u093e, \u0928\u093e\u0938\u093e \u0915\u094b \u092d\u0940 \u0906\u092f\u093e,"
 },
 {
  "start": 48.26,
  "end": 52.86,
  "text": " \u0928\u093e\u0928\u094d\u091f\u0940\u0928 \u0938\u092c\u0928\u094d\u091f\u0940\u0938 \u0915\u0947 \u0935\u093e\u090f\u0915\u093f\u0902\u091a\u093f\u0928 \u0938\u0947, \u0938\u093e\u0901\u0928\u094d\u091f\u093f\u0938 \u092f\u0939\u093e\u0902 \u092e\u093e\u0930\u094d\u0938 \u0915\u0947 \u0905\u0908\u091f\u093f\u092f\u093e \u0938\u094d\u091f\u0947\u0938\u094d\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948,"
 },
 {
  "start": 53.1,
  "end": 58.24,
  "text": " \u0915\u0941\u091b\u0940 \u092e\u093e\u0930\u094d\u0938 \u091c\u0948\u0938\u0940 \u0938\u092c\u0938\u0947 \u0915\u0930\u0940\u092d\u0940 \u091c\u0917\u0947, \u0938\u092c\u0938 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0926\u0930\u0924\u0940 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0928\u093f\u091a\u0932\u0947 \u091a\u094b\u0930 \u092a\u0930 \u0939\u0948,"
 },
 {
  "start": 58.24,
  "end": 66.5,
  "text": " \u0905\u0930 \u091f\u094d\u0935\u093f\u0938\u094d\u091f \u091c\u093f\u0928\u094d\u0926\u093f\u0917\u0940 \u092b\u093f\u0930 \u092d\u0940 \u092f\u0939\u093e \u0939\u0948, \u091a\u091f\u094d\u091f\u093e\u0928\u094b \u0915\u0947 \u0905\u0902\u0926\u0930 \u091a\u093f\u092a\u0940, \u0928\u092c \u092d\u093e\u0930\u093f\u0936 \u0928\u093e \u0915\u093f\u0930\u093e\u092f\u093e, \u0935\u094d\u092f\u0941 \u0936\u093e\u0928\u094d\u0926\u093e\u0930, \u092f\u0947 \u0939\u0948 \u092d\u0942\u0917\u094b\u0932."
 },
 {
  "start": 66.86,
  "end": 69.26,
  "text": " \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e\u0930 \u091c\u094b\u0917\u0930\u092b\u0940 \u092a\u0915\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u0932\u094b \u0915\u0930\u0947\u0902."
 }
]