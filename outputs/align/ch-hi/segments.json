  "text": " \u092a\u0948\u0938\u093e \u090f\u0915, \u0938\u094d\u0935\u093f\u0938\u094d\u092b\u094d\u0930\u093e\u0902\u0915, \u0928\u093e\u0907\u0928\u094d\u091f\u0940\u0928 \u0924\u0941\u0907\u0921\u093f\u092b\u0941\u0930 \u0938\u0947"
