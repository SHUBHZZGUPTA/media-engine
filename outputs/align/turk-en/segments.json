[
 {
  "start": 0.0,
  "end": 3.36,
  "text": " a bird named after a country it's not even from."
 },
 {
  "start": 4.08,
  "end": 5.78,
  "text": " It's actually from Mexico."
 },
 {
  "start": 6.3,
  "end": 9.62,
  "text": " The Aztecs raised turkeys over 2,000 years ago."
 },
 {
  "start": 10.14,
  "end": 12.74,
  "text": " In the 1500s, the Spanish shipped them to Europe."
 },
 {
  "start": 13.16,
  "end": 14.52,
  "text": " But Europe got confused."
 },
 {
  "start": 15.02,
  "end": 16.64,
  "text": " It looked like the guinea fowl,"
 },
 {
  "start": 16.88,
  "end": 19.22,
  "text": " an African bird that came through Turkish lands."
 },
 {
  "start": 19.72,
  "end": 21.66,
  "text": " So the English just called it Turkey."
 },
 {
  "start": 22.3,
  "end": 24.12,
  "text": " But what does Turkey call it?"
 },
 {
  "start": 24.72,
  "end": 26.98,
  "text": " Hindi, literally from India."
 },
 {
  "start": 26.98,
  "end": 30.56,
  "text": " And in India, in Hindi, it's called Turkey."
 },
 {
  "start": 31.38,
  "end": 33.06,
  "text": " And it gets even weirder."
 },
 {
  "start": 34.04,
  "end": 34.86,
  "text": " France donned."
 },
 {
  "start": 35.02,
  "end": 35.8,
  "text": " Chicken of India."
 },
 {
  "start": 36.34,
  "end": 37.34,
  "text": " Portugal, Peru."
 },
 {
  "start": 37.92,
  "end": 39.08,
  "text": " Named after Peru."
 },
 {
  "start": 39.88,
  "end": 41.48,
  "text": " Arabic, Roman chicken."
 },
 {
  "start": 42.38,
  "end": 44.0,
  "text": " Malaysia, Dutch chicken."
 },
 {
  "start": 44.56,
  "end": 46.9,
  "text": " Every country named it after somewhere else."
 },
 {
  "start": 47.46,
  "end": 50.94,
  "text": " In 2022, Turkey asked the UN to say Turkey-A."
 },
 {
  "start": 51.2,
  "end": 52.34,
  "text": " Partly to ditch the bird."
 },
 {
  "start": 52.98,
  "end": 53.74,
  "text": " And Mexico?"
 },
 {
  "start": 54.34,
  "end": 55.86,
  "text": " Guys, it's mine."
 },
 {
  "start": 55.86,
  "end": 60.28,
  "text": " We call it wajolote. So this Thursday you're eating"
 }
]