  "text": " \u092e\u091a\u094d\u0932\u093f\u092f\u094b \u0938\u0947 \u0915\u093f\u0938\u0940\u0928\u0947 \u092a\u0942\u091a\u093e \u0939\u0940 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 46.94,
  "end": 48.0,
  "text": " \u0906\u091c\u094d\u0938\u093e \u0939\u0941\u0935\u093e \u0928\u0939\u0940\u0902"
 },
 {
  "start": 48.0,
  "end": 51.379999999999995,
  "text": " \u092b\u093f\u0930 1979 \u092e\u093f\u0938 \u092a\u0940\u0928 \u0914\u0930 \u092e\u0941\u0930\u094b\u0915\u0941\u0928\u0940 \u091c\u0941\u0921\u0928\u0947 \u0915\u093e \u092b\u0948\u0938\u094d\u0932\u093e \u0915\u093f\u092f\u093e"
 },
 {
  "start": 51.379999999999995,
  "end": 52.44,
  "text": " \u091a\u093f\u0932\u094b \u092c\u0928\u093e\u0924\u0947\u0902"
 },
 {
  "start": 52.44,
  "end": 53.980000000000004,
  "text": " \u0926\u0940\u0932, \u0936\u0941\u0930\u0941\u0915 \u0905\u092a \u0915\u0930\u0947\u0902"
 },
 {
  "start": 53.980000000000004,
  "end": 55.9,
  "text": " \u0935\u0938, \u090f\u0915 \u0914\u0930 \u0938\u094d\u0924\u091f\u0940 \u0915\u0947 \u092c\u093e\u0926"
 },
 {
  "start": 55.9,
  "end": 57.42,
  "text": " 47 \u0938\u093e\u0932 \u092c\u093e\u0926"
 },
 {
  "start": 57.42,
  "end": 59.92,
  "text": " \u090f\u0915 \u0938\u094d\u0924\u091f\u0940 \u0915\u093e \u091c\u0935\u093e\u092c \u0906\u0916\u093f\u0930 \u0915\u093e\u0930 \u0905\u0932\u0917\u093e\u092f\u093e"
 },
 {
  "start": 60.0,
  "end": 79.96000000000001,
  "text": " \u092f\u0947 \u092e\u0941\u092e\u0915\u093f\u0928 \u0939\u0948, \u090f\u0915 \u0930\u0940\u0932 \u0924\u0928\u0932 \u0938\u092e\u0941\u0926\u0930 \u0938\u0947 475 \u092e\u0940\u091f\u0930 \u0928\u0940\u091a\u0947, \u091a\u093e\u0928\u0932 \u0924\u0928\u0932 \u0938\u0947 \u091a\u093e\u0930 \u0917\u0941\u0928\u093e \u0917\u0939\u0930\u0940, \u0938\u092a\u0947\u0928 \u0938\u0947 \u092e\u0941\u0930\u094b\u0915\u094b \u0938\u0930\u094d\u092b \u0924\u0940\u0938 \u092e\u093f\u0928\u0926 \u092e\u0947\u0902, \u0915\u092c \u0924\u0915, 2035 \u092f\u093e 2040, \u092e\u093f\u0932\u0915\u0930 \u0939\u094b\u0938\u094d\u0924 \u0939\u094b \u0930\u0939\u0947, 2030 world cup \u0915\u0947 \u0932\u093f\u090f \u0932\u0940\u091f, \u092f\u093e \u092c\u0938 \u0930\u0942\u0915 \u091c\u093e\u0913, \u0906\u092b\u0930\u093f\u0915\u093e \u0939\u0930 \u0938\u093e\u0932 \u0915\u0941\u091b \u092e\u093f\u0932\u0940 \u092e\u0940\u091f\u0930 \u092f\u0942\u0930\u094b\u092a \u0915\u0940 \u0924\u0930\u0917 \u0915\u093f \u0938\u0915 \u0930\u0939\u093e \u0939\u0948"
 },
 {
  "start": 79.96000000000001,
  "end": 86.08,
  "text": " \u0915\u0941\u091b \u092e\u093f\u0932\u094d\u092f\u0928 \u0938\u093e\u0932 \u0930\u094b\u0917, \u091c\u0940\u094b\u0932\u091c\u093f\u0938\u094d\u0924 \u0938\u0915\u0939\u0924\u0940 \u0939\u0948\u0902 \u092f\u0947 \u0917\u0906\u092a \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 \u092c\u0902\u0926 \u0939\u0941\u091c\u093e\u090f\u0917\u093e, \u0924\u092c \u0924\u0915 \u091c\u093f\u0902\u0924\u093e \u092e\u0924 \u0915\u0930\u094b."
 }
]