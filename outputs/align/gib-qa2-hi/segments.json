  "end": 7.78,
  "text": " \u092b\u093f\u0930 \u0935\u0939\u093e\u0902 \u0926\u094d\u0930\u093e\u0907\u0935 \u0915\u094d\u092f\u094b \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947, \u092f\u0947 \u092e\u0948\u0928 \u0939\u0948\u091f\u0928 \u0938\u0947 \u092d\u0940 \u091a\u094b\u091f\u093e \u0939\u0948"
 },
 {
