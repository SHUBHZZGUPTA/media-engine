[
 {
  "start": 0.0,
  "end": 4.02,
  "text": " \u092f\u0942\u0930\u092a \u0938\u0947 \u0906\u092a\u094d\u0930\u093f\u0915\u093e \u0926\u093f\u0916\u0924\u093e \u0939\u0948, \u092c\u0938 \u091a\u094b\u0921\u093e \u0915\u093f\u0932\u0942\u092e\u0940\u091f\u0930 \u0926\u0942\u0930"
 },
 {
