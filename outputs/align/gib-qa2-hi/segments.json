  "end": 10.1,
  "text": " \u091a\u0948\u0928\u0932 \u0924\u0930\u0928\u0932 \u0924\u094b \u092a\u091a\u093e\u0938 \u0915\u093f\u0932\u0942\u092e\u0940\u091f\u0930 \u0915\u093e \u0939\u0948"
 },
 {
  "start": 10.1,
  "end": 12.9,
  "text": " \u0924\u094b \u092b\u094b\u091f\u0940\u0928 \u0924\u094b \u0906\u0938\u093e\u0928 \u0939\u0941\u0928\u093e \u091a\u093e\u0939\u093f\u092f\u0947, \u0939\u0948 \u0928\u093e"
 },
 {
  "start": 12.9,
  "end": 16.14,
  "text": " \u092a\u0930 \u092a\u0947\u091a \u092f\u0947 \u0939\u0948, \u0926\u093f\u0916\u0915\u0924 \u0926\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948"
 },
 {
  "start": 16.14,
  "end": 21.22,
  "text": " \u0917\u093c\u0947\u0930\u093e\u0908 \u0939\u0948, \u0928\u094b \u0938\u094b \u092e\u0940\u091f\u0930 \u0924\u0915 \u0917\u093c\u0947\u0930\u093e \u092c\u0940\u091b \u092e\u0947\u0902 \u092c\u0942\u0930\u094d\u091c \u0916\u0932\u0940\u092b\u093e \u0926\u0941\u092c\u093e\u0926\u094b"
 },
 {
  "start": 21.22,
  "end": 25.84,
  "text": " \u0914\u0930 \u0935\u094b \u0917\u093e\u092f\u092c \u0909\u092a\u0930 \u0938\u0947 \u0924\u0947\u091c\u0927\u093e\u0930\u093e\u0908 \u0924\u0915\u094d\u0930\u093e\u0924\u0940 \u0924\u0947\u0915\u094d\u091f\u094b\u0928\u093f\u0915 \u092a\u094d\u0932\u0947\u091f\u094d\u0938"
 },
 {
  "start": 25.84,
  "end": 29.12,
  "text": " \u0914\u0930 \u0926\u0942\u0928\u093f\u092f\u093e \u0915\u0947 \u0938\u092c \u0938\u0947 \u092c\u093f\u0938\u0940 \u0936\u093f\u092a\u093f\u0902\u0917 \u0930\u093e\u0938\u094d\u0924\u094b \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915"
 },
 {
  "start": 29.12,
  "end": 29.98,
  "text": " \u0924\u094b \u0926\u094b..."
 },
 {
  "start": 30.0,
  "end": 31.58,
  "text": " \u092e\u0939\u093e\u0926\u0935\u0940\u092a\u094b \u0915\u094b \u091c\u094b\u0928\u0947 \u0915\u0948\u0938\u0947?"
 },
 {
  "start": 32.04,
  "end": 33.86,
  "text": " \u091c\u0932\u094b, 1928 \u092e\u0947\u0902 \u091a\u0932\u0924\u0947 \u0939\u0948,"
 },
 {
  "start": 34.04,
  "end": 35.2,
  "text": " \u090f\u0915 \u091c\u0930\u094d\u092e\u0928 \u0905\u0916\u093f\u091f\u0947\u0915\u094d\u091f,"
 },
 {
  "start": 35.3,
  "end": 37.36,
  "text": " \u0939\u0947\u0930\u094d\u092e\u0928 \u091c\u094b\u0930\u094d\u0917\u0932 \u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 \u092a\u094d\u0932\u093e\u0928 \u0925\u093e."
 },
 {
  "start": 37.72,
  "end": 39.06,
  "text": " \u0936\u094d\u091f\u094d\u0930\u0947\u091f \u092a\u0930 \u0926\u093e\u092e \u092c\u0928\u093e\u0926\u094b,"
 },
 {
  "start": 39.42,
  "end": 40.74,
  "text": " \u0914\u0930 \u092a\u0942\u0930\u0947 \u092e\u0947\u091f\u093f\u091f\u0930 \u092f\u0947\u0928\u094d\u092f\u0928 \u0915\u094b"
 },
 {
  "start": 40.74,
  "end": 42.64,
  "text": " 200 \u092e\u0940\u091f\u0930 \u0924\u0915 \u0928\u0940\u091a\u0947 \u0915\u0930\u0924\u094b."
 },
 {
  "start": 43.04,
  "end": 44.82,
  "text": " \u0932\u0917\u092c\u092c\u0916 \u092b\u094d\u0930\u093e\u0928\u094d\u0938 \u091a\u093f\u0924\u0928\u0940 \u0928\u0939\u0940\u0902 \u091c\u092e\u0940\u0928,"
 },
 {
  "start": 44.82,
