[
 {
  "start": 0.0,
  "end": 4.6,
  "text": " \u092f\u0947 \u0906\u0926\u092e\u0940 1998 \u092e\u0947\u0902 \u0917\u0930 \u0938\u0947 \u0928\u093f\u0915\u0932\u093e \u0914\u0930 \u0905\u092c \u091c\u093e\u0915\u0930 \u092a\u0947\u0926\u093e \u0932\u094b\u091f \u0930\u0939\u093e \u0939\u0948."
 },
 {
  "start": 4.84,
  "end": 10.52,
  "text": " 1998 \u092e\u0947\u0902 \u0915\u093e\u0932 \u092d\u0942\u0937\u094d\u092d\u0940 \u091a\u093f\u0932\u0947 \u0915\u0947 \u0906\u0916\u094d\u0930\u0940 \u091a\u094b\u0930 \u0938\u0947 \u0938\u093f\u0930\u094d\u092b \u092a\u093e\u0925 \u0938\u094b \u0921\u094b\u0932\u0930 \u0932\u0947\u0915\u0930 \u0928\u093f\u0915\u0932\u0947."
 },
 {
  "start": 10.8,
  "end": 14.74,
  "text": " \u0909\u0928\u0915\u093e \u0928\u093f\u092f\u092e \u0906\u0917\u0947 \u092c\u0921\u0928\u0947 \u0915\u093f\u0932\u093f\u090f \u0928\u0915\u093e\u0930 \u0928\u093e \u092a\u0932\u0947\u0928 \u0928\u093e \u092c\u094b\u0924."
 },
 {
  "start": 14.9,
  "end": 17.02,
  "text": " \u0914\u0930 \u0917\u0930 \u0924\u092d\u0940 \u091c\u0915 \u092a\u0947\u0921\u0932 \u092a\u0942\u0901\u091a\u0947\u0902"
 },
 {
  "start": 17.02,
  "end": 18.66,
  "text": " \u092a\u094d\u0932\u093e\u0928 \u0924\u093e \u0926\u0938 \u0938\u0947 \u092c\u093e\u0930\u093e \u0938\u093e\u0932"
 },
 {
  "start": 18.66,
  "end": 19.78,
  "text": " \u0932\u0917\u0947 \u0905\u0920\u094d\u092b\u093e\u0907\u0938"
 },
 {
  "start": 19.78,
  "end": 22.08,
  "text": " \u0909\u0928\u0939\u0941\u0928\u0947 \u0926\u093e\u0930\u094d\u092f\u0928 \u0917\u092a \u0915\u093e \u091c\u0902\u0917\u0932 \u092a\u093e\u0930 \u0915\u093f\u092f\u093e"
 },
 {
  "start": 22.26,
  "end": 24.6,
  "text": " \u0914\u0930 \u092a\u0928\u093e\u092e\u093e \u0915\u0940 \u091c\u0947\u0932 \u092e\u0947\u0902, \u0905\u091f\u093e\u0930\u093e \u0926\u093f\u0928 \u092c\u093f\u0924\u093e\u090f."
 },
 {
  "start": 24.92,
  "end": 28.14,
  "text": " 2006 \u092e\u0947\u0902, \u0935\u094b \u091c\u092e\u0947\u0939\u0941\u090f \u092c\u0948\u0930\u093f\u0902\u091a \u091a\u094d\u0930\u0947\u091f \u092a\u0930 \u091a\u0932\u0915\u0930,"
 },
 {
  "start": 28.3,
  "end": 29.6,
  "text": " \u0905\u0932\u093e\u0938\u0915\u093e \u0938\u0947 \u0930\u0937\u094d\u092f\u093e \u092a\u0942\u0901\u091a\u0947."
 },
 {
  "start": 29.840000000000003,
  "end": 31.080000000000002,
  "text": " \u0905\u091f\u094d\u091f\u093e\u090f \u0938\u093e\u0932."
 },
 {
  "start": 31.520000000000003,
  "end": 32.980000000000004,
  "text": " \u092e\u0941\u091d\u0947 \u0928\u0939\u0940\u0902 \u0924\u0932\u0935\u0947 \u091a\u093e\u0939\u0940 \u0939\u0948."
 },
 {
  "start": 33.22,
  "end": 35.78,
  "text": " \u092b\u093f\u0930 \u0930\u0936\u094d\u092f\u093e\u0928\u0947 \u0909\u0928\u094d\u092a\u0930 \u092a\u093e\u0925 \u0938\u093e\u0932 \u0915\u093e \u092c\u0948\u0928 \u0932\u0917\u093e \u0926\u093f\u092f\u093e"
 },
 {
  "start": 35.78,
  "end": 38.18,
  "text": " \u092a\u0939\u093e\u0921\u094b\u0902 \u0938\u0947 \u091c\u0906\u0926\u093e \u0909\u0928\u0939\u0947 \u0935\u0940\u091c\u093e\u0928\u0947 \u0930\u094b\u0915\u093e"
 },
 {
  "start": 38.18,
  "end": 40.44,
  "text": " \u091c\u0939\u093e\u0902 \u091a\u0932 \u0928\u0939\u0940\u0902 \u0938\u0915\u0924\u0947 \u0924\u0947 \u0935\u0939\u093e\u0902 \u091f\u0947\u0930\u0947"
 },
 {
  "start": 40.44,
  "end": 42.82,
  "text": " \u0915\u093e\u0938\u094d\u092a\u093f\u092f\u0902\u0937\u0940 \u092e\u0947\u0902 \u0926\u094b\u0938\u094b \u0905\u0920\u093e\u0938\u0940 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930"
 },
 {
  "start": 43.0,
  "end": 44.82,
  "text": " \u0914\u0930 \u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u090f\u0902\u0917\u0932\u093f\u0936 \u091a\u093e\u0928\u0932"
 },
 {
  "start": 44.82,
  "end": 48.3,
  "text": " \u0928\u093e\u0907\u0928\u094d\u091f\u0940 \u0928\u093e\u0907\u0928\u094d\u091f\u0940 \u090f\u091f \u0915\u093f\u092c\u093e\u0926 \u092c\u094d\u0930\u093f\u0924\u0947\u0928 \u0915\u0940 \u091c\u092e\u0940\u0928 \u092a\u0930 \u092a\u0939\u0932\u093e \u0915\u0926\u092e"
 },
 {
  "start": 48.3,
  "end": 51.06,
  "text": " \u0915\u0930\u0940 \u092a\u091a\u093e \u0938\u093e\u091c\u093e\u0930 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930, \u0909\u0902\u091f\u0940\u091c \u0926\u0947\u0936"
 },
 {
  "start": 51.06,
  "end": 54.36,
  "text": " \u0914\u0930 \u0906\u091c \u0935\u094b \u0905\u092a\u0928\u0947 \u0936\u0939\u0930 \u0939\u0932 \u092e\u0947\u0902, \u092a\u0947\u0926\u0932 \u092a\u0939\u0941\u091a\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948"
 },
 {
  "start": 54.36,
  "end": 56.480000000000004,
  "text": " \u0905\u0917\u0932\u0940 \u092c\u093e\u0930, \u092c\u0938 \u0938\u0947 \u091a\u0932\u0947\u0902\u0917\u0947"
 },
 {
  "start": 56.67,
  "end": 60.35,
  "text": " \u092f\u0947 \u0939\u0948 \u092c\u0939\u0941\u0917\u094b\u0932, \u0906\u091c\u093c\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e\u0930 \u091c\u094b\u0917\u0930\u094d\u092b\u0940 \u092b\u093e\u0915\u094d\u091f\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u093e\u0932\u094b \u0915\u0930\u0947."
 }
]