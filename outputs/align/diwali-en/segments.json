[
 {
  "start": 0.0,
  "end": 3.02,
  "text": " This is the Diwali photo that fooled India."
 },
 {
  "start": 3.74,
  "end": 5.46,
  "text": " Every Diwali, it goes viral."
 },
 {
  "start": 6.38,
  "end": 8.78,
  "text": " India from space on Diwali night."
 },
 {
  "start": 9.42,
  "end": 9.98,
  "text": " It's not."
 },
 {
  "start": 10.66,
  "end": 12.06,
  "text": " It's real satellite data."
 },
 {
  "start": 12.76,
  "end": 14.0,
  "text": " But not from Diwali."
 },
 {
  "start": 14.62,
  "end": 15.78,
  "text": " And not from one night."
 },
 {
  "start": 16.72,
  "end": 19.08,
  "text": " A NOAA scientist made it in 2003"
 },
 {
  "start": 19.08,
  "end": 21.52,
  "text": " to show how India's cities grew."
 },
 {
  "start": 22.5,
  "end": 23.8,
  "text": " Each color is a year."
 },
 {
  "start": 24.5,
  "end": 26.42,
  "text": " White lights existed before 1992."
 },
 {
  "start": 27.24,
  "end": 28.28,
  "text": " Blue appeared in 92."
 },
 {
  "start": 28.82,
  "end": 29.44,
  "text": " Green in 98."
 },
 {
  "start": 29.44,
  "end": 31.46,
  "text": " eight, read in 2003."
 },
 {
  "start": 32.1,
  "end": 34.56,
  "text": " So, I'm not even in it?"
 },
 {
  "start": 35.22,
  "end": 37.58,
  "text": " What does real Diwali look like from space?"
 },
 {
  "start": 38.82,
  "end": 40.28,
  "text": " NASA checked in 2012."
 },
 {
  "start": 41.14,
  "end": 42.74,
  "text": " The extra light was so subtle,"
 },
 {
  "start": 43.04,
  "end": 44.84,
  "text": " it's likely invisible from orbit."
 },
 {
  "start": 45.84,
  "end": 48.38,
  "text": " This year, Diwali is on the 8th of November."
 },
 {
  "start": 48.96,
  "end": 51.9,
  "text": " When this photo shows up again, you'll know."
 },
 {
  "start": 52.72,
  "end": 55.16,
  "text": " Share this, before the fake one."
 },
 {
  "start": 55.16,
  "end": 59.04,
  "text": " This is Boogal. Follow for more geography fun facts."
 }
]