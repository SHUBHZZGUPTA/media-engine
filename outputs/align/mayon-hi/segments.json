 },
 {
  "start": 37.52,
  "end": 39.7,
  "text": " \u092e\u0948\u0902\u0914\u0928 \u0930\u093f\u0902\u0917 \u0905 \u092b\u093e\u092f\u0930 \u092a\u0930 \u092c\u0948\u091f\u093e \u0939\u0948"
