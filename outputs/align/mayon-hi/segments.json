[
 {
  "start": 0.0,
  "end": 4.34,
  "text": " \u0906\u092a\u0915\u0940 \u0906\u0916\u0947 \u0926\u0942\u0915\u093e \u0928\u0939\u0940\u0902 \u0915\u0939\u093e\u0930\u0947\u0902, \u092f\u0947 \u092a\u0939\u093e\u0921 \u0932\u0917\u092d\u0915 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0939\u0948."
 },
 {
  "start": 4.62,
  "end": 8.36,
  "text": " \u0924\u094b \u091c\u094b \u0935\u094b\u0932\u0915\u0947\u0928\u094b \u0915\u0930\u0940\u092c \u0939\u0930 \u0906\u091f \u0938\u093e\u0932 \u092a\u0939\u0924\u0924\u093e \u0939\u0948, \u0935\u094b \u0907\u0924\u0928\u093e \u0928\u0940\u091f \u0915\u0948\u0938\u0947."
 },
 {
  "start": 8.68,
  "end": 15.18,
  "text": " \u092f\u0947 \u0939\u0948 \u092e\u0948\u0902\u0914\u0928, \u092b\u093f\u0932\u093f\u092a\u0940\u0928\u094d\u0938 \u092e\u0947\u0902, 2462 m \u0909\u091a\u093e, \u0915\u0930\u0940\u092c 34 \u0915\u0941\u0924\u092c \u092e\u0940\u0928\u093e\u0930 \u091c\u093f\u0924\u0928\u093e,"
 },
 {
  "start": 15.18,
  "end": 19.22,
  "text": " \u0914\u0930 30 \u0905\u0915\u094d\u091f\u094b\u092c\u0930 \u0915\u094b \u092f\u0947 \u092b\u093f\u0930 \u092d\u091f\u093e, \u0924\u0930\u0940 \u0915\u093f\u0932\u094b\u092e\u093f\u091f\u0930\u094d\u0938 \u0909\u092a\u0930 \u0924\u0915 \u0930\u093e\u0916 \u0939\u0942\u0921\u093e\u0908."
 },
 {
  "start": 19.46,
  "end": 24.02,
  "text": " \u092c\u093e\u0924 \u092f\u0947 \u0939\u0948, \u091c\u0948\u0926\u093e\u0924\u0930 \u092a\u0939\u093e\u0926 \u092c\u094b\u0921\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948, \u092c\u093e\u0930\u0947\u0936 \u0914\u0930 \u0939\u0935\u093e \u0909\u0928\u0947 \u0917\u093f\u0938 \u0926\u0947\u0924\u0940 \u0939\u0948."
 },
 {
  "start": 24.26,
  "end": 30.02,
  "text": " \u092a\u0930 \u092e\u0948\u092f\u093e\u0928 \u0909\u0928\u0947 \u0935\u0915\u094d\u0924 \u0939\u0940 \u0928\u0939\u0940 \u0926\u0947\u0924\u093e. 16-16 \u0938\u0947 \u0905\u092a \u0926\u0915 \u092f\u0947 \u0915\u0930\u0940 \u092b\u094d\u092b\u094d\u091f\u0940 \u092c\u093e\u0930 \u092d\u091f \u091a\u0941\u0915\u093e \u0939\u0948."
 },
 {
  "start": 30.02,
  "end": 32.56,
  "text": " \u0914\u0930 \u0939\u0930 \u092c\u093e\u0930 \u091a\u094b\u091f\u0940 \u092a\u0930 \u0928\u0939\u0940\u0902 \u091a\u091f\u093e\u0928 \u091c\u092e\u0924\u0940 \u0939\u0948"
 },
 {
  "start": 32.56,
  "end": 33.82,
