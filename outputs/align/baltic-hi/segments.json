[
 {
  "start": 0.0,
  "end": 3.72,
  "text": " \u0905\u0917\u0930 \u0905\u0938\u094d\u091f\u094b\u0928\u093f\u092f\u093e \u0932\u093e\u0924\u094d\u0935\u093f\u092f\u093e \u0914\u0930 \u0932\u093f\u0924\u094d\u0935\u0947\u0928\u093f\u092f\u093e \u090f\u0915 \u0926\u0947\u0936 \u092a\u0928\u094d\u091c\u093e\u090f."
 },
 {
  "start": 4.12,
  "end": 8.06,
  "text": " \u0924\u0942\u0938\u094d\u091f \u092f\u0947 \u0939\u0948 \u090f\u0915 \u0926\u093f\u0928 \u0915\u093f\u0932\u093f\u090f \u092f\u0947 \u0924\u0940\u0928\u094b \u090f\u0915 \u092c\u0928 \u091a\u0941\u0915\u0947\u0902."
 },
 {
  "start": 8.38,
  "end": 11.86,
  "text": " 1989 \u092e\u0947\u0902 2 \u092e\u093f\u0932\u094d\u0932\u093f\u092f\u0928 \u0932\u094b\u0917\u094b\u0928\u0947 \u0939\u0924 \u092a\u0915\u0921\u0947."
 },
 {
  "start": 12.46,
  "end": 16.56,
  "text": " \u090f\u0915 \u092c\u093f\u0928\u093e \u0924\u0942\u091f\u0940 \u091a\u0947\u0928 \u092e\u0947\u0902 675 \u0915\u093f\u0932\u092e\u092c\u0940."
 },
 {
  "start": 17.0,
  "end": 20.36,
  "text": " \u0924\u093e\u0932\u093f\u0928 \u0938\u0947 \u0930\u0940\u0917\u093e \u0939\u094b\u0924\u0947\u0935\u0947 \u0935\u093f\u0932\u094d\u0928\u093f\u092f\u093e\u0938 \u0924\u0915."
 },
 {
  "start": 20.36,
  "end": 22.12,
  "text": " \u0924\u094b \u0907\u0938 \u0926\u0947\u0936 \u0915\u094b \u0915\u094d\u092f\u093e \u092e\u093f\u0932\u0947\u0917\u093e?"
 },
 {
  "start": 22.58,
  "end": 23.92,
  "text": " \u0936\u093f\u0915\u094d\u0938 \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917"
 },
 {
  "start": 23.92,
  "end": 26.22,
  "text": " \u0914\u0930 \u091c\u092e\u0940\u0928 \u0932\u0917\u094d\u092c\u092c\u0916 \u092b\u094d\u0932\u094b\u0930\u0947\u0921\u093e \u091c\u093f\u0924\u0928\u0940"
 },
 {
  "start": 26.22,
  "end": 28.06,
  "text": " \u0932\u0947\u0915\u0947 \u0928\u0947\u0915 \u092a\u0947\u0902\u091a \u0939\u0948"
 },
 {
  "start": 28.06,
  "end": 30.68,
  "text": " \u092f\u0947 \u090f\u0915 \u0926\u0941\u0938\u0930\u0947 \u0915\u0940 \u092c\u093e\u0936\u093e \u0928 \u0938\u092e\u091a\u0924\u0947 \u0939\u0940 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 30.68,
  "end": 33.2,
  "text": " \u0932\u093e\u091f\u094d\u0935\u093f\u092f\u0928 \u0935\u094b \u0932\u093f\u0926\u094c\u090f\u0928\u094d\u092f\u0928 \u0930\u093f\u0937\u094d\u091f\u0947\u0926\u093e\u0930 \u092c\u093e\u0936\u093e \u0939\u0948"
 },
 {
  "start": 33.2,
  "end": 54.46,
  "text": " \u0907\u0938\u094d\u091f\u094b\u0928\u094d\u092f\u0928, \u0935\u094b \u0924\u094b \u092b\u093f\u0928\u093f\u0937\u0915\u0947 \u0915\u0930\u0940\u092c \u0939\u0948, \u092b\u093f\u0930 \u0915\u093e\u092a\u093f\u091f\u0932, \u0924\u093e\u0932\u093f\u0928, \u0930\u0940\u0917\u093e, \u0935\u093f\u0932\u0928\u093f\u092f\u0941\u0938, \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0905\u092d\u0940 \u0938\u092c\u0938\u0947 \u0905\u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0932\u0917\u092c\u092d\u0917 600 \u0938\u093e\u0932 \u092a\u0939\u0932\u0947 \u0905\u0915\u0947\u0932\u093e \u0932\u093f\u0924\u094d\u0935\u0947\u0928\u093f\u092f, \u092f\u094b\u0930\u092c \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0926\u0947\u0936 \u0925\u093e, \u0935\u094b \u092a\u0939\u0932\u093e \u0925\u093e \u092c\u093e\u0932\u094d\u091f\u093f\u0915 \u0938\u0940 \u0938\u0947 \u092c\u0932\u093e\u0915 \u0938\u0940 \u0924\u0915, \u0914\u0930 \u0906\u091c \u0924\u0940\u0928\u094b \ufffd"
 },
 {
  "start": 57.66,
  "end": 60.66,
  "text": " \u0924\u094b \u090f\u0915 \u0926\u0947\u0936 \u092f\u093e \u0924\u0940\u0928 \u0915\u094d\u092f\u094b\u0902\u0917\u0940 \u0938\u091c \u092c\u0924\u093e \u0939\u0942\u0901"
 }
]