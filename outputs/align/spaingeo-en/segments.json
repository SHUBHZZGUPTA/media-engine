[
 {
  "start": 0.0,
  "end": 2.06,
  "text": " You think Spain has two neighbors."
 },
 {
  "start": 2.56,
  "end": 6.26,
  "text": " It has five, and one border is shorter than a football pitch."
 },
 {
  "start": 7.16,
  "end": 11.2,
  "text": " Portugal, France, and tiny Andorra, under a third the size of London,"
 },
 {
  "start": 11.72,
  "end": 15.24,
  "text": " Britain through Gibraltar, and Morocco, in Africa."
 },
 {
  "start": 15.94,
  "end": 19.24,
  "text": " Sayuta, Melilla, and a Spanish rock right off the coast."
 },
 {
  "start": 19.84,
  "end": 24.08,
  "text": " In 1934, a storm piled up sand and glued that rock to Africa."
 },
 {
  "start": 24.64,
  "end": 26.46,
  "text": " New border, about 85 meters."
 },
 {
  "start": 26.92,
  "end": 28.1,
  "text": " You could walk it in a minute,"
 },
 {
  "start": 28.1,
  "end": 31.76,
  "text": " But Spain's weirdest borders aren't in Africa, they're with France."
 },
 {
  "start": 32.38,
  "end": 32.68,
  "text": " So how?"
 },
 {
  "start": 33.34,
  "end": 34.76,
  "text": " Rewind to 1659."
 },
 {
  "start": 35.36,
  "end": 37.54,
  "text": " Spain and France sign peace on a tiny river island."
 },
 {
  "start": 38.1,
  "end": 40.54,
  "text": " Spain hands France 33 villages in the mountains."
 },
 {
  "start": 41.44,
  "end": 42.36,
  "text": " 30 trois-village."
 },
 {
  "start": 42.8,
  "end": 44.24,
  "text": " Yivia, you're French now."
 },
 {
  "start": 44.56,
  "end": 45.38,
  "text": " Excuse me?"
 },
 {
  "start": 45.68,
  "end": 46.48,
  "text": " I'm a town."
 },
 {
  "start": 47.28,
  "end": 47.54,
  "text": " Seriously?"
 },
 {
  "start": 48.4,
  "end": 48.72,
  "text": " Seriously."
 },
 {
  "start": 49.22,
  "end": 52.84,
  "text": " So Yivia stayed Spanish, surrounded by France on every side."
 },
 {
  "start": 53.14,
  "end": 57.2,
  "text": " Its road to Spain still runs through France, about 1.6 kilometers of it."
 },
 {
  "start": 57.2,
  "end": 59.1,
  "text": " And that's still not the strangest part."
 },
 {
  "start": 59.66,
  "end": 62.14,
  "text": " Remember that river island? Neither country would let it go."
 },
 {
  "start": 62.5,
  "end": 63.58,
  "text": " So they share custody."
 },
 {
  "start": 64.32,
  "end": 65.5,
  "text": " February to July, it's Spanish."
 },
 {
  "start": 65.98,
  "end": 67.18,
  "text": " August to January, French."
 },
 {
  "start": 67.7,
  "end": 70.2,
  "text": " They've swapped like this for over 120 years."
 },
 {
  "start": 70.8,
  "end": 71.54,
  "text": " Nobody lives there."
 },
 {
  "start": 71.92,
  "end": 73.66,
  "text": " Honestly, probably for the best."
 },
 {
  "start": 74.1,
  "end": 75.56,
  "text": " Am I Spanish or French?"
 },
 {
  "start": 76.24,
  "end": 76.88,
  "text": " Check the calendar."
 },
 {
  "start": 77.42,
  "end": 78.0,
  "text": " This is Boogle."
 },
 {
  "start": 78.36,
  "end": 79.88,
  "text": " Follow for more geography fun facts."
 }
]