[
 {
  "start": 0.0,
  "end": 4.02,
  "text": " \u0906\u092c \u0926\u093e\u0928\u094d\u092f\u0942\u092a \u0915\u094b \u091c\u093e\u0928\u0924\u0947 \u0939\u0948, \u091a\u093e\u0930 \u0915\u0947\u092a\u093f\u091f\u0932\u094d\u0938 \u0926\u0938 \u0926\u0947\u0936,"
 },
 {
  "start": 4.5,
  "end": 8.12,
  "text": " \u092a\u0930 \u0906\u092a\u0928\u0947 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u093e \u0907\u0938\u0915\u093e \u090f\u0915 \u0939\u093f\u0938\u094d\u0938\u093e \u0905\u0938\u0932 \u092e\u0947\u0902 \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
 },
 {
  "start": 8.14,
  "end": 11.92,
  "text": " \u092f\u0947 \u091c\u0930\u094d\u092e\u0928\u0940 \u0915\u0947 \u092c\u094d\u0932\u093e\u0915 \u092b\u094b\u0930\u0947\u0938\u094d\u0924 \u0938\u0947 \u0928\u093f\u0915\u0932\u0924\u0940 \u0939\u0948, \u092c\u094d\u0932\u093e\u0915 \u0938\u0940\u0915\u093f\u092f\u094b\u0930."
 },
 {
  "start": 12.3,
  "end": 16.58,
  "text": " \u0930\u093e\u0938\u094d\u0924\u0947 \u092e\u0947\u0902 \u0935\u093f\u092f\u0928\u093e, \u092b\u093f\u0930 \u092c\u0938 56 \u0915\u093f\u0932\u0941\u092e\u0940\u091f\u0930\u094d\u0938 \u092c\u093e\u0926 \u092c\u094d\u0930\u093e\u0924\u093f\u0938\u094d\u0932\u093e\u0935\u093e."
 },
 {
  "start": 16.85,
  "end": 19.970000000000002,
  "text": " \u0924\u094b \u0915\u093e\u092a\u093f\u091f\u0932\u094d\u091f\u0932\u094d\u0926, \u0915\u093e\u0908 \u0932\u094b\u0917\u094b \u0915\u0947 \u0905\u092b\u093f\u0938 \u0938\u0947 \u092d\u0940 \u092a\u093e\u0938."
 },
 {
  "start": 20.630000000000003,
  "end": 22.630000000000003,
  "text": " \u092b\u093f\u0930 \u092f\u0947 \u092c\u0941\u0921\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u094b \u092c\u0940\u091a \u0938\u0947 \u0915\u093e\u091f\u0924\u0940 \u0939\u0948."
 },
 {
  "start": 22.950000000000003,
  "end": 23.630000000000003,
  "text": " \u092b\u093f\u0930 \u092d\u0947\u0932 \u0917\u094d\u0930\u0947\u0926"
 },
 {
  "start": 23.84,
  "end": 27.84,
  "text": " \u091a\u093e\u0930 \u0915\u093e\u092a\u093f\u091f\u0932\u091c \u090f\u0915 \u0928\u0926\u0940\u092a\u0930, \u0915\u093f\u0938\u0940 \u0914\u0930 \u0928\u0926\u0940\u092a\u0930 \u0907\u0924\u0928\u0940 \u0928\u0939\u0940\u0902,"
 },
 {
  "start": 28.5,
  "end": 31.46,
  "text": " \u0924\u094b \u092b\u093f\u0930 \u0936\u0941\u0935\u093e\u0926 \u0915\u0947 \u092a\u093e\u0938 \u092f\u0947 \u0915\u092d\u0940-\u0915\u092d\u0940..."
 },
 {
  "start": 31.87,
  "end": 33.39,
  "text": " \u0917\u093e\u092f\u092c \u0915\u094d\u092f\u094b\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948?"
 },
 {
  "start": 33.93,
  "end": 34.550000000000004,
  "text": " \u0930\u0940\u0935\u093e\u0908\u0902\u091f"
 },
 {
  "start": 34.550000000000004,
  "end": 36.870000000000005,
  "text": " \u091c\u0930\u094d\u092e\u0928\u0940 \u092e\u0947\u0902 \u0907\u092e\u093f\u0928\u094d\u091f\u093f\u0902\u0917\u093f\u0928 \u0915\u0947 \u092a\u093e\u0938"
 },
 {
  "start": 36.870000000000005,
  "end": 38.49,
  "text": " \u0928\u0926\u0940 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0932\u093e\u0908\u092e\u094d\u0938\u094d\u091f\u094b\u0928 \u0939\u0948"
 },
 {
  "start": 38.49,
  "end": 39.55,
  "text": " \u0926\u0930\u093e\u0930\u094b \u0938\u093f\u092c\u0939\u0930\u093e"
 },
 {
  "start": 39.55,
  "end": 40.77,
  "text": " \u092a\u093e\u0928\u0940 \u0930\u093f\u0938\u0915\u0930"
 },
 {
  "start": 40.77,
  "end": 42.81,
  "text": " \u0938\u0940\u0927 \u0939\u0940 \u091c\u092e\u0940\u0928 \u092e\u0947\u0902 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948"
 },
 {
  "start": 43.93,
  "end": 48.19,
  "text": " 1921 \u092e\u0947\u0902 \u0935\u094b \u0939\u093f\u0938\u094d\u0938\u093e \u0938\u0941\u0916\u093e \u0930\u0939\u093e, 309 \u0926\u093f\u0928."
 },
 {
  "start": 48.83,
  "end": 50.33,
  "text": " \u0928\u0926\u093f\u092f\u094b \u0915\u094b \u092d\u0940 \u091a\u0941\u091f\u0940 \u091a\u093e\u0939\u0940 \u0939\u0948."
 },
 {
  "start": 50.52,
  "end": 53.480000000000004,
  "text": " \u092c\u0938 309 \u0926\u0947\u091c \u0928\u0939\u0940\u0902"
 },
 {
  "start": 53.480000000000004,
  "end": 57.580000000000005,
  "text": " 1877 \u092e\u0947\u0902 \u0935\u0947\u0917\u094d\u092f\u093e\u0928\u0947\u0915\u094b\u0928\u0947 \u0928\u092e\u0915 \u0914\u0930 \u0930\u0902\u0917 \u0921\u093e\u0932\u093e \u0926\u0930\u093e\u0930\u094b \u092e\u0947\u0902"
 },
 {
  "start": 57.68,
  "end": 58.82,
  "text": " \u0914\u0930 \u0907\u0902\u0924\u093f\u091c\u093e\u0930 \u0915\u093f\u092f\u093e"
 },
 {
  "start": 59.34,
  "end": 62.56,
  "text": " 60 \u0905\u0935\u093e\u091c \u092c\u093e\u0926 \u0935\u094b 12 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0938 \u0926\u0915\u094d\u0937\u0928 \u092e\u0947\u0902 \u0928\u093f\u0915\u0932\u093e"
 },
 {
  "start": 62.56,
  "end": 63.84,
  "text": " \u090f\u0915 \u091c\u06be\u0930\u0928\u0947 \u092e\u0947\u0902"
 },
 {
  "start": 63.84,
  "end": 65.34,
  "text": " \u091c\u094b \u0932\u0947\u0915 \u0915\u094b\u0902\u0938\u094d\u091f\u0928\u094d\u0938 \u092e\u0947\u0902 \u091c\u093e\u0924\u093e \u0939\u0948"
 },
 {
  "start": 65.55,
  "end": 71.21,
  "text": " \u0932\u0947\u0917 \u0915\u0941\u0928\u094d\u0938\u094d\u0924\u093f\u0928\u094d\u0938\u0947 \u092a\u093e\u0928\u0940 \u0930\u093e\u0908\u0928 \u092e\u0947\u0902 \u091c\u093e\u0924\u093e \u0939\u0948, \u0930\u093e\u0908\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0928\u093e\u091a\u094d\u0938\u0940 \u092e\u0947\u0902, \u0917\u0932\u0924 \u0938\u092e\u0941\u0926\u094d\u0930."
 },
 {
  "start": 71.77,
  "end": 73.78999999999999,
  "text": " \u091c\u0930\u094d\u092e\u0928\u0940 \u0915\u0947 \u0930\u093e\u091c\u094d\u091c\u0947 \u0915\u094b\u091b \u0924\u0915 \u0917\u0948?"
 },
 {
  "start": 73.98,
  "end": 80.4,
  "text": " 1927 \u092e\u0947\u0902, \u0909\u0938 \u092a\u093e\u0928\u0940 \u0915\u0947 \u0932\u093f\u090f, \u091c\u094b \u0916\u0941\u0926 \u091a\u0932\u093e\u0917\u092f\u093e, \u0917\u0932\u0924 \u0938\u092e\u0941\u0926\u094d\u0926\u094d\u0930\u0964"
 },
 {
  "start": 80.4,
  "end": 86.5,
  "text": " \u0905\u091f\u094d\u0935\u093f\u0938\u094d\u091f, \u091c\u0940\u094b\u0932\u094b\u0917\u093f\u0938\u094d\u091f \u092e\u093e\u0928\u0924\u0947 \u0939\u0948, \u0915\u093f \u0909\u092a\u094d\u0930\u0940 \u0926\u093e\u0928\u0942\u092d \u090f\u0915 \u0926\u093f\u0928 \u0930\u093e\u0908\u0928 \u092e\u0947\u0939\u0940 \u092c\u0939\u0928\u0947 \u0932\u0917\u0947, \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f."
 },
 {
  "start": 87.10000000000001,
  "end": 91.64,
  "text": " \u091a\u093e\u0930 \u0915\u093e\u092a\u093f\u0924\u0932\u094d\u0938, \u0926\u0938 \u0926\u0947\u0936, \u0914\u0930 \u090f\u0915 \u0928\u0926\u0940, \u091c\u094b \u0905\u092a\u0928\u093e \u0939\u0940 \u092a\u093e\u0928\u0940 \u0928\u0939\u0940\u0902 \u0930\u0916 \u092c\u093e\u0924\u0940."
 },
 {
  "start": 92.07,
  "end": 96.36999999999999,
  "text": " \u092f\u0947 \u0939\u0948 \u092c\u0942\u0917\u094b\u0932. \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u093f\u0926\u093e\u0930 \u091c\u0940\u0905\u0917\u094d\u0930\u094b\u092b\u0940 \u092b\u093e\u0915\u094d\u091f\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u0932\u094b \u0915\u0930\u0947\u0902."
 }
]