 {
  "start": 27.76,
  "end": 33.7,
  "text": " \u090f\u0915 \u092e\u093f\u0928\u0947\u091f \u092e\u0947\u0902 \u092a\u0947\u0921\u0932 \u092a\u093e\u0930, \u0932\u093f\u0915\u093f\u0928 \u0938\u094d\u092a\u0947\u0928 \u0915\u0947 \u0938\u092c \u0938\u0947 \u0905\u091c\u0940\u092c \u092d\u093e\u0921\u0930 \u0905\u092a\u094d\u0930\u093f\u0915\u093e \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u092b\u094d\u0930\u093e\u0928\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0939\u0948\u0964"
 },
 {
  "start": 33.78,
  "end": 39.760000000000005,
  "text": " \u0905\u0938\u093e \u0915\u0948\u0938\u0947? 1659 \u092e\u0947\u0902 \u091a\u0932\u0940\u090f, \u0938\u094d\u092a\u0947\u0928 \u0914\u0930 \u092b\u094d\u0930\u093e\u0928\u094d\u0938 \u090f\u0915 \u091b\u094b\u091f\u0947 \u0938\u0947 \u0928\u0926\u0940 \u0926\u094d\u0935\u0940\u092a \u092a\u0930 \u0938\u0941\u0932\u0939 \u0915\u0930\u0924\u0947 \u0939\u0948."
