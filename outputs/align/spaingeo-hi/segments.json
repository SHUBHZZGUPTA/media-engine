 {
  "start": 50.120000000000005,
  "end": 61.92,
  "text": " \u0924\u094b \u092f\u0947\u0935\u093f\u092f\u093e \u0938\u094d\u092a\u0947\u0928 \u0915\u0939\u0940 \u0930\u0939\u093e, \u091a\u093e\u0930\u094b \u0924\u0930\u0935 \u092b\u094d\u0930\u093e\u0928\u094d\u0938\u0947 \u0917\u0947\u0930\u093e, \u0938\u094d\u092a\u0947\u0928 \u091c\u093e\u0928\u0947\u0935\u093e\u0932\u0940 \u0907\u0938\u0915\u0940 \u0938\u0921\u093c\u0915 \u0906\u091c \u092d\u0940 \u092b\u094d\u0930\u093e\u0928\u094d\u0938\u0947 \u0939\u094b\u0915\u0930 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0915\u0930\u0940\u092c 1.6 km, \u0914\u0930 \u092f\u0947 \u0905\u092d\u0940 \u0938\u092c\u0938\u0947 \u0905\u091c\u0940\u092c \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0935\u094b \u0928\u0926\u093f\u0935\u093e\u0932\u093e \u0926\u094d\u0935\u0940 \u092a\u094d\u092f\u093e\u0926 \u0939\u0948."
 },
 {
  "start": 62.13,
  "end": 65.97,
  "text": " \u0915\u094b\u0908 \u0926\u0947\u0936 \u0909\u0938\u0947 \u091a\u094b\u0921\u0928\u0947 \u0915\u094b \u0924\u092f\u093e\u0930 \u0928\u0939\u0940\u0902 \u0924\u093e, \u0924\u094b \u0926\u094b\u0928\u094b\u0902\u0928\u0947 \u0915\u0938\u094d\u091f\u0947\u0926\u0940 \u092c\u093e\u091f\u0932\u0940,"
