[
 {
  "start": 0.0,
  "end": 5.82,
  "text": " \u0905\u0917\u0930 \u092c\u094d\u0930\u093e\u091c\u093f\u0932 \u0914\u0930 \u092a\u0942\u0930\u094d\u0924\u0941\u0915\u093e\u0932 \u090f\u0915 \u0926\u0947\u0936 \u092a\u0928 \u091c\u093e\u090f\u0902, \u092c\u094d\u0930\u093e\u091c\u093f\u0932 92 \u0917\u0941\u0928\u093e \u092c\u0922\u093c\u093e \u0939\u0948\u0964"
 },
 {
  "start": 5.82,
  "end": 13.56,
  "text": " \u092a\u0942\u0930\u094d\u091a\u0941\u0915\u0932 \u0924\u094b \u092c\u0938 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0915\u094b\u0923\u093e \u0939\u094b\u0917\u093e, 225 \u092e\u093f\u0932\u093f\u092f\u0928 \u0932\u094b\u0917, \u0938\u092c \u092a\u0942\u0930\u094d\u091a\u0941\u0915\u0940\u0938 \u092c\u094b\u0932\u0928\u0947 \u0935\u093e\u0932\u0947\u0964"
 },
 {
  "start": 13.56,
  "end": 15.92,
  "text": " \u0924\u094b \u0907\u0938 \u092c\u0922\u093c\u0947 \u0926\u0947\u0936 \u092a\u0930 \u0930\u093e\u091c \u0915\u094c\u0928 \u0915\u0930\u0947\u0917\u093e?"
 },
 {
  "start": 15.92,
  "end": 19.04,
  "text": " \u0924\u0941\u0907\u0938\u094d\u091f \u092f\u0939 \u0939\u0948, \u092f\u0939 \u092a\u0939\u0932\u0947 \u0939\u094b \u091a\u0941\u0915\u093e \u0939\u0948"
 },
 {
  "start": 19.04,
  "end": 22.8,
  "text": " 1807 \u092e\u0947\u0902 \u0928\u093f\u092a\u094b\u0932\u093f\u092f\u093e \u0928\u0947 \u092a\u0942\u0930\u094d\u0924\u0941\u0915\u093e\u0932 \u092a\u0930 \u0939\u092e\u094d\u0932\u093e \u0915\u093f\u092f\u093e"
 },
 {
  "start": 22.8,
  "end": 25.88,
  "text": " \u0924\u094b \u092a\u0942\u0930\u0940 \u0930\u0949\u092f\u0932 \u092b\u093e\u092e\u094d\u0932\u0940 \u092c\u094d\u0930\u0938\u093f\u0932 \u091a\u0932\u0940 \u0917\u0908"
 },
 {
  "start": 25.88,
  "end": 29.76,
  "text": " 13 \u0938\u093e\u0932 \u0924\u0915 \u092a\u0942\u0930\u094d\u091b\u0941\u0915\u0932 \u092a\u0930 \u0930\u093e\u091c \u0939\u0941\u0906 \u0930\u093f\u092f\u094b \u0921\u0947 \u091c\u0947\u0928\u0947\u0930\u094b \u0938\u0947"
 },
 {
  "start": 29.76,
  "end": 33.42,
  "text": " 1815 \u0924\u0915 \u090f\u0915 \u0915\u093f\u0902\u0921\u092e \u0926\u094b \u0915\u0941\u0902\u091f\u093f\u0928\u0947\u0902\u091f\u094d\u0938"
 },
 {
  "start": 33.42,
  "end": 35.92,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u0905\u092d\u0940 \u0938\u092c\u0938\u0947 \u0905\u091c\u0940\u092c \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902"
 },
 {
  "start": 36.66,
  "end": 39.74,
  "text": " \u0915\u093f\u0902\u0917 \u0935\u093e\u092a\u0938 \u092a\u0949\u0930\u094d\u091a\u0941\u0917\u0932 \u0917\u090f \u0914\u0930 \u0905\u092a\u0928\u0947 \u092c\u0947\u091f\u0947 \u0915\u094b \u091a\u093e\u0930\u094d\u091c \u0926\u0947 \u0917\u090f"
 },
 {
  "start": 39.74,
  "end": 45.88,
  "text": " \u0914\u0930 1822 \u092e\u0947\u0902 \u0909\u0928\u0915\u0947 \u0905\u092a\u0928\u0947 \u092c\u0947\u091f\u0947 \u0928\u0947 \u092c\u094d\u0930\u0938\u0940\u0932 \u0915\u094b \u0906\u091c\u093e\u0926 \u0917\u094b\u0936\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e"
 },
 {
  "start": 45.88,
  "end": 50.28,
  "text": " \u092b\u093f\u0930 \u0915\u093f\u0902\u0917 \u0915\u0940 \u092e\u094c\u0925 \u0939\u0941\u0908 \u0914\u0930 \u0935\u0939\u0940 \u092c\u0947\u091f\u093e \u092a\u0949\u0930\u094d\u091a\u0915\u0932 \u0915\u093e \u0915\u093f\u0902\u0917 \u092d\u0940 \u092c\u0928 \u0917\u092f\u093e"
 },
 {
  "start": 50.28,
  "end": 52.7,
  "text": " \u0938\u093f\u0930\u094d\u0935 \u0926\u094b \u092e\u0939\u093f\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f"
 },
 {
  "start": 52.7,
  "end": 55.88,
  "text": " \u0914\u0930 \u0915\u0948\u092a\u093f\u091f\u0932, \u0932\u093f\u0938\u092c\u093f\u0928, \u0930\u093f\u092f\u094b \u092f\u093e \u092a\u094d\u0930\u0938\u0940\u0932\u093f\u092f\u093e"
 },
 {
  "start": 56.62,
  "end": 58.68,
  "text": " \u092c\u094d\u0930\u0938\u0940\u0932 5 \u0935\u0949\u0932\u094d\u0915\u092a"
 },
 {
  "start": 58.68,
  "end": 62.66,
  "text": " \u092a\u0941\u0930\u094d\u0924\u0915\u093e\u0932, \u0905\u091a\u094d\u091b\u093e \u092e\u093e\u0930\u0947 \u092a\u093e\u0938 \u0915\u0938\u094d\u091f\u0930 \u091f\u093e\u091f\u094d\u0938 \u0939\u0948\u0902"
 },
 {
  "start": 62.66,
  "end": 64.9,
  "text": " \u0924\u094b \u090f\u0915 \u0926\u0947\u0936 \u092f\u093e \u0926\u094b"
 },
 {
  "start": 64.9,
  "end": 65.9,
  "text": " \u0915\u094d\u092f\u0941\u0917\u0940 \u0938\u091a\u092e\u0947\u0902\u0964"
 }
