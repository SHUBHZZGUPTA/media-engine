[
 {
  "start": 0.0,
  "end": 1.86,
  "text": " \u092e\u0948\u0902 100 \u0921\u094b\u0932\u0930 \u0915\u0940 \u0936\u093f\u0930\u094d\u091f \u0932\u0917\u093e\u0924\u093e \u0939\u0942\u0901"
 },
 {
  "start": 1.86,
  "end": 4.06,
  "text": " \u0906\u092a\u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e\u0924\u093e \u0915\u0940 \u0915\u0941\u091b \u0915\u0902\u091f\u094d\u0930\u0940\u0938 \u0926\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u092d\u0940 \u092d\u0940\u0932\u0941\u0916\u093e\u0921"
 },
 {
  "start": 4.06,
  "end": 5.64,
  "text": " \u092a\u0930 \u0938\u093e\u0907\u091c \u092e\u0947\u0902 \u0932\u0917\u093e\u092c \u090f\u0915 \u091c\u0948\u0938\u0940 \u0939\u0948\u0902"
 },
 {
  "start": 5.64,
  "end": 6.5,
  "text": " \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 6.5,
  "end": 7.36,
  "text": " \u0928\u092e\u092c\u0930 \u092b\u093e\u0907\u0935 \u0938\u0947"
 },
 {
  "start": 7.36,
  "end": 8.62,
  "text": " \u0928\u0947\u092a\u093e\u0932 \u0914\u0930 \u092d\u093e\u0902\u0917\u0932\u093e\u0926\u0947\u0936"
 },
 {
  "start": 8.62,
  "end": 10.32,
  "text": " \u0926\u094b\u0928\u094b \u092c\u0938 22 \u0915\u093f\u0932\u093e\u092e\u0940\u091f\u0930 \u0926\u0942\u0930 \u0939\u0948\u0902"
 },
 {
  "start": 10.42,
  "end": 13.58,
  "text": " \u092f\u0915 \u092e\u093e\u0901\u091f \u090f\u0935\u0930\u093f\u0938\u094d\u091f \u0938\u0947 \u0906\u0938\u094d\u092e\u093e\u0928 \u091a\u0942\u091f\u093e \u0939\u0948, \u0914\u0930 \u0926\u0941\u0938\u094d\u0930\u093e \u0905\u092a\u0928\u0940 \u0928\u0926\u093f\u092f\u094b \u0938\u0947 \u0938\u092e\u0928\u094d\u0926\u0930."
 },
 {
  "start": 13.72,
  "end": 16.5,
  "text": " \u0928\u092e\u094d\u092c \u092b\u0930, \u0917\u093f\u0928\u0940 \u0914\u0930 \u092f\u0941\u0928\u093e\u0907\u091f\u094d\u091f\u093f\u091f \u0915\u093f\u0902\u0917\u092e, \u092f\u0915\u0940\u0928 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e."
 },
 {
  "start": 16.58,
  "end": 19.76,
  "text": " \u0915\u092d\u0940 \u0926\u0941\u0928\u094d\u092f\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0906\u0902\u092a\u093e\u092f\u0930, \u0906\u091c \u0909\u0938\u0915\u093e \u0905\u0930\u094d\u092f\u093e \u092c\u0938 \u0917\u093f\u0928\u0940 \u091c\u093f\u0924\u0928\u093e \u0939\u0948."
 },
 {
  "start": 19.88,
  "end": 20.44,
  "text": " \u0915\u093f\u0924\u0928\u093e \u0926\u0941\u0916\u0921\u0926?"
 },
 {
  "start": 20.44,
  "end": 22.24,
  "text": " 3. \u091a\u093f\u0932\u0940 \u0914\u0930 \u091c\u093e\u092e\u094d\u092d\u094d\u092f\u093e"
 },
 {
  "start": 22.24,
  "end": 24.58,
  "text": " \u091c\u093e\u092e\u094d\u092d\u094d\u092f\u093e \u0915\u094b \u091a\u0942\u0907\u0902\u0917\u092e \u0915\u0940 \u0924\u0930\u093e \u0916\u0940\u0902\u091a\u094b \u0924\u094b \u0909\u0924\u0928\u0940 \u0939\u0940 \u092c\u0921\u0940"
 },
 {
  "start": 24.58,
  "end": 25.56,
  "text": " \u090f\u0915 \u0914\u0930 \u091a\u093f\u0932\u0940 \u092c\u0928 \u091c\u093e\u090f\u0917\u0940"
 },
 {
  "start": 25.56,
  "end": 27.38,
  "text": " 2. \u0907\u091f\u0932\u0940 \u0914\u0930 \u092b\u093f\u0932\u093f\u092a\u093f\u0928\u0940\u0938"
 },
 {
  "start": 27.38,
  "end": 28.82,
  "text": " \u090f\u0915 \u091c\u0942\u091f\u0947 \u091c\u0948\u0938\u093e \u0926\u093f\u0915\u0924\u093e \u0939\u0948"
 },
 {
  "start": 28.82,
  "end": 30.62,
  "text": " \u0914\u0930 \u0926\u0942\u0938\u094d\u0930\u093e \u092d\u0947\u0920\u0947 \u0939\u0941\u090f \u0906\u0926\u094d\u092e\u0940 \u091c\u0948\u0938\u093e"
 },
 {
  "start": 30.62,
  "end": 33.4,
  "text": " \u092c\u0930 \u0926\u094b\u0928\u094b \u0915\u094b \u091c\u094b\u093c\u0921 \u0926\u094b \u0924\u094b \u092a\u0941\u0921\u093e \u0905\u0902\u0938\u093e\u0928 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948"
 },
 {
  "start": 33.4,
  "end": 34.38,
  "text": " \u0914\u0930 \u0928\u092e\u092c\u0930 \u0935\u0928 \u0939\u0948"
 },
 {
  "start": 34.38,
  "end": 35.72,
  "text": " \u092e\u0932\u0947\u0936\u093f\u092f\u093e \u0914\u0930 \u0935\u093f\u0924\u0928\u093e\u092e"
 },
 {
  "start": 35.72,
  "end": 36.96,
  "text": " \u0924\u094b\u0928\u094b \u0938\u093e\u0925 \u090f\u091c\u092e\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 36.96,
  "end": 38.52,
  "text": " \u0924\u094b\u0928\u094b \u0915\u0947 \u0932\u0902\u092c\u0947 \u0915\u094b\u0938 \u0932\u093e\u0907\u0902\u091f \u0939\u0948\u0902"
 },
 {
  "start": 38.52,
  "end": 39.76,
  "text": " \u0914\u0930 \u0938\u093e\u0907\u091c \u0932\u0917\u0917 \u092c\u0930\u093e\u092c\u0930"
 },
 {
  "start": 39.76,
  "end": 40.4,
  "text": " \u0932\u0917\u0924\u093e \u0939\u0948"
 },
 {
  "start": 40.4,
  "end": 42.32,
  "text": " \u092f\u0947 \u090f\u0915 \u0926\u0942\u0938\u094d\u0930\u0947 \u0915\u0947 \u0932\u093f\u092f\u0947 \u0939\u0940 \u092c\u0928\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 42.32,
  "end": 43.32,
  "text": " \u0926\u092c\u0932 \u0914\u0930 \u0928\u092b\u093f\u0902\u0915\u0930\u0947\u0902"
 }
