 {
  "start": 9.0,
  "end": 10.68,
  "text": " \u0924\u094b \u0907\u0938\u0947 \u0920\u093e\u092e\u0947 \u0915\u094b\u0908 \u0939\u0948\u0902?"
 },
 {
  "start": 10.72,
  "end": 12.86,
  "text": " \u0907\u0938 \u0905\u0915\u094d\u0924\u094b\u092c\u0930 \u091f\u0947\u0938\u094d\u0932\u093e \u0928\u0947 \u0905\u092a\u0928\u0940 \u0928\u0939\u0940\u0902 \u0930\u094b\u091f\u094d\u0938\u094d\u091f\u0930"
 },
 {
  "start": 12.86,
  "end": 15.38,
  "text": " \u0905\u0930 \u090f\u0915 \u0909\u092e\u093e\u0935\u094d\u0926\u093e\u0930 \u0930\u092e\u092a\u0930 \u091a\u093c\u093e\u0908 \u0914\u0930 \u0930\u094b\u0915 \u0926\u0940"
 },
 {
  "start": 15.38,
  "end": 18.82,
  "text": " \u092e\u093e\u0935 \u0915\u0940 \u091c\u0940\u090f, \u092e\u0948\u0902 \u0916\u0940\u091c \u0930\u0939\u0942\u0902, \u0915\u0941\u091b \u0939\u094b\u0908 \u0928\u0940\u0930\u093e"
