[
 {
  "start": 0.0,
  "end": 3.06,
  "text": " \u0906\u092a \u091c\u094b \u0926\u0947\u0916 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0935\u094b \u091f\u094d\u0930\u093f\u0915 \u0936\u094b\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0902"
