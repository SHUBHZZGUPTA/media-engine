 {
  "start": 18.82,
  "end": 21.34,
  "text": " \u091f\u094d\u0930\u093f\u0915 \u092f\u0947 \u0939\u0948, \u0939\u0935\u093e \u092d\u093e\u0930\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948"
 },
 {
