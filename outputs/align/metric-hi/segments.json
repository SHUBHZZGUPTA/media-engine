[
 {
  "start": 0.0,
  "end": 3.34,
  "text": " \u0939\u0930 \u0906\u092e\u0947\u0930\u093f\u0915\u0940 \u0930\u0942\u0932\u0930 \u0905\u0938\u0932 \u092e\u0947\u0902 \u091a\u0941\u092a\u0915\u0947 \u0938\u0947 \u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0939\u0948"
 },
 {
  "start": 3.34,
  "end": 9.18,
  "text": " 1893 \u0938\u0947 \u0906\u092e\u0947\u0930\u093f\u0915\u093e \u0905\u092a\u0928\u093e \u0907\u0902\u091a \u0914\u0930 \u092a\u093e\u0923\u094d\u0921, \u092e\u0940\u091f\u0930 \u0914\u0930 \u0915\u093f\u0932\u094b\u0917\u094d\u0930\u093e\u092e \u0938\u0947 \u0924\u0948\u0915\u0930\u0924\u093e \u0939\u0948"
 },
 {
  "start": 9.46,
  "end": 14.22,
  "text": " \u0906\u091c \u090f\u0915 \u0907\u0902\u091a \u0924\u0940\u0915 \u0924\u094b \u0926\u0936\u092e\u0932\u093e \u092a\u093e\u091a \u091a\u093e\u0930 \u0938\u0902\u091f\u093f\u092e\u0940\u091f\u0930 \u0939\u0948, \u092a\u0930 \u0907\u092c \u0939\u093e\u0901\u0936\u093e \u0938\u0947"
 },
 {
  "start": 14.22,
  "end": 16.96,
  "text": " \u0936\u094d\u0935, \u0915\u093f\u0938\u0940 \u0915\u094b \u092e\u0924 \u092c\u0924\u093e\u0928\u093e \u0915\u0940 \u092e\u0947\u0902 \u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0939\u0942\u0901"
 },
 {
  "start": 17.15,
  "end": 19.89,
  "text": " \u092b\u093f\u0930 \u092d\u0940 \u0906\u092e\u0917\u0930\u0947\u0915\u093e\u0928\u0947 \u0915\u092d\u0940 \u092a\u0942\u0930\u0940 \u0924\u0930\u093e \u0936\u094d\u0935\u093f\u091b \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e"
 },
 {
  "start": 19.89,
  "end": 24.029999999999998,
  "text": " \u0928\u093e\u0907\u0902\u091f\u0940\u0928 \u0938\u092c\u0928\u094d\u0924\u0940 \u092b\u0948\u0935 \u092e\u0947\u0902, \u0915\u094b\u0902\u0917\u094d\u0930\u0947\u0938 \u0928\u0947 \u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0915\u093e\u0928\u0942\u0928 \u092a\u093e\u0938 \u0915\u093f\u092f\u093e,"
 },
 {
  "start": 24.27,
  "end": 25.83,
  "text": " \u092a\u0930 \u0909\u0938\u0947 \u0905\u092a\u0928\u0940 \u092e\u0930\u094d\u091c\u0940 \u092a\u0930 \u091a\u094b\u0930 \u0926\u093f\u092f\u093e."
 },
 {
  "start": 26.11,
  "end": 29.73,
  "text": " \u091c\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092a\u0930\u0935\u093e\u0939\u0940 \u0928\u0939\u0940\u0902 \u0915\u0940, \u0914\u0930 \u092f\u0947 \u092e\u0939\u0947\u0902\u0917\u093e \u092a\u0921\u093e."
 },
 {
  "start": 30.29,
  "end": 34.37,
  "text": " 1999 \u092e\u0947\u0902 \u090f\u0915 \u091f\u0940\u0902\u0915\u0947 \u0938\u094b\u092b\u094d\u091f\u094d\u0935\u0930 \u0928\u0947 \u0928\u092e\u092c\u0938 \u0935\u0942\u0938 \u092f\u0942\u0928\u093f\u091f\u094d\u0938 \u092e\u0947\u0902 \u0926\u093f\u092f\u0947."
 },
 {
  "start": 34.58,
  "end": 37.12,
  "text": " \u091c\u092c \u0915\u0940 \u0928\u093e\u0938\u093e \u0915\u0940 \u0928\u093e\u0935\u093f\u0917\u0947\u0936\u0928 \u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u092e\u093e\u0928 \u0930\u0939\u0940 \u0925\u0940"
