 {
  "start": 37.12,
  "end": 41.0,
  "text": " \u092e\u093e\u0938 \u0916\u094d\u0932\u093e\u092e\u0947\u091f \u0905\u092c\u093f\u091f\u0930 \u092c\u0939\u0941\u0924 \u0928\u0940\u091a\u0947 \u0938\u0947 \u0917\u0941\u091c\u094d\u0930\u093e \u0914\u0930 \u0916\u094b \u0917\u092f\u093e"
 },
 {
  "start": 41.23,
  "end": 43.55,
  "text": " \u0924\u0940\u0928\u094d\u0938\u094b \u0938\u0925\u094d\u091f\u094d\u091f\u0940\u0936 \u092e\u093f\u0932\u094d\u092f\u0928 \u0921\u0932\u0930 \u0915\u093e \u092e\u093f\u0936\u0928"
 },
 {
  "start": 43.55,
  "end": 47.589999999999996,
  "text": " \u0914\u0930 \u0924\u094d\u0935\u0947\u0928\u094d\u0924\u0940 \u091f\u094d\u0935\u0947\u0928\u094d\u0924\u0940 \u0924\u0941 \u0924\u0915 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u092e\u0947\u0902 \u0926\u094b \u0930\u0917 \u0930\u0917 \u092b\u0941\u091f \u091a\u0932\u0924\u0947 \u0925\u0947"
 },
 {
  "start": 47.78,
  "end": 49.9,
  "text": " \u0907\u0915 \u0938\u0930\u0935\u0947\u092f\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0924\u094b\u0921\u093e \u0932\u0902\u092c\u093e"
 },
 {
  "start": 49.9,
  "end": 52.44,
  "text": " \u0930\u0941\u0915\u094b \u092e\u0948\u0902 \u0915\u094b\u0902\u0938\u093e \u092b\u0941\u0924 \u0939\u0942\u0901"
 },
 {
  "start": 52.44,
  "end": 54.260000000000005,
  "text": " \u0924\u094b \u0906\u092e\u0947\u0930\u093f\u0915\u093e\u0928\u0947 \u0938\u094d\u0935\u093f\u091a \u0915\u094d\u092f\u094b \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e"
 },
 {
  "start": 54.47,
  "end": 58.79,
  "text": " \u0906\u0926\u0924, \u0914\u0930 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932\u0928\u0947 \u0915\u093e \u0916\u0930\u094d\u091a, \u0930\u094b\u091f \u0938\u093e\u0908\u0928 \u0938\u0947 \u0932\u093f\u0915\u0930 \u0930\u0948\u0938\u0947\u092a\u0940\u0938 \u0926\u0916."
