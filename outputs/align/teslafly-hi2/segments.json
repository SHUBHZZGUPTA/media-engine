 },
 {
  "start": 27.080000000000002,
  "end": 30.54,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u0930\u094b\u091f\u0938\u094d\u091f\u0930 \u0915\u0947 \u091a\u093e\u0930 \u092b\u093e\u0928\u094d\u0938 \u0907\u0938\u0915\u0947 \u0928\u0940\u091a\u0947 \u0938\u0947 \u0939\u0935\u093e \u0916\u0940\u091a \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964"
