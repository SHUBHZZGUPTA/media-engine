  "end": 32.28,
  "text": " \u0928\u0940\u091a\u0947 \u0915\u092e \u0939\u0935\u093e, \u092c\u093e\u0939\u0930 \u0909\u0924\u0928\u0940 \u0939\u0940\u0964"
 },
 {
  "start": 32.46,
  "end": 34.32,
  "text": " \u0924\u094b \u0939\u0935\u093e \u0907\u0938\u0947 \u0938\u0921\u093c\u0915 \u0938\u0947 \u091a\u093f\u092a\u0915\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
 },
 {
  "start": 34.36,
  "end": 36.3,
  "text": " \u0909\u0932\u094d\u091f\u093e \u0939\u094b\u0928\u0947 \u092a\u0930 \u092d\u0940, \u0915\u093f\u0924\u0928\u093e \u091c\u094b\u0930?"
 },
 {
  "start": 36.5,
  "end": 39.34,
  "text": " \u0924\u0947\u0938\u094d\u0932\u093e \u0915\u093e \u0926\u093e\u0935\u093e \u0939\u0948 \u0915\u0930\u0940\u092c 4700 \u0915\u093f\u0932\u094b\u091c"
 },
 {
  "start": 39.34,
  "end": 43.2,
  "text": " \u0935\u091c\u0928 \u0915\u093e \u0932\u0917\u092d\u092d\u0917 3 \u0917\u0941\u0928\u093e, \u0932\u0917\u092d\u092d\u092d 3 \u0938\u0947 1 \u092c\u0924\u094d\u0924\u092e\u0940\u091c\u0940"
 },
 {
  "start": 43.2,
  "end": 46.34,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0924\u0947\u0938\u094d\u0932\u093e \u0915\u0940 \u0916\u094b\u091c \u0928\u0939\u0940\u0902 \u0939\u0948, \u091a\u0932\u093f\u092f\u0947 1978 \u092e\u0947\u0902"
 },
 {
  "start": 46.36,
  "end": 52.96,
  "text": " \u0938\u094d\u0935\u0940\u0921\u0928 \u092e\u0947\u0902 \u090f\u0915 \u092b\u093e\u092e\u093f\u0932\u093e \u0913\u0928 \u0915\u093e\u0930 \u0926\u094b\u0921\u0940, \u092a\u0940\u091a\u0947 \u090f\u0915 \u092c\u0921\u093c\u0947 \u092b\u093e\u0928 \u0915\u0947 \u0938\u093e\u0925, \u092f\u0947 \u0907\u0902\u091c\u0941\u0928 \u0925\u0902\u0921\u093c\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0938\u091a\u094d\u091a\u0940."
 },
 {
  "start": 53.1,
  "end": 57.6,
  "text": " \u0907\u0938\u0928\u0947 \u0905\u092a\u0928\u0940 \u090f\u0915\u0932\u094b\u0924\u0940 \u0930\u0947\u091c \u0906\u0927\u0947 \u092e\u093f\u0928\u093f\u091f \u0938\u0947 \u091c\u0940\u0924\u0940, \u092b\u093f\u0930 \u092b\u093e\u0928 \u0915\u093e\u0930\u094d\u0938 \u092a\u0930 \u092c\u0948\u0928 \u0932\u0917 \u0917\u092f\u093e."
 },
 {
  "start": 57.7,
  "end": 62.32,
  "text": " \u0924\u094b \u0930\u094b\u091f\u094d\u0938 \u0924\u0915 \u0917\u094d\u0930\u093e\u0935\u093f\u091f\u0940 \u0915\u094b \u0939\u0930\u093e \u0928\u0939\u0940\u0902 \u0930\u0939\u0940 \u092f\u0939 \u0906\u0938\u094d\u092e\u093e\u0928 \u0915\u094b \u0939\u0940 \u0909\u0938\u0915\u0947 \u0916\u093f\u0932\u093e\u0935 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964"
 },
 {
  "start": 62.32,
  "end": 65.28,
  "text": " \u0914\u0930 \u0928\u0940\u091a\u0947 \u0915\u0948\u0938\u0947 \u0906\u092f? \u092f\u0939 \u0909\u0930\u0924\u0940 \u0939\u0948\u0902, \u0915\u0941\u091b \u0939\u0925 \u0924\u0915\u0964"
 },
 {
  "start": 65.28,
  "end": 69.3,
  "text": " \u0938\u094d\u092a\u0947\u0938\u0947\u0915\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0928\u0947 \u0926\u0938 \u0924\u094d\u0930\u0938\u094d\u091f\u0930\u094d\u0938 600 \u0932\u093f\u091f\u0930\u094d\u0938 \u0926\u092c\u0940 \u0939\u0935\u093e \u091b\u094b\u0921\u0924\u0947 \u0939\u0948\u0902."
 },
 {
  "start": 69.7,
  "end": 80.32000000000001,
  "text": " \u092e\u093e\u091c \u0924\u0947\u0938\u094d\u0932\u093e\u091c \u0915\u0947 \u0909\u092a\u0930 \u0938\u0947 \u0915\u0942\u0926\u0940, \u0939\u0935\u093e \u092e\u0947\u0902 \u0918\u0942\u092e\u0940 \u0914\u0930 \u0909\u0924\u0930 \u0917\u0908, \u0905\u0902\u0926\u0930 \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u0925\u093e, \u0924\u0947\u0938\u094d\u0932\u093e \u0915\u0939\u0924\u0940 \u0939\u0948 \u092a\u094d\u0930\u094b\u0921\u093c\u0915\u094d\u0937\u0928 2020 \u090f\u091f \u092e\u0947\u0902 \u0936\u0941\u0930\u0942 \u0939\u094b\u0917\u093e, \u092a\u0939\u0932\u093e \u0935\u093e\u0926\u093e \u0925\u093e 2020 \u0915\u093e, \u0906\u0930\u093e\u092e \u0938\u0947 \u092e\u0948\u0902 \u092f\u0939\u0940 \u0939\u0942\u0902\u0964"
 },
 {
  "start": 80.36,
  "end": 83.96,
  "text": " \u092f\u0947 \u0939\u0948 \u092d\u0942\u0917\u0942\u0932\u0964 \u0910\u0938\u0947 \u092f\u0947 \u092e\u091c\u093f\u0926\u093e\u0930 \u091c\u094d\u092f\u094b\u0917\u094d\u0930\u092b\u0940 \u092b\u093e\u0915\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u0949\u0932\u094b \u0915\u0930\u0947\u0902\u0964"
 }
