  "end": 9.12,
  "text": " \u0905\u091f\u0940 \u0938\u093e\u0932 \u0924\u0947 \u091c\u092f\u093e\u0926 \u092a\u0928\u092e\u093e, \u0916\u0942\u0932\u0902\u092c\u094d\u092f\u093e \u0915\u093e \u0939\u093f\u0938\u094d\u091a\u093e \u0918\u093e"
 },
 {
  "start": 9.12,
  "end": 11.38,
  "text": " \u092b\u093f\u0930 \u0906\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u094b \u090f\u0915 \u0916\u0928\u093e\u0932 \u091a\u093e\u0939\u093f\u090f \u0925\u0940"
 },
 {
