  "end": 23.04,
  "text": " \u0924\u0941 \u0939\u093e\u0901\u0925\u0947 \u092c\u093e\u0926 \u0906\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u094b \u0909\u0938\u0915\u0940 \u0915\u0928\u093e\u0932 \u0921\u0940\u0932 \u092e\u093f\u0932 \u0917\u090f"
 },
 {
  "start": 23.04,
  "end": 27.62,
  "text": " \u0915\u0928\u093e\u0932 \u0916\u0941\u0932\u0940 1914 \u092e\u0947\u0902 \u092a\u093e\u0928\u092e\u093e \u092e\u0947\u0902, \u0915\u0932\u0902\u092c\u094d\u092f\u093e \u092e\u0947\u0902 \u0928\u0939\u0940\u0902"
