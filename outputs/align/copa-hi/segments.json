  "end": 13.9,
  "text": " \u0914\u0930 \u0916\u0942\u0932\u0902\u092c\u094d\u092f\u093e \u0928\u0947 \u092e\u0928\u093e \u0915\u0930 \u0926\u093f\u092f\u093e"
 },
 {
  "start": 13.9,
  "end": 18.8,
  "text": " \u0924\u094b 1903 \u092e\u0947\u0902 \u092a\u093e\u0928\u092e\u093e \u0905\u0932\u0917 \u0939\u094b \u0917\u092f\u093e \u0914\u0930 U.S \u0915\u0947 \u091c\u0902\u0917\u0940 \u091c\u093e\u0939\u0938 \u0926\u0947\u0915 \u0924\u0947 \u0930\u0939\u0947\u0902"
 },
 {
