[
 {
  "start": 0.0,
  "end": 2.76,
  "text": " \u0906\u0926\u0930 \u0916\u0942\u0932\u0902\u092c\u094d\u092f\u093e \u0914\u0930 \u092a\u0928\u092e\u093e \u090f\u0915 \u0926\u0947\u0936 \u092c\u0928 \u091c\u093e\u090f?"
 },
 {
  "start": 3.08,
  "end": 5.68,
  "text": " \u091c\u0941\u090f\u091a\u094d\u0924 \u092f\u0947 \u0939\u0948 \u092f\u0947 \u092a\u0939\u0932\u0947 \u092d\u0940 \u090f\u0915 \u0925\u0947"
 },
 {
