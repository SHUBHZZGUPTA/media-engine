  "end": 32.12,
  "text": " \u0924\u094b \u0906\u091c \u092f\u0947 \u0926\u0947\u0936 \u0915\u0948\u0938\u093e \u0939\u094b\u0917\u093e? 58 \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917, \u0924\u094b \u0938\u092e\u0928\u0926\u0930"
 },
 {
  "start": 32.12,
  "end": 33.76,
  "text": " \u0914\u0930 \u092a\u0948\u0928\u092e\u093e \u0915\u093f\u0928\u093e\u0932 \u092d\u0940"
 },
 {
  "start": 33.76,
  "end": 37.2,
  "text": " \u0914\u0930 \u0907\u0938\u0915\u0940 \u0907\u0915\u094b\u0928\u092e\u0940 \u0928\u094b\u0930\u0935\u0947 \u0914\u0930 \u0938\u093f\u0902\u0917\u093e\u092a\u094b\u0930 \u0938\u0947 \u092d\u0940 \u092c\u0921\u093c\u0940"
 },
 {
  "start": 37.94,
  "end": 40.6,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0905\u092d\u0940 \u0938\u092c \u0938\u0947 \u0905\u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948"
