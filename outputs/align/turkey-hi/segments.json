  "end": 43.09,
  "text": " \u0926\u093f\u0935\u093e\u0930 \u0924\u0942\u091f\u0940 \u0914\u0930 \u0907\u0915 \u0936\u0947\u0939\u0930 \u092e\u093f\u0932\u093e."
 },
 {
  "start": 43.269999999999996,
  "end": 44.97,
