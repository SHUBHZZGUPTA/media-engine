[
 {
  "start": 0.0,
  "end": 7.92,
  "text": " \u0906\u092a \u0916\u0930 \u0915\u0940 \u0926\u093f\u0935\u093e\u0930 \u0924\u094b\u0921\u093c\u0947\u0902 \u0914\u0930 \u090f\u0915 \u0916\u094b\u092f\u093e \u0936\u0948\u0939\u0930 \u092e\u093f\u0932 \u091c\u093e\u090f\u0902, \u0924\u0942\u0915\u0940 \u092e\u0947\u0902 \u0910\u0938\u093e \u0939\u0942\u0901\u0901 \u092f\u0947 \u0928\u092e\u092c\u092c\u091f \u0924\u0942\u0915\u0940 \u0915\u0947 6 Facts \u0924\u0942\u0915\u0935\u0947\u0917 \u0932\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
 },
 {
  "start": 8.14,
  "end": 11.1,
  "text": " \u0914\u0930 \u0928\u092e\u092c \u0935\u0928 \u0924\u094b\u0917\u0940 \u092a\u0930 \u0939\u0948 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0928\u092e\u092c \u0936\u093f\u0915\u094d\u0938"
 },
 {
  "start": 11.28,
  "end": 19.14,
  "text": " \u0907\u0938\u094d\u091f\u093e\u0928\u094d\u092c\u0942\u0932 \u0924\u094b \u0915\u094b\u0902\u091f\u0928\u0947\u0902\u091f\u094d\u0938 \u092a\u0930 \u092c\u0938\u093e \u0939\u0948, \u0915\u093e\u092e \u092f\u094b\u0930\u0935\u092a \u092e\u0947\u0902, \u0928\u0940\u0902\u0926 \u090f\u0936\u094d\u092f\u093e \u092e\u0947\u0902, \u0914\u0930 \u092f\u0947 \u0915\u093e\u092a\u093f\u091f\u0932 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0915\u093e\u092a\u093f\u091f\u0932 \u0939\u0948 \u0905\u0902\u0915\u0930\u093e, \u0928\u092e\u092c \u092b\u093e\u0907\u0935."
 },
 {
  "start": 19.14,
  "end": 26.38,
  "text": " \u0924\u0930\u094d\u0915\u0940 \u0915\u0947 \u092a\u093e\u0938 \u092a\u0941\u0930\u093e \u090f\u0915 \u0938\u092e\u0941\u0926\u094d\u0930 \u0939\u0948, \u092e\u093e\u0930\u094d\u092e\u0930\u093e, \u092a\u0941\u0930\u093e \u0909\u0938\u0915\u0940 \u0938\u0940\u092e\u093e \u0915\u0947 \u0905\u0902\u0926\u0930, \u0914\u0930 \u0907\u0938\u0947 \u0926\u0941\u0928\u094d\u092f\u093e \u0915\u093e \u0938\u092c \u0938\u092c \u091a\u094b\u091f\u093e \u0938\u092e\u0941\u0926\u094d\u0930 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902."
 },
 {
  "start": 26.42,
  "end": 29.299999999999997,
  "text": " \u0924\u094b \u090f\u0915 \u0939\u0940 \u0926\u0947\u0936 \u092e\u0947\u0902 \u092f\u0947 \u0938\u092c \u0915\u094d\u092f\u0942, \u092f\u0947 \u0938\u0935\u093e\u0932 \u092f\u093e\u0926 \u0930\u0916\u093f\u092f\u0947."
 },
 {
  "start": 29.299999999999997,
  "end": 36.5,
  "text": " 4. \u0938\u093e\u0928\u094d\u091f\u0930\u094d\u0915\u094d\u0932\u094b\u0938 \u0924\u0930\u094d\u0915\u0940 \u0938\u0947 \u0939\u0948, \u0915\u0941\u091b \u0939\u0924\u094d\u0924\u0915, \u0938\u0947\u0902\u091f \u0928\u093f\u0915\u0941\u0932\u0938 \u092d\u093f\u0937\u094d\u0935\u092a \ufffdthe, \u092e\u0948\u0930\u093e \u0915\u0947 \u0906\u091c\u0915\u093e \u0926\u0947\u092e\u094d\u0930\u0947, No. 3."
 },
 {
  "start": 36.75,
  "end": 41.05,
  "text": " \u0935\u094b \u0926\u093f\u0935\u093e\u0930, 1963 \u092e\u0947\u0902 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u090f\u0915 \u0906\u0926\u094d\u092e\u0940 \u0917\u0930 \u0920\u0940\u0916 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e,"
 },
 {
