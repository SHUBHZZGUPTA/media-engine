 },
 {
  "start": 47.91,
  "end": 50.69,
  "text": " 20,000 \u0932\u094b\u0917\u094b\u0902 \u0924\u0915 \u0915\u0940 \u091c\u0917\u093e \u0909\u0928\u0915\u0947 \u091c\u093e\u0928\u0935\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925."
 },
 {
