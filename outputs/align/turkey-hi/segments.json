  "text": " \u092a\u0924\u094d\u0924\u0930 \u0915\u0947 \u0916\u0902\u092c\u0947 \u0916\u093c\u0947 \u0939\u0941\u090f \u0915\u0930\u0940\u092c 11500 \u0938\u093e\u0932 \u092a\u0939\u0932\u0947,"
 },
 {
  "start": 56.769999999999996,
  "end": 59.93,
  "text": " \u0936\u094d\u091f\u094b\u0928 \u0939\u0947\u0902\u091a\u094d\u0938\u0940 6000 \u0938\u093e\u0932 \u092a\u0939\u0932\u0947, \u0932\u093f\u0916\u093e\u0935\u0924 \u0938\u0947 \u092d\u0940 \u092a\u0939\u0932\u0947."
