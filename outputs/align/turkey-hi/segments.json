 },
 {
  "start": 65.01,
  "end": 68.17,
  "text": " 1. \u0907\u0902\u0917\u094d\u0932\u093f\u0936 \u092e\u0947\u0902 \u090f\u0915 \u092a\u0915\u094d\u0937\u0940 \u0915\u093e \u0928\u093e\u092e \u0924\u0930\u094d\u0915\u0940 \u092a\u0921\u093e"
