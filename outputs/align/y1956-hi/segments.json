[
 {
  "start": 0.0,
  "end": 8.52,
  "text": " \u092c\u093e\u0930\u0924 \u0915\u0947 \u091a\u093e\u0930 \u0930\u093e\u091c\u094b \u0915\u093e \u092c\u0930\u091f\u094d\u091f\u0947 \u090f\u0915 \u0939\u0940 \u0926\u093f\u0928 \u0939\u0948, \u0906\u091c \u090f\u0915 \u0928\u0935\u0947\u092e\u092c\u0930 1956 \u0909\u0938\u0915\u0947 \u092a\u0939\u0932\u0947 \u092c\u093e\u0930\u0924 \u0915\u093e \u0928\u0915\u094d\u0937\u093e \u090f\u0915 \u091c\u094b\u0921 \u0924\u094b\u0930 \u0920\u093e."
 },
 {
  "start": 8.75,
  "end": 11.99,
  "text": " \u0909\u0928\u094d\u0924\u0940 \u0938\u093f\u0916\u093e\u092f\u093e \u092a\u093e\u0924 \u0906\u092c\u0940 \u0938\u0940 \u0914\u0930 \u0926\u0940 \u092e\u0947\u0902 \u092c\u091f\u0940 \u0939\u0941\u0908"
 },
 {
  "start": 11.99,
  "end": 13.61,
  "text": " \u0930\u0941\u0915\u094b \u092e\u0948\u0902 \u0915\u094b\u0902\u0938\u093e \u092a\u093e\u0924\u0942?"
 },
 {
  "start": 13.93,
  "end": 15.51,
  "text": " \u092b\u093f\u0930 \u0928\u093e\u0907\u0928\u094d\u091f\u0940\u0928 \u092b\u093f\u092b\u094d\u0937\u094d\u091f\u0940 \u0924\u0941 \u092e\u0947\u0902"
 },
 {
  "start": 15.51,
  "end": 17.89,
  "text": " \u092a\u094b\u091f\u0940 \u0936\u094d\u0930\u0940 \u0930\u093e\u092e\u0942\u0932\u0941\u0928\u0947 \u0924\u0947\u0932\u094d\u0917\u0941 \u092c\u094b\u0932\u0928\u0947 \u0935\u093e\u0932\u094b\u0902 \u0915\u0947"
 },
 {
  "start": 17.89,
  "end": 19.61,
  "text": " \u0905\u0932\u0917 \u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0905\u0902\u0936\u0928 \u091a\u0942\u0930\u094b \u0915\u093f\u092f\u093e"
 },
 {
  "start": 19.8,
  "end": 35.46,
  "text": " \u0905\u091f\u094d\u091f\u093e\u0935\u0928 \u0935\u0947 \u0926\u093f\u0928 \u0909\u0928\u0915\u0940 \u092e\u0941\u0924 \u0939\u094b \u0917\u090f, \u0924\u0940\u0928 \u0926\u093f\u0928 \u092c\u093e\u0926 \u0928\u0939\u0930\u0941\u0928\u0947 \u0906\u0928\u094d\u0926\u094d\u0930 \u0915\u093e \u0908\u0932\u093e\u0928 \u0915\u0930 \u0926\u093f\u092f\u093e, \u092b\u093f\u0930 \u090f\u0915 \u0906\u092f\u094b\u0915 \u0928\u0947 \u092c\u093e\u0936\u093e \u0915\u0947 \u0906\u0926\u093e\u0930 \u092a\u0930 \u0928\u0915\u094d\u0937\u093e \u0926\u0941\u092c\u093e\u0930\u093e \u092c\u0928\u093e\u092f\u093e, \u0914\u0930 \u090f\u0915 \u0928\u0935\u092e\u092c\u0930 1956 \u0915\u094b \u0909\u0928\u094d\u0924\u0940 \u0938\u0947 \u0915\u093e\u092f\u093e \u092c\u0928 \u0917\u092f\u0902 \u091a\u094b\u0926 \u0939\u0930\u093e\u091c\u094d\u091c \u0914\u0930 \u091a\u0947 \u0915\u093f\u0928\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936, \u0909\u0938 \u0926\u093f\u0928 \u091c\u0928 \u092e\u0947\u0902 \u0915"
 },
 {
  "start": 35.46,
  "end": 49.46,
  "text": " \u0915\u0947\u0930\u0932, \u0906\u0928\u094d\u0926\u094d\u0930 \u092a\u094d\u0930\u0926\u0947\u0936, \u092e\u0926\u094d\u0926\u094d\u092f\u092a\u094d\u0930\u0926\u0947\u0936, \u091c\u094b \u0924\u092c \u0938\u092c \u0938\u0947 \u092c\u0921\u093c\u093e \u0930\u093e\u091c\u091c\u093c \u0924\u093e, \u0914\u0930 \u092e\u093e\u0907 \u0938\u094b\u0930 \u0938\u094d\u091f\u0947\u091f, \u091c\u094b 1973 \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 \u0915\u0930 \u0928\u093e\u091f\u0915 \u092c\u0928\u093e, \u0914\u0930\u0947 \u092e\u0947\u0930\u093e \u092c\u094b\u0921\u0930 \u0915\u093f\u0938\u094d\u0915\u093e\u092f\u093e, \u0914\u0930 \u0907\u0938 \u0938\u093e\u0932 \u0915\u0947\u0930\u0932 \u0938\u0924\u094d\u0924\u0930 \u0915\u093e \u0939\u094b \u0917\u092f\u093e, \u0907\u0915 \u0928\u0939\u0940\u0902 \u0906\u0926\u0947\u0915\u093e\u0930\u093f\u0915 \u0928\u093e\u092e \u0915\u0947 \u0938\u093e\u0925, \u0915\u0947\u0930\u0932\u092e."
 },
 {
  "start": 49.67,
  "end": 53.57,
  "text": " \u092f\u0947 \u0939\u0948 \u092d\u0942\u0917\u094b\u0932, \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u0926\u093e\u0930 \u091c\u094b\u0917\u0930\u092b\u0940 \u092b\u0915\u094d\u0924 \u0915\u0947 \u0932\u093f\u090f \u092b\u093e\u0932\u094b \u0915\u0930\u0947\u0902"
 }
]