[
 {
  "start": 0.0,
  "end": 6.7,
  "text": " \u092f\u0942\u0930\u092a \u0938\u0947 \u0906\u092a\u094d\u0930\u093f\u0915\u093e \u0926\u093f\u0916\u0924\u093e \u0939\u0948, \u092c\u0938 \u091a\u094b\u0921\u093e \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930 \u0926\u0942\u0930, \u092b\u093f\u0930 \u0935\u0939\u093e\u0901 \u0926\u094d\u0930\u093e\u0907\u0935 \u0915\u094d\u092f\u094b \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0964"
 },
 {
  "start": 6.7,
  "end": 11.4,
  "text": " \u092f\u0947 \u092e\u0948\u0902\u0939\u093e\u091f\u0928 \u0938\u0947 \u092d\u0940 \u091b\u094b\u091f\u093e \u0939\u0948, \u091a\u0948\u0928\u0932 \u0924\u0928\u0932 \u0924\u094b \u092a\u091a\u093e\u0938 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930 \u0915\u093e \u0939\u0948\u0964"
 },
 {
  "start": 11.4,
  "end": 14.04,
  "text": " \u0924\u094b \u092b\u094b\u091f\u0940\u0928 \u0924\u094b \u0906\u0938\u093e\u0928 \u0939\u0942\u0928\u093e \u091a\u093e\u0939\u093f\u092f\u0947, \u0939\u0948 \u0928\u093e?"
 },
 {
  "start": 14.04,
  "end": 19.08,
  "text": " \u092a\u0930 \u092a\u0947\u091a \u092f\u0947 \u0939\u0948, \u0926\u093f\u0915\u094d\u0915\u0924 \u0926\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0917\u0947\u0930\u093e\u0908 \u0939\u0948."
 },
 {
  "start": 19.8,
  "end": 25.02,
  "text": " \u0928\u094b \u0938\u094b \u092e\u0940\u091f\u0930 \u0924\u0915 \u0917\u0947\u0930\u093e, \u092c\u0940\u091a \u092e\u0947\u0902 \u092c\u0942\u0930\u091c \u0916\u0932\u0940\u092a\u093e \u0926\u0942\u092c\u093e\u0926\u094b, \u0914\u0930 \u0935\u094b \u0917\u093e\u092f\u092c."
 },
 {
  "start": 25.76,
  "end": 29.06,
  "text": " \u0909\u092a\u0930 \u0938\u0947 \u0924\u0947\u091c \u0926\u093e\u0930\u093e\u092f, \u0924\u0915\u094d\u0930\u093e\u0924\u0940 \u091f\u0947\u0915\u094d\u091f\u094b\u0928\u093f\u0915 \u092a\u094d\u0932\u0947\u091f\u094d\u0938,"
 },
 {
  "start": 29.4,
  "end": 32.58,
  "text": " \u0914\u0930 \u0926\u0942\u0928\u093f\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u092c\u093f\u0938\u0940 \u0936\u093f\u092a\u093f\u0902\u0917 \u0930\u093e\u0938\u094d\u0924\u094b \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915."
 },
 {
  "start": 32.58,
  "end": 35.5,
  "text": " \u0924\u0941 \u0926\u094b \u092e\u0939\u0926\u094d\u0935\u0940\u092a\u094b \u0915\u094b \u091c\u094b\u0921\u093c\u0947 \u0915\u0948\u0938\u0947?"
 },
 {
  "start": 36.0,
  "end": 38.5,
  "text": " \u091a\u0932\u094b, 1928 \u092e\u0947\u0902 \u091a\u0932\u0924\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 38.5,
  "end": 42.04,
  "text": " \u0907\u0915 \u091c\u0930\u094d\u092e\u0928 \u0906\u0927\u094d\u091f\u0947\u0915\u094d\u0924, \u0939\u0947\u0930\u094d\u092e\u0928 \u091c\u094b\u0930\u094d\u0917\u0932 \u0915\u0947 \u092a\u093e\u0938 \u0907\u0915 \u092a\u094d\u0932\u093e\u0928 \u0925\u093e"
 },
 {
  "start": 42.58,
  "end": 44.18,
  "text": " \u0936\u094d\u091f\u094d\u0930\u0947\u091f \u092a\u0930 \u0926\u0902\u092c \u092c\u0928\u093e\u0926\u094b"
 },
 {
  "start": 44.18,
  "end": 47.98,
  "text": " \u0914\u0930 \u092a\u0942\u0930\u0947 \u092e\u0947\u091f\u093f\u091f\u0930 \u0907\u0928\u094d\u092f\u0928\u094d\u092f\u0928 \u0915\u094b 200 \u092e\u0940\u091f\u0930 \u0924\u0915 \u0928\u0940\u091a\u0947 \u0915\u0930 \u0926\u094b"
 },
 {
  "start": 48.58,
  "end": 50.52,
  "text": " \u0932\u0917 \u092d\u0915 \u092b\u094d\u0930\u093e\u0902\u0938 \u091a\u093f\u0924\u094d\u0928\u0940 \u0928\u0939\u0940\u0902 \u091c\u092e\u0940\u0928"
 },
 {
  "start": 50.52,
  "end": 52.94,
  "text": " \u092e\u091a\u094d\u0932\u093f\u092f\u094b \u0938\u0947 \u0915\u093f\u0938\u0940\u0928\u0947 \u092a\u0942\u091a\u093e \u0939\u0940 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 52.94,
  "end": 54.16,
  "text": " \u0906\u0901\u0908\u0938\u093e \u0939\u0941\u0935\u093e \u0928\u0939\u0940\u0902"
 },
 {
  "start": 54.16,
  "end": 56.74,
  "text": " \u092b\u093f\u0930 1979 \u092e\u0947\u0902 \u0938\u094d\u092a\u0947\u0928 \u0914\u0930 \u092e\u0941\u0930\u094b\u0915\u094b\u0928\u0940"
 },
 {
  "start": 56.74,
  "end": 57.8,
  "text": " \u091c\u094b\u0921\u0928\u0947 \u0915\u093e \u092b\u0948\u0938\u094d\u0932\u093e \u0915\u093f\u092f\u093e"
 },
 {
  "start": 57.8,
  "end": 59.16,
  "text": " \u091a\u0932\u094b \u092c\u0928\u093e\u0924\u0947\u0902"
 },
 {
  "start": 59.16,
  "end": 61.04,
  "text": " \u0926\u0947\u0932 \u0936\u0941\u0930\u094b \u0915\u092c \u0915\u0930\u0947\u0902"
 },
 {
  "start": 61.04,
  "end": 63.26,
  "text": " \u0935\u0938 \u090f\u0915 \u0914\u0930 \u0938\u094d\u091f\u0921\u0940 \u0915\u0947 \u092c\u093e\u0926"
 },
 {
  "start": 63.26,
  "end": 65.28,
  "text": " 47 \u0938\u093e\u0932 \u092c\u093e\u0926"
 },
 {
  "start": 65.28,
  "end": 67.54,
  "text": " \u090f\u0915 \u0938\u094d\u091f\u0921\u0940 \u0915\u093e \u091c\u092c\u093e\u092c \u0906\u0916\u093f\u0930 \u0915\u093e\u0930"
 },
 {
  "start": 67.54,
  "end": 68.32,
  "text": " \u0905\u0932\u0917\u093e\u092f\u093e"
 },
 {
  "start": 68.32,
  "end": 79.42,
  "text": " \u092f\u0947 \u092e\u0941\u092e\u094d\u0915\u093f\u0928 \u0939\u0948, \u090f\u0915 \u0930\u0947\u0932 \u0924\u0928\u0932 \u0938\u092e\u0941\u0926\u094d\u0930 \u0938\u0947 475 \u092e\u0940\u091f\u0930 \u0928\u0940\u091a\u0947, \u091a\u093e\u0928\u0932 \u0924\u0928\u0932 \u0938\u0947 \u091a\u093e\u0930 \u0917\u0941\u0928\u093e \u0917\u0939\u0930\u0940, \u0938\u092a\u0947\u0908\u0928 \u0938\u0947 \u092e\u0941\u0930\u094b\u0915\u094b \u0938\u0930\u094d\u092b \u0924\u0940\u0938 \u092e\u093f\u0928\u0924 \u092e\u0947\u0902."
 },
 {
  "start": 79.56,
  "end": 86.3,
  "text": " \u0915\u092c \u0924\u0915? 2035? \u092f\u093e 2040? \u092e\u093f\u0932\u0915\u0930 \u0939\u094b\u0938\u094d\u0924 \u0939\u094b \u0930\u0939\u0947 2030 \u0935\u093e\u0932\u094d\u0921 \u0915\u092c \u0915\u093f\u0932\u093f\u090f \u0932\u0947\u0908\u0924?"
 },
 {
  "start": 86.3,
  "end": 91.5,
  "text": " \u092f\u093e \u092c\u0938 \u0930\u0941\u0915 \u091c\u093e\u0913, \u0906\u092a\u094d\u0930\u093f\u0915\u093e \u0939\u0930 \u0938\u093e\u0932 \u0915\u0941\u091b \u092e\u093f\u0932\u0940 \u092e\u0940\u091f\u0930 \u092f\u0942\u0930\u094b\u092a \u0915\u0940 \u0924\u0930\u092b \u0916\u093f\u0938\u0915 \u0930\u0939\u093e \u0939\u0948."
 },
 {
  "start": 92.0,
  "end": 96.62,
  "text": " \u0915\u0941\u091b \u092e\u093f\u0932\u0940\u0928 \u0938\u093e\u0932 \u0930\u0941\u0915\u094b, \u091c\u094d\u092f\u094b\u0932\u0917\u093f\u0938 \u0915\u0939\u0924\u0947 \u0939\u0948 \u092f\u0947 \u0917\u0906\u092a \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 \u092c\u0902\u0926 \u0939\u0941\u091c\u093e\u090f\u0915\u093e."
 },
 {
  "start": 97.2,
  "end": 98.82,
  "text": " \u0924\u092c \u0924\u0915 \u091b\u093f\u0902\u0924\u093e \u092e\u0924 \u0915\u0930\u094b."
 }
]