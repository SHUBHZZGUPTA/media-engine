[
 {
  "start": 0.0,
  "end": 1.98,
  "text": " What you're seeing isn't a trick shot."
 },
 {
  "start": 2.78,
  "end": 7.06,
  "text": " This car weighs almost 1.7 tons, and it's stopped upside down."
 },
 {
  "start": 7.58,
  "end": 10.62,
  "text": " No magnets, no glue, so what's holding it up?"
 },
 {
  "start": 11.3,
  "end": 15.66,
  "text": " This October, Tesla drove its new Roadster up a curved ramp and stopped."
 },
 {
  "start": 16.08,
  "end": 17.0,
  "text": " Excuse me?"
 },
 {
  "start": 17.68,
  "end": 18.36,
  "text": " I'm pulling."
 },
 {
  "start": 19.22,
  "end": 20.14,
  "text": " Nothing's happening."
 },
 {
  "start": 20.76,
  "end": 21.6,
  "text": " Here's the trick."
 },
 {
  "start": 22.1,
  "end": 22.98,
  "text": " Air is heavy."
 },
 {
  "start": 23.56,
  "end": 27.96,
  "text": " Every square meter around you carries about tons of air, roughly two elephants."
 },
 {
  "start": 27.96,
  "end": 31.84,
  "text": " But the Roadster's four fans suck the air out from under it."
 },
 {
  "start": 32.3,
  "end": 34.2,
  "text": " Less air below, same air outside."
 },
 {
  "start": 34.76,
  "end": 36.16,
  "text": " So the air pins it to the road."
 },
 {
  "start": 36.64,
  "end": 37.72,
  "text": " Even upside down."
 },
 {
  "start": 38.16,
  "end": 38.58,
  "text": " How hard?"
 },
 {
  "start": 39.22,
  "end": 41.7,
  "text": " Tesla claims about 4,700 kilograms."
 },
 {
  "start": 42.3,
  "end": 43.94,
  "text": " Nearly three times the car's weight."
 },
 {
  "start": 44.3,
  "end": 45.66,
  "text": " Nearly three to one?"
 },
 {
  "start": 46.4,
  "end": 46.68,
  "text": " Rude."
 },
 {
  "start": 47.18,
  "end": 48.64,
  "text": " But Tesla didn't invent this."
 },
 {
  "start": 48.96,
  "end": 50.36,
  "text": " Rewind to 1978."
 },
 {
  "start": 50.88,
  "end": 54.22,
  "text": " A Formula One car raced in Sweden with a giant fan on its back."
 },
 {
  "start": 54.46,
  "end": 56.32,
  "text": " It's for cooling the engine. Honest."
 },
 {
  "start": 56.32,
  "end": 59.24,
  "text": " It won its only race by over half a minute."
 },
 {
  "start": 59.58,
  "end": 64.3,
  "text": " Then fan cars got banned, so the Roadster isn't beating gravity, it's turning the sky"
 },
 {
  "start": 64.3,
  "end": 65.0,
  "text": " against it."
 },
 {
  "start": 65.2,
  "end": 65.94,
  "text": " And to come down?"
 },
 {
  "start": 66.3,
  "end": 66.72,
  "text": " It flies."
 },
 {
  "start": 67.48,
  "end": 67.86,
  "text": " Sort of."
 },
 {
  "start": 68.42,
  "end": 72.84,
  "text": " Ten thrusters, built with SpaceX, blast out 600 liters of squeezed air."
 },
 {
  "start": 73.16,
  "end": 76.38,
  "text": " It hopped over five Teslas, rolled in mid-air, and landed."
 },
 {
  "start": 76.92,
  "end": 77.66,
  "text": " Nobody inside."
 },
 {
  "start": 78.5,
  "end": 80.58,
  "text": " Tesla says production starts in 2028."
 },
 {
  "start": 81.14,
  "end": 82.46,
  "text": " First promised, 2020."
 },
 {
  "start": 83.0,
  "end": 83.76,
  "text": " Take your time."
 },
 {
  "start": 84.18,
  "end": 84.88,
  "text": " I'll be here."
 },
 {
  "start": 84.88,
  "end": 88.24,
  "text": " This is Boogal. Follow for more geography fun facts."
 }
]