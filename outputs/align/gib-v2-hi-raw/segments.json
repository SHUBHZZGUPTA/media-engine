[
 {
  "start": 0.0,
  "end": 6.28,
  "text": " \u092f\u093e\u0930\u0941\u092a \u0938\u0947 \u0906\u092a\u094d\u0930\u093f\u0915\u093e \u0926\u093f\u0915\u0924\u093e \u0939\u0948, \u092c\u0938 \u092b\u094b\u091f\u0940\u0928 \u0915\u093f\u0932\u094b\u092e\u0947\u091f\u0930 \u0926\u0942\u0930, \u092b\u093f\u0930 \u0935\u0939\u093e\u0902 \u0926\u094d\u0930\u093e\u0907\u0907\u092a \u0915\u094d\u092f\u094b \u0928\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0964"
 },
 {
  "start": 6.28,
  "end": 10.58,
  "text": " \u092f\u0947 \u092e\u0948\u0902\u0939\u093e\u091f\u0928 \u0938\u0947 \u092d\u0940 \u091a\u094b\u091f\u093e \u0939\u0948, \u091a\u0948\u0928\u0932 \u0924\u0930\u0928\u0932 \u0924\u094b \u092b\u093f\u0932\u094d\u091f\u0940 \u0915\u093f\u0932\u094b\u092e\u0947\u091f\u0930 \u0915\u093e \u0939\u0948\u0964"
 },
 {
  "start": 10.58,
  "end": 12.74,
  "text": " \u0924\u094b \u092b\u094b\u091f\u0940\u0928 \u0924\u094b \u0906\u0938\u093e\u0928 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u0940 \u0939\u0948, \u0939\u0948 \u0928\u093e?"
 },
 {
  "start": 12.74,
  "end": 17.18,
  "text": " \u092a\u0930 \u092a\u0947\u091a \u092f\u0947 \u0939\u0948, \u0926\u093f\u0916\u0915 \u0926\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0917\u0947\u0939\u0930\u093e\u0908 \u0939\u0948,"
 },
 {
  "start": 17.62,
  "end": 21.74,
  "text": " \u0928\u094b\u0938\u094b \u092e\u0940\u091f\u0930 \u0924\u0915 \u0917\u0947\u0939\u0930\u093e, \u092c\u0942\u0930\u094d\u091a \u0916\u0932\u0940\u092a \u0926\u0941\u092c\u093e\u0926\u094b, \u0914\u0930 \u0935\u094b \u0917\u093e\u092f\u092c."
 },
 {
  "start": 22.32,
  "end": 26.9,
  "text": " \u0924\u0947\u0938 \u0926\u0939\u093e\u0930\u093e\u0908, \u0924\u0915\u094d\u0930\u093e\u0924\u0940 \u092a\u0932\u0947\u091f\u094d\u0938, \u0914\u0930 \u0926\u0941\u092e\u094d\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u092d\u0940\u091c\u0940 \u0936\u093f\u092a\u094d\u091f\u093f\u0902\u0917 \u0930\u093e\u0938\u094d\u092a\u094b \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915."
 },
 {
  "start": 26.9,
  "end": 29.28,
  "text": " \u0924\u0941 \u0926\u094b \u092e\u0939\u093e\u0926\u0935\u0940\u092a\u094b\u0902 \u0915\u094b \u091c\u094b\u0921\u093c\u0947 \u0915\u0948\u0938\u0947?"
 },
 {
  "start": 29.82,
  "end": 32.32,
  "text": " \u091a\u0932\u094b, 1928 \u092e\u0947\u0902 \u091a\u0932\u0924\u0947 \u0939\u0948\u0902."
 },
 {
  "start": 32.32,
  "end": 35.7,
  "text": " \u090f\u0915 \u091c\u0930\u094d\u092e\u0928 \u0905\u0915\u094d\u091f\u0947\u0915\u094d\u091f, \u0939\u0947\u0930\u094d\u092e\u093e\u0928 \u091c\u0942\u0930\u094d\u0917\u0932 \u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 \u092a\u094d\u0932\u093e\u0928 \u0925\u093e."
 },
 {
  "start": 36.24,
  "end": 37.54,
  "text": " \u0938\u094d\u091f\u094d\u0930\u0947\u091f \u092a\u0930 \u0926\u093e\u092e \u092c\u0928\u093e\u0926\u094b."
 },
 {
  "start": 37.78,
  "end": 40.54,
  "text": " \u0914\u0930 \u092e\u0947\u091f\u093f\u091f\u0930 \u090f\u0928\u094d\u092f\u0928 \u0915\u094b 200 \u092e\u0940\u091f\u0930 \u0924\u0915 \u0928\u0940\u091a\u0947 \u0915\u0930 \u0926\u094b."
 },
 {
  "start": 41.02,
  "end": 42.9,
  "text": " \u0932\u0917\u094d\u092c\u093e\u0917 \u092b\u094d\u0930\u093e\u0928\u094d\u0938 \u091c\u093f\u0924\u0928\u0940 \u0928\u0939\u0940\u0902 \u091c\u092e\u0940\u0928."
 },
 {
  "start": 42.9,
  "end": 45.24,
  "text": " \u092e\u091a\u094d\u0932\u093f\u092f\u094b \u0938\u0947 \u0915\u093f\u0938\u0940\u0928\u0947 \u092a\u0942\u091a\u093e\u0908 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 45.24,
  "end": 46.34,
  "text": " \u0906\u0938\u093e \u0939\u0941\u0906 \u0928\u0939\u0940\u0902"
 },
 {
  "start": 46.9,
  "end": 50.0,
  "text": " 1979 \u092e\u0947\u0902 \u0938\u094d\u092a\u0940\u0928 \u0914\u0930 \u092e\u0941\u0930\u094b\u0915\u094b \u0928\u0947 \u091c\u0941\u0921\u0928\u0947 \u0915\u093e \u092b\u0948\u0938\u094d\u0932\u093e \u0915\u093f\u092f\u093e"
 },
 {
  "start": 50.0,
  "end": 51.46,
  "text": " \u091a\u0932\u094b \u092c\u0928\u093e\u0924\u0947 \u0939\u0948"
 },
 {
  "start": 51.46,
  "end": 53.78,
  "text": " \u0926\u0940\u0932 \u0936\u0941\u0930\u0942 \u0915\u092a \u0915\u0930\u0947\u0902"
 },
 {
  "start": 53.78,
  "end": 56.26,
  "text": " \u092c\u0938 \u090f\u0915 \u0914\u0930 \u0938\u094d\u091f\u0940 \u0915\u0947 \u092c\u093e\u0926"
 },
 {
  "start": 56.26,
  "end": 58.08,
  "text": " 47 \u0938\u093e\u0932 \u092c\u093e\u0926"
 },
 {
  "start": 58.08,
  "end": 60.28,
  "text": " \u090f\u0915 \u0938\u094d\u091f\u0940 \u0915\u093e \u091c\u0935\u093e\u092c \u0905\u0932\u0917\u093e\u092f\u093e"
 },
 {
  "start": 60.28,
  "end": 61.6,
  "text": " \u092f\u0947 \u092e\u0941\u092e\u0915\u093f\u0928 \u0939\u0948"
 },
 {
  "start": 61.6,
  "end": 62.74,
  "text": " \u090f\u0915 \u0930\u0947\u0932 \u091f\u0928\u0932"
 },
 {
  "start": 62.74,
  "end": 65.44,
  "text": " \u0938\u092e\u0941\u0926\u094d\u0930 \u0938\u0947 475 \u092e\u0940\u091f\u0930 \u0928\u0940\u091a\u0947"
 },
 {
  "start": 65.44,
  "end": 67.66,
  "text": " \u091a\u093e\u0928\u0932 \u0924\u0928\u0932 \u0938\u0947 4 \u0917\u0941\u0928\u093e \u0917\u0939\u0930\u0940"
 },
 {
  "start": 67.66,
  "end": 70.64,
  "text": " \u0938\u094d\u092a\u0940\u0928 \u0938\u0947 \u092e\u0941\u0930\u094b\u0915\u094b \u0938\u093f\u0930\u094d\u092b \u0924\u0940\u0938 \u092e\u093f\u0928\u0947\u091f \u092e\u0947\u0902"
 },
 {
  "start": 70.64,
  "end": 73.66,
  "text": " \u0915\u092c \u0924\u0915 2035 \u092f\u093e 2040"
 },
 {
  "start": 73.66,
  "end": 75.94,
  "text": " \u0905\u092a\u0928\u0947 2030 \u0935\u094b\u0932\u094d\u0917\u092c \u0915\u0947 \u0932\u093f\u090f \u0932\u0947\u091f"
 },
 {
  "start": 76.74000000000001,
  "end": 77.78,
  "text": " \u092f\u093e \u092c\u0938 \u0930\u0941\u0915 \u091c\u093e\u0913"
 },
 {
  "start": 77.78,
  "end": 79.88,
  "text": " \u0906\u092a\u094d\u0930\u093f\u0915\u093e \u0939\u0930 \u0938\u093e\u0932 \u092e\u093f\u0932\u0940 \u092e\u0940\u091f\u0930"
 },
 {
  "start": 79.88,
  "end": 81.24,
  "text": " \u092c\u0939\u0930 \u092f\u094b\u0930\u092a \u0915\u0940 \u0924\u0930\u092b \u0916\u0947 \u0938\u0915 \u0930\u0939\u093e \u0939\u0948"
 },
 {
  "start": 81.24,
  "end": 85.24,
  "text": " \u0915\u0941\u091b \u092e\u093f\u0932\u093f\u090f\u0928 \u0938\u093e\u0932 \u0930\u094b\u0915\u094b \u0914\u0930 \u0917\u094d\u092f\u093e\u092a \u0916\u0941\u0926 \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 \u092c\u0928\u094d\u0926 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948"
 },
 {
