[
 {
  "start": 0.0,
  "end": 6.64,
  "text": " \u0915\u094d\u092f\u093e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b, \u092f\u0947 \u091a\u094b\u091f\u093e \u0938\u093e \u0906\u0908\u0932\u0947\u0902\u091f, \u0906\u0926\u093e \u0938\u094d\u0935\u0940\u0921\u0928 \u0939\u0948, \u0914\u0930 \u0906\u0926\u093e \u092b\u093f\u0928\u0932\u0947\u0902\u091f, \u0914\u0930 \u092f\u0947 \u092c\u094b\u093c\u0930 \u0924\u094b \u0926\u0947\u0916\u094b."
 },
 {
  "start": 6.87,
  "end": 10.15,
  "text": " \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0906\u0938 \u091c\u0948\u0938\u093e \u0939\u0948, \u0915\u094b\u0908 \u0906\u0938\u093e \u092c\u0905\u0921\u0930 \u0915\u094d\u092f\u094b\u0902 \u092c\u0928\u093e\u090f\u0917\u093e?"
 },
 {
  "start": 10.61,
  "end": 15.23,
  "text": " \u092f\u0947 \u0939\u0948 \u092e\u093e\u0915\u0947\u091f, \u090f\u0915 \u0916\u093e\u0932\u0940 \u091a\u091f\u093e\u0928, \u0938\u094d\u0935\u0940\u0921\u0928 \u0914\u0930 \u092b\u093f\u0928\u0932\u0928 \u0915\u0940 \u092d\u0940\u091a."
 },
 {
  "start": 15.55,
  "end": 19.51,
  "text": " \u0928\u093e \u092a\u0947\u0921 \u0928\u093e \u0932\u094b\u0917 \u092c\u0938 \u0925\u092c \u0938\u0940 \u0930\u0935\u091a\u094d\u091f\u0940 \u092e\u0940\u091f\u0930 \u0915\u0940 \u091a\u091f\u093e\u0928"
 },
 {
  "start": 19.51,
  "end": 22.990000000000002,
  "text": " \u090f\u091f\u0940\u0928\u094b \u0932\u093e\u0908\u0928 \u092e\u0947\u0902 \u0938\u0942\u0913\u0926\u0928 \u0928\u0947 \u092b\u093f\u0932\u0928\u094d\u0930\u0936\u094d\u092f\u093e \u0924\u0947\u0939\u093e\u0930 \u0926\u093f\u092f\u093e"
 },
 {
  "start": 23.26,
  "end": 26.340000000000003,
  "text": " \u0914\u0930 \u0928\u092f\u093e \u092c\u094b\u0921\u0930 \u0938\u0940\u0926\u093e \u0907\u0938 \u0906\u0908\u0932\u0947\u0902\u091f \u0915\u0947 \u092c\u0940\u091f \u0938\u0947 \u0917\u092f\u093e."
 },
 {
  "start": 26.8,
  "end": 30.520000000000003,
  "text": " \u092b\u093f\u0930 1885 \u092e\u0947\u0902 \u092b\u093f\u0902\u0932\u0947\u0902\u091f \u0928\u0947 \u092f\u0939\u093e\u0902 \u090f\u0915 \u0932\u093e\u0907\u091f \u0939\u0942\u0901\u0938 \u092c\u0928\u093e\u092f\u093e."
 },
 {
  "start": 30.67,
  "end": 33.690000000000005,
  "text": " \u0938\u092c \u0938\u0947 \u0909\u091a\u0940 \u091c\u0917\u093e\u092a\u0930, \u092a\u0942\u0930\u0947 3 \u092e\u0940\u091f\u0930 \u0909\u091a\u0940"
 },
 {
  "start": 33.690000000000005,
  "end": 37.35,
  "text": " \u092c\u0938 \u090f\u0915 \u092a\u094d\u0930\u092c\u094d\u0932\u092e, \u0935\u094b \u091c\u0917\u093e \u0938\u094d\u0935\u0940\u0921\u093f\u0928 \u092e\u0947\u0920\u0940"
 },
 {
  "start": 37.6,
  "end": 41.44,
  "text": " 100 \u0938\u093e\u0932 \u0924\u0915 \u0935\u094b \u0916\u093c\u093e \u0930\u0939\u093e, \u0917\u0932\u0924 \u0926\u0947\u0936 \u092e\u0947\u0902"
 },
 {
  "start": 41.44,
  "end": 43.88,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0905\u092d\u0940 \u0938\u092c \u0938\u0940 \u0906\u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948"
