  "end": 55.290000000000006,
  "text": " \u0924\u0930\u092c \u0935\u094b \u092c\u091a\u094d\u091b\u093e\u0901, \u092c\u091a\u094d\u091b\u093e\u0901, \u092c\u091a\u094d\u091b\u093e\u0901"
 },
 {
  "start": 55.290000000000006,
  "end": 57.550000000000004,
  "text": " \u0914\u0930 \u0938\u094d\u0935\u0940\u0921\u0928 \u0915\u094b \u0909\u0924\u0928\u0940 \u0939\u0940 \u091c\u092e\u0940\u0928 \u0935\u093e\u092a\u0938 \u092e\u093f\u0932 \u0917\u090f"
 },
 {
