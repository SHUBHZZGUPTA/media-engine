[
 {
  "start": 0.0,
  "end": 3.22,
  "text": " \u0905\u0917\u0930 \u0938\u094d\u092a\u0947\u0928 \u0914\u0930 \u092a\u0941\u0930\u094d\u091b\u0941\u0916\u0932 \u092b\u093f\u0930\u0938\u0947 \u090f\u0915 \u0926\u0947\u0936 \u092c\u0928 \u091c\u093e\u090f?"
 },
 {
  "start": 3.68,
  "end": 6.84,
  "text": " \u0906, \u092b\u093f\u0930\u0938\u0947, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0947 \u092a\u0939\u0932\u0947 \u092d\u0940 \u0939\u094b\u091f \u091a\u0941\u0915\u093e \u0939\u0948."
 },
 {
  "start": 7.58,
  "end": 11.64,
  "text": " 1580 \u092e\u0947\u0902 \u092a\u094b\u091a\u094d\u091f\u0941\u0917\u0932 \u0915\u0947 \u0930\u093e\u091c \u0917\u0930\u093e\u0928\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0935\u093e\u0930\u0947\u0938 \u0928\u0939\u0940\u0902 \u092c\u091a\u093e."
 },
 {
  "start": 12.02,
  "end": 13.98,
  "text": " \u0924\u094b \u0938\u094d\u092a\u0947\u0928 \u0915\u0947 \u0930\u093e\u091c\u093e\u0928\u0947 \u0924\u093e\u091c \u0932\u0947 \u0932\u093f\u092f\u093e."
 },
 {
  "start": 14.36,
  "end": 15.78,
  "text": " \u092a\u0942\u0930\u0947 60 \u0938\u093e\u0932 \u0915\u093f \u0932\u093f\u092f\u0947."
 },
 {
  "start": 15.78,
  "end": 21.96,
  "text": " \u0924\u094b \u0906\u091c \u092f\u0947 \u0926\u0947\u0936 \u0915\u0948\u0938\u093e \u0939\u094b\u0917\u093e? \u0915\u0930\u0940\u092c 61 \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917, \u0907\u091f\u093f\u0932\u0940 \u0938\u0947 \u092d\u0940 \u091c\u0906\u0926\u093e?"
 },
 {
  "start": 22.48,
  "end": 26.42,
  "text": " \u0924\u094b \u092c\u0939\u093e\u0936\u093e\u090f\u092e, \u091c\u094b 800 \u092e\u093f\u0932\u094d\u092f\u0928 \u0938\u0947 \u091c\u093c\u093e\u0926\u093e \u0932\u094b\u0917 \u092c\u094b\u0932\u0924\u0947 \u0939\u0948\u0902."
 },
 {
  "start": 26.42,
  "end": 28.9,
  "text": " \u0914\u0930 \u090f\u0915 \u0928\u094b\u092d\u0932 \u0935\u093f\u091c\u0947\u0924\u093e \u0928\u0947 \u0907\u0938\u0915\u093e \u0928\u093e\u092e \u092d\u0940 \u0930\u0917 \u0926\u093f\u092f\u093e \u0926\u093e."
 },
 {
  "start": 29.44,
  "end": 32.08,
  "text": " \u0906\u0908\u092d\u0947\u0930\u093f\u092f\u093e. \u0924\u094b \u092a\u094b\u091a\u094d\u091f\u094d\u0917\u0932 \u0905\u0932\u0917 \u0915\u094d\u092f\u094b\u0902 \u0935\u0939?"
 },
 {
  "start": 35.84000000000001,
  "end": 42.82,
  "text": " \u0924\u0941 \u092b\u094d\u0930\u0941\u0938\u094d\u091f\u094d\u0926\u093f\u0938\u092e\u092c\u0930 1640 \u0915\u094b \u092a\u094b\u091b\u094d\u0917\u0932 \u0928\u0947 \u0905\u092a\u0928\u093e \u0924\u093e\u091c \u0935\u093e\u092a\u0938 \u0932\u0947\u0932\u0947 \u0932\u093f\u092f\u093e \u0914\u0930 \u0906\u091c \u092d\u0940 \u0909\u0938 \u0926\u093f\u0928 \u091a\u0941\u091f\u094d\u091f\u0940 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948."
 },
 {
  "start": 43.32,
  "end": 48.86,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0906\u092d\u0940 \u0938\u092c \u0938\u0947 \u0906\u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948. \u0906\u091c \u092c\u094b\u0930\u094d\u091f\u0930 \u092a\u093e\u0930 \u0915\u0930\u094b \u0914\u0930 \u0906\u092a \u0924\u093e\u0907\u092e \u092e\u0947\u0902 \u092a\u0940\u091a\u0947 \u091a\u0932\u0947 \u091c\u093e\u0924\u0947 \u0939\u094b."
 },
 {
  "start": 48.86,
  "end": 53.06,
  "text": " \u0938\u094d\u092a\u0947\u0928 \u0915\u0940 \u0917\u0921\u093f\u092f\u093e \u090f\u0915 \u0917\u0921\u093c\u093e \u0905\u0917\u0947 \u091a\u0932\u0924\u0940 \u0939\u0948, 1940 \u0938\u0947"
 },
 {
  "start": 53.06,
  "end": 56.64,
  "text": " \u092b\u093f\u0930 \u0915\u093e\u092a\u093f\u091f\u0932 \u0915\u093e \u091c\u0917\u094d\u093c\u093e, \u092e\u0926\u094d\u0930\u093f\u0924 \u092f\u093e \u0932\u093f\u0938\u094d\u092a\u0941\u0932"
 },
 {
  "start": 56.64,
  "end": 61.18,
  "text": " \u0914\u0930 \u092a\u094b\u091a\u094b\u0917\u0932 \u0915\u0940 \u092a\u0938 \u090f\u0915 \u0936\u093e\u0930\u094d\u0924 \u0939\u0948, \u0924\u094b \u090f\u0915 \u0926\u0947\u0936 \u092f\u093e \u0926\u094b"
 },
 {
  "start": 61.18,
  "end": 62.4,
  "text": " \u0915\u094d\u092f\u094b\u0902 \u0915\u0940 \u0938\u091a \u092c\u0924\u093e\u0942\u0902"
