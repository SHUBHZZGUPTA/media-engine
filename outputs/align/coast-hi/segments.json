[
 {
  "start": 0.0,
  "end": 5.88,
  "text": " \u0915\u094d\u0930\u094b\u0947\u0936\u093f\u092f\u093e \u0928\u0947 \u091a\u093e\u0930\u094d\u0938\u094b \u092c\u0940\u0938 \u092e\u093f\u0932\u094d\u092f\u0928 \u092f\u094b\u0930\u094b \u0915\u0939\u0930\u091a \u0915\u093f\u092f\u0947, \u092c\u0938 \u092d\u094b\u0938\u094d\u0928\u093f\u092f\u093e \u0915\u0947 \u092c\u0940\u0938 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930 \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f."
 },
 {
  "start": 6.15,
  "end": 8.91,
  "text": " \u0915\u0941\u091b \u0926\u0947\u0936\u094b \u0915\u0947 \u0939\u093f\u0938\u094d\u0938\u0947 \u0938\u092e\u0941\u0926\u094d\u0930 \u0915\u093e \u092c\u091a\u093e\u0916\u0941\u091a\u093e \u0939\u0940 \u0906\u092f\u093e"
 },
 {
  "start": 8.91,
  "end": 12.030000000000001,
  "text": " \u0926\u0940\u0930 \u0915\u094b\u0902\u0917\u094b \u0906\u092b\u0930\u093f\u0915\u093e \u0915\u093e \u0926\u0941\u0938\u094d\u0930\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0926\u0947\u0936 \u0939\u0948"
 },
 {
  "start": 12.030000000000001,
  "end": 14.43,
  "text": " \u0914\u0930 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u0926, \u0938\u0930\u094d\u092b \u0938\u0948\u0924\u0940\u0938 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930"
 },
 {
  "start": 14.66,
  "end": 19.98,
  "text": " \u090f\u0930\u093e\u0917 \u0915\u0947 \u092a\u093e\u0938 \u091a\u093e\u0930 \u0932\u093e\u0915 \u0924\u0940\u0938 \u0927\u0938 \u0935\u0930\u094d\u0915 \u0915\u093f\u0932\u094b \u092e\u093f\u091f\u0930 \u0938\u0947 \u091c\u093c\u092f\u093e\u0926\u093e \u091c\u092e\u0940\u0928 \u0939\u0948, \u0914\u0930 \u0905\u091f\u094d\u0916\u093e\u0935\u0928 \u0915\u093f\u0932\u094b\u092e\u094d\u092e\u093f\u091f\u0930 \u0924\u0926."
 },
 {
  "start": 20.240000000000002,
  "end": 24.14,
  "text": " \u091c\u094b\u0930\u094d\u0926\u0928 \u0915\u0947 \u092a\u093e\u0938 \u091a\u092c \u0935\u0940\u0938 \u0915\u093f\u0932\u094b\u092e\u093f\u091f\u0930, \u0905\u0916\u092d\u093e \u092e\u0947\u0902 \u0930\u0947\u091f\u094d\u0938\u0940 \u092a\u0925 \u0939\u0941\u093d \u0915\u0940 \u0901\u091b\u093e\u0964."
 },
 {
  "start": 24.14,
  "end": 27.060000000000002,
  "text": " \u092c\u094b\u0938\u094d\u0928\u093f\u092f\u093e \u0914\u0930 \u0930\u091c\u0947 \u0917\u094b\u0935\u0940\u0928\u093e \u0915\u0947 \u092a\u093e\u0938 \u0915\u0930\u0940 \u092c\u0940\u0938 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930"
 },
 {
  "start": 27.060000000000002,
  "end": 29.66,
  "text": " \u0914\u0930 \u0938\u092e\u0941\u0926\u094d\u0930 \u0915\u093f\u0928\u093e\u0930\u0947 \u090f\u0915 \u0939\u0940 \u0936\u0939\u0930, \u0928\u0947\u094b\u092e."
 },
 {
  "start": 29.84,
  "end": 37.980000000000004,
  "text": " \u0935\u094b \u091a\u094b\u091f\u0940 \u0938\u0940 \u092a\u091f\u094d\u091f\u0940 \u0915\u094d\u0930\u0942\u090f\u0936\u094d\u092f\u093e \u0915\u094b \u0926\u094b \u0939\u093f\u0938\u094d\u0935\u094b \u092e\u0947\u0902 \u0915\u093e\u091f \u0926\u0947\u0924\u0940 \u0939\u0948, \u0924\u094b \u0915\u094d\u0930\u0942\u090f\u0936\u094d\u092f\u093e \u0928\u0947 \u0926\u094b \u0926\u0936\u092e\u0932\u0935 \u091a\u093e\u0930 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930 \u0915\u093e \u092a\u0942\u0932 \u092c\u0928\u093e \u0926\u093f\u092f\u093e, \u092c\u0938 \u0909\u0938\u0915\u0947 \u092c\u0917\u0932 \u0938\u0947 \u0928\u093f\u0915\u0932\u0928\u0947 \u0915\u093f\u0932\u093f\u090f."
 },
 {
  "start": 38.16,
  "end": 44.76,
  "text": " \u092c\u0940\u091c \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930, \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u092c\u0921\u093c\u0947 \u092c\u0940\u091c \u0926\u0947\u0916\u0947\u0902, \u0914\u0930 \u0938\u092c\u0938\u0947 \u091a\u094b\u091f\u093e \u0924\u0926 \u092e\u0942\u0928\u0948\u0915\u094b, \u0915\u0930\u0940\u092c \u091a\u093e\u0930 \u0915\u093f\u0932\u094b \u092e\u0940\u091f\u0930."
 },
 {
  "start": 44.92,
  "end": 50.08,
  "text": " \u092b\u0947\u0930 \u092d\u0940 \u092e\u0941\u091a \u0938\u0947 \u091c\u093e\u0926\u093e \u092d\u0940\u091a \u092f\u0947 \u0939\u0948 \u092d\u0942\u0917\u094b\u0932, \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u093f\u0926\u093e\u0930 \u091c\u094b\u0917\u0930\u092b\u0940 \u092b\u093e\u0915\u094d\u091f\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u0932\u094b \u0915\u0930\u0947\u0902."
