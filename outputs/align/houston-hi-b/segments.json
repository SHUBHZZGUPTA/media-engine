[
 {
  "start": 0.0,
  "end": 3.94,
  "text": " \u0905\u092e\u0930\u0915\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u092a\u094b\u091f, \u0938\u092e\u0928\u0926\u0930 \u0938\u0947 \u092b\u094d\u092b\u0924\u0940 \u092e\u093e\u0901\u0908\u0932\u094d\u0938 \u0926\u0942\u0930 \u0939\u0948."
 },
 {
  "start": 4.4,
  "end": 4.66,
  "text": " \u0915\u094d\u092f\u094b\u0902?"
 },
 {
  "start": 5.02,
  "end": 8.82,
  "text": " \u0938\u092e\u0928\u0926\u0930 \u092a\u0930 \u092c\u0938\u093e, \u0905\u0938\u0932\u0940 \u0936\u0939\u0930, \u0924\u094b \u091a\u094b\u091f\u093e \u0938\u093e \u0917\u094d\u092f\u093e\u0932\u094d\u0935\u093f\u0938\u094d\u091f\u0928 \u0939\u0948."
 },
 {
  "start": 9.3,
  "end": 13.8,
  "text": " \u0932\u0947\u0915\u093f\u0928, 1880 \u092e\u0947\u0902 \u0917\u094d\u092f\u093e\u0932\u094d\u0935\u093f\u0938\u094d\u091f\u0928 \u0939\u0940 \u0924\u093e, \u091f\u0947\u0915\u094d\u0938\u0938 \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0936\u0939\u0930."
 },
 {
  "start": 13.8,
  "end": 17.8,
  "text": " \u0914\u0930 \u092a\u0942\u092f\u0938\u094d\u091f\u0947\u0928? \u0910\u0915 \u091a\u093f\u091a\u0932\u0940 \u0928\u0926\u0940 \u092a\u0930 \u0915\u0940 \u091a\u0921\u091b\u092c\u0930\u093e \u0915\u091c\u094d\u0935\u093e"
 },
 {
  "start": 17.8,
  "end": 20.44,
  "text": " \u0924\u094b \u0939\u0942\u0938\u094d\u091f\u0928 \u0928\u0947 \u092c\u093e\u0938\u0940 \u0915\u0948\u0938\u0947 \u092e\u093e\u0930\u0940?"
 },
 {
  "start": 21.08,
  "end": 22.88,
  "text": " \u0907\u091f \u0938\u092a\u094d\u091f\u092e\u094d\u092c\u0930 Twelve Sir"
 },
 {
  "start": 22.88,
  "end": 25.16,
  "text": " \u0907\u0915 \u0939\u0941\u0930\u093f\u0915\u0947\u0928 \u0917\u0948\u0932\u0935\u093f\u0938\u094d\u091f\u0947\u0928 \u0938\u0947 \u091f\u094d\u0916\u0930\u093e\u092f\u093e"
 },
 {
  "start": 25.8,
  "end": 27.1,
  "text": " \u0936\u0939\u0930 \u0915\u0940 \u0938\u092c\u0938\u0947 \u0939\u0941\u091a\u0940 \u091c\u0917\u093e"
 },
 {
  "start": 27.1,
  "end": 28.5,
  "text": " \u0906\u092a \u0905\u092a \u0924\u0928\u0947\u0917\u093c \u092b\u0940\u091f \u0938\u0947 \u0915\u092e"
 },
 {
  "start": 28.5,
  "end": 29.9,
  "text": " \u0938\u092e\u0928\u0926\u0930 \u0915\u0940 \u0932\u0947\u0939\u0930"
 },
 {
  "start": 29.9,
  "end": 31.52,
  "text": " 15 \u0938\u0947 \u0909\u092a\u0930"
 },
 {
  "start": 31.52,
  "end": 38.04,
  "text": " \u0915\u092e \u0938\u0947 \u0915\u092e 6,000 \u0932\u094b\u0917 \u092e\u093e\u0930\u0947 \u0917\u092f, \u0906\u091c \u092d\u0940 \u0905\u092e\u0930\u093f\u0915\u093e \u0915\u0940 \u0938\u092c\u0938\u0947 \u0917\u093e\u0924\u093e \u0915\u0941\u0926\u094d\u0930\u0924\u093f \u0906\u092a\u0924\u093e."
 },
 {
  "start": 38.92,
  "end": 45.02,
  "text": " \u0917\u0932\u094d\u0935\u093f\u0938\u094d\u091f\u0928 \u0928\u0947 \u0939\u093e\u0930 \u0928\u0939\u0940\u0902 \u092e\u093e\u0928\u0940, 17 \u092b\u0940\u091f \u0915\u0940 \u0926\u093f\u092c\u093e\u0930 \u092c\u0928\u093e\u0908 \u0914\u0930 \u092a\u0942\u0930\u093e \u0936\u0939\u0930 \u0909\u092a\u0930 \u0909\u092a\u0930 \u0909\u0920\u093e \u0926\u093f\u092f\u093e."
 },
 {
  "start": 45.54,
  "end": 47.58,
  "text": " \u0932\u093f\u090f\u0915 \u0917\u0932\u094d\u0935\u093f\u0938\u094d\u091f\u0928 \u0915\u094b \u0924\u0942\u092b\u093e\u0928 \u0928\u0947 \u0916\u0924\u0928 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e."
 },
 {
  "start": 47.58,
  "end": 51.58,
  "text": " \u091a\u093e\u0930 \u092e\u0939\u0940\u0928\u0947 \u092c\u093e\u0926 \u0936\u094d\u092a\u093f\u0902\u091f\u0932 \u0924\u094b\u092a \u092e\u0947\u0902 \u0924\u0947\u0932 \u092b\u0941\u091f \u092a\u0921\u093e"
 },
 {
  "start": 51.58,
  "end": 56.04,
  "text": " \u0913\u092f\u0932 \u0915\u092e\u092a\u0928\u0940\u0938 \u0915\u094b \u091a\u093e\u0908\u090f \u0924\u093e \u090f\u0938\u093e \u092a\u094b\u091f, \u091c\u093f\u0938\u0947 \u0924\u0942\u092b\u093e\u0928 \u0928\u093e \u092c\u0939\u093e\u0938\u0915\u0947"
 },
 {
  "start": 56.04,
  "end": 59.64,
  "text": " \u0924\u094b \u0939\u0942\u0901\u0938\u094d\u091f\u0928 \u0928\u0947 \u0905\u092a\u0928\u0940 \u0928\u0926\u0940 \u0916\u094b\u0926 \u0915\u0930 \u0936\u093f\u092a \u091a\u093e\u0928\u0932 \u092c\u0928\u093e\u0926\u0940"
 },
 {
  "start": 59.64,
  "end": 61.34,
  "text": " \u092b\u0941\u092a\u094d\u091f\u0940 \u092e\u093e\u0901\u0932\u094d\u091c \u0932\u0902\u092d\u0940"
 },
 {
  "start": 61.34,
  "end": 65.46,
  "text": " 1914 \u092e\u0947\u0902 \u092a\u094d\u0930\u0947\u091c\u093c\u0926\u0928 \u0932\u0947 \u0935\u093e\u0936\u093f\u0902\u091f\u0928 \u092e\u0947\u0902 \u092c\u0924\u0928 \u0926\u092c\u093e\u092f\u093e"
 },
 {
  "start": 65.46,
  "end": 67.32,
  "text": " \u0914\u0930 \u0939\u0942\u0901\u0938\u094d\u091f\u0928 \u092e\u0947\u0902 \u0924\u094b\u092c \u091a\u0932\u0940"
 },
 {
  "start": 67.32,
  "end": 70.72,
  "text": " \u0906\u092c \u092c\u0921\u093c\u0947 \u091c\u0939\u093e\u0938 \u0917\u0932\u094d\u0935\u093f\u0938\u094d\u091f\u0928 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0938\u0947 \u0938\u0940\u0925\u0947 \u0928\u093f\u0915\u0932 \u091c\u093e\u0924\u0947"
 },
 {
  "start": 71.34,
  "end": 74.22,
  "text": " \u0906\u091c \u0939\u0942\u0901\u0938\u094d\u091f\u0928 2.4 \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917"
 },
 {
  "start": 74.22,
  "end": 77.0,
  "text": " \u0917\u0932\u094d\u0935\u093f\u0938\u094d\u091f\u0928 \u0915\u0930\u0940\u092c 53,000"
 },
 {
  "start": 77.0,
  "end": 79.66,
  "text": " \u0905\u092c \u0935\u094b \u092c\u0938 \u0939\u0942\u0901\u0938\u094d\u091f\u0928 \u0915\u093e \u092d\u0940\u091a\u094d\u091f\u093e\u0928 \u0906\u0908"
 },
 {
  "start": 79.66,
  "end": 83.46,
  "text": " \u0924\u094b \u0926\u093f\u092e\u093e \u0906\u0917\u094d\u092f\u093e \u0935\u0938 \u0915\u093f\u0938\u094d\u092e\u0924, \u091c\u094b\u0935\u0940 \u0939\u094b \u0907\u0938\u0940 \u0932\u093f\u090f"
 }
]