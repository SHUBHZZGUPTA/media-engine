[
 {
  "start": 0.0,
  "end": 5.68,
  "text": " \u0938\u094b\u091a\u094b, \u0905\u0917\u0930 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0947 6 \u0938\u092c\u0938\u0947 \u0916\u094b\u091c \u0926\u0947\u0936\u094b \u092e\u0947\u0902 \u0938\u0947 5 \u090f\u0915 \u0939\u0940 \u0926\u0947\u0936 \u092c\u0928 \u091c\u093e\u090f?"
 },
 {
  "start": 6.18,
  "end": 11.24,
  "text": " \u092c\u0905\u0921\u0930 \u092e\u093f\u091f\u093e\u0926\u094b, \u0926\u0948\u0928 \u092e\u093e\u0915, \u0928\u094b\u0930\u0935\u0947, \u0938\u094c\u090f\u0921\u0928, \u092b\u093f\u0928\u0932\u0947\u0902\u0926 \u0914\u0930 \u0905\u0907\u0938\u0932\u0947\u0902\u0917 \u0915\u0947 \u092c\u0940\u091a"
 },
 {
  "start": 11.24,
  "end": 15.12,
  "text": " \u0914\u0930 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e 7th \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0926\u0947\u0936"
 },
 {
  "start": 15.12,
  "end": 19.14,
  "text": " \u0939\u093e, \u0907\u0938\u0915\u093e \u0932\u0917 \u092d\u0917 \u0906\u0926\u093e \u0939\u0948 \u0938\u092c \u0935\u0930\u094d\u092b \u0939\u0948"
 },
 {
  "start": 19.14,
  "end": 23.82,
  "text": " \u0906\u092c\u093e\u0926\u0940 \u0938\u093f\u0930\u094d\u092b \u091f\u094d\u0935\u0947\u0902\u091f\u0940 \u090f\u091f \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917 \u092f\u093e\u0928\u0940 \u091f\u0947\u0915\u094d\u0938\u0947 \u0938\u0947 \u092d\u0940 \u0915\u092e"
 },
 {
  "start": 23.82,
  "end": 31.06,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u090f\u0915\u094b\u0928\u0942\u092e\u0940 \u0915\u0930\u0940\u092c 2.2 \u091f\u094d\u0930\u093f\u0932\u094d\u092f\u0928 \u0921\u094b\u0932\u0930\u094d\u0938 \u0926\u0942\u0928\u093f\u092f\u093e \u0915\u0947 top 12 \u092e\u0947\u0902"
 },
 {
  "start": 31.06,
  "end": 34.3,
  "text": " \u0914\u0930 \u0928\u094b\u0930\u094d\u0935\u0947 \u0932\u093e\u0924\u093e \u0939\u0948 \u0926\u0942\u0928\u093f\u092f\u093e \u0915\u093e \u0938\u092c \u0938\u0947 \u092c\u0921\u093c\u093e \u0917\u0941\u0932\u094d\u0932\u0915"
 },
 {
  "start": 34.3,
  "end": 36.88,
  "text": " \u0924\u0942 \u091f\u094d\u0930\u093f\u0932\u094d\u092f\u0928 \u0921\u094b\u0932\u0930\u094d\u0930 \u0938\u0947 \u092d\u0940 \u091c\u094d\u092f\u093e\u0926\u093e"
 },
 {
  "start": 36.88,
  "end": 39.12,
  "text": " \u0924\u0941 \u092f\u0947 \u0906\u091c \u0924\u0915 \u0915\u093f\u0938\u0940\u0928\u0947 \u0915\u093f\u092f\u093e \u0915\u094d\u092f\u094b\u0928\u0940?"
 },
 {
  "start": 39.66,
  "end": 42.08,
  "text": " \u0924\u0942\u0938\u094d\u091f\u0940 \u092f\u0947 \u0939\u0948, \u0935\u094b \u0915\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902"
 },
 {
  "start": 42.08,
  "end": 46.16,
  "text": " \u0938\u093e\u0932 3097 \u092e\u0947\u0902 \u0926\u0947\u0928\u094d\u092e\u093e\u0915, \u0928\u094b\u0930\u0935\u0947\u0930 \u0914\u0930 \u0938\u094d\u0935\u0940\u0921\u0928 \u0928\u0947 \u090f\u0915 \u0939\u0940 \u0930\u093e\u091c\u093e \u091a\u0941\u0928\u093e"
 },
 {
  "start": 46.16,
  "end": 47.88,
  "text": " \u0938\u094d\u0935\u0940\u0921\u0928 \u0915\u0947 \u090f\u0915 \u0936\u0939\u0930 \u0915\u093e\u0932\u092e\u093e\u0930 \u092e\u0947\u0902"
 },
 {
  "start": 48.48,
  "end": 52.18,
  "text": " \u092f\u0947 \u092f\u0942\u0928\u094d\u092f\u0947\u0902 \u091a\u0932\u093e, 126 \u0938\u093e\u0932"
 },
 {
  "start": 52.18,
  "end": 53.8,
  "text": " \u0914\u0930 \u092f\u0947 \u0916\u0924\u0928 \u0915\u0948 \u0938\u0947 \u0935\u0939?"
 },
 {
  "start": 54.14,
  "end": 55.26,
  "text": " \u0935\u0948\u0908 \u0938\u092c \u0938\u0947 \u092e\u091c\u0926\u093e\u0930 \u0939\u0948"
 },
 {
  "start": 55.26,
  "end": 59.54,
  "text": " \u0938\u093e\u0932 1523 \u092e\u0947\u0902, \u0938\u094d\u0935\u0940\u0921\u0928 \u092c\u0938 \u0909\u091f\u0915\u0930 \u091a\u0932\u093e \u0917\u092f\u093e?"
 },
 {
  "start": 59.96,
  "end": 63.56,
  "text": " \u0938\u094d\u0935\u0940\u0921\u0928 \u0915\u093e \u0928\u093e\u0936\u0928\u0932 \u0926\u0947 \u0906\u091c \u092d\u0940 \u0909\u0938\u0940 \u0924\u093e\u0930\u0940\u0915 \u0915\u094b \u092e\u0928\u093e\u092f \u091c\u093e\u0924\u093e \u0939\u0948"
 },
 {
  "start": 63.56,
  "end": 68.28,
  "text": " \u092b\u093f\u0930 \u092d\u0940 1950 \u0938\u0947 \u092f\u0947 \u090f\u0915 \u0924\u0941\u0938\u0930\u0947 \u0915\u0947 \u0926\u0947\u0936\u094b \u092e\u0947\u0902 \u092c\u093f\u0928\u093e \u092a\u093e\u0938\u094d\u092a\u094b\u091f \u0915\u0947 \u0906\u0924\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948"
 },
 {
  "start": 68.28,
  "end": 69.84,
  "text": " \u0924\u094b, \u0915\u093e\u092a\u093f\u0924\u0932 \u0915\u094b\u0928 \u092c\u0928\u0947\u0917\u093e?"
 },
 {
  "start": 70.2,
  "end": 73.06,
  "text": " \u0938\u094d\u091f\u094b\u0915 \u0939\u094b\u092e, \u0905\u0938\u094d\u0932\u094b, \u0915\u094b\u092a\u0928\u0939\u0947\u0917\u0928, \u0939\u0932\u094d\u0938\u093f\u0902\u0915\u0940?"
 },
 {
  "start": 73.06,
  "end": 74.58,
  "text": " \u0939\u0932\u094b \u0930\u0947\u0915\u0947 \u0935\u093f\u0915"
 },
 {
  "start": 74.58,
  "end": 76.58,
  "text": " \u0938\u092e\u091c\u094d\u0924\u0917\u094d\u0924\u093e\u0930\u0940 \u0935\u0924 \u0935\u0924 of of"
 },
 {
  "start": 76.58,
  "end": 77.12,
  "text": " \u0915\u093e\u0932\u092e\u093e\u0930"
 },
 {
  "start": 77.12,
  "end": 78.56,
  "text": " \u0915\u094d\u092f\u093e \u092f\u094b \u0938\u0947 \u0938\u092c \u0936\u0930\u094d\u092c \u0939\u0941\u090f"
 },
 {
