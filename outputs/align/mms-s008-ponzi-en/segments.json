[
 {
  "start": 0.0,
  "end": 7.04,
  "text": " In 1920, a man in Boston promised you 50% profit in just 45 days."
 },
 {
  "start": 7.78,
  "end": 10.04,
  "text": " His name was Charles Ponzi."
 },
 {
  "start": 10.62,
  "end": 11.88,
  "text": " His idea sounded clever."
 },
 {
  "start": 12.86,
  "end": 13.92,
  "text": " Postal reply coupons."
 },
 {
  "start": 14.6,
  "end": 17.58,
  "text": " Buy them cheap in Europe, cash them in America for more."
 },
 {
  "start": 18.08,
  "end": 19.2,
  "text": " A real price gap?"
 },
 {
  "start": 19.96,
  "end": 20.58,
  "text": " On paper."
 },
 {
  "start": 21.4,
  "end": 23.0,
  "text": " But you couldn't do it at scale."
 },
 {
  "start": 23.54,
  "end": 26.58,
  "text": " So he paid old investors with new investors' money."
 },
 {
  "start": 27.42,
  "end": 28.52,
  "text": " Thousands lined up."
 },
 {
  "start": 28.52,
  "end": 32.76,
  "text": " He took in roughly 15 million dollars in about 8 months."
 },
 {
  "start": 33.64,
  "end": 35.68,
  "text": " Then the Boston Post started digging."
 },
 {
  "start": 36.28,
  "end": 38.96,
  "text": " By August 1920, it was over."
 },
 {
  "start": 39.7,
  "end": 42.32,
  "text": " Investors lost about 20 million dollars."
 },
 {
  "start": 42.82,
  "end": 44.68,
  "text": " That's over 200 million today."
 },
 {
  "start": 45.26,
  "end": 46.74,
  "text": " The Post won a Pulitzer."
 },
 {
  "start": 47.76,
  "end": 52.7,
  "text": " Ponzi went to prison, was deported to Italy, and died broke in Rio in 1949."
 },
 {
  "start": 53.78,
  "end": 54.88,
  "text": " That's the mirage."
 },
 {
  "start": 54.88,
  "end": 58.8,
  "text": " The early profits were real because they were your money."
 },
 {
  "start": 59.4,
  "end": 63.8,
  "text": " So when returns are huge and nobody can explain how, walk away."
 },
 {
  "start": 64.76,
  "end": 67.5,
  "text": " This is Money Mirage. Follow for more."
 }
]