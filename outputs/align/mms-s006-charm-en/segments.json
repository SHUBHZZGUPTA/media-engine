[
 {
  "start": 0.0,
  "end": 2.84,
  "text": " Why does everything cost $9.99?"
 },
 {
  "start": 3.76,
  "end": 5.94,
  "text": " Because your brain reads it as $9."
 },
 {
  "start": 6.56,
  "end": 8.84,
  "text": " It's called the left digit effect."
 },
 {
  "start": 9.42,
  "end": 12.76,
  "text": " You read a price left to right, and the first digit sticks."
 },
 {
  "start": 13.54,
  "end": 15.2,
  "text": " $10 feels like $10."
 },
 {
  "start": 15.6,
  "end": 17.96,
  "text": " $9.99 feels like $9 something."
 },
 {
  "start": 18.62,
  "end": 21.2,
  "text": " One cent moves a whole dollar in your head."
 },
 {
  "start": 21.84,
  "end": 23.08,
  "text": " It even works on cars."
 },
 {
  "start": 23.64,
  "end": 26.08,
  "text": " Across 22 million auction sales,"
 },
 {
  "start": 26.46,
  "end": 29.06,
  "text": " used cars sold for about $200 less"
 },
 {
  "start": 29.06,
  "end": 32.32,
  "text": " once the odometer crossed a 10,000 mile mark."
 },
 {
  "start": 33.04,
  "end": 34.28,
  "text": " But here's the weird part."
 },
 {
  "start": 34.72,
  "end": 39.68,
  "text": " In one experiment, a dress sold better at $39 than at $34."
 },
 {
  "start": 40.56,
  "end": 42.98,
  "text": " Cheaper and fewer buyers. Why?"
 },
 {
  "start": 43.82,
  "end": 46.78,
  "text": " Years of sales taught us that a nine means bargain."
 },
 {
  "start": 47.46,
  "end": 48.54,
  "text": " That's the mirage."
 },
 {
  "start": 48.96,
  "end": 50.4,
  "text": " The nine isn't a discount."
 },
 {
  "start": 50.7,
  "end": 52.56,
  "text": " It's a signal that feels like one."
 },
 {
  "start": 53.14,
  "end": 55.72,
  "text": " So round up. $9.99 is $10."
 },
 {
  "start": 55.72,
  "end": 57.74,
  "text": " This is Money Mirage."
 },
 {
  "start": 58.3,
  "end": 58.8,
  "text": " Follow for more."
 }
]