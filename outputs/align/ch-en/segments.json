[
 {
  "start": 0.0,
  "end": 3.28,
  "text": " What if Switzerland and Liechtenstein became one country?"
 },
 {
  "start": 4.62,
  "end": 6.86,
  "text": " Switzerland is 260 times bigger."
 },
 {
  "start": 7.4,
  "end": 9.88,
  "text": " Liechtenstein is just 25 kilometers long."
 },
 {
  "start": 10.56,
  "end": 12.82,
  "text": " And it has no army. Zero."
 },
 {
  "start": 13.42,
  "end": 15.08,
  "text": " So would anyone even notice?"
 },
 {
  "start": 15.76,
  "end": 18.84,
  "text": " Here's the twist. They're already halfway there."
 },
 {
  "start": 19.6,
  "end": 22.5,
  "text": " Same money. The Swiss franc since 1924."
 },
 {
  "start": 23.32,
  "end": 24.92,
  "text": " No border checks between them."
 },
 {
  "start": 25.62,
  "end": 28.62,
  "text": " Swiss customs officers even guard Liechtenstein's border."
 },
 {
  "start": 28.62,
  "end": 36.98,
  "text": " In 2007, 170 Swiss soldiers got lost at night and accidentally invaded Liechtenstein."
 },
 {
  "start": 37.76,
  "end": 39.2,
  "text": " Nobody there even noticed."
 },
 {
  "start": 39.84,
  "end": 41.62,
  "text": " But that's not even the weirdest part."
 },
 {
  "start": 42.24,
  "end": 47.7,
  "text": " In 1866, its last army marched off to war with 80 men."
 },
 {
  "start": 48.48,
  "end": 51.14,
  "text": " And the story goes, 81 came back."
 },
 {
  "start": 51.72,
  "end": 54.6,
  "text": " And the capital? Burn or tiny vaduz?"
 },
 {
  "start": 55.16,
  "end": 57.96,
  "text": " Switzerland, relax. We'll protect you."
 },
 {
  "start": 57.96,
  "end": 61.04,
  "text": " Liechtenstein just don't get lost again."
 },
 {
  "start": 61.5,
  "end": 63.6,
  "text": " So one country or two?"
 },
 {
  "start": 64.0,
  "end": 64.72,
  "text": " Because honestly?"
 }
]