[
 {
  "start": 0.0,
  "end": 2.12,
  "text": " \u0905\u0917\u0930 \u0915\u0930\u0947\u092c\u093f\u092f\u0928 \u090f\u0915 \u0926\u0947\u0936 \u0939\u094b\u0924\u093e?"
 },
 {
  "start": 2.66,
  "end": 5.34,
  "text": " \u0924\u0942\u090f\u0938\u094d\u091f\u093f\u092f\u093e \u0939\u0948, \u0907\u0938\u0915\u093e \u090f\u0915 \u0939\u093f\u0938\u093e \u092a\u0939\u0932\u0947 \u0938\u0947 \u0924\u093e."
 },
 {
  "start": 5.82,
  "end": 8.9,
  "text": " 1958 \u092e\u0947\u0902 10 \u092c\u094d\u0930\u093f\u0924\u093f\u0937 \u0906\u0908\u0932\u0947\u0902 \u0924\u0947\u0932\u094d\u091f\u094d\u0930\u0940\u0938."
 },
 {
  "start": 9.26,
  "end": 12.2,
  "text": " \u092e\u093f\u0932\u0915\u0930 \u092c\u0928\u0947 \u090f\u0915 \u0926\u0947\u0936 \u0935\u0947\u0938\u094d\u091f\u093f\u0928\u094d\u091f\u0940\u091c \u092b\u0947\u091f\u0930\u0947\u0936\u0928."
 },
 {
  "start": 12.78,
  "end": 15.34,
  "text": " \u091c\u092e\u0947\u0915\u093e \u0938\u0947 \u0938\u0940 \u0926\u093e \u091f\u094d\u0930\u093f\u0928\u0947\u0921 \u0906\u091f \u0924\u0915."
 },
 {
  "start": 15.76,
  "end": 16.96,
  "text": " \u0924\u094b \u0907\u0938 \u0926\u0947\u0936 \u0915\u094b \u0915\u094d\u092f\u093e \u092e\u093f\u0932\u093e?"
 },
 {
  "start": 16.96,
  "end": 22.48,
  "text": " \u0932\u0917 \u092d\u0915 3 \u092e\u093f\u0932\u094d\u092f\u0928 \u0932\u094b\u0917, \u0905\u092a\u0928\u093e \u092b\u094d\u0932\u093e\u0917 \u0914\u0930 \u0905\u092a\u0928\u093e \u092a\u094d\u0930\u093e\u0908\u092e \u092e\u0947\u0928\u093f\u0938\u094d\u091f\u0930."
 },
 {
  "start": 23.02,
  "end": 28.4,
  "text": " \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u092a\u0947\u091a \u0924\u093e, \u091c\u092e\u0948\u0915\u093e \u0924\u093e \u0915\u093e\u092a\u093f\u091f\u0932 \u0938\u0947 1800 \u0915\u093f\u0932\u094b\u092e\u0947\u091f\u0930 \u0938\u0947 \u092d\u0940 \u0926\u0942\u0930."
 },
 {
  "start": 29.06,
  "end": 31.98,
  "text": " 1961 \u092e\u0947\u0902 \u091c\u092e\u0948\u0915\u093e\u0928\u0947 \u0935\u094b\u0921 \u0915\u093f\u092f\u093e \u0928\u093f\u0915\u0932\u0928\u0947\u0915\u093e."
 },
 {
  "start": 32.52,
  "end": 36.84,
  "text": " \u0924\u0942\u0928\u0947\u0926\u093e\u0926 \u0915\u0947 \u0932\u0940\u091f\u0930\u0928\u0947 \u0939\u093f\u0938\u093e\u092c \u0932\u0917\u093e\u092f\u093e, \u0926\u0938 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0917\u092f\u093e, \u0924\u094b \u092c\u091a\u093e \u091c\u0940\u0930\u094b."
 },
 {
  "start": 36.84,
  "end": 39.7,
  "text": " \u092f\u0947 \u0926\u0947\u0936 \u091a\u0932\u093e \u0938\u0930\u094d\u092b \u091a\u093e\u0930 \u0938\u093e\u0932."
 },
 {
  "start": 40.28,
  "end": 42.32,
  "text": " \u0932\u0947\u0917\u093f\u0928 \u092f\u0947 \u0906\u092d\u0940 \u0938\u092c \u0938\u0947 \u0906\u091c\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948."
 },
 {
  "start": 42.86,
  "end": 44.74,
  "text": " \u092f\u0947 \u0915\u092d\u0940 \u0905\u0932\u0917 \u0939\u0941\u090f \u0939\u0940 \u0928\u0939\u0940\u0902."
 },
 {
  "start": 45.0,
  "end": 45.72,
  "text": " \u0915\u094d\u0930\u093f\u0915\u0947\u091f \u092e\u0947\u0902."
 },
 {
  "start": 46.22,
  "end": 49.14,
  "text": " 15 \u0926\u0947\u0936 \u0914\u0930 \u091f\u0947\u0930\u0947\u091f\u094d\u0930\u0940\u091c \u0906\u091c \u092d\u0940 \u0916\u0947\u0932\u0924\u0947 \u0939\u0948."
 },
 {
  "start": 49.38,
  "end": 51.22,
  "text": " 8 \u0924\u0940\u092e \u092c\u0928 \u0915\u0947 \u0935\u0947\u0938\u094d\u091f\u093f\u0928\u094d\u091f\u0940\u091c."
 },
 {
  "start": 51.8,
  "end": 54.56,
  "text": " \u0914\u0930 \u0924\u094b \u0907\u0928\u094b \u0928\u0947 \u091c\u0940\u0924\u093e \u0939\u0948 \u0935\u094b\u0932\u094d\u0917 \u0915\u093e 2 \u092c\u093e\u0930."
 },
 {
  "start": 54.56,
  "end": 56.82,
  "text": " \u0914\u0930 \u091c\u092e\u0947\u0915\u093e \u092c\u0938 \u090f\u0915 \u092c\u093e\u0924 \u0915\u0939\u0924\u093e \u0939\u0948"
 },
 {
  "start": 56.82,
  "end": 59.2,
  "text": " \u0924\u094b \u090f\u0915 \u0915\u0947 \u0930\u0947\u092d\u0940\u0928 \u092f\u093e \u0915\u0908"
 },
 {
  "start": 59.2,
  "end": 60.5,
  "text": " \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0938\u091c \u092c\u0924\u093e\u0942\u0902"
 }
]