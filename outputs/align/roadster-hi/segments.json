[
 {
  "start": 0.0,
  "end": 2.74,
  "text": " \u0906\u092a\u0928\u0947 \u0915\u092d\u0940 \u092e\u093e\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0938\u0947 \u0917\u093e\u0921\u0940 \u0928\u0939\u0940\u0902 \u091a\u0932\u093e\u090f,"
 },
 {
  "start": 2.94,
  "end": 5.98,
  "text": " \u092a\u0930 \u090f\u0915 \u0932\u093e\u0932 \u0915\u093e\u0930\u0928\u0947 \u091a\u0932\u093e\u090f, \u0914\u0930 \u091a\u0932\u093e \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u0930\u0939\u093e \u0925\u093e."
 },
 {
  "start": 6.24,
  "end": 8.78,
  "text": " \u0914\u0930 \u0928\u0939\u0940\u0902, \u092f\u0947 \u090f\u0930\u094d\u0925 \u0915\u0947 \u091a\u0915\u094d\u0915\u0930 \u0928\u0939\u0940\u0902 \u0932\u0917\u093e \u0930\u0939\u0940\u0902."
 },
 {
  "start": 9.04,
  "end": 10.12,
  "text": " \u0915\u092d\u0940 \u0932\u0917\u093e\u0908 \u0939\u0940 \u0928\u0939\u0940\u0902."
 },
 {
  "start": 10.24,
  "end": 13.98,
  "text": " \u091a\u0932\u093f\u092f\u0947 2018 \u092e\u0947\u0902, \u0928\u0939\u0940\u0902 \u0930\u094b\u0915\u0947\u091f \u0915\u0947 \u091f\u0947\u0938\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u0935\u091c\u0928 \u091a\u093e\u0939\u093f\u092f\u0947 \u0925\u093e."
 },
 {
  "start": 13.98,
  "end": 40.14,
  "text": " \u0906\u092e \u0924\u094b\u0930 \u092a\u0930, \u0915\u094b\u0902\u0915\u094d\u0930\u0940\u0924, \u0907\u0932\u094b\u0902 \u092e\u0941\u0938\u094d\u0915 \u0928\u0947 \u0905\u092a\u0928\u0940 \u0932\u093e\u0932 \u0930\u094b\u091f\u094d\u0938\u094d\u091f\u0930 \u092c\u0947\u091c\u094d\u091f\u0940, \u0926\u094d\u0930\u0940\u0935\u0930 \u0925\u093e \u0938\u094d\u092a\u0947\u0938 \u0938\u0941\u091f\u094d\u0935\u093e\u0932\u093e \u092a\u0941\u0924\u094d\u0932\u093e, \u0938\u094d\u0924\u093e\u0930 \u092e\u0948\u0928, \u0926\u093e\u0936 \u092c\u094b\u0921 \u092c\u094b\u0932\u093e \u0917\u092d\u094d\u0930\u093e\u0935 \u092e\u0924, \u092e\u0948\u0902 \u0928\u0939\u0940\u0902 \u0917\u092d\u094d\u0930\u093e\u092f\u093e, \u0930\u094b\u0915\u093f\u0924 \u0928\u0947 \u0909\u0938\u0947 \u090f\u0921\u094d\u0926 \u0915\u0940 \u092a\u0915\u0930 \u0938\u0947 \u092c\u0939\u093e\u0930 \u092b\u0947\u0917 \u0926\u093f\u092f\u093e, \u0924\u094b \u0917\u0908 \u0915\u0939\u093e, \u0938\u0928 \u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0914"
 },
 {
  "start": 40.14,
  "end": 41.38,
  "text": " \u091a\u093e\u0928\u094d\u0926 \u0915\u0940 \u0926\u0942\u0930\u0940"
 },
 {
  "start": 42.14,
  "end": 43.58,
  "text": " 260 \u0924\u093e\u0908\u0902\u0938"
 },
 {
  "start": 43.58,
  "end": 45.22,
  "text": " \u0938\u0928 \u0915\u0947 \u0932\u0917\u092c\u092d\u0915 6 \u091a\u0915\u094d\u0915\u0930"
 },
 {
  "start": 45.22,
  "end": 47.44,
  "text": " \u0935\u093e\u0930\u0947\u0902\u091f\u0940 36,000 \u092e\u093f\u0932\u094d\u0938"
 },
 {
  "start": 47.44,
  "end": 48.38,
  "text": " \u0915\u094d\u0932\u0940\u092e \u0930\u093f\u091c\u0947\u0915\u094d\u0924"
 },
 {
  "start": 48.38,
  "end": 49.92,
  "text": " \u092b\u093f\u0930 \u0915\u0939\u093e\u0928\u0940 \u0914\u0930 \u091c\u0940\u092c \u0939\u0941\u0908"
 },
 {
  "start": 49.92,
  "end": 51.36,
  "text": " 2025 \u092e\u0947\u0902"
 },
 {
  "start": 51.36,
  "end": 54.02,
  "text": " \u0906\u0938\u094d\u091f\u0930\u0928\u094b\u092e\u091c \u0928\u0947 \u0905\u0930\u094d\u0925 \u0915\u0947 \u092a\u093e\u0938 \u0907\u0915 \u0928\u092f\u093e \u0906\u0938\u094d\u091f\u0930\u094b\u0907\u091f \u0915\u094b\u091c\u093e"
 },
 {
  "start": 54.02,
  "end": 55.38,
  "text": " \u0928\u092f\u093e \u0906\u0938\u094d\u091f\u0930\u094b\u0907\u091f"
 },
 {
  "start": 55.38,
  "end": 57.08,
  "text": " \u0930\u0942\u0915\u094b, \u0907\u0938 \u092e\u0947\u0902 \u0938\u0940\u091f\u0947 \u0939\u0948"
 },
 {
  "start": 57.08,
  "end": 62.22,
  "text": " \u0907\u0915 \u0926\u093f\u0928 \u092c\u093e\u0926 \u0909\u0938\u0947 \u0939\u0924\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e, \u0935\u094b \u0915\u093e\u0930 \u0925\u0940, \u0938\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u092a\u094b\u091f\u094d\u0938 \u0915\u093e\u0930 \u092d\u0940 \u092c\u0938\u0947 \u090f\u0915 \u0914\u0930 \u092a\u0924\u094d\u0924\u0930 \u0939\u0948."
 },
 {
  "start": 62.46,
  "end": 65.28,
  "text": " \u0907\u0938 \u092e\u0939\u0940\u0928\u0947 \u091f\u0947\u0938\u094d\u0932\u093e\u0928\u0947 \u0928\u0939\u0940\u0902 \u0930\u094b\u091f \u0938\u094d\u091f\u0930 \u0926\u093f\u0916\u093e\u090f, \u092a\u0939\u0932\u0940 \u0935\u093e\u0932\u0940."
 },
 {
  "start": 66.1,
  "end": 68.56,
  "text": " \u0905\u092c \u092d\u0940 \u0935\u0939\u0940, \u091f\u094d\u0930\u093f\u0938\u094d\u091f \u092f\u0947 \u0935\u093e\u092a\u0938 \u0906\u0938\u0915\u0924\u0940 \u0939\u0948."
 },
 {
  "start": 68.82,
  "end": 71.26,
  "text": " \u0905\u0930\u094d\u0925 \u092f\u093e \u0935\u0940\u0928\u0938 \u0938\u0947 \u0924\u0915\u094d\u0930\u093e \u0915\u0930, \u092e\u093f\u0932\u094d\u092f\u0928 \u0938\u093e\u0932\u094b \u092e\u0947\u0902."
 },
 {
  "start": 71.26,
  "end": 77.18,
  "text": " \u0924\u094b\u0921\u093e \u0932\u0947\u091f \u0939\u0941, \u0906\u0924\u093e \u0939\u0941, \u0936\u093e\u092f\u090f\u0926, \u092f\u0947 \u0939\u0948 \u092d\u0941\u0917\u094b\u0932, \u0906\u0938\u0947 \u0939\u0940 \u092e\u091c\u093f\u0926\u093e\u0930 \u091c\u0940\u0905\u0917\u094d\u0930\u092b\u0940 Facts \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u0932\u094b \u0915\u0930\u0947\u0902\u0964"
 }
]