[
 {
  "start": 0.0,
  "end": 3.18,
  "text": " \u0905\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0938\u0947 \u092f\u094b\u0930\u092c \u091c\u093e\u0928\u093e \u0939\u094b \u0924\u094b \u0906\u092c \u0935\u0947\u0938\u094d\u091f \u091c\u093e\u0924\u0947\u0902"
 },
 {
  "start": 3.18,
  "end": 7.58,
  "text": " \u092f\u0947 \u092a\u094d\u0932\u0947\u0928 \u0907\u0938\u094d\u091f \u0917\u092f\u093e, 24 \u0905\u0935\u0930\u094d\u0938 \u0928\u093e\u0901\u0938\u094d\u091f\u094d\u0930\u094d\u092a"
 },
 {
  "start": 7.58,
  "end": 9.76,
  "text": " \u0914\u0930 \u090f\u0930\u094d\u0932\u093f\u0928\u0930 \u0935\u0932\u094d\u0921 \u0930\u0947\u0915\u0921 \u092c\u0928\u093e \u0926\u093f\u092f\u093e"
 },
 {
  "start": 9.76,
  "end": 15.18,
  "text": " \u0907\u0902\u091f\u093f\u092f\u093e \u0915\u0947 \u092a\u093e\u0938 \u0938\u0947 \u0936\u094b\u091f \u0930\u093e\u0938\u094d\u091f\u093e \u0915\u0930\u0940\u092c 17,000 km \u0906\u092a \u092f\u0947 \u091c\u0947\u091f \u092a\u0938\u094d\u0938\u093f\u092b\u093f\u0915,"
 },
 {
  "start": 15.18,
  "end": 20.94,
  "text": " \u0905\u092e\u0930\u0947\u0915\u093e \u0914\u0930 \u0905\u0924\u094d\u0932\u093e\u0928\u094d\u091f\u093f\u0915 \u092a\u093e\u0930 \u0915\u0930 \u0917\u092f\u093e, \u0926\u094b \u0938\u0928\u094d\u0938\u0947\u091f \u0926\u094b \u0938\u0928\u094d\u0930\u093e\u0907\u0938 \u0924\u0941 \u0932\u0902\u092c\u093e \u0930\u093e\u0938\u094d\u0924\u093e \u0915\u094d\u092f\u0964"
 },
 {
  "start": 20.94,
  "end": 27.12,
  "text": " \u0915\u094d\u092f\u0964 \u0915\u094d\u092f\u0964 \u0930\u0947\u0915\u0930\u094d\u091f \u0926\u093f\u0938\u094d\u091f\u0928\u094d\u0938 \u0917\u093f\u0928\u094d\u0924\u093e \u0939\u0948, 23,000 km \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0905\u0926\u0940 \u0926\u0930\u094d\u0924\u0940 \u0938\u0947 \u092d\u0940 \u0932\u0902\u092d\u093e"
 },
 {
  "start": 27.12,
  "end": 31.92,
  "text": " \u0914\u0930 \u091c\u094b \u0930\u0947\u0915\u0930\u094d\u091f \u0924\u0941\u091f\u093e 2005 \u0915\u093e \u090f\u0915 \u092c\u094b\u0907\u0902\u0917, \u0935\u094b \u092d\u0940 \u0932\u0902\u092d\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u0917\u092f\u093e \u0925\u093e"
 },
 {
  "start": 31.92,
  "end": 35.64,
  "text": " \u0915\u0928\u094d\u0924\u094d\u0930\u0942\u0932\u0930\u094d\u0938 \u0928\u0947 \u0924\u094b \u0936\u094b\u091f \u0915\u0930 \u0924\u0915 \u0905\u092b\u0930 \u0915\u093f\u090f, \u092a\u093f\u0932\u0947\u091f\u094d\u0938 \u0928\u0947 \u092e\u0928\u093e \u0915\u0930 \u0926\u093f\u092f\u093e."
 },
 {
  "start": 36.12,
  "end": 39.26,
  "text": " \u0930\u0947\u0915\u094d\u0921 \u0915\u0940 \u0926\u0942\u0928\u094d\u092f\u093e \u092e\u0947\u0902 \u0917\u0932\u0924 \u0930\u093e\u0938\u094d\u0924\u093e \u0939\u0940 \u0938\u0939\u0940 \u0930\u093e\u0938\u094d\u0924\u093e \u0939\u0948."
 },
 {
  "start": 39.62,
  "end": 40.9,
  "text": " \u092f\u0947 \u0939\u0948 \u092c\u0942\u0917\u094b\u0932."
