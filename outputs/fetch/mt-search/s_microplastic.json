icity_assay_in_Daphnia_magna_-_1-s2.0-S0269749120360802-fx1_lrg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Microplastic_toxicity_assay_in_Daphnia_magna_-_1-s2.0-S0269749120360802-fx1_lrg.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=101682659","extmetadata":{"ImageDescription":{"value":"Microplastic toxicity assay in Daphnia magna for polyvinyl chloride (PVC), polyurethane (PUR) and polylactic acid (PLA) microplastics","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-08-19","source":"commons-desc-page"},"Artist":{"value":"Lisa Zimmermann, Sarah G\u00f6ttlich, J\u00f6rg Oehlmann, Martin Wagner, Carolin V\u00f6lker","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}}}]},"101682660":{"pageid":101682660,"ns":6,"title":"File:Microplastic toxicity assay in Daphnia magna - 1-s2.0-S0269749120360802-gr2 lrg.jpg","index":7,"imagerepository":"local","imageinfo":[{"size":469868,"width":1693,"height":2276,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Microplastic_toxicity_assay_in_Daphnia_magna_-_1-s2.0-S0269749120360802-gr2_lrg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1800,"thumbheight":2420,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Microplastic_toxicity_assay_in_Daphnia_magna_-_1-s2.0-S0269749120360802-gr2_lrg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1800,"height":2420},"url":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Microplastic_toxicity_assay_in_Daphnia_magna_-_1-s2.0-S0269749120360802-gr2_lrg.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Microplastic_toxicity_assay_in_Daphnia_magna_-_1-s2.0-S0269749120360802-gr2_lrg.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=101682660","extmetadata":{"ImageDescription":{"value":"Microplastic toxicity assay in Daphnia magna for polyvinyl chloride (PVC), polyurethane (PUR) and polylactic acid (PLA) microplastics. Daphnids were exposed to four treatments of PVC, PUR and PLA: (1, MP) untreated microplastics containing all chemicals, (2, eMP) microplastics without extractable chemicals, (3, E) plastic extracts containing all extractable chemicals and (4, M) plastic migrates containing the chemicals released from microplastics into water (M). We included a negative control (NC), a solvent control (DMSO) and procedural blanks of the extraction (PB E) and migration (PB M) consisting of Elendt M4 media treated identically as the plastic extracts and migrates, respectively.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-08-19","source":"commons-desc-page"},"Artist":{"value":"Lisa Zimmermann, Sarah G\u00f6ttlich, J\u00f6rg Oehlmann, Martin Wagner, Carolin V\u00f6lker","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}}}]},"81011631":{"pageid":81011631,"ns":6,"title":"File:Microplastics- an emerging pollutant in an aquatic ecosystem.png","index":2,"imagerepository":"local","imageinfo":[{"size":1107136,"width":775,"height":714,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/1d/Microplastics-_an_emerging_pollutant_in_an_aquatic_ecosystem.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1800,"thumbheight":1658,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/1d/Microplastics-_an_emerging_pollutant_in_an_aquatic_ecosystem.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1800,"height":1658},"url":"https://upload.wikimedia.or