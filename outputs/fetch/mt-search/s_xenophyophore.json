/Xenophyophore.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1800,"thumbheight":1203,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/5/5d/Xenophyophore.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1800,"height":1203},"url":"https://upload.wikimedia.org/wikipedia/commons/5/5d/Xenophyophore.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Xenophyophore.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=57230","extmetadata":{"ImageDescription":{"value":"Xenophyophore in the Galapagos Rift","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2002-06-04","source":"commons-desc-page"},"Artist":{"value":"NOAA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"26265506":{"pageid":26265506,"ns":6,"title":"File:XenophyophoreNOAA.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":92362,"width":600,"height":514,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/6/64/XenophyophoreNOAA.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1800,"thumbheight":1542,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/6/64/XenophyophoreNOAA.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1800,"height":1542},"url":"https://upload.wikimedia.org/wikipedia/commons/6/64/XenophyophoreNOAA.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:XenophyophoreNOAA.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=26265506","extmetadata":{"ImageDescription":{"value":"The image may be one of a large 20-cm wide <a href=\"https://en.wikipedia.org/wiki/Xenophyophore\" class=\"extiw\" title=\"en:Xenophyophore\">Xenophyophore</a>. Xenophyophores are single cell Eukaryotes called protists. As benthic particulate feeders, xenophyophores normally sift through the sediments on the sea floor and excrete a slimy substance; in locations with a dense population of xenophyophores, such as at the bottoms of oceanic trenches, this slime may cover large areas. Local population densities may be as high as 2,000 individuals per 100 square meters. Image courtesy of IFE, URI-JAO, Lost City science party, and NOAA.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2005","source":"commons-desc-page"},"Artist":{"value":"NOAA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"92098011":{"pageid":92098011,"ns":6,"title":"File:Xenophyophore (10.1016-j.ejop.2020.125715) Figure 15.jpg","index":6,"imagerepository":"local","imageinfo":[{"size":1056610,"width":2508,"height":2094,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Xenophyophore_%2810.1016-j.ejop.2020.125715%29_Figure_15.jpg/1920px-Xenophyophore_%2810.1016-j.ejop.2020.125715%29_Figure_15.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1800,"thumbheight":1503,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/c/c6/Xenophyophore_%2810.1016-j.ejop.2020.125715%29_Figure_15.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Xenophyophore_%2810.1016-j.ejop.2020.125715%29_Figure_15.jpg/1920px-Xenophyophore_%2810.1016-j.ejop.2020.125715%29_Figure_15.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1800,"height":1503,"srcset":"https:/