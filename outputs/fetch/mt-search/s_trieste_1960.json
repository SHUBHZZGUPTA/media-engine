.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Bathyscaphe_Trieste_hoisted.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=500706","extmetadata":{"ImageDescription":{"value":"US Navy Bathyscaphe Trieste (1958 \u2013 1963) is hoisted from the water by a floating crane, during testing by the Naval Electronics Laboratory in the San Diego, California, area. Trieste was being prepared for transportation to the Marianas Islands for a three-month series of deep-submergence operations. On 2 October 1959, she was loaded on the frieghter Santa Maria for the trip to the mid-Pacific. U.S. Naval History and Heritage Command Photograph.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"circa 1958<div style=\"display: none;\">date QS:P,+1958-00-00T00:00:00Z/9,P1480,Q5727902</div>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"500700":{"pageid":500700,"ns":6,"title":"File:Bathyscaphe Trieste sphere.jpg","index":6,"imagerepository":"local","imageinfo":[{"size":93383,"width":595,"height":740,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/d/d6/Bathyscaphe_Trieste_sphere.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1800,"thumbheight":2239,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/d/d6/Bathyscaphe_Trieste_sphere.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1800,"height":2239},"url":"https://upload.wikimedia.org/wikipedia/commons/d/d6/Bathyscaphe_Trieste_sphere.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Bathyscaphe_Trieste_sphere.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=500700","extmetadata":{"Licens