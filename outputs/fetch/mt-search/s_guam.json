f=\"https://en.wikipedia.org/wiki/Agana_Spanish_Bridge\" class=\"extiw\" title=\"en:Agana Spanish Bridge\">Agana Spanish Bridge</a> to a location west of the current marina and Paseo de Susana.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1943-11-12","source":"commons-desc-page"},"Artist":{"value":"Naval Air Station Weeksville airship, U.S. National Archives","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"20601342":{"pageid":20601342,"ns":6,"title":"File:Air Depot Field Guam aerial photo January 1945.jpg","index":7,"imagerepository":"local","imageinfo":[{"size":1710450,"width":2287,"height":2249,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/Air_Depot_Field_Guam_aerial_photo_January_1945.jpg/1920px-Air_Depot_Field_Guam_aerial_photo_January_1945.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1800,"thumbheight":1770,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/8/8f/Air_Depot_Field_Guam_aerial_photo_January_1945.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/Air_Depot_Field_Guam_aerial_photo_January_1945.jpg/1920px-Air_Depot_Field_Guam_aerial_photo_January_1945.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1800,"height":1770,"srcset":"https://upload.wikimedia.org/wikipedia/commons/8/8f/Air_Depot_Field_Guam_aerial_photo_January_1945.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8f/Air_Depot_Field_Guam_aerial_photo_January_1945.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Air_Depot_Field_Guam_aerial_photo_January_1945.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=20601342","extmetadata":{"ImageDescription":{"value":"Aerial view of Air Depot Field (20th Air Force) Guam. Construction on this field began on 6 September 1944 and the 2.100 m by 45 m runway became operational on 10 November. USAAF Consolidated B-24 <i>Liberator</i> bombers used it at first to make raids on adjacent Japanese controlled islands. The Japanese had started construction on this field known as Tiyan airfield, in 1944 and the Americans enlarged, improved, and completed it. Air Depot Field, later renamed Harmon Field, is still under construction in this view. The buildings and storage areas were completed by the end of February 1945. The Agana (Naval) airfield is visible at the left of this photo, located on a higher plateau. Agana Bay is visible in the far distance at the end of the Air Depot runway and a small portion of Tumon Bay can be seen in the upper right.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1945-01-24","source":"commons-desc-page"},"Artist":{"value":"USN","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"11740197":{"pageid":11740197,"ns":6,"title":"File:Orote Peninsula old airfield Guam aerial 1999.JPEG","index":1,"imagerepository":"local","imageinfo":[{"size":4126165,"width":2870,"height":1940,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Orote_Peninsula_old_airfield_Guam_aerial_1999.JPEG/1920px-Orote_Peninsula_old_airfield_Guam_aerial_1999.JPEG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1800,"thumbheight":1217,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/6/67/Orote_Peninsula_old_airfield_Guam_aerial_1999.JPEG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipe