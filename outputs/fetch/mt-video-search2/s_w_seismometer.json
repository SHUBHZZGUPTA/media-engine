:1080,"duration":10.683,"url":"https://upload.wikimedia.org/wikipedia/commons/d/d2/Elizabeth_Ann_technician_handling_part_of_obs_and_monitoring.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Elizabeth_Ann_technician_handling_part_of_obs_and_monitoring.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=100112424","extmetadata":{"ImageDescription":{"value":"Elizabeth Ann, the first cloned black-footed ferret and first-ever cloned U.S. endangered species, is handled by a technician during routine monitoring and observation.","source":"commons-desc-page"},"Artist":{"value":"USFWS National Black-footed Ferret Conservation Center","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"68311165":{"pageid":68311165,"ns":6,"title":"File:How to stream with free software.webm","index":8,"imagerepository":"local","imageinfo":[{"size":613753586,"width":1280,"height":720,"duration":2374.014,"url":"https://upload.wikimedia.org/wikipedia/commons/3/3e/How_to_stream_with_free_software.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:How_to_stream_with_free_software.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=68311165","extmetadata":{"ImageDescription":{"value":"OBS Studio is a FLOSS application that puts you in the director's chair for live streaming or recording. It is built as an application to help video game or creative streamers share their computer screens with a live audience, but its power goes well beyond that. Anyone who is using their computer to tell a story can benefit from the professional touch that OBS can provide. It can manage multiple capture devices, independently combine captured window areas, and overlay text and graphics. In this presentation, I'll show you what this software can do, and what you can do with it. A simple example: presenters often like to include their social media handle on their slides. When the presenter goes to the terminal, this isn't displayed. If the presenter uses OBS studio to control the projector display, OBS studio can trivially be configured to overlay anything.","source":"commons-desc-page"},"Artist":{"value":"Free Software Foundation","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"172237082":{"pageid":172237082,"ns":6,"title":"File:Interview research cruise KASEAOPE-01 (Ifremer 00834-94616).webm","index":28,"imagerepository":"local","imageinfo":[{"size":390911355,"width":1920,"height":1080,"duration":350.493,"url":"https://upload.wikimedia.org/wikipedia/commons/5/53/Interview_research_cruise_KASEAOPE-01_%28Ifremer_00834-94616%29.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Interview_research_cruise_KASEAOPE-01_(Ifremer_00834-94616).webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=172237082","extmetadata":{"ImageDescription":{"value":"An interview of three participants of the research cruise KASEAOPE-01 (May 2023) to deploy an observatory system off the New Caledonia, under the project ScInObs.","source":"commons-desc-page"},"Artist":{"value":"Nan-Chin Chu, Marie Guennou","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"172239382":{"pageid":172239382,"ns":6,"title":"File:Interview research cruise KASEAOPE-02 (Ifremer 00914-102631).webm","index":27,"imagerepository":"local","imageinfo":[{"size":577320052,"width":1920,"height":1080,"duration":455.346,"url":"https://upload.wikimedia.org/wikipedia/commons/a/ac/Interview_research_cruise_KASEAOPE-02_%28Ifremer_00914-102631%29.w