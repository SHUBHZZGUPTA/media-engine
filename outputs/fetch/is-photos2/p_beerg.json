ce":"commons-templates","hidden":""}}}]},"27663347":{"pageid":27663347,"ns":6,"title":"File:Saku P\u00fcssirohu Punane.jpg","index":9,"imagerepository":"local","imageinfo":[{"size":2669520,"width":3000,"height":4000,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/4/41/Saku_P%C3%BCssirohu_Punane.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":2560,"thumbheight":3413,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/4/41/Saku_P%C3%BCssirohu_Punane.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":2560,"height":3413},"url":"https://upload.wikimedia.org/wikipedia/commons/4/41/Saku_P%C3%BCssirohu_Punane.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saku_P%C3%BCssirohu_Punane.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/27663347","extmetadata":{"DateTime":{"value":"2013-08-11 14:36:28","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Saku P\u00fcssirohu Punane","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Canon PowerShot SX260 HS|Beers of Estonia|Saku Brewery|Tartu Gunpowder Cellar|Flickr images uploaded by Flickr upload bot|2013 in Tartu|Estonia photographs taken on 2013-07-01|Glasses of beer|Files from Bernt Rostad Flickr stream","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>A 1-liter mug of Saku P\u00fcssirohu Punane served on draft at P\u00fcssirohukelder beer restaurant in Tartu, Estonia.\n</p>\nSaku P\u00fcssirohu Punane is a 5% abv red tinged, golden brown lager, brewed at the Carlsberg owned &lt;a href=\"<a rel=\"nofollow\" class=\"external free\" href=\"http://www.saku.ee/\">http://www.saku.ee/</a>\" rel=\"nofollow\"&gt;Saku \u00d5lletehas&lt;/a&gt; just outside Tallinn as the house beer for P\u00fcssirohukelder. Punane means red in Estonian, hinting to the color of this filtered lager. It had a fine malt aroma with some toasted notes, this was followed up in the flavor which reminded me of a Vienna lager. Overall a decent beer, but a bit thinner and simpler than the better Vienna lagers.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a01 July 2013, 19:04:34","source":"commons-desc-page"},"Credit":{"value":"<a href=\"//commons.wikimedia.org/wiki/Flickr\" class=\"mw-redirect\" title=\"Flickr\">Flickr</a>: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/67975030@N00/9414767702\">Saku P\u00fcssirohu Punane</a>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//www.flickr.com/people/67975030@N00\" class=\"extiw\" title=\"flickruser:67975030@N00\">Bernt Rostad</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]},"43165739":{"pageid":43165739,"ns":6,"title":"File:\u30b5\u30c3\u30dd\u30ed\u30d3\u30fc\u30eb \u30dd\u30ed\u541b (4933045511).jpg","index":6,"imagerepository":"local","imageinfo":[{"size":625615,"width":1000,"height":1000,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/2/2e/%E3%82%B5%E3%83%83%E3%83%9D%E3%83%AD%E3%83%93%E3%83%BC%E3%83%AB_%E3%83%9D%E3%83%AD%E5%90%9B_%284933045511%29.jpg?utm_source=com