27\">6124127</a>. <a href=\"https://en.wikipedia.org/wiki/PMID_(identifier)\" class=\"extiw\" title=\"en:PMID (identifier)\">PMID</a>\u00a0<a rel=\"nofollow\" class=\"external text\" href=\"https://pubmed.ncbi.nlm.nih.gov/30225016\">30225016</a>. (<a rel=\"nofollow\" class=\"external text\" href=\"https://crossmark.crossref.org/dialog/?doi=10.1098/rsos.180286&amp;domain=pdf\">Check for updates</a>)","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2018-08-22","source":"commons-desc-page"},"Artist":{"value":"Marsh, Leigh; Huvenne, Veerle A. I.; Jones, Daniel O. B.","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}}}]},"91529553":{"pageid":91529553,"ns":6,"title":"File:MARINE DEBRIS AND WILDLIFE- IMPACTS, SOURCES, AND SOLUTIONS (IA gov.gpo.fdsys.CHRG-114shrg22168).pdf","index":1,"imagerepository":"local","imageinfo":[{"size":3580228,"width":1275,"height":1650,"pagecount":437,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/MARINE_DEBRIS_AND_WILDLIFE-_IMPACTS%2C_SOURCES%2C_AND_SOLUTIONS_%28IA_gov.gpo.fdsys.CHRG-114shrg22168%29.pdf/page1-960px-MARINE_DEBRIS_AND_WILDLIFE-_IMPACTS%2C_SOURCES%2C_AND_SOLUTIONS_%28IA_gov.gpo.fdsys.CHRG-114shrg22168%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1800,"thumbheight":2329,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/MARINE_DEBRIS_AND_WILDLIFE-_IMPACTS%2C_SOURCES%2C_AND_SOLUTIONS_%28IA_gov.gpo.fdsys.CHRG-114shrg22168%29.pdf/page1-960px-MARINE_DEBRIS_AND_WILDLIFE-_IMPACTS%2C_SOURCES%2C_AND_SOLUTIONS_%28IA_gov.gpo.fdsys.CHRG-114shrg22168%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1800,"height":2329},"url":"https://upload.wikimedia.org/wikipedia/commons/2/2f/MARINE_DEBRIS_AND_WILDLIFE-_IMPACTS%2C_SOURCES%2C_AND_SOLUTIONS_%28IA_gov.gpo.fdsys.CHRG-114shrg22168%29.pd