org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":1080,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/Khaba_Fort.jpg/3840px-Khaba_Fort.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/Khaba_Fort.jpg/1920px-Khaba_Fort.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":1080,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/Khaba_Fort.jpg/3840px-Khaba_Fort.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/2/2c/Khaba_Fort.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Khaba_Fort.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=200661298","extmetadata":{"ImageDescription":{"value":"Khaba Fort, overlooking the abandoned village of Khabha near Jaisalmer, Rajasthan, stands amidst the stark landscape of the Thar Desert. Built from locally available golden-yellow sandstone, the fort is characterized by its long defensive walls, crenellated parapets, projecting bastions and a prominent arched entrance. I have framed the monument with the winding road leading towards the central gateway, emphasizing the fort's imposing horizontal form, its isolation and its close relationship with the surrounding desert landscape.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2021-01-13 12:56:39","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:Kartikr.naturephotography&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Kartikr.naturephotography (page does not exist)\">Kartikr.naturephotography</a>","source":"commons-desc-page"}