{"batchcomplete":"","continue":{"gsroffset":8,"continue":"gsroffset||"},"query":{"pages":{"7216200":{"pageid":7216200,"ns":6,"title":"File:Saharan Dust Crosses the Atlantic.jpg","index":4,"imagerepository":"local","imageinfo":[{"size":110222,"width":540,"height":703,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/7/70/Saharan_Dust_Crosses_the_Atlantic.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1920,"thumbheight":2500,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/7/70/Saharan_Dust_Crosses_the_Atlantic.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1920,"height":2500},"url":"https://upload.wikimedia.org/wikipedia/commons/7/70/Saharan_Dust_Crosses_the_Atlantic.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_Dust_Crosses_the_Atlantic.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=7216200","extmetadata":{"ImageDescription":{"value":"The June 22 image shows the massive dust plume blowing off the west coast of Africa toward the west in a slightly clockwise direction. As the dust blows, vortex streets\u2014swirling clouds that occur in the wake of air-flow obstacles such as islands\u2014meander southward from Cape Verde. Cape Verde receives regular doses of African dust, but dust often travels much farther west, as the June 25 image shows. Although less distinct than it appeared three days earlier, the plume is still discernible as it approaches the Caribbean and mainland South America. In the south, cloud cover obscures the view of the plume.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2007-06-27","source":"commons-desc-page"},"Artist":{"value":"Jeff Schmaltz","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"10544484":{"pageid":10544484,"ns":6,"title":"File:Saharan Dust Crosses the Atlantic (MODIS).jpg","index":2,"imagerepository":"local","imageinfo":[{"size":11999216,"width":11000,"height":5200,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg/1920px-Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":908,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg/3840px-Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg/1920px-Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":908,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg/3840px-Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/c9/Saharan_Dust_Crosses_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_Dust_Crosses_the_Atlantic_(MODIS).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=10544484","extmetadata":{"ImageDescription":{"value":"This photo-like satellite image shows Saharan dust being ferried across the <a href=\"//commons.wikimedia.org/wiki/Atlantic\" class=\"mw-redirect\" title=\"Atlantic\">Atlantic</a> on easterly <a href=\"//commons.wikimedia.org/wiki/Wind\" title=\"Wind\">winds</a>.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2010-06-04","source":"commons-desc-page"},"Artist":{"value":"Jeff Schmaltz","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"86359224":{"pageid":86359224,"ns":6,"title":"File:Saharan Dust off West Africa.jpg","index":7,"imagerepository":"local","imageinfo":[{"size":52692,"width":514,"height":385,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/9/90/Saharan_Dust_off_West_Africa.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1920,"thumbheight":1438,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/9/90/Saharan_Dust_off_West_Africa.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1920,"height":1438},"url":"https://upload.wikimedia.org/wikipedia/commons/9/90/Saharan_Dust_off_West_Africa.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_Dust_off_West_Africa.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=86359224","extmetadata":{"ImageDescription":{"value":"An intense African dust storm sent a massive dust plume northwestward over the Atlantic Ocean on March 2, 2003. In this true-color scene, acquired by the Moderate Resolution Imaging Spectroradiometer (MODIS) aboard NASA's Terra satellite, the thick dust plume (light brown) can be seen blowing westward and then routed northward by strong southerly winds. The plume extends more than 1,000 miles (1,600 km), covering a vast swath of ocean extending from the Cape Verde Islands (lower lef), off the coast of Senegal, to the Canary Islands (top center) off the coast of Morocco. The high-resolution image provided above is 500 meters per pixel. The MODIS Rapid Response System provides this image at MODIS\u2019 maximum spatial resolution of 250 meters. Image courtesy Jacques Descloitres, MODIS Rapid Response Team, NASA GSFC.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2003-03-02","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"135361378":{"pageid":135361378,"ns":6,"title":"File:Saharan Dust over the Atlantic (MODIS).jpg","index":1,"imagerepository":"local","imageinfo":[{"size":3518593,"width":8123,"height":6177,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/1920px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":1460,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/3840px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/1920px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":1460,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/3840px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_Dust_over_the_Atlantic_(MODIS).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=135361378","extmetadata":{"ImageDescription":{"value":"Since mid-February 2023, massive pulses of dust have poured off the west coast of Africa, coloring the skies with a tan haze.\n<p>The Moderate Resolution Imaging Spectroradiometer (MODIS) on board NASA\u2019s Aqua satellite captured a true-color image of dust stretching more than 2,000 km (1,200 miles) over the coastal countries (Mali, Senegal, Gambia, Guinea-Bissau, Guinea, Sierra Leone) to the open waters of the Atlantic. The dust is so thick in the west that it obscures the blue waters of the Atlantic from view.\n</p><p>According to the Copernicus Atmospheric Monitoring Service (CAMS), the first large-scale Saharan dust transport of 2023 took place in mid-February, with dust concentrations across the Iberian Peninsula rising on February 20. The report, published on February 21, forecast that Saharan dust would reach as far north as Denmark by February 23. Daily MODIS imagery confirms dust not only pulsing northward to Europe during that time, but also reaching across the North Atlantic Ocean, closely approaching the shores of South America.\n</p>\nThe Sahara Desert is by far Earth\u2019s largest source of airborne dust, and the storms can arise at any time of year. It is estimated that winds pick up 100 million tons of dust from the Sahara each year, with a sizable portion blowing out over the North Atlantic Ocean. During winter and spring storms, the dust often ends up fertilizing the nutrient-poor soils of South America\u2019s Amazon rainforest.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a023 February 2023","source":"commons-desc-page"},"Artist":{"value":"MODIS Land Rapid Response Team, NASA GSFC","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"94017022":{"pageid":94017022,"ns":6,"title":"File:Saharan dust - Jun 18, 2020.jpg","index":3,"imagerepository":"local","imageinfo":[{"size":1741911,"width":4532,"height":3233,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Saharan_dust_-_Jun_18%2C_2020.jpg/1920px-Saharan_dust_-_Jun_18%2C_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":1370,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Saharan_dust_-_Jun_18%2C_2020.jpg/3840px-Saharan_dust_-_Jun_18%2C_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Saharan_dust_-_Jun_18%2C_2020.jpg/1920px-Saharan_dust_-_Jun_18%2C_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":1370,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Saharan_dust_-_Jun_18%2C_2020.jpg/3840px-Saharan_dust_-_Jun_18%2C_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/9/92/Saharan_dust_-_Jun_18%2C_2020.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_dust_-_Jun_18,_2020.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=94017022","extmetadata":{"ImageDescription":{"value":"Satellite image showing mineral dust in the Atlantic Ocean on June 18, 2020.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-06-18","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"97609377":{"pageid":97609377,"ns":6,"title":"File:Saharan dust over the Atlantic Ocean (33132810158).jpg","index":6,"imagerepository":"local","imageinfo":[{"size":21382741,"width":8084,"height":5833,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg/1920px-Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":1385,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg/3840px-Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg/1920px-Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":1385,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg/3840px-Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/9/93/Saharan_dust_over_the_Atlantic_Ocean_%2833132810158%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_dust_over_the_Atlantic_Ocean_(33132810158).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=97609377","extmetadata":{"ImageDescription":{"value":"<p>Aqua and Terra MODIS data through &lt;a href=\"<a rel=\"nofollow\" class=\"external free\" href=\"https://worldview.earthdata.nasa.gov/\">https://worldview.earthdata.nasa.gov/</a>\" rel=\"noreferrer nofollow\"&gt;NASA Worldview&lt;/a&gt;, processed by &lt;a href=\"<a rel=\"nofollow\" class=\"external free\" href=\"https://twitter.com/Pierre_Markuse\">https://twitter.com/Pierre_Markuse</a>\" rel=\"noreferrer nofollow\"&gt;Pierre Markuse&lt;/a&gt;\n</p>\nSaharan dust over the Atlantic Ocean","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-02-06 19:11","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/24998770@N07\">Pierre Markuse</a> from Hamm, Germany","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"144785133":{"pageid":144785133,"ns":6,"title":"File:Sweeping Saharan Dust Storm (MODIS 2021-02-18).jpg","index":8,"imagerepository":"local","imageinfo":[{"size":2608041,"width":5152,"height":4269,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg/1920px-Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":1591,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg/3840px-Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg/1920px-Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":1591,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg/3840px-Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/d/d2/Sweeping_Saharan_Dust_Storm_%28MODIS_2021-02-18%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Sweeping_Saharan_Dust_Storm_(MODIS_2021-02-18).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=144785133","extmetadata":{"ImageDescription":{"value":"Strong winds blowing across northern Africa created a sweeping storm of sand and dust in mid-February 2021. The Moderate Resolution Imaging Spectroradiometer (MODIS) on board NASA\u2019s Terra satellite acquired a true-color image of a massive mobilization of Saharan dust on February 16. The image is a mosaic, with data from three different passes of the satellite over Africa stitched together to give a broad view of the region. The dark areas are created by lack of data collection at the edge of the satellite swaths and due to projection of a curved Earth surface onto a flat image.\n<p>Plumes of camel-color dust rise as far inland as Libya and Chad and blow westward, joining more rising dust until the shifting sand completely blankets the skies over Mauritania, southern Morocco, and northern Senegal. The leading edge of the massive dust cloud extends about 500 miles (805 km) off the African coast to completely obscure part of the North Atlantic Ocean from view. Thick swirls of dust also hang over the Canary Islands.\n</p><p>The total length of shifting sand, measured from the first major plumes of inland to the leading edge of dust over the Atlantic, comes in at about 2,600 miles (4,180 km). For comparison, the approximate maximum width of the African Continent, from east to west, is 4,600 miles (7,400 km) and the distance from the coast of Senegal (Africa) to the coast of Brazil (South America) is only about 1,600 miles (2,575 km).\n</p>\nBy February 15, the leading edge of the dust appeared to be extending further across the Atlantic Ocean, moving toward South America. Every year, about 800 million tons of dust is picked up by the wind from deserts in North Africa and blown across the Atlantic Ocean, traveling to the Amazon River Basin in South America, beaches in the Caribbean and, in part, into the air in North and South America.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a016 December 2021","source":"commons-desc-page"},"Artist":{"value":"MODIS Land Rapid Response Team, NASA GSFC","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"95849697":{"pageid":95849697,"ns":6,"title":"File:This animation of the progression Saharan dust cloud across the Atlantic Ocean from June 15 to 25, 2020.gif","index":5,"imagerepository":"local","imageinfo":[{"size":7766684,"width":994,"height":580,"duration":7,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/19/This_animation_of_the_progression_Saharan_dust_cloud_across_the_Atlantic_Ocean_from_June_15_to_25%2C_2020.gif?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1920,"thumbheight":1120,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/19/This_animation_of_the_progression_Saharan_dust_cloud_across_the_Atlantic_Ocean_from_June_15_to_25%2C_2020.gif?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1920,"height":1120},"url":"https://upload.wikimedia.org/wikipedia/commons/1/19/This_animation_of_the_progression_Saharan_dust_cloud_across_the_Atlantic_Ocean_from_June_15_to_25%2C_2020.gif?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:This_animation_of_the_progression_Saharan_dust_cloud_across_the_Atlantic_Ocean_from_June_15_to_25,_2020.gif","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=95849697","extmetadata":{"ImageDescription":{"value":"This animation of the progression Saharan dust cloud across the Atlantic Ocean from June 15 to 25, 2020 combines OMPS aerosol index and VIIRS visible imagery from NASA/NOAA\u2019s Suomi NPP satellite.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-06-29","source":"commons-desc-page"},"Artist":{"value":"NASA/NOAA, Colin Seftor","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""}},"mime":"image/gif"}]}}}}