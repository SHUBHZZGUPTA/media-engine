Artist":{"value":"GOES imagery: CSU/CIRA &amp; NOAA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"17104300":{"pageid":17104300,"ns":6,"title":"File:Evening Pass over the Sahara Desert and the Middle East.ogv","index":1,"imagerepository":"local","imageinfo":[{"size":4273163,"width":840,"height":560,"duration":23,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Evening_Pass_over_the_Sahara_Desert_and_the_Middle_East.ogv/500px--Evening_Pass_over_the_Sahara_Desert_and_the_Middle_East.ogv.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo","thumbwidth":840,"thumbheight":560,"thumbattribs":[],"url":"https://upload.wikimedia.org/wikipedia/commons/2/27/Evening_Pass_over_the_Sahara_Desert_and_the_Middle_East.ogv?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Evening_Pass_over_the_Sahara_Desert_and_the_Middle_East.ogv","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=17104300","extmetadata":{"ImageDescription":{"value":"This video over the Sahara Desert and the Middle East was taken by the crew of <a href=\"//commons.wikimedia.org/wiki/Category:ISS_Expedition_29\" title=\"Category:ISS Expedition 29\">Expedition 29</a> on board the <a href=\"//commons.wikimedia.org/wiki/International_Space_Station\" title=\"International Space Station\">International Space Station</a>. This sequence of shots was taken October 6, 2011 from 19:46:23 to 19:58:41 GMT, on an ascending pass from the Sahara Desert to western <a href=\"//commons.wikimedia.org/wiki/Kazakhstan\" title=\"Kazakhstan\">Kazakhstan</a>. The rust colour of the Sahara Desert is the first view in this video. Because this is an evening pass, the surface colours can be seen still, along with the bright lights of populated areas. The first view of these bright lights is along the <a href=\"//commons.wikimedia.org/wiki/Nile\" title=\"Nile\">Nile</a> River, which can be seen just before the <a href=\"//commons.wikimedia.org/wiki/Red_Sea\" title=\"Red Sea\">Red Sea</a>. Just down track are <a href=\"//commons.wikimedia.org/wiki/Jerusalem\" title=\"Jerusalem\">Jerusalem</a> and Lebanon's capital city, <a href=\"//commons.wikimedia.org/wiki/Beirut\" class=\"mw-redirect\" title=\"Beirut\">Beirut</a>. As the ISS approaches the <a href=\"//commons.wikimedia.org/wiki/Caspian_Sea\" class=\"mw-redirect\" title=\"Caspian Sea\">Caspian Sea</a>, the <a href=\"//commons.wikimedia.org/wiki/Category:Baku\" title=\"Category:Baku\">Baku</a> peninsula can be seen as a bright peninsula in the sea. The pass ends looking over Kazakhstan.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2011-10-06","source":"commons-desc-page"},"Artist":{"value":"ISS Expedition 29 crew","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"application/ogg"}]},"24037851":{"pageid":24037851,"ns":6,"title":"File:International Festival of the Sahara Douz.ogv","index":4,"imagerepository":"local","imageinfo":[{"size":51770574,"width":1920,"height":1080,"duration":20.578639455782312,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/International_Festival_of_the_Sahara_Douz.ogv/1920px--International_Festival_of_the_Sahara_Douz.ogv.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo","thumbwidth":1920,"thumbheight":1080,"thumbattribs":[],"url":"https://upload.wikimedia.org/wikipedia/commons/d/d5/International_Festival_of_the_Sahara_Douz.ogv?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:International_Festival_of_the_Sahara_Douz.ogv","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=24037851","extmetadata":{"ImageDescription":{"value":"Douz International Festival of the Sahara","source":"commons