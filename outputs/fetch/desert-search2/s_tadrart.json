{"batchcomplete":"","continue":{"gsroffset":8,"continue":"gsroffset||"},"query":{"pages":{"87320507":{"pageid":87320507,"ns":6,"title":"File:Journal.pone.0228588.pdf","index":8,"imagerepository":"local","imageinfo":[{"size":7783708,"width":1275,"height":1650,"pagecount":34,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Journal.pone.0228588.pdf/page1-960px-Journal.pone.0228588.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":2485,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Journal.pone.0228588.pdf/page1-960px-Journal.pone.0228588.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":2485},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1b/Journal.pone.0228588.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Journal.pone.0228588.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=87320507","extmetadata":{"ImageDescription":{"value":"The abundant faunal remains from the Takarkori rock shelter in the Tadrart Acacus region of southwestern Libya are described. The material that covers the period between 10,200 to 4650 years cal BP illustrates the more humid environmental conditions in the Central Sahara during early and middle Holocene times. Particular attention is focussed on the aquatic fauna that shows marked diachronic changes related to increasing aridification. This is reflected in the decreasing amount of fish remains compared to mammals and, within the fish fauna, by changes through time in the proportion of the species and by a reduction of fish size. The aquatic fauna can, in addition, be used to formulate hypotheses about the former palaeohydrographical network. This is done by considering the possible location of pre-Holocene relic populations combined with observations on the topography and palaeohydrological settings of the Central Sahara.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-02-19","source":"commons-desc-page"},"Artist":{"value":"Wim Van Neer, Francesca Alhaique, Wim Wouters, Katrien Dierickx, Monica Gala, Quentin Goffette, Guido S. Mariani, Andrea Zerboni, Savino di Lernia","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}},"mime":"application/pdf"}]},"2147279":{"pageid":2147279,"ns":6,"title":"File:Libya 4870 Pictograms Tadrart Acacus Luca Galuzzi 2007.jpg","index":6,"imagerepository":"local","imageinfo":[{"size":4763587,"width":2000,"height":1333,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e4/Libya_4870_Pictograms_Tadrart_Acacus_Luca_Galuzzi_2007.jpg/1920px-Libya_4870_Pictograms_Tadrart_Acacus_Luca_Galuzzi_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":1280,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/e/e4/Libya_4870_Pictograms_Tadrart_Acacus_Luca_Galuzzi_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e4/Libya_4870_Pictograms_Tadrart_Acacus_Luca_Galuzzi_2007.jpg/1920px-Libya_4870_Pictograms_Tadrart_Acacus_Luca_Galuzzi_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":1280,"srcset":"https://upload.wikimedia.org/wikipedia/commons/e/e4/Libya_4870_Pictograms_Tadrart_Acacus_Luca_Galuzzi_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e4/Libya_4870_Pictograms_Tadrart_Acacus_Luca_Galuzzi_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&u