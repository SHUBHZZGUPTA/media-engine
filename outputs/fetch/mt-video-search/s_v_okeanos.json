{"batchcomplete":"","continue":{"gsroffset":25,"continue":"gsroffset||"},"query":{"pages":{"134533086":{"pageid":134533086,"ns":6,"title":"File:0501-hydrothermal-vents-640x360.webm","index":24,"imagerepository":"local","imageinfo":[{"size":26525663,"width":640,"height":360,"duration":65.714,"url":"https://upload.wikimedia.org/wikipedia/commons/7/71/0501-hydrothermal-vents-640x360.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:0501-hydrothermal-vents-640x360.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=134533086","extmetadata":{"ImageDescription":{"value":"This incredible active hydrothermal vent was imaged for the first time during the Marianas expedition. It was 30 meters high and gushing high-temperature fluid full of metal particulates. This vent was home to many different species, including Chorocaris shrimp, Munidopsis squat lobsters, Austinograea crabs, limpets, mussels, and snails.","source":"commons-desc-page"},"Artist":{"value":"NOAA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"136676787":{"pageid":136676787,"ns":6,"title":"File:Acanthacaris tenuimana.webm","index":23,"imagerepository":"local","imageinfo":[{"size":31563134,"width":1920,"height":1080,"duration":175450.942,"url":"https://upload.wikimedia.org/wikipedia/commons/8/89/Acanthacaris_tenuimana.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Acanthacaris_tenuimana.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=136676787","extmetadata":{"ImageDescription":{"value":"This deep-sea lobster was seen guarding a series of large burrows with claws poised for action.","source":"commons-desc-page"},"Artist":{"value":"NOAA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"136532635":{"pageid":136532635,"ns":6,"title":"File:Bathynomus giganteus.webm","index":22,"imagerepository":"local","imageinfo":[{"size":15797334,"width":1280,"height":720,"duration":61.319,"url":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Bathynomus_giganteus.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Bathynomus_giganteus.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=136532635","extmetadata":{"ImageDescription":{"value":"During the first dive of the expedition, we saw this giant deep-sea isopod, <i>Bathynomus giganteus</i>. While we often see these giant underwater 'pill bugs' resting on the seafloor, we don't always get to see them swim, so seeing this isopod, which measured nearly 30 centimeters (almost one foot) long, come in for a landing was exciting!","source":"commons-desc-page"},"Artist":{"value":"NOAA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"58943149":{"pageid":58943149,"ns":6,"title":"File:Dive 7- March 10, 2016- 2016 Hohonu Moana.webm","index":5,"imagerepository":"local","imageinfo":[{"size":69181718,"width":1920,"height":1080,"duration":64.109,"url":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Dive_7-_March_10%2C_2016-_2016_Hohonu_Moana.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Dive_7-_March_10,_2016-_2016_Hohonu_Moana.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=58943149","extmetadata":{"ImageDescription":{"value":"An amazing diversity of beautiful and fragile coral and ancient organisms have occupied Papah\u0101naumoku\u0101kea Marine National Monument for hundreds to thousands of years. This footage was captured at a depth of ~2,000 meters, while exploring a ridge extending to the southeast of Castellano Seamount. This seamount had never been previously surveyed and therefore its geology and biological communities were completely unknown.\n<p>Learn more about the expedition: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/welcome.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/welcome.html</a>\n</p><p>Video courtesy of the NOAA Office of Ocean Exploration and Research, 2016 Hohonu Moana.\n</p>\nSource: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/dailyupdates/media/video/dive_7_diverse/ex1603_dive7_diverse.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/dailyupdates/media/video/dive_7_diverse/ex1603_dive7_diverse.html</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/user/oceanexplorergov\">oceanexplorergov</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"32550368":{"pageid":32550368,"ns":6,"title":"File:Ex1402-dive01.webm","index":18,"imagerepository":"local","imageinfo":[{"size":42336156,"width":640,"height":360,"duration":261.379,"url":"https://upload.wikimedia.org/wikipedia/commons/a/a7/Ex1402-dive01.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ex1402-dive01.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=32550368","extmetadata":{"ImageDescription":{"value":"Okeanos Explorer Dive 01","source":"commons-desc-page"},"Artist":{"value":"NOAA Okeanos Explorer","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"3