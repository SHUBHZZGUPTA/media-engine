rturl":"https://commons.wikimedia.org/w/index.php?curid=32550766","extmetadata":{"ImageDescription":{"value":"Okeanos Explorer Dive 11","source":"commons-desc-page"},"Artist":{"value":"NOAA Okeanos Explorer","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"36598989":{"pageid":36598989,"ns":6,"title":"File:Ex1402-dive11 fish.webm","index":11,"imagerepository":"local","imageinfo":[{"size":5302815,"width":1920,"height":1080,"duration":14.398,"url":"https://upload.wikimedia.org/wikipedia/commons/6/6f/Ex1402-dive11_fish.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ex1402-dive11_fish.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=36598989","extmetadata":{"ImageDescription":{"value":"Deep-sea fish. This was filmed at a depth of about 28 m on April 23, 2014 in the north-central Gulf of Mexico. (No audio.)","source":"commons-desc-page"},"Artist":{"value":"NOAA Okeanos Explorer","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"32550769":{"pageid":32550769,"ns":6,"title":"File:Ex1402-dive12.webm","index":19,"imagerepository":"local","imageinfo":[{"size":43719123,"width":640,"height":360,"duration":284.504,"url":"https://upload.wikimedia.org/wikipedia/commons/c/cc/Ex1402-dive12.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ex1402-dive12.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=32550769","extmetadata":{"ImageDescription":{"value":"Okeanos Explorer Dive 12","source":"commons-desc-page"},"Artist":{"value":"NOAA Okeanos Explorer","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"58942796":{"pageid":58942796,"ns":6,"title":"File:Jellyfish- 2016 Deepwater Exploration of the Marianas.webm","index":17,"imagerepository":"local","imageinfo":[{"size":11380043,"width":1920,"height":1080,"duration":42.955,"url":"https://upload.wikimedia.org/wikipedia/commons/c/c1/Jellyfish-_2016_Deepwater_Exploration_of_the_Marianas.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Jellyfish-_2016_Deepwater_Exploration_of_the_Marianas.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=58942796","extmetadata":{"ImageDescription":{"value":"This stunningly beautiful jelly was seen during Dive 4 of the 2016 Deepwater Exploration of the Marianas expedition on April 24, 2016, while exploring the informally named \"Enigma Seamount\" at a depth of ~3,700 meters.\n<p>Scientists identified this hydromedusa as belonging to the genus Crossota. Note the two sets of tentacles \u2014 short and long. At the beginning of the video, you'll see that the long tentacles are even and extended outward and the bell is motionless. This suggests an ambush predation mode. Within the bell, the radial canals in red are connecting points for what looks like the gonads in bright yellow.\n</p><p>Video courtesy of the NOAA Office of Ocean Exploration and Research, 2016 Deepwater Exploration of the Marianas.\n</p><p>Learn more about the expedition here: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1605/welcome.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1605/welcome.html</a>\n</p>\nSource: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1605/dailyupdates/media/video/0424-jelly/0424-jelly.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1605/dailyupdates/media/video/0424-jelly/0424-jelly.html</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/user/oceanexplorergov\">oceanexplorergov</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"48457391":{"pageid":48457391,"ns":6,"title":"File:Jellyfish - Deepwater Exploration of the Marianas expedition - April 24, 2016.webm","index":21,"imagerepository":"local","imageinfo":[{"size":7358150,"width":1920,"height":1080,"duration":42.961,"url":"https://upload.wikimedia.org/wikipedia/commons/c/c0/Jellyfish_-_Deepwater_Exploration_of_the_Marianas_expedition_-_April_24%2C_2016.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Jellyfish_-_Deepwater_Exploration_of_the_Marianas_expedition_-_April_24,_2016.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=48457391","extmetadata":{"ImageDescription":{"value":"This stunningly beautiful jellyfish was seen during Dive 4 of the 2016 Deepwater Exploration of the Marianas expedition on April 24, 2016, while exploring Enigma Seamount at a depth of ~3,700 meters.\n<p>Scientists identified this hydromedusa as belonging to the genus Crossota. Note the two sets of tentacles \u2014 short and long. At the beginning of the video, you'll see that the long tentacles are even and extended outward and the bell is motionless. This suggests an ambush predation mode. Within the bell, the radial canals in red are connecting points for what looks like the gonads in bright yellow.\n</p><p>Video courtesy of the NOAA Office of Ocean Exploration and Research, 2016 Deepwater Exploration of the Marianas.\n</p>\nLearn more about the expedition here: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1605/welcome.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1605/welcome.html</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/user/oceanexplorergov\">oceanexplorergov</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"169489875":{"pageid":169489875,"ns":6,"title":"File:King crab eating a brittle star.webm","index":4,"imagerepository":"local","imageinfo":[{"size":95154991,"width":1280,"height":720,"duration":112.921,"url":"https://upload.wikimedia.org/wikipedia/commons/d/d9/King_crab_eating_a_brittle_star.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:King_crab_eating_a_brittle_star.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=169489875","extmetadata":{"ImageDescription":{"value":"NOAA Ship Okeanos Explorer Dive 11: A Bad Day to be a Brittle Star - During Dive 11, we observed this lithodid crab, which is a type of king crab, feasting on a brittle star. While a bit graphic to watch the crab pull the hapless brittle star apart, being able to witness predation events such as this offers scientists unique glimpses into the lives and behaviors of animals of the deep.","source":"commons-desc-page"},"Artist":{"value":"NOAA Office of Ocean Exploration and Research","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"58942701":{"pageid":58942701,"ns":6,"title":"File:NEW Octopus Species- 2016 Hohonu Moana- Exploring Deep Waters.webm","index":3,"imagerepository":"local","imageinfo":[{"size":6903083,"width":640,"height":360,"duration":46.021,"url":"https://upload.wikimedia.org/wikipedia/commons/6/67/NEW_Octopus_Species-_2016_Hohonu_Moana-_Exploring_Deep_Waters.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:NEW_Octopus_Species-_2016_Hohonu_Moana-_Exploring_Deep_Waters.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=58942701","extmetadata":{"ImageDescription":{"value":"During the first dive of the Okeanos Explorer 2016 Hohonu Moana: Exploring Deep Waters off Hawaii expedition to explore on the northeast side of <a href=\"//commons.wikimedia.org/wiki/Category:Necker_Island_(Hawaii)\" title=\"Category:Necker Island (Hawaii)\">Necker Island</a>, the Deep Discoverer remotely operated vehicle encountered this octopus, which confused several of our shore based scientists who have never seen anything like it. Upon further review, this ghostlike octopod is almost certainly an undescribed species and may not belong to any yet-described genus.\n<p>Learn more: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/logs/mar2/mar2.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/logs/mar2/mar2.html</a>\n</p><p>Video courtesy of the NOAA Office of Ocean Exploration and Research, 2016 Hohonu Moana: Exploring Deep Waters.\n</p>\nSource: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/dailyupdates/media/video/dive_1/ex1603_dive1_022716.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1603/dailyupdates/media/video/dive_1/ex1603_dive1_022716.html</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/user/oceanexplorergov\">oceanexplorergov</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"112718548":{"pageid":112718548,"ns":6,"title":"File:Okeanos Explorer PR and USVI Dive 8- Psychedelic Medusa-NOAA-1280x720.webm","index":2,"imagerepository":"local","imageinfo":[{"size":14478447,"width":1280,"height":720,"duration":67.624,"url":"https://upload.wikimedia.org/wikipedia/commons/9/9f/Okeanos_Explorer_PR_and_USVI_Dive_8-_Psychedelic_Medusa-NOAA-1280x720.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Okeanos_Explorer_PR_and_USVI_Dive_8-_Psychedelic_Medusa-NOAA-1280x720.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=112718548","extmetadata":{"ImageDescription":{"value":"Medusa \u2014 360-degree video feeding. \u201cWith tentacles extended in all directions, the Rhopalonematid jelly Crossota millsae is caught in a very interesting natural pose by the remotely operated vehicle (ROV) Deep Discoverer\u2019s cameras in waters south of La Parguera on the southwestern shore of Puerto Rico at a depth of 1,015 meters (3,330 feet). Moving just above the seafloor, ROV Deep Discoverer came across this jellyfish hovering with its tentacles extending outward in all directions. Looking into known accounts of jellyfish similar to this one, it appears the jellyfish shown is a male individual of Crossota millsae, a jellyfish in the Family <a href=\"//commons.wikimedia.org/w/index.php?title=Rhopalonematidae&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Rhopalonematidae (page does not exist)\">Rhopalonematidae</a>.\n<p>This is not the first time we have encountered a specimen like this \u2013 other species in this family of jellies have been caught by our ROV\u2019s cameras. Certainly psychedelic, the video shows a jelly in a very interesting pose, suggesting this jellyfish may feed by hovering above the seafloor with stinging cell-loaded tentacles extended and waiting for prey. In other dives, these poses were followed by rapid swimming.\n</p><p>Known from the Atlantic as well as the Pacific, jellies similar to these have been found not too far from the seafloor, suggesting a linkage between the benthos and the water column. Recording seemingly natural behaviors and stances by deep-ocean life in high-definition has given us the ability to not only identify these organisms, but learn a little about how they live.\u201d\n</p><p>\u2014 Text by Mike Ford, NOAA National Marine Fisheries Service and Smithsonian Environmental Research Center.\n</p>\nVideo courtesy of the NOAA Office of Ocean Exploration and Research, Exploring Deep-sea Habitats off Puerto Rico and the U.S. Virgin Islands, Dive 8","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/National_Oceanic_and_Atmospheric_Administration\" title=\"National Oceanic and Atmospheric Administration\">National Oceanic and Atmospheric Administration</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"73403140":{"pageid":73403140,"ns":6,"title":"File:Okeanos Explorer on Horizon Guyot.webm","index":1,"imagerepository":"local","imageinfo":[{"size":45470123,"width":1280,"height":720,"duration":81.987,"url":"https://upload.wikimedia.org/wikipedia/commons/0/09/Okeanos_Explorer_on_Horizon_Guyot.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Okeanos_Explorer_on_Horizon_Guyot.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=73403140","extmetadata":{"ImageDescription":{"value":"While exploring Horizon Guyot, a seamount located north of Johnston Atoll, scientists observed a seafloor community dominated by several species of hexactinellid \u2013 or glass \u2013 sponges. Glass sponges have skeletons made of silica, which is the same material used to make glass; however, glass sponges are not glass, per se.","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"28805175":{"pageid":28805175,"ns":6,"title":"File:Rhinochimera.webm","index":15,"imagerepository":"local","imageinfo":[{"size":2360264,"width":640,"height":360,"duration":81.81700000000001,"url":"https://upload.wikimedia.org/wikipedia/commons/3/34/Rhinochimera.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Rhinochimera.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=28805175","extmetadata":{"ImageDescription":{"value":"A Rhinochimera (Harriotta sp.) swims 10 meters above the seafloor in Hydrographer Canyon during Dive 05, July 13, of the Okeanos Explorer Northeast U.S. Canyons Expedition 2013. Video courtesy of NOAA Okeanos Explorer Program.","source":"commons-desc-page"},"Artist":{"value":"National Oceanic and Atmospheric Administration","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"39234199":{"pageid":39234199,"ns":6,"title":"File:Sonar data scan of the water column.ogv","index":13,"imagerepository":"local","imageinfo":[{"size":767261,"width":720,"height":480,"duration":7.541654599999999,"url":"https://upload.wikimedia.org/wikipedia/commons/e/e8/Sonar_data_scan_of_the_water_column.ogv?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Sonar_data_scan_of_the_water_column.ogv","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=39234199","extmetadata":{"ImageDescription":{"value":"Movie capturing the time lapse of a 3-D mapping of water column sonar data by the NOAA research ship <a rel=\"nofollow\" class=\"external text\" href=\"http://oceanexplorer.noaa.gov/\"><i>Okeanos Explorer</i></a> in the North Atlantic Ocean, July 2013. The sonar data are overlaid onto coastal relief model bathymetry courtesy of Elliot Lim. The backscattered signal (green) above the bottom is likely the deep scattering layer.","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"http://oceanexplorer.noaa.gov/\">NOAA <i>Okeanos Explorer</i></a>, Elliot Lim","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"application/ogg"}]},"58942736":{"pageid":58942736,"ns":6,"title":"File:Venus Flytrap Anemone- 2017 American Samoa.webm","index":6,"imagerepository":"local","imageinfo":[{"size":24598777,"width":1280,"height":720,"duration":57.085,"url":"https://upload.wikimedia.org/wikipedia/commons/0/02/Venus_Flytrap_Anemone-_2017_American_Samoa.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Venus_Flytrap_Anemone-_2017_American_Samoa.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=58942736","extmetadata":{"ImageDescription":{"value":"A beautiful, but perhaps sinister, Venus flytrap anemone perched on top of a dead Iridogorgia coral, closes up as the remotely operated vehicle approaches.\n<p>Video courtesy of the NOAA Office of Ocean Exploration and Research, 2017 American Samoa.\n</p>\nLearn more about the expedition: <a rel=\"nofollow\" class=\"external free\" href=\"http://oceanexplorer.noaa.gov/okeanos/explorations/ex1702/welcome.html\">http://oceanexplorer.noaa.gov/okeanos/explorations/ex1702/welcome.html</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/user/oceanexplorergov\">oceanexplorergov</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]},"47343695":{"pageid":47343695,"ns":6,"title":"File:Very Deep, Ghostlike Incirrate Octopod - NOAA Office of Ocean Exploration and Research, Hohonu Moana 2016.webm","index":25,"imagerepository":"local","imageinfo":[{"size":252020028,"width":1920,"height":1080,"duration":43.267,"url":"https://upload.wikimedia.org/wikipedia/commons/2/25/Very_Deep%2C_Ghostlike_Incirrate_Octopod_-_NOAA_Office_of_Ocean_Exploration_and_Research%2C_Hohonu_Moana_2016.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Very_Deep,_Ghostlike_Incirrate_Octopod_-_NOAA_Office_of_Ocean_Exploration_and_Research,_Hohonu_Moana_2016.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=47343695","extmetadata":{"ImageDescription":{"value":"This ghostlike octopod is almost certainly an undescribed species and may not belong to any described genus. Image courtesy of NOAA Office of Ocean Exploration and Research, Hohonu Moana 2016.","source":"commons-desc-page"},"Artist":{"value":"NOAA Office of Ocean Exploration and Research, Hohonu Moana 2016","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"video/webm"}]}}}}